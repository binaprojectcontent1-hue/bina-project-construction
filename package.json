{
  "name": "binaproject",
  "type": "module",
  "version": "2.0.0",
  "description": "Bina Project Construction & Interior Official Website",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/sync-media.mjs",
    "build": "astro build",
    "postbuild": "node scripts/ping-sitemap.mjs",
    "prepreview": "node scripts/sync-media.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "dev:dash": "npm --prefix apps/dashboard run dev",
    "build:dash": "npm --prefix apps/dashboard run build",
    "typecheck:dash": "npm --prefix apps/dashboard run typecheck",
    "dev:bio": "npm --prefix apps/biolink run dev",
    "build:bio": "npm --prefix apps/biolink run build",
    "typecheck:bio": "npm --prefix apps/biolink run typecheck",
    "dev:career": "npm --prefix apps/career run dev",
    "build:career": "npm --prefix apps/career run build",
    "typecheck:career": "npm --prefix apps/career run typecheck",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.2.1",
    "@iconify-json/simple-icons": "^1.2.95",
    "@iconify-json/solar": "^1.2.10",
    "@supabase/supabase-js": "^2.48.1",
    "astro": "^5.3.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro-icon": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
