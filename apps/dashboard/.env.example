# Supabase Configuration for dash.binaproject.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# GitHub Media Storage (user-provided token for security)
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=your-media-repo
VITE_GITHUB_BRANCH=main

# Error Monitoring (optional)
VITE_MONITORING_URL=https://your-monitoring-service.com/api/errors

# Cloudflare Pages Deploy Hook URL (dari project website utama di Cloudflare)
VITE_CLOUDFLARE_DEPLOY_HOOK_URL=
