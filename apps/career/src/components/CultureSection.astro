---
const pillars = [
  {
    icon: '🎨',
    title: 'Kebebasan Eksplorasi Desain',
    description: 'Kami mendorong setiap anggota tim untuk bereksperimen dan menuangkan kreativitas terbaiknya dalam setiap proyek arsitektur dan interior.',
  },
  {
    icon: '🤝',
    title: 'Budaya Kolaboratif & Terbuka',
    description: 'Tim kami bekerja dalam lingkungan yang saling mendukung, di mana setiap ide dihargai dan dikembangkan bersama.',
  },
  {
    icon: '🏗️',
    title: 'Proyek Nyata Skala Besar',
    description: 'Kesempatan terlibat langsung dalam proyek konstruksi dan renovasi berskala besar di Malang dan Jawa Timur.',
  },
  {
    icon: '📈',
    title: 'Pengembangan Keahlian Teknis',
    description: 'Kami berinvestasi dalam peningkatan skill tim — dari pelatihan software desain hingga manajemen proyek profesional.',
  },
];
---

<section class="py-16 sm:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
        Life at Bina Project
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
        Mengapa Berkarir di <span class="text-gradient-amber">Bina Project</span>?
      </h2>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Kami percaya bahwa karyawan yang bahagia dan berkembang akan menghasilkan karya arsitektur dan interior yang luar biasa.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {pillars.map((pillar) => (
        <div class="group relative rounded-2xl bg-gradient-to-br from-[#0E1E38]/80 to-[#0B132B]/60 border border-white/5 p-6 sm:p-8 hover:border-amber-500/20 transition-all duration-300 hover:shadow-lg hover:shadow-amber-500/5">
          <!-- Icon -->
          <div class="text-3xl mb-4">{pillar.icon}</div>
          
          <!-- Content -->
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-amber-400 transition-colors">
            {pillar.title}
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            {pillar.description}
          </p>

          <!-- Hover glow -->
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-amber-500/0 to-amber-500/0 group-hover:from-amber-500/3 group-hover:to-transparent transition-all duration-500 pointer-events-none"></div>
        </div>
      ))}
    </div>
  </div>
</section>
