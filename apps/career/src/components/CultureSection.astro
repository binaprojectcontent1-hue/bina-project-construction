---
const pillars = [
  {
    icon: 'solar:palette-round-linear',
    title: 'Eksplorasi Desain Tanpa Batas',
    description: 'Kami memberikan ruang dan kebebasan penuh bagi arsitek dan desainer interior untuk berinovasi, bereksperimen dengan material, dan melahirkan rancangan yang berani.',
  },
  {
    icon: 'solar:users-group-rounded-linear',
    title: 'Kultur Kolaboratif & Terbuka',
    description: 'Bekerja bersama tim multidisiplin (arsitek, estimator RAB, hingga pelaksana lapangan) dengan komunikasi yang transparan, apresiatif, dan saling mendukung.',
  },
  {
    icon: 'solar:buildings-linear',
    title: 'Proyek Nyata Berkualitas Tinggi',
    description: 'Keterlibatan langsung dalam proyek residensial mewah, villa estetik, kawasan komersial, hingga fasilitas publik terkemuka di Malang Raya dan Jawa Timur.',
  },
  {
    icon: 'solar:chart-square-linear',
    title: 'Jenjang Karir & Mentorship Nyata',
    description: 'Investasi berkelanjutan pada pengembangan kapabilitas tim: pelatihan software arsitektur terbaru (BIM, Enscape), sertifikasi teknis, dan mentoring langsung.',
  },
];
---

<section id="budaya" class="py-24 bg-[#F8FAFC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-technical font-bold uppercase tracking-widest text-[#22416D] block mb-2">
        Budaya &amp; Nilai Kerja
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-extrabold text-[#17202A] tracking-tight">
        Mengapa Membangun Karir di Bina Project?
      </h2>
      <p class="text-[#475569] font-body text-sm sm:text-base mt-3 leading-relaxed">
        Kami percaya karya konstruksi dan interior berkualitas berakar dari tim yang bertumbuh, dihargai, dan bangga atas setiap detail yang dibangun.
      </p>
    </div>

    <!-- 4-Pillar Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {pillars.map((pillar, idx) => (
        <div class="bg-white rounded-2xl p-7 sm:p-8 shadow-[0_2px_14px_rgba(13,25,43,0.04)] hover:shadow-[0_12px_28px_rgba(13,25,43,0.07)] hover:-translate-y-1 transition-all duration-300 flex items-start gap-5 border border-slate-200/60 group">
          <!-- Number Marker -->
          <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-slate-50 text-[#22416D] flex items-center justify-center font-technical text-base font-bold group-hover:bg-[#22416D] group-hover:text-white transition-colors">
            0{idx + 1}
          </div>

          <!-- Text -->
          <div>
            <h3 class="text-lg font-heading font-bold text-[#17202A] mb-2 group-hover:text-[#22416D] transition-colors">
              {pillar.title}
            </h3>
            <p class="text-sm font-body text-[#475569] leading-relaxed">
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
