---
interface Props {
  slug: string;
  title: string;
  department: string;
  jobType: string;
  workplaceType: string;
  location: string;
  experienceLevel: string;
  deadline?: string | null;
  salaryRange?: string | null;
  showSalary?: boolean;
}

const { slug, title, department, jobType, workplaceType, location, experienceLevel, deadline, salaryRange, showSalary } = Astro.props;

const deptStyles: Record<string, { bg: string; text: string; border: string }> = {
  'Arsitektur & Desain': { bg: 'bg-[#EFF6FF]', text: 'text-[#22416D]', border: 'border-[#BFDBFE]' },
  'Konstruksi & Lapangan': { bg: 'bg-[#F0FDF4]', text: 'text-[#166534]', border: 'border-[#BBF7D0]' },
  'Estimator & RAB': { bg: 'bg-[#F8FAFC]', text: 'text-[#1E293B]', border: 'border-[#CBD5E1]' },
  'Marketing & Finance': { bg: 'bg-[#FAF5FF]', text: 'text-[#6B21A8]', border: 'border-[#E9D5FF]' },
  'Magang': { bg: 'bg-[#FFFBEB]', text: 'text-[#92400E]', border: 'border-[#FDE68A]' },
};

const badgeTheme = deptStyles[department] || { bg: 'bg-[#EFF6FF]', text: 'text-[#22416D]', border: 'border-[#BFDBFE]' };

const deadlineDate = deadline ? new Date(deadline) : null;
const isExpiringSoon = deadlineDate && (deadlineDate.getTime() - Date.now()) < 7 * 24 * 60 * 60 * 1000;
---

<a
  href={`/loker/${slug}`}
  class="bento-card bento-card-hover p-6 sm:p-7 block group relative text-[#17202A] no-underline bg-white"
>
  <!-- Top Row: Department Badge + Job Type -->
  <div class="flex items-center justify-between gap-3 mb-3.5">
    <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-technical font-bold border ${badgeTheme.bg} ${badgeTheme.text} ${badgeTheme.border}`}>
      {department}
    </span>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-technical font-medium bg-[#F1F5F9] text-[#475569] border border-[#E2E8F0]">
      {jobType}
    </span>
  </div>

  <!-- Job Title -->
  <h3 class="text-xl font-heading font-extrabold text-[#17202A] mb-3 group-hover:text-[#22416D] transition-colors leading-snug line-clamp-2">
    {title}
  </h3>

  <!-- Info Tags (Location, Experience, Workplace) -->
  <div class="flex flex-wrap gap-2.5 mb-5">
    <span class="inline-flex items-center gap-1.5 text-xs font-technical font-medium text-[#475569] bg-[#F8FAFC] px-2.5 py-1 rounded-md border border-[#E2E8F0]">
      <svg class="w-3.5 h-3.5 text-[#22416D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {location}
    </span>
    <span class="inline-flex items-center gap-1.5 text-xs font-technical font-medium text-[#475569] bg-[#F8FAFC] px-2.5 py-1 rounded-md border border-[#E2E8F0]">
      <svg class="w-3.5 h-3.5 text-[#22416D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      {experienceLevel}
    </span>
    <span class="inline-flex items-center gap-1.5 text-xs font-technical font-medium text-[#475569] bg-[#F8FAFC] px-2.5 py-1 rounded-md border border-[#E2E8F0]">
      <svg class="w-3.5 h-3.5 text-[#22416D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      {workplaceType}
    </span>
  </div>

  <!-- Salary, Deadline & Button Row -->
  <div class="flex items-center justify-between gap-3 pt-4 border-t border-[#E2E8F0]">
    <div>
      {showSalary && salaryRange ? (
        <span class="inline-block text-xs font-technical font-bold text-[#065F46] bg-[#ECFDF5] px-2.5 py-1 rounded-md border border-[#A7F3D0]">
          {salaryRange}
        </span>
      ) : (
        <span class="text-xs font-technical font-medium text-[#64748B]">
          Gaji Kompetitif
        </span>
      )}
    </div>

    <div class="flex items-center gap-3">
      {deadlineDate && (
        <span class={`text-xs font-technical font-medium ${isExpiringSoon ? 'text-red-600 font-bold' : 'text-[#64748B]'}`}>
          Batas: {deadlineDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' })}
        </span>
      )}
      
      <span class="w-8 h-8 rounded-lg bg-[#EFF6FF] text-[#22416D] group-hover:bg-[#22416D] group-hover:text-white transition-all flex items-center justify-center shadow-xs">
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </div>
</a>
