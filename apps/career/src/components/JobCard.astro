---
interface Props {
  slug: string;
  title: string;
  department: string;
  jobType: string;
  workplaceType: string;
  location: string;
  experienceLevel: string;
  thumbnailUrl?: string | null;
  deadline?: string | null;
  salaryRange?: string | null;
  showSalary?: boolean;
  status?: string | null;
}

const {
  slug,
  title,
  department,
  jobType,
  workplaceType,
  location,
  experienceLevel,
  thumbnailUrl,
  deadline,
  salaryRange,
  showSalary,
  status = 'published',
} = Astro.props;

// Curated high-res architectural & construction photography per department
const defaultThumbnails: Record<string, string> = {
  'Arsitektur & Desain': 'https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=800&auto=format&fit=crop',
  'Konstruksi & Lapangan': 'https://images.unsplash.com/photo-1541888946425-d0fbb186f5f7?q=80&w=800&auto=format&fit=crop',
  'Estimator & RAB': 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?q=80&w=800&auto=format&fit=crop',
  'Marketing & Finance': 'https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop',
  'Magang': 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800&auto=format&fit=crop',
};

const thumbnail = thumbnailUrl?.trim() || defaultThumbnails[department] || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=800&auto=format&fit=crop';

const deadlineDate = deadline ? new Date(deadline) : null;
const isClosed = status === 'closed' || (deadlineDate && deadlineDate.getTime() < Date.now());
const isExpiringSoon = !isClosed && deadlineDate && (deadlineDate.getTime() - Date.now()) < 7 * 24 * 60 * 60 * 1000;
---

<a
  href={`/loker/${slug}`}
  class={`bg-white rounded-3xl overflow-hidden flex flex-col sm:flex-row h-full group relative text-[#17202A] no-underline border ${isClosed ? 'border-slate-300/80 bg-slate-50/20' : 'border-slate-200/80'} shadow-[0_4px_20px_rgba(13,25,43,0.04)] hover:shadow-[0_20px_45px_-12px_rgba(34,65,109,0.18)] hover:border-[#22416D]/40 hover:-translate-y-1.5 transition-all duration-400 ease-out`}
>
  <!-- Left Panel: Pure 1:1 Edge-to-Edge Media Panel (No Pill Badges) -->
  <div class="relative w-full sm:w-56 lg:w-60 aspect-square shrink-0 overflow-hidden bg-slate-950">
    <img
      src={thumbnail}
      alt={title}
      loading="lazy"
      class={`w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 ${isClosed ? 'grayscale contrast-125 opacity-70' : ''}`}
    />
  </div>

  <!-- Right Panel: Clean Bento Content & Metadata (No Pill Badges) -->
  <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between min-w-0 bg-white group-hover:bg-gradient-to-br group-hover:from-white group-hover:via-white group-hover:to-slate-50/70 transition-colors duration-400">
    <div>
      <!-- Eyebrow (Department & Job Type / Closed Notice) -->
      <div class="flex items-center justify-between gap-2 mb-2.5 text-xs font-technical">
        <span class="font-bold uppercase tracking-widest text-[#22416D]">
          {department}
        </span>
        {isClosed ? (
          <span class="font-bold text-rose-600 uppercase tracking-wider">
            [Lowongan Ditutup]
          </span>
        ) : (
          <span class="text-slate-400">
            {jobType}
          </span>
        )}
      </div>

      <!-- Job Title -->
      <h3 class="text-xl sm:text-2xl font-heading font-black text-[#17202A] group-hover:text-[#22416D] transition-colors leading-snug mb-3.5 line-clamp-2">
        {title}
      </h3>

      <!-- Clean Inline Metadata with Minimalist Icons (No Boxed Pills) -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-technical text-slate-500 mb-6">
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{location}</span>
        </div>

        <span class="text-slate-300 hidden sm:inline">&bull;</span>

        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{experienceLevel}</span>
        </div>

        <span class="text-slate-300 hidden sm:inline">&bull;</span>

        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          <span>{workplaceType}</span>
        </div>
      </div>
    </div>

    <!-- Bottom Footer Row: Salary, Deadline & Detail Link (Clean Minimalist) -->
    <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3 mt-auto">
      <div>
        {isClosed ? (
          <span class="text-xs font-technical text-slate-400 font-medium">
            Pendaftaran Berakhir
          </span>
        ) : showSalary && salaryRange ? (
          <span class="text-xs font-technical font-bold text-emerald-700">
            {salaryRange}
          </span>
        ) : (
          <span class="text-xs font-technical text-slate-400 font-medium">
            Gaji Kompetitif
          </span>
        )}
      </div>

      <div class="flex items-center gap-4">
        {!isClosed && deadlineDate && (
          <span class={`text-xs font-technical ${isExpiringSoon ? 'text-red-600 font-bold' : 'text-slate-400'}`}>
            {isExpiringSoon ? 'Segera Berakhir' : `Batas: ${deadlineDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' })}`}
          </span>
        )}

        <!-- Detail Link -->
        <span class={`inline-flex items-center gap-1 text-xs font-heading font-bold ${isClosed ? 'text-slate-500 group-hover:text-slate-800' : 'text-[#22416D] group-hover:text-[#1B365D]'} transition-colors`}>
          <span>{isClosed ? 'Lihat Arsip Posisi' : 'Lihat Detail'}</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>
  </div>
</a>
