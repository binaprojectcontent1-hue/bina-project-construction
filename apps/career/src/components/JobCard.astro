---
interface Props {
  slug: string;
  title: string;
  department: string;
  jobType: string;
  workplaceType: string;
  location: string;
  experienceLevel: string;
  deadline?: string | null;
  salaryRange?: string | null;
  showSalary?: boolean;
}

const { slug, title, department, jobType, workplaceType, location, experienceLevel, deadline, salaryRange, showSalary } = Astro.props;

const deptColors: Record<string, string> = {
  'Arsitektur & Desain': 'bg-violet-500/15 text-violet-300 border-violet-500/20',
  'Konstruksi & Lapangan': 'bg-emerald-500/15 text-emerald-300 border-emerald-500/20',
  'Estimator & RAB': 'bg-blue-500/15 text-blue-300 border-blue-500/20',
  'Marketing & Finance': 'bg-pink-500/15 text-pink-300 border-pink-500/20',
  'Magang': 'bg-amber-500/15 text-amber-300 border-amber-500/20',
};

const badgeClass = deptColors[department] || 'bg-slate-500/15 text-slate-300 border-slate-500/20';

const deadlineDate = deadline ? new Date(deadline) : null;
const isExpiringSoon = deadlineDate && (deadlineDate.getTime() - Date.now()) < 7 * 24 * 60 * 60 * 1000;
---

<a
  href={`/loker/${slug}`}
  class="group block relative rounded-2xl bg-gradient-to-br from-[#0E1E38] to-[#0B132B] border border-white/5 p-5 sm:p-6 hover:border-amber-500/20 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/5 hover:-translate-y-0.5"
>
  <!-- Top Row: Department Badge + Job Type -->
  <div class="flex items-center justify-between gap-3 mb-4">
    <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border ${badgeClass}`}>
      {department}
    </span>
    <span class="text-xs text-slate-500 font-medium">
      {jobType}
    </span>
  </div>

  <!-- Title -->
  <h3 class="text-lg font-bold text-white mb-3 group-hover:text-amber-400 transition-colors line-clamp-2">
    {title}
  </h3>

  <!-- Info Tags -->
  <div class="flex flex-wrap gap-2 mb-4">
    <span class="inline-flex items-center gap-1.5 text-xs text-slate-400">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      {location}
    </span>
    <span class="inline-flex items-center gap-1.5 text-xs text-slate-400">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      {experienceLevel}
    </span>
    <span class="inline-flex items-center gap-1.5 text-xs text-slate-400">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
      {workplaceType}
    </span>
  </div>

  <!-- Salary & Deadline -->
  <div class="flex items-center justify-between gap-3 pt-4 border-t border-white/5">
    {showSalary && salaryRange ? (
      <span class="text-sm font-bold text-amber-400">{salaryRange}</span>
    ) : (
      <span class="text-xs text-slate-500">Gaji kompetitif</span>
    )}

    {deadlineDate && (
      <span class={`text-xs font-medium ${isExpiringSoon ? 'text-red-400' : 'text-slate-500'}`}>
        Batas: {deadlineDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
      </span>
    )}
  </div>

  <!-- CTA Arrow -->
  <div class="absolute bottom-5 right-5 sm:bottom-6 sm:right-6 w-8 h-8 rounded-full bg-amber-500/10 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-0.5">
    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
  </div>
</a>
