---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/#lowongan', label: 'Lowongan Kerja' },
  { href: '/#budaya', label: 'Budaya Kerja' },
  { href: '/#faq', label: 'FAQ' },
].map((item) => {
  const isHome = item.href === '/';
  const isActive = isHome
    ? currentPath === '/'
    : currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
  return { ...item, isActive };
});
---

<header class="modern-header">
  <!--============================== Main Glassmorphism Navbar ==============================-->
  <div class="main-navbar-sticky" id="mainNavbarSticky">
    <div class="navbar-container">
      <div class="navbar-inner">
        <!-- Logo & Portal Badge -->
        <div class="navbar-logo">
          <a href="/" class="logo-link">
            <img
              src="/assets/img/logo.svg"
              alt="Bina Project"
              width="180"
              height="63"
              fetchpriority="high"
              decoding="async"
            />
            <span class="portal-badge">Karir</span>
          </a>
        </div>

        <!-- React Bits Style Pill Dock Nav (Desktop) -->
        <div class="dock-wrapper">
          <nav class="nav-pill-dock" aria-label="Navigasi Karir">
            {navLinks.map((item) => (
              <a
                href={item.href}
                class={`nav-pill-item ${item.isActive ? 'active' : ''}`}
                aria-current={item.isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <!-- shadcn/ui Style Actions -->
        <div class="navbar-actions">
          <!-- Secondary Action: Link ke Web Utama -->
          <a
            href="https://binaproject.id"
            target="_blank"
            rel="noopener noreferrer"
            class="shadcn-ghost-btn"
          >
            <span>Web Utama</span>
            <svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>

          <!-- Primary CTA Button: Lihat Lowongan -->
          <a href="/#lowongan" class="shadcn-cta-btn">
            <span>Lihat Lowongan</span>
            <svg class="arrow-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>

          <!-- Mobile Toggle Button -->
          <button
            type="button"
            class="mobile-toggle-btn"
            id="careerMobileToggle"
            aria-label="Buka Menu Mobile"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Mobile Slide-Out Drawer ==============================-->
  <div class="custom-mobile-menu" id="careerMobileDrawer">
    <div class="custom-drawer-body">
      <!-- Top Header -->
      <div class="drawer-header">
        <a href="/" class="drawer-logo-wrap">
          <img src="/assets/img/logo.svg" alt="Bina Project Logo" width="145" height="50" />
          <span class="portal-badge-sm">Karir</span>
        </a>
        <button type="button" class="drawer-close-btn" id="careerDrawerCloseBtn" aria-label="Tutup Menu Mobile">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Navigation Menu Landmark -->
      <nav class="drawer-nav-section" aria-label="Navigasi Menu Mobile">
        <div class="drawer-nav-list">
          <!-- Beranda -->
          <a href="/" class={`drawer-nav-link ${currentPath === '/' ? 'active' : ''}`}>
            <div class="drawer-item-content">
              <div class="drawer-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </div>
              <span class="drawer-item-text">Beranda</span>
            </div>
            <svg class="drawer-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>

          <!-- Lowongan Kerja -->
          <a href="/#lowongan" class="drawer-nav-link">
            <div class="drawer-item-content">
              <div class="drawer-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <span class="drawer-item-text">Lowongan Kerja</span>
            </div>
            <svg class="drawer-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>

          <!-- Budaya Kerja -->
          <a href="/#budaya" class="drawer-nav-link">
            <div class="drawer-item-content">
              <div class="drawer-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="drawer-item-text">Budaya Kerja</span>
            </div>
            <svg class="drawer-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>

          <!-- FAQ -->
          <a href="/#faq" class="drawer-nav-link">
            <div class="drawer-item-content">
              <div class="drawer-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </div>
              <span class="drawer-item-text">FAQ</span>
            </div>
            <svg class="drawer-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>

        <!-- Micro Studio Info -->
        <div class="drawer-studio-info">
          <div class="drawer-studio-header">
            <span class="status-pulse-dot"></span>
            <span class="drawer-studio-name">Portal Karir Bina Project</span>
          </div>
          <p class="drawer-studio-address">
            Wujudkan potensi terbaik Anda dalam tim profesional rancang bangun, konstruksi, dan interior Jawa Timur.
          </p>
        </div>
      </nav>

      <!-- Bottom Footer Section -->
      <div class="drawer-footer">
        <a href="/#lowongan" class="drawer-cta-btn drawer-cta-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="me-2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
          <span>Lihat Lowongan Kerja</span>
        </a>

        <a
          href="https://binaproject.id"
          target="_blank"
          rel="noopener noreferrer"
          class="drawer-cta-btn drawer-cta-secondary"
        >
          <span>Kunjungi Website Utama</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ms-1.5">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .modern-header {
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 1000;
  }

  /* Main Sticky Navbar with Apple Glassmorphism */
  .main-navbar-sticky {
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.7);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease;
    z-index: 100;
  }

  .navbar-container {
    width: 100%;
    max-width: 1440px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  @media (min-width: 1200px) {
    .navbar-container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .main-navbar-sticky.is-scrolled {
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 10px 30px rgba(13, 25, 43, 0.08);
    border-bottom-color: rgba(226, 232, 240, 0.9);
  }

  .main-navbar-sticky.is-scrolled .navbar-inner {
    padding-top: 6px;
    padding-bottom: 6px;
  }

  /* Logo & Brand Badge */
  .navbar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    gap: 10px;
  }

  .navbar-logo img {
    width: 175px;
    height: auto;
    max-width: 100%;
    display: block;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
  }

  .main-navbar-sticky.is-scrolled .navbar-logo img {
    transform: scale(0.95);
  }

  .portal-badge {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 3px 8px;
    border-radius: 6px;
    background: #EFF6FF;
    color: #22416D;
    border: 1px solid #DBEAFE;
    white-space: nowrap;
  }

  /* Center Pill Navigation Dock */
  .dock-wrapper {
    display: none;
  }

  @media (min-width: 992px) {
    .dock-wrapper {
      display: block;
    }
  }

  .nav-pill-dock {
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 9999px;
    padding: 5px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
  }

  .nav-pill-item {
    color: #334155;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: 9999px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    line-height: 1.2;
  }

  .nav-pill-item:hover {
    background: #22416D;
    color: #FFFFFF !important;
  }

  .nav-pill-item.active {
    background: #22416D;
    color: #FFFFFF !important;
    box-shadow: 0 2px 8px rgba(34, 65, 109, 0.2);
  }

  @media (min-width: 992px) and (max-width: 1200px) {
    .nav-pill-dock {
      padding: 4px;
      gap: 3px;
    }
    .nav-pill-item {
      padding: 7px 13px;
      font-size: 13.5px;
    }
  }

  /* Actions Container */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Secondary Button (Web Utama) */
  .shadcn-ghost-btn {
    display: none;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    color: #334155 !important;
    padding: 9px 16px;
    border-radius: 12px;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid #E2E8F0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .shadcn-ghost-btn {
      display: inline-flex;
    }
  }

  .shadcn-ghost-btn:hover {
    background: #EFF6FF;
    border-color: #22416D;
    color: #22416D !important;
  }

  .shadcn-ghost-btn .arrow-icon {
    transition: transform 0.2s ease;
  }

  .shadcn-ghost-btn:hover .arrow-icon {
    transform: translate(2px, -2px);
  }

  /* Primary Button (CTA: Lihat Lowongan) */
  .shadcn-cta-btn {
    display: none;
    align-items: center;
    gap: 6px;
    background: #22416D;
    color: #FFFFFF !important;
    padding: 10px 20px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
    text-decoration: none;
    border: 1.5px solid #22416D;
    box-shadow: 0 2px 8px rgba(34, 65, 109, 0.15);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .shadcn-cta-btn {
      display: inline-flex;
    }
  }

  .shadcn-cta-btn:hover {
    background: #1B3457;
    border-color: #1B3457;
  }

  .shadcn-cta-btn .arrow-icon {
    transition: transform 0.2s ease;
  }

  .shadcn-cta-btn:hover .arrow-icon {
    transform: translateY(2px);
  }

  /* Mobile Toggle Button */
  .mobile-toggle-btn {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 12px;
    border: 1.5px solid #E2E8F0;
    background: #FFFFFF;
    color: #17202A;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  @media (min-width: 992px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  .mobile-toggle-btn:hover {
    background: #F8FAFC;
    border-color: #CBD5E1;
  }

  /*============================== Slide-Out Mobile Drawer ==============================*/
  .custom-mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(13, 25, 43, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    display: flex;
    justify-content: flex-start;
  }

  .custom-mobile-menu.th-body-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .custom-drawer-body {
    width: 85%;
    max-width: 380px;
    height: 100%;
    background: #FFFFFF;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    box-shadow: 8px 0 40px rgba(0, 0, 0, 0.15);
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .custom-mobile-menu.th-body-visible .custom-drawer-body {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid #E2E8F0;
  }

  .drawer-logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .portal-badge-sm {
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 2px 6px;
    border-radius: 4px;
    background: #EFF6FF;
    color: #22416D;
    border: 1px solid #DBEAFE;
  }

  .drawer-close-btn {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1.5px solid #E2E8F0;
    background: #F8FAFC;
    color: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .drawer-close-btn:hover {
    background: #EF4444;
    border-color: #EF4444;
    color: #FFFFFF;
  }

  .drawer-nav-section {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .drawer-nav-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .drawer-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: 10px;
    color: #334155;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .drawer-nav-link:hover,
  .drawer-nav-link.active {
    background: #EFF6FF;
    color: #22416D;
  }

  .drawer-item-content {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .drawer-item-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #F1F5F9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #22416D;
    flex-shrink: 0;
  }

  .drawer-arrow {
    color: #94A3B8;
  }

  .drawer-studio-info {
    margin-top: 25px;
    padding: 14px 16px;
    border-radius: 12px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
  }

  .drawer-studio-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .status-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .drawer-studio-name {
    font-size: 12px;
    font-weight: 500;
    color: #17202A;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .drawer-studio-address {
    font-size: 13px;
    color: #475569;
    line-height: 1.5;
    margin: 0;
  }

  .drawer-footer {
    padding-top: 20px;
    margin-top: auto;
    border-top: 1px solid #E2E8F0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .drawer-cta-btn {
    width: 100%;
    padding: 12px 18px;
    border-radius: 12px;
    font-weight: 500;
    font-size: 14px;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .drawer-cta-primary {
    background: #22416D;
    color: #FFFFFF !important;
    border: 1.5px solid #22416D;
    box-shadow: 0 2px 8px rgba(34, 65, 109, 0.15);
  }

  .drawer-cta-primary:hover {
    background: #1B3457;
    border-color: #1B3457;
  }

  .drawer-cta-secondary {
    background: #F8FAFC;
    color: #22416D !important;
    border: 1.5px solid #CBD5E1;
  }

  .drawer-cta-secondary:hover {
    background: #EFF6FF;
    border-color: #22416D;
  }
</style>

<script>
  function initCareerHeader() {
    // 1. Sticky Navbar Condensation on Scroll
    const navbar = document.getElementById('mainNavbarSticky');
    if (navbar) {
      let ticking = false;
      const updateNavbar = () => {
        const scrollY = window.scrollY || window.pageYOffset || 0;
        if (scrollY > 20) {
          navbar.classList.add('is-scrolled');
        } else {
          navbar.classList.remove('is-scrolled');
        }
        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateNavbar);
          ticking = true;
        }
      }, { passive: true });

      updateNavbar();
    }

    // 2. Mobile Drawer Interaction
    const drawer = document.getElementById('careerMobileDrawer');
    const toggleBtn = document.getElementById('careerMobileToggle');
    const closeBtn = document.getElementById('careerDrawerCloseBtn');

    if (drawer && toggleBtn) {
      if ((drawer as any)._hasCareerMenuHandler) return;
      (drawer as any)._hasCareerMenuHandler = true;

      const openDrawer = () => {
        drawer.classList.add('th-body-visible');
        document.body.style.overflow = 'hidden';
      };

      const closeDrawer = () => {
        drawer.classList.remove('th-body-visible');
        document.body.style.overflow = '';
      };

      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openDrawer();
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          closeDrawer();
        });
      }

      // Backdrop click
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) {
          closeDrawer();
        }
      });

      // Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('th-body-visible')) {
          closeDrawer();
        }
      });

      // Nav link click inside drawer
      const links = drawer.querySelectorAll('.drawer-nav-link, .drawer-cta-btn');
      links.forEach((link) => {
        link.addEventListener('click', () => {
          closeDrawer();
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCareerHeader);
  } else {
    initCareerHeader();
  }

  document.addEventListener('astro:page-load', initCareerHeader);
</script>
