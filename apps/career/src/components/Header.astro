---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda Karir' },
  { href: '/#lowongan', label: 'Lowongan' },
  { href: '/talent-pool', label: 'Talent Pool' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-[#0B132B]/80 border-b border-white/5">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-18">
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-[#F68A0A] to-[#E07800] text-white font-extrabold text-sm shadow-lg shadow-amber-500/20 group-hover:shadow-amber-500/40 transition-shadow">
          B
        </div>
        <div class="hidden sm:block">
          <span class="block text-sm font-bold text-white leading-tight">Bina Project</span>
          <span class="block text-[11px] text-amber-400/80 font-medium leading-tight">Karir & Rekrutmen</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-4 py-2 rounded-full text-sm font-medium transition-all ${
              currentPath === link.href
                ? 'bg-white/10 text-white'
                : 'text-slate-300 hover:text-white hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a
          href="https://binaproject.id"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 px-4 py-2 rounded-full text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5 transition-all flex items-center gap-1.5"
        >
          <span>Website Utama</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-[#0B132B]/95 backdrop-blur-xl">
    <div class="px-4 py-3 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-2.5 rounded-xl text-sm font-medium transition-all ${
            currentPath === link.href
              ? 'bg-white/10 text-white'
              : 'text-slate-300 hover:text-white hover:bg-white/5'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://binaproject.id"
        target="_blank"
        rel="noopener noreferrer"
        class="block px-4 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-white/5 transition-all"
      >
        Website Utama ↗
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
