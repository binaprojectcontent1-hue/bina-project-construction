---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/#lowongan', label: 'Lowongan Kerja' },
  { href: '/#budaya', label: 'Budaya Kerja' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/talent-pool', label: 'Talent Pool' },
];
---

<header class="sticky top-0 z-50 bg-white/92 backdrop-blur-md border-b border-[#E2E8F0] shadow-[0_4px_20px_rgba(13,25,43,0.04)] transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Career Badge -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <img
            src="/assets/img/logo.svg"
            alt="Bina Project"
            width="170"
            height="50"
            class="h-10 w-auto object-contain transition-transform group-hover:scale-98"
          />
        </a>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-technical font-semibold bg-[#EFF6FF] text-[#22416D] border border-[#BFDBFE]">
          Karir
        </span>
      </div>

      <!-- React Bits Style Pill Dock Nav (Desktop) -->
      <nav class="hidden lg:flex items-center">
        <div class="nav-pill-dock">
          {navLinks.map((link) => {
            const isActive = link.href === '/' 
              ? currentPath === '/' 
              : currentPath === link.href || currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class={`nav-pill-item ${isActive ? 'active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </div>
      </nav>

      <!-- Action Button (Desktop) -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="https://binaproject.id"
          target="_blank"
          rel="noopener noreferrer"
          class="th-btn th-btn-sm gap-1.5 group"
        >
          <span>Web Utama</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2.5 rounded-xl text-[#334155] hover:text-[#22416D] hover:bg-[#F1F5F9] transition-colors"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#E2E8F0] bg-white/98 backdrop-blur-xl px-4 py-4 shadow-xl">
    <div class="space-y-1.5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-2.5 rounded-xl text-sm font-semibold transition-all ${
            currentPath === link.href
              ? 'bg-[#22416D] text-white'
              : 'text-[#334155] hover:bg-[#F1F5F9] hover:text-[#22416D]'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="pt-2 border-t border-[#E2E8F0]">
        <a
          href="https://binaproject.id"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl text-sm font-bold bg-[#EFF6FF] text-[#22416D] border border-[#BFDBFE] hover:bg-[#DBEAFE] transition-colors"
        >
          <span>Kunjungi Website Utama</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
