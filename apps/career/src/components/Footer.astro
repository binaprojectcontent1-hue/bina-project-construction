---
const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 bg-[#070D1A]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-[#F68A0A] to-[#E07800] text-white font-extrabold text-sm shadow-lg shadow-amber-500/20">
            B
          </div>
          <div>
            <span class="block text-sm font-bold text-white">Bina Project</span>
            <span class="block text-[11px] text-slate-400">Construction & Interior</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-xs">
          Membangun mahakarya arsitektur dan interior dengan standar profesional tertinggi di Malang, Jawa Timur.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-4">Karir</h3>
        <ul class="space-y-2.5">
          <li><a href="/" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">Beranda Karir</a></li>
          <li><a href="/#lowongan" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">Lowongan Terbuka</a></li>
          <li><a href="/talent-pool" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">Talent Pool</a></li>
        </ul>
      </div>

      <!-- Ecosystem -->
      <div>
        <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-4">Ekosistem</h3>
        <ul class="space-y-2.5">
          <li><a href="https://binaproject.id" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">Website Utama ↗</a></li>
          <li><a href="https://binaproject.id/portfolio" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">Portofolio ↗</a></li>
          <li><a href="https://bio.binaproject.id" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">Bio Link ↗</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-4">Hubungi Kami</h3>
        <ul class="space-y-2.5">
          <li class="text-sm text-slate-400">
            <span class="block text-slate-300 font-medium">Kantor Malang</span>
            Jawa Timur, Indonesia
          </li>
          <li>
            <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">
              WhatsApp HRD ↗
            </a>
          </li>
          <li>
            <a href="mailto:hrd@binaproject.id" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">
              hrd@binaproject.id
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} Bina Project Construction & Interior. Hak cipta dilindungi.
      </p>
      <div class="flex items-center gap-4">
        <a href="https://instagram.com/binaproject" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-amber-400 transition-colors" aria-label="Instagram">
