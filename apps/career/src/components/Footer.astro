---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: 'Beranda Karir', href: '/' },
  { name: 'Lowongan Kerja', href: '/#lowongan' },
  { name: 'Budaya Kerja', href: '/#budaya' },
  { name: 'FAQ Rekrutmen', href: '/#faq' },
  { name: 'Talent Pool', href: '/talent-pool' },
];

const ecosystemLinks = [
  { name: 'Website Resmi Bina Project', href: 'https://binaproject.id' },
  { name: 'Portofolio Proyek', href: 'https://binaproject.id/portfolio' },
  { name: 'Proyek Berjalan (Live)', href: 'https://binaproject.id/about#proyek-berjalan' },
  { name: 'Blog & Tips Arsitektur', href: 'https://binaproject.id/blog' },
  { name: 'Bio Link Media Sosial', href: 'https://bio.binaproject.id' },
];
---

<footer class="relative bg-[#0D192B] text-slate-300 font-body border-t border-[#1E3A5F]">
  
  <!-- Top Callout Strip (Bina Project Bento Banner) -->
  <div class="border-b border-[#1A3356] bg-gradient-to-r from-[#0D192B] via-[#152A47] to-[#0D192B] py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-[#1A3356]/90 to-[#0A1320]/90 rounded-2xl p-6 sm:p-8 border border-[#2B4C7E] flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="text-center md:text-left">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-technical font-semibold bg-[#22416D] text-[#84ACDF] mb-2.5">
            Bina Project Construction & Interior
          </span>
          <h3 class="text-xl sm:text-2xl font-heading font-extrabold text-white">
            Solusi Aman Membangun Ruang Impian Anda
          </h3>
          <p class="text-sm text-slate-300 mt-1 max-w-xl">
            Tertarik bekerja sama untuk proyek arsitektur, perencanaan desain, kontraktor, atau renovasi bangunan?
          </p>
        </div>
        <div class="flex-shrink-0">
          <a
            href="https://binaproject.id/contact"
            target="_blank"
            rel="noopener noreferrer"
            class="th-btn bg-white text-[#22416D]! hover:bg-[#EFF6FF]! border-white shadow-lg text-sm"
          >
            <span>Konsultasi Proyek Gratis</span>
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main 4-Column Footer Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      
      <!-- Col 1: Brand & Profile -->
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <img
            src="/assets/img/logo.svg"
            alt="Bina Project"
            width="180"
            height="55"
            class="h-11 w-auto brightness-0 invert object-contain"
          />
        </a>
        <p class="text-sm text-slate-300 leading-relaxed">
          Perusahaan profesional yang bergerak di bidang desain perencanaan, kontraktor interior, kontraktor konstruksi, dan waterproofing terpercaya di Malang, Jawa Timur.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://instagram.com/binaproject"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-[#1A3356] text-white hover:bg-[#22416D] hover:text-[#84ACDF] transition-colors flex items-center justify-center text-sm"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a
            href="https://tiktok.com/@binaproject"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-[#1A3356] text-white hover:bg-[#22416D] hover:text-[#84ACDF] transition-colors flex items-center justify-center text-sm"
            aria-label="TikTok"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V9.37a8.16 8.16 0 004.76 1.52v-3.4a4.85 4.85 0 01-1-.8z"/></svg>
          </a>
          <a
            href="https://wa.me/6281335335304"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-[#1A3356] text-white hover:bg-[#22416D] hover:text-[#84ACDF] transition-colors flex items-center justify-center text-sm"
            aria-label="WhatsApp"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigasi Karir -->
      <div>
        <h4 class="text-sm font-heading font-bold text-white uppercase tracking-wider mb-5">
          Portal Karir
        </h4>
        <ul class="space-y-3">
          {quickLinks.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-slate-300 hover:text-[#84ACDF] transition-colors flex items-center gap-2">
                <svg class="w-3 h-3 text-[#345F99]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Ekosistem Bina Project -->
      <div>
        <h4 class="text-sm font-heading font-bold text-white uppercase tracking-wider mb-5">
          Ekosistem Bina Project
        </h4>
        <ul class="space-y-3">
          {ecosystemLinks.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-300 hover:text-[#84ACDF] transition-colors flex items-center gap-2">
                <svg class="w-3 h-3 text-[#345F99]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Kontak & Kantor -->
      <div>
        <h4 class="text-sm font-heading font-bold text-white uppercase tracking-wider mb-5">
          Kantor & Kontak HR
        </h4>
        <div class="space-y-3 text-sm text-slate-300">
          <p class="leading-relaxed">
            <strong class="text-white block font-medium">Bina Project Headquarter</strong>
            Malang, Jawa Timur, Indonesia
          </p>
          <div class="pt-2">
            <span class="block text-xs text-slate-400">Pertanyaan Karir & Rekrutmen:</span>
            <a href="mailto:karir@binaproject.id" class="text-white hover:text-[#84ACDF] font-semibold transition-colors block mt-0.5">
              karir@binaproject.id
            </a>
          </div>
          <div class="pt-1">
            <span class="block text-xs text-slate-400">WhatsApp Resmi Tim Rekrutmen:</span>
            <a href="https://wa.me/6281335335304" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#84ACDF] font-semibold transition-colors block mt-0.5">
              +62 813-3533-5304
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-14 pt-8 border-t border-[#1A3356] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>
        &copy; {currentYear} Bina Project Construction & Interior. Hak cipta dilindungi.
      </p>
      <div class="flex items-center gap-6">
        <a href="https://binaproject.id/syarat-ketentuan" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Syarat & Ketentuan</a>
        <a href="https://binaproject.id" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">binaproject.id</a>
      </div>
    </div>
  </div>
</footer>
