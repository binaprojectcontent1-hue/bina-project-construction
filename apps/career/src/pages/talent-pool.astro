---
import CareerLayout from '../layouts/CareerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ApplicationForm } from '../components/form/ApplicationForm';
---

<CareerLayout
  title="Talent Pool & Open Application"
  description="Belum menemukan lowongan yang sesuai? Kirimkan CV Anda ke Talent Pool Resmi Bina Project. Profil Anda akan diprioritaskan saat posisi baru dibuka."
>
  <Header />

  <!-- Top Dark Navy Hero Sub-strip -->
  <section class="bg-gradient-to-b from-[#0D192B] to-[#152B49] text-white pt-12 pb-16 border-b border-[#22416D] relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid opacity-60 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-technical font-semibold bg-[#22416D] text-[#84ACDF] border border-[#345F99] mb-4">
        Komunitas Bakat Bina Project
      </span>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight text-white mb-4">
        Bergabung Bersama <span class="text-[#84ACDF]">Talent Pool</span> Kami
      </h1>
      <p class="text-slate-300 font-body text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Belum menemukan posisi yang pas hari ini? Titipkan Curriculum Vitae (CV) Anda. Tim People & Culture Bina Project akan segera menghubungi saat ada peluang yang cocok dengan aspirasi Anda.
      </p>
    </div>
  </section>

  <!-- Main Content Area -->
  <main class="py-12 sm:py-16 bg-[#F8FAFC]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- 3-Step Process Bento Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="bento-card p-5 text-center bg-white">
          <div class="w-11 h-11 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center font-technical font-bold text-sm mx-auto mb-3 border border-[#BFDBFE]">
            01
          </div>
          <h3 class="text-sm font-heading font-bold text-[#17202A] mb-1">Kirimkan CV</h3>
          <p class="text-xs font-body text-[#64748B]">Unggah file PDF resume terbaru dan portofolio Anda.</p>
        </div>

        <div class="bento-card p-5 text-center bg-white">
          <div class="w-11 h-11 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center font-technical font-bold text-sm mx-auto mb-3 border border-[#BFDBFE]">
            02
          </div>
          <h3 class="text-sm font-heading font-bold text-[#17202A] mb-1">Review Tim HR</h3>
          <p class="text-xs font-body text-[#64748B]">Data Anda kami simpan dalam arsip talenta prioritas.</p>
        </div>

        <div class="bento-card p-5 text-center bg-white">
          <div class="w-11 h-11 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center font-technical font-bold text-sm mx-auto mb-3 border border-[#BFDBFE]">
            03
          </div>
          <h3 class="text-sm font-heading font-bold text-[#17202A] mb-1">Kontak Langsung</h3>
          <p class="text-xs font-body text-[#64748B]">Kami hubungi via WhatsApp saat ada posisi baru.</p>
        </div>
      </div>

      <!-- Application Form Card -->
      <div class="bento-card p-6 sm:p-8 bg-white border border-[#E2E8F0] shadow-md">
        <div class="mb-6 pb-4 border-b border-[#E2E8F0]">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-technical font-semibold bg-[#EFF6FF] text-[#22416D] mb-1.5">
            Pendaftaran Bebas
          </span>
          <h2 class="text-xl font-heading font-extrabold text-[#17202A]">
            Formulir Pendaftaran Talent Pool
          </h2>
          <p class="text-xs font-body text-[#64748B]">
            Lengkapi data dan lampirkan CV terbaik Anda untuk disimpan dalam database karir Bina Project.
          </p>
        </div>

        <ApplicationForm
          client:load
          jobId={null}
          jobTitle="Talent Pool (Pendaftaran Bebas)"
          jobSlug="talent-pool"
          customQuestions={[]}
          isTalentPool={true}
        />
      </div>

      <!-- Back Link -->
      <div class="text-center mt-8">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-[#22416D] hover:underline">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Kembali ke Beranda Lowongan</span>
        </a>
      </div>

    </div>
  </main>

  <Footer />
</CareerLayout>
