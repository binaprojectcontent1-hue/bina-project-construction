---
import CareerLayout from '../layouts/CareerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ApplicationForm } from '../components/form/ApplicationForm';
---

<CareerLayout
  title="Talent Pool — Kirim CV Anda"
  description="Belum menemukan posisi yang cocok? Kirimkan CV Anda ke Talent Pool Bina Project. Kami akan menghubungi Anda ketika ada lowongan yang sesuai."
>
  <Header />

  <main class="py-12 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-10 sm:mb-14">
        <span class="inline-block px-4 py-1.5 rounded-full bg-blue-500/10 text-blue-300 text-xs font-bold uppercase tracking-wider mb-4">
          Talent Pool
        </span>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
          Kirimkan CV Anda ke <span class="text-gradient-amber">Talent Pool</span>
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-xl mx-auto">
          Belum menemukan posisi yang cocok? Tidak masalah. Kirimkan CV dan data diri Anda, dan kami akan menghubungi
          ketika ada lowongan yang sesuai dengan profil Anda.
        </p>
      </div>

      <!-- Info Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="rounded-xl bg-[#0E1E38]/60 border border-white/5 p-5 text-center">
          <div class="text-2xl mb-2">📄</div>
          <h3 class="text-sm font-bold text-white mb-1">Kirim CV</h3>
          <p class="text-xs text-slate-400">Upload CV PDF terbaru Anda</p>
        </div>
        <div class="rounded-xl bg-[#0E1E38]/60 border border-white/5 p-5 text-center">
          <div class="text-2xl mb-2">🔍</div>
          <h3 class="text-sm font-bold text-white mb-1">Tim HRD Review</h3>
          <p class="text-xs text-slate-400">Profil Anda akan kami simpan</p>
        </div>
        <div class="rounded-xl bg-[#0E1E38]/60 border border-white/5 p-5 text-center">
          <div class="text-2xl mb-2">📞</div>
          <h3 class="text-sm font-bold text-white mb-1">Kami Hubungi</h3>
          <p class="text-xs text-slate-400">Saat ada posisi yang sesuai</p>
        </div>
      </div>

      <!-- Application Form -->
      <div class="rounded-2xl bg-[#0E1E38]/80 border border-white/5 p-6 sm:p-8">
        <h2 class="text-xl font-bold text-white mb-6">Formulir Talent Pool</h2>
        <ApplicationForm
          client:load
          jobId={null}
          jobTitle="Talent Pool (Open Application)"
          jobSlug="talent-pool"
          customQuestions={[]}
          isTalentPool={true}
        />
      </div>

      <!-- Back Link -->
      <div class="text-center mt-8">
        <a href="/" class="text-sm text-slate-400 hover:text-amber-400 transition-colors">
          ← Kembali ke Beranda Karir
        </a>
      </div>
    </div>
  </main>

  <Footer />
</CareerLayout>
