---
import CareerLayout from '../../layouts/CareerLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ApplicationForm } from '../../components/form/ApplicationForm';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  if (!supabase) return [];
  const { data } = await supabase
    .from('job_postings')
    .select('slug')
    .eq('status', 'published');
  return (data || []).map((job) => ({ params: { slug: job.slug } }));
}

const { slug } = Astro.params;

let job: any = null;
if (supabase && slug) {
  const { data } = await supabase
    .from('job_postings')
    .select('*')
    .eq('slug', slug)
    .eq('status', 'published')
    .single();
  job = data;
}

if (!job) {
  return Astro.redirect('/');
}

// Employment type mapping for Schema.org
const employmentTypeMap: Record<string, string> = {
  'Full-time': 'FULL_TIME',
  'Kontrak': 'CONTRACTOR',
  'Magang / Internship': 'INTERN',
  'Freelance': 'OTHER',
};

// Google for Jobs JSON-LD
const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'JobPosting',
  title: job.title,
  description: job.description,
  identifier: {
    '@type': 'PropertyValue',
    name: 'Bina Project',
    value: `BP-${job.id.slice(0, 8).toUpperCase()}`,
  },
  datePosted: new Date(job.created_at).toISOString().split('T')[0],
  ...(job.application_deadline && {
    validThrough: new Date(job.application_deadline).toISOString(),
  }),
  employmentType: employmentTypeMap[job.job_type] || 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Bina Project Construction & Interior',
    sameAs: 'https://binaproject.id',
    logo: 'https://binaproject.id/favicon.png',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Malang',
      addressRegion: 'Jawa Timur',
      addressCountry: 'ID',
    },
  },
};

const deptColors: Record<string, string> = {
  'Arsitektur & Desain': 'bg-violet-500/15 text-violet-300 border-violet-500/20',
  'Konstruksi & Lapangan': 'bg-emerald-500/15 text-emerald-300 border-emerald-500/20',
  'Estimator & RAB': 'bg-blue-500/15 text-blue-300 border-blue-500/20',
  'Marketing & Finance': 'bg-pink-500/15 text-pink-300 border-pink-500/20',
  'Magang': 'bg-amber-500/15 text-amber-300 border-amber-500/20',
};
const badgeClass = deptColors[job.department] || 'bg-slate-500/15 text-slate-300 border-slate-500/20';

const shareUrl = `https://karir.binaproject.id/loker/${slug}`;
const shareText = `Lowongan Kerja: ${job.title} di Bina Project — ${job.location}`;
---

<CareerLayout
  title={job.title}
  description={`Lowongan kerja ${job.title} di Bina Project Construction & Interior, ${job.location}. ${job.job_type} — ${job.experience_level}. Lamar sekarang!`}
  jsonLd={jsonLd}
>
  <Header />

  <main class="py-8 sm:py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm">
        <ol class="flex items-center gap-2 text-slate-500">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Karir</a></li>
          <li>/</li>
          <li><a href="/#lowongan" class="hover:text-amber-400 transition-colors">Lowongan</a></li>
          <li>/</li>
          <li class="text-slate-300 truncate max-w-[200px]">{job.title}</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Job Header -->
          <div class="rounded-2xl bg-[#0E1E38]/80 border border-white/5 p-6 sm:p-8">
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border ${badgeClass}`}>
                {job.department}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/5 text-slate-400 border border-white/5">
                {job.job_type}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-white/5 text-slate-400 border border-white/5">
                {job.workplace_type}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-bold text-white mb-4">{job.title}</h1>

            <div class="flex flex-wrap gap-4 text-sm text-slate-400">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                {job.location}
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                {job.experience_level}
              </span>
              {job.show_salary && job.salary_range && (
                <span class="flex items-center gap-1.5 text-amber-400 font-semibold">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  {job.salary_range}
                </span>
              )}
            </div>

            {job.application_deadline && (
              <div class="mt-4 pt-4 border-t border-white/5">
                <span class="text-xs text-slate-500">
                  Batas Lamaran: {new Date(job.application_deadline).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                </span>
              </div>
            )}
          </div>

          <!-- Description -->
          <div class="rounded-2xl bg-[#0E1E38]/80 border border-white/5 p-6 sm:p-8 space-y-8">
            <div>
              <h2 class="text-lg font-bold text-white mb-3">Tentang Pekerjaan Ini</h2>
              <div class="text-sm text-slate-300 leading-relaxed whitespace-pre-line">{job.description}</div>
            </div>

            {job.responsibilities && job.responsibilities.length > 0 && (
              <div>
                <h2 class="text-lg font-bold text-white mb-3">Tanggung Jawab Utama</h2>
                <ul class="space-y-2">
                  {job.responsibilities.map((item: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-300">
                      <svg class="w-4 h-4 mt-0.5 shrink-0 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" /></svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {job.requirements && job.requirements.length > 0 && (
              <div>
                <h2 class="text-lg font-bold text-white mb-3">Kualifikasi & Persyaratan</h2>
                <ul class="space-y-2">
                  {job.requirements.map((item: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-300">
                      <svg class="w-4 h-4 mt-0.5 shrink-0 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {job.benefits && job.benefits.length > 0 && (
              <div>
                <h2 class="text-lg font-bold text-white mb-3">Benefit & Fasilitas</h2>
                <ul class="space-y-2">
                  {job.benefits.map((item: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-300">
                      <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Application Form -->
          <div id="lamar" class="rounded-2xl bg-[#0E1E38]/80 border border-white/5 p-6 sm:p-8 scroll-mt-24">
            <h2 class="text-xl font-bold text-white mb-6">Lamar Posisi Ini</h2>
            <ApplicationForm
              client:load
              jobId={job.id}
              jobTitle={job.title}
              jobSlug={job.slug}
              customQuestions={job.custom_questions || []}
            />
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Sticky Apply CTA -->
          <div class="lg:sticky lg:top-24 space-y-4">
            <a
              href="#lamar"
              class="w-full flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-gradient-to-r from-[#F68A0A] to-[#E07800] text-white font-bold text-sm shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 transition-all hover:-translate-y-0.5"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              Lamar Sekarang
            </a>

            <!-- Share -->
            <div class="rounded-2xl bg-[#0E1E38]/60 border border-white/5 p-5">
              <h3 class="text-sm font-bold text-white mb-3">Bagikan Lowongan</h3>
              <div class="flex items-center gap-2">
                <a
                  href={`https://wa.me/?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-lg bg-emerald-500/10 text-emerald-300 text-xs font-bold hover:bg-emerald-500/20 transition-colors"
                >
                  WhatsApp
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-lg bg-blue-500/10 text-blue-300 text-xs font-bold hover:bg-blue-500/20 transition-colors"
                >
                  LinkedIn
                </a>
                <button
                  type="button"
                  id="copy-link-btn"
                  data-url={shareUrl}
                  class="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-lg bg-white/5 text-slate-300 text-xs font-bold hover:bg-white/10 transition-colors"
                >
                  Salin Link
                </button>
              </div>
            </div>

            <!-- Back to all jobs -->
            <a
              href="/#lowongan"
              class="block text-center text-sm text-slate-400 hover:text-amber-400 transition-colors"
            >
              ← Lihat Semua Lowongan
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</CareerLayout>

<script>
  const btn = document.getElementById('copy-link-btn');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url');
    if (url) {
      await navigator.clipboard.writeText(url);
      btn.textContent = 'Tersalin!';
      setTimeout(() => { btn.textContent = 'Salin Link'; }, 2000);
    }
  });
</script>
