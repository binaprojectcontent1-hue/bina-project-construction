---
import CareerLayout from '../../layouts/CareerLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ApplicationForm } from '../../components/form/ApplicationForm';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  if (!supabase) return [];
  const { data } = await supabase
    .from('job_postings')
    .select('slug')
    .eq('status', 'published');
  return (data || []).map((job) => ({ params: { slug: job.slug } }));
}

const { slug } = Astro.params;

let job: any = null;
if (supabase && slug) {
  const { data } = await supabase
    .from('job_postings')
    .select('*')
    .eq('slug', slug)
    .eq('status', 'published')
    .single();
  job = data;
}

if (!job) {
  return Astro.redirect('/');
}

// Employment type mapping for Google for Jobs Schema.org
const employmentTypeMap: Record<string, string> = {
  'Full-time': 'FULL_TIME',
  'Kontrak': 'CONTRACTOR',
  'Magang / Internship': 'INTERN',
  'Freelance': 'OTHER',
};

const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'JobPosting',
  title: job.title,
  description: job.description || job.title,
  identifier: {
    '@type': 'PropertyValue',
    name: 'Bina Project',
    value: `BP-${job.id.slice(0, 8).toUpperCase()}`,
  },
  datePosted: new Date(job.created_at).toISOString().split('T')[0],
  ...(job.application_deadline && {
    validThrough: new Date(job.application_deadline).toISOString(),
  }),
  employmentType: employmentTypeMap[job.job_type] || 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Bina Project Construction & Interior',
    sameAs: 'https://binaproject.id',
    logo: 'https://binaproject.id/assets/img/logo.svg',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Malang',
      addressRegion: 'Jawa Timur',
      addressCountry: 'ID',
    },
  },
};

const shareUrl = `https://karir.binaproject.id/loker/${slug}`;
const shareText = `Lowongan Kerja ${job.title} di Bina Project:`;

// Department styling
const deptStyles: Record<string, { bg: string; text: string; border: string }> = {
  'Arsitektur & Desain': { bg: 'bg-[#EFF6FF]', text: 'text-[#22416D]', border: 'border-[#BFDBFE]' },
  'Konstruksi & Lapangan': { bg: 'bg-[#F0FDF4]', text: 'text-[#166534]', border: 'border-[#BBF7D0]' },
  'Estimator & RAB': { bg: 'bg-[#F8FAFC]', text: 'text-[#1E293B]', border: 'border-[#CBD5E1]' },
  'Marketing & Finance': { bg: 'bg-[#FAF5FF]', text: 'text-[#6B21A8]', border: 'border-[#E9D5FF]' },
  'Magang': { bg: 'bg-[#FFFBEB]', text: 'text-[#92400E]', border: 'border-[#FDE68A]' },
};

const badgeTheme = deptStyles[job.department] || { bg: 'bg-[#EFF6FF]', text: 'text-[#22416D]', border: 'border-[#BFDBFE]' };
---

<CareerLayout
  title={`${job.title} — Karir`}
  description={`Lowongan kerja ${job.title} di Bina Project Construction & Interior (${job.location}). ${job.job_type} — ${job.experience_level}. Kirimkan lamaran Anda sekarang!`}
  jsonLd={jsonLd}
>
  <Header />

  <!-- Page Header Sub-strip -->
  <section class="bg-gradient-to-b from-[#0D192B] to-[#152B49] text-white pt-10 pb-12 border-b border-[#22416D] relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid opacity-60 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-xs font-technical text-[#84ACDF]" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-white transition-colors">Karir</a></li>
          <li>/</li>
          <li><a href="/#lowongan" class="hover:text-white transition-colors">Lowongan</a></li>
          <li>/</li>
          <li class="text-slate-300 font-semibold truncate max-w-[240px]">{job.title}</li>
        </ol>
      </nav>

      <!-- Position Headline -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5 flex-wrap mb-2.5">
            <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-technical font-bold border ${badgeTheme.bg} ${badgeTheme.text} ${badgeTheme.border}`}>
              {job.department}
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-technical font-medium bg-white/10 text-slate-200 border border-white/15">
              {job.job_type}
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-technical font-medium bg-white/10 text-slate-200 border border-white/15">
              {job.workplace_type}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-heading font-black tracking-tight text-white">
            {job.title}
          </h1>
        </div>

        <div class="flex items-center gap-3">
          <a
            href="#formulir-lamaran"
            class="th-btn bg-white text-[#22416D]! hover:bg-[#EFF6FF]! border-white shadow-md text-sm whitespace-nowrap"
          >
            <span>Lamar Sekarang</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       2-COLUMN ARCHITECTURAL CONTENT LAYOUT
       ========================================================================= -->
  <main class="py-12 sm:py-16 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- LEFT COLUMN (65%): Position Details & Requirements -->
        <div class="lg:col-span-7 space-y-8">
          
          <!-- Section 1: Overview & Description -->
          <div class="bento-card p-6 sm:p-8 bg-white">
            <h2 class="text-xl font-heading font-extrabold text-[#17202A] mb-4 pb-3 border-b border-[#F1F5F9]">
              Deskripsi Posisi
            </h2>
            <div class="text-sm font-body text-[#475569] leading-relaxed whitespace-pre-line space-y-4">
              {job.description}
            </div>
          </div>

          <!-- Section 2: Responsibilities -->
          {job.responsibilities && (
            <div class="bento-card p-6 sm:p-8 bg-white">
              <h2 class="text-xl font-heading font-extrabold text-[#17202A] mb-4 pb-3 border-b border-[#F1F5F9]">
                Tanggung Jawab Utama
              </h2>
              <div class="text-sm font-body text-[#475569] leading-relaxed whitespace-pre-line space-y-2">
                {job.responsibilities}
              </div>
            </div>
          )}

          <!-- Section 3: Requirements & Qualifications -->
          {job.requirements && (
            <div class="bento-card p-6 sm:p-8 bg-white">
              <h2 class="text-xl font-heading font-extrabold text-[#17202A] mb-4 pb-3 border-b border-[#F1F5F9]">
                Kualifikasi & Persyaratan
              </h2>
              <div class="text-sm font-body text-[#475569] leading-relaxed whitespace-pre-line space-y-2">
                {job.requirements}
              </div>
            </div>
          )}

          <!-- Section 4: Benefits & Perks -->
          {job.benefits && (
            <div class="bento-card p-6 sm:p-8 bg-white">
              <h2 class="text-xl font-heading font-extrabold text-[#17202A] mb-4 pb-3 border-b border-[#F1F5F9]">
                Benefit & Fasilitas
              </h2>
              <div class="text-sm font-body text-[#475569] leading-relaxed whitespace-pre-line space-y-2">
                {job.benefits}
              </div>
            </div>
          )}

          <!-- Section 5: About Company -->
          <div class="bento-card p-6 sm:p-8 bg-gradient-to-br from-[#EFF6FF] to-white border border-[#BFDBFE]">
            <h3 class="text-lg font-heading font-bold text-[#22416D] mb-2">
              Tentang Bina Project Construction & Interior
            </h3>
            <p class="text-sm font-body text-[#475569] leading-relaxed">
              Bina Project adalah perusahaan arsitektur, kontraktor konstruksi dan interior yang berpusat di Malang, Jawa Timur. Dengan rekam jejak lebih dari 200 proyek selesai, kami mengedepankan kualitas konstruksi amanah, kepastian struktur, dan estetika desain kontemporer.
            </p>
          </div>

        </div>

        <!-- RIGHT COLUMN (35%): Sticky Sidebar Info & Application Form -->
        <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">
          
          <!-- Summary Info Card -->
          <div class="bento-card p-6 sm:p-7 bg-white">
            <h3 class="text-base font-heading font-bold text-[#17202A] mb-4 pb-3 border-b border-[#E2E8F0]">
              Ringkasan Lowongan
            </h3>

            <div class="space-y-3.5 text-sm font-body">
              <div class="flex items-center justify-between">
                <span class="text-xs font-technical text-[#64748B]">Departemen:</span>
                <span class="font-semibold text-[#17202A] text-right">{job.department}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-technical text-[#64748B]">Tipe Pekerjaan:</span>
                <span class="font-semibold text-[#17202A] text-right">{job.job_type}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-technical text-[#64748B]">Lokasi Penempatan:</span>
                <span class="font-semibold text-[#17202A] text-right">{job.location}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-technical text-[#64748B]">Pengalaman:</span>
                <span class="font-semibold text-[#17202A] text-right">{job.experience_level}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-technical text-[#64748B]">Sistem Kerja:</span>
                <span class="font-semibold text-[#17202A] text-right">{job.workplace_type}</span>
              </div>
              {job.show_salary && job.salary_range && (
                <div class="flex items-center justify-between pt-2 border-t border-[#F1F5F9]">
                  <span class="text-xs font-technical text-[#64748B]">Rentang Gaji:</span>
                  <span class="font-technical font-bold text-[#065F46] bg-[#ECFDF5] px-2.5 py-0.5 rounded-md border border-[#A7F3D0]">
                    {job.salary_range}
                  </span>
                </div>
              )}
              {job.application_deadline && (
                <div class="flex items-center justify-between pt-2 border-t border-[#F1F5F9]">
                  <span class="text-xs font-technical text-[#64748B]">Batas Lamaran:</span>
                  <span class="font-technical font-semibold text-[#EF4444]">
                    {new Date(job.application_deadline).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </span>
                </div>
              )}
            </div>

            <!-- Share Buttons -->
            <div class="mt-6 pt-5 border-t border-[#E2E8F0]">
              <span class="block text-xs font-technical text-[#64748B] mb-2.5">Bagikan lowongan ini:</span>
              <div class="flex items-center gap-2">
                <a
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 py-2 px-3 rounded-lg bg-[#25D366]/10 text-[#128C7E] hover:bg-[#25D366]/20 font-technical text-xs font-bold text-center transition-colors flex items-center justify-center gap-1.5"
                >
                  <span>WhatsApp</span>
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 py-2 px-3 rounded-lg bg-[#0A66C2]/10 text-[#0A66C2] hover:bg-[#0A66C2]/20 font-technical text-xs font-bold text-center transition-colors flex items-center justify-center gap-1.5"
                >
                  <span>LinkedIn</span>
                </a>
                <button
                  type="button"
                  id="copy-link-btn"
                  data-url={shareUrl}
                  class="py-2 px-3 rounded-lg bg-[#F1F5F9] text-[#475569] hover:bg-[#E2E8F0] font-technical text-xs font-bold transition-colors cursor-pointer"
                  title="Salin tautan"
                >
                  Salin Link
                </button>
              </div>
            </div>

          </div>

          <!-- Application Form Card -->
          <div id="formulir-lamaran" class="bento-card p-6 sm:p-7 bg-white scroll-mt-24 shadow-md">
            <div class="mb-5 pb-3 border-b border-[#E2E8F0]">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-technical font-semibold bg-[#EFF6FF] text-[#22416D] mb-1.5">
                Pendaftaran Online
              </span>
              <h3 class="text-lg font-heading font-extrabold text-[#17202A]">
                Formulir Lamaran Kerja
              </h3>
              <p class="text-xs font-body text-[#64748B]">
                Isi data diri dan lampirkan CV Anda untuk melamar posisi ini.
              </p>
            </div>

            <ApplicationForm
              client:load
              jobId={job.id}
              jobTitle={job.title}
              jobSlug={job.slug}
              customQuestions={job.custom_questions || []}
            />
          </div>

        </div>

      </div>

    </div>
  </main>

  <Footer />
</CareerLayout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const originalText = copyBtn.innerText;
        copyBtn.innerText = 'Tersalin!';
        copyBtn.classList.add('text-[#22416D]', 'bg-[#EFF6FF]');
        setTimeout(() => {
          copyBtn.innerText = originalText;
          copyBtn.classList.remove('text-[#22416D]', 'bg-[#EFF6FF]');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }
</script>
