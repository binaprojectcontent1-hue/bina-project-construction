---
import CareerLayout from '../../layouts/CareerLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  if (!supabase) return [];
  const { data } = await supabase
    .from('job_postings')
    .select('slug')
    .in('status', ['published', 'unlisted', 'closed']);
  return (data || []).map((job) => ({ params: { slug: job.slug } }));
}

const { slug } = Astro.params;

let job: any = null;
if (supabase && slug) {
  const { data } = await supabase
    .from('job_postings')
    .select('*')
    .eq('slug', slug)
    .single();
  job = data;
}

if (!job) {
  return Astro.redirect('/');
}

// Employment type mapping for Google for Jobs Schema.org
const displayDepartment = job.department === 'Arsitektur & Desain' ? 'Desain & Perencanaan' : job.department;
const employmentTypeMap: Record<string, string> = {
  'Full-time': 'FULL_TIME',
  'Kontrak': 'CONTRACTOR',
  'Magang / Internship': 'INTERN',
  'Freelance': 'OTHER',
};

const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'JobPosting',
  title: job.title,
  description: job.description || job.title,
  identifier: {
    '@type': 'PropertyValue',
    name: 'Bina Project',
    value: `BP-${job.id.slice(0, 8).toUpperCase()}`,
  },
  datePosted: new Date(job.created_at).toISOString().split('T')[0],
  ...(job.application_deadline && {
    validThrough: new Date(job.application_deadline).toISOString(),
  }),
  employmentType: employmentTypeMap[job.job_type] || 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Bina Project Construction',
    sameAs: 'https://binaproject.id',
    logo: 'https://binaproject.id/assets/img/logo.svg',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Malang',
      addressRegion: 'Jawa Timur',
      addressCountry: 'ID',
    },
  },
};

const shareUrl = `https://karir.binaproject.id/loker/${slug}`;
const shareText = `Lowongan Kerja ${job.title} di Bina Project Construction:`;

const isClosed = job.status === 'closed' || (job.application_deadline && new Date(job.application_deadline).getTime() < Date.now());

// Helper function to safely format lists from Supabase (handles both string[] and newline-delimited strings)
function formatListItems(data: unknown): string[] {
  if (!data) return [];
  if (Array.isArray(data)) {
    return data
      .flatMap((item) => (typeof item === 'string' ? item.split('\n') : []))
      .map((s) => s.replace(/^([•\-\*]|\d+[\.\)])\s+/, '').trim())
      .filter(Boolean);
  }
  if (typeof data === 'string') {
    return data
      .split('\n')
      .map((s) => s.replace(/^([•\-\*]|\d+[\.\)])\s+/, '').trim())
      .filter(Boolean);
  }
  return [];
}

const responsibilities = formatListItems(job.responsibilities);
const requirements = formatListItems(job.requirements);
const benefits = formatListItems(job.benefits);

const descriptionText = typeof job.description === 'string' 
  ? job.description.trim() 
  : '';
---

<CareerLayout
  title={job.title}
  description={`Lowongan kerja ${job.title} di Bina Project Construction (${job.location}). ${job.job_type} — ${job.experience_level}. Kirimkan lamaran Anda sekarang!`}
  ogImage={job.thumbnail_url || '/og-career.png'}
  jsonLd={jsonLd}
>
  <Header />

  <!-- =========================================================================
       HERO BANNER (ARCHITECTURAL DEEP NAVY STRIP)
       ========================================================================= -->
  <section class="bg-[#0A1320] text-white pt-12 pb-14 border-b border-slate-800/80 relative overflow-hidden">
    <!-- Subtle Blueprint Ambient Pattern -->
    <div class="blueprint-grid absolute inset-0 opacity-15 pointer-events-none"></div>

    {job.thumbnail_url && (
      <div 
        class="absolute inset-0 bg-cover bg-center opacity-10 mix-blend-luminosity pointer-events-none"
        style={`background-image: url('${job.thumbnail_url}');`}
      ></div>
    )}

    <!-- Glow Accent Orb -->
    <div class="absolute -top-24 right-1/4 w-96 h-96 bg-[#22416D]/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="mb-5 text-xs font-technical text-slate-400" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/" class="hover:text-white transition-colors flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span>Beranda</span>
            </a>
          </li>
          <li class="text-slate-600">/</li>
          <li><a href="/#lowongan" class="hover:text-white transition-colors">Lowongan Kerja</a></li>
          <li class="text-slate-600">/</li>
          <li class="text-[#84ACDF] font-semibold truncate max-w-[260px]">{job.title}</li>
        </ol>
      </nav>

      <!-- Position Headline & Meta Badges -->
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="space-y-3.5">
          <!-- Meta Tags Strip (Consistent Blue & White/Slate Theme) -->
          <div class="flex items-center gap-2 flex-wrap text-xs font-technical">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg bg-[#22416D]/70 border border-[#84ACDF]/40 text-[#84ACDF] font-bold uppercase tracking-wider">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>{displayDepartment}</span>
            </span>

            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 text-slate-300 font-medium">
              {job.job_type}
            </span>

            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 text-slate-300 font-medium">
              {job.workplace_type}
            </span>

            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 text-slate-300 font-medium">
              {job.location}
            </span>

            {isClosed && (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-800/90 border border-slate-700 text-slate-300 font-bold uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-[#84ACDF]"></span>
                Pendaftaran Ditutup
              </span>
            )}
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-5xl font-heading font-black tracking-tight text-white leading-tight">
            {job.title}
          </h1>
        </div>

        <!-- Top Right Action -->
        <div class="flex items-center gap-3 shrink-0">
          {isClosed ? (
            <div class="px-4 py-2.5 rounded-xl bg-slate-800/70 border border-slate-700/70 text-left sm:text-right">
              <span class="text-xs font-technical font-bold uppercase tracking-wider text-[#84ACDF] block">
                Status: Arsip Lowongan
              </span>
              <span class="text-[11px] font-technical text-slate-400">
                Posisi saat ini tidak menerima berkas baru
              </span>
            </div>
          ) : (
            <a
              href={`/loker/${job.slug}/lamar`}
              class="th-btn gap-2 text-sm whitespace-nowrap px-7 py-3.5 shadow-lg shadow-[#22416D]/30 hover:shadow-xl transition-all"
            >
              <span>Lamar Posisi Ini</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          )}
        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       MAIN CONTENT: 2-COLUMN BALANCED ARCHITECTURAL LAYOUT (BLUE & WHITE PALETTE)
       ========================================================================= -->
  <main class="py-10 sm:py-14 pb-28 lg:pb-16 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Notice Alert if Closed (Clean Blue & White Architectural Card) -->
      {isClosed && (
        <div class="mb-8 p-5 sm:p-6 rounded-2xl bg-white border border-[#CBD5E1] text-[#17202A] flex items-start gap-4 shadow-[0_2px_14px_rgba(13,25,43,0.04)]">
          <div class="w-10 h-10 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center shrink-0 mt-0.5 border border-blue-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="space-y-1.5 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2.5 py-0.5 rounded-md text-[11px] font-technical font-bold uppercase tracking-wider bg-[#EFF6FF] text-[#22416D] border border-blue-100">
                Arsip Rekrutmen
              </span>
              <h3 class="text-sm sm:text-base font-heading font-extrabold text-[#17202A]">
                Penerimaan Berkas untuk Posisi Ini Telah Ditutup
              </h3>
            </div>
            <p class="text-xs sm:text-sm font-body text-slate-600 leading-relaxed">
              Masa penerimaan berkas telah berakhir atau posisi telah terisi. Rincian kompetensi dan kualifikasi di bawah ini tetap disajikan sebagai referensi standar talenta Bina Project Construction.
            </p>
            <div class="pt-1.5">
              <a href="/#lowongan" class="inline-flex items-center gap-1.5 text-xs font-technical font-bold text-[#22416D] hover:text-[#0D192B] bg-[#EFF6FF] hover:bg-blue-100/70 px-3.5 py-2 rounded-xl border border-blue-200/80 transition-colors">
                <span>Jelajahi Lowongan Kerja Aktif Lainnya</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- ===================================================================
             LEFT COLUMN (65%): Clean Detail Sections
             =================================================================== -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Card 1: Deskripsi Posisi -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-[0_2px_14px_rgba(13,25,43,0.04)] border border-slate-200/80">
            <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-100">
              <div class="w-10 h-10 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center shrink-0 border border-blue-100/80">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-heading font-extrabold text-[#17202A]">
                  Deskripsi Posisi
                </h2>
                <p class="text-xs font-technical text-slate-400">
                  Ruang lingkup & gambaran peran di Bina Project
                </p>
              </div>
            </div>

            <div class="text-sm sm:text-[15px] font-body text-slate-700 leading-relaxed whitespace-pre-line">
              {descriptionText}
            </div>
          </div>

          <!-- Card 2: Tanggung Jawab Utama -->
          {responsibilities.length > 0 && (
            <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-[0_2px_14px_rgba(13,25,43,0.04)] border border-slate-200/80">
              <div class="flex items-center justify-between gap-4 mb-4 pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center shrink-0 border border-blue-100/80">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                  </div>
                  <div>
                    <h2 class="text-xl font-heading font-extrabold text-[#17202A]">
                      Tanggung Jawab Utama
                    </h2>
                    <p class="text-xs font-technical text-slate-400">
                      Tugas operasional dan target kerja harian
                    </p>
                  </div>
                </div>
                <span class="text-xs font-technical font-bold px-2.5 py-1 rounded-lg bg-[#EFF6FF] text-[#22416D] border border-blue-100 shrink-0">
                  {responsibilities.length} Poin Kunci
                </span>
              </div>

              <ul class="space-y-3">
                {responsibilities.map((resp, idx) => (
                  <li class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-[#EFF6FF]/40 transition-colors border border-transparent hover:border-[#84ACDF]/30">
                    <span class="w-6 h-6 rounded-md bg-[#22416D]/10 text-[#22416D] font-technical font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 border border-[#22416D]/20">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    <span class="text-sm sm:text-[15px] font-body text-slate-700 leading-relaxed pt-0.5">
                      {resp}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Card 3: Kualifikasi & Persyaratan (Pure Blue & White Palette) -->
          {requirements.length > 0 && (
            <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-[0_2px_14px_rgba(13,25,43,0.04)] border border-slate-200/80">
              <div class="flex items-center justify-between gap-4 mb-4 pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center shrink-0 border border-blue-100/80">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                  </div>
                  <div>
                    <h2 class="text-xl font-heading font-extrabold text-[#17202A]">
                      Kualifikasi &amp; Persyaratan
                    </h2>
                    <p class="text-xs font-technical text-slate-400">
                      Kriteria kemampuan & kompetensi yang dibutuhkan
                    </p>
                  </div>
                </div>
                <span class="text-xs font-technical font-bold px-2.5 py-1 rounded-lg bg-[#EFF6FF] text-[#22416D] border border-blue-100 shrink-0">
                  {requirements.length} Persyaratan
                </span>
              </div>

              <ul class="space-y-2.5">
                {requirements.map((req) => (
                  <li class="flex items-start gap-3 p-3 rounded-xl bg-slate-50/60 hover:bg-white border border-slate-200/70 hover:border-[#84ACDF]/50 transition-colors">
                    <div class="w-5 h-5 rounded-md bg-[#EFF6FF] text-[#22416D] flex items-center justify-center shrink-0 mt-0.5 border border-[#84ACDF]/50">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <span class="text-sm sm:text-[15px] font-body text-slate-700 leading-relaxed font-medium">
                      {req}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Card 4: Benefit & Fasilitas (Pure Blue & White Palette) -->
          {benefits.length > 0 && (
            <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-[0_2px_14px_rgba(13,25,43,0.04)] border border-slate-200/80">
              <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-100">
                <div class="w-10 h-10 rounded-xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center shrink-0 border border-blue-100/80">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                  </svg>
                </div>
                <div>
                  <h2 class="text-xl font-heading font-extrabold text-[#17202A]">
                    Benefit &amp; Fasilitas
                  </h2>
                  <p class="text-xs font-technical text-slate-400">
                    Apresiasi & dukungan karir untuk talenta Bina Project
                  </p>
                </div>
              </div>

              <!-- Modern Bento Grid of Benefits in Clean Blue & White -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                {benefits.map((benefit) => (
                  <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white hover:bg-[#EFF6FF]/40 border border-slate-200/80 hover:border-[#84ACDF]/60 transition-all shadow-2xs">
                    <div class="w-6 h-6 rounded-lg bg-[#EFF6FF] text-[#22416D] flex items-center justify-center shrink-0 mt-0.5 border border-blue-100/80">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <span class="text-sm font-heading font-semibold text-[#17202A] leading-snug pt-0.5">
                      {benefit}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Card 5: Tentang Bina Project Construction -->
          <div class="bg-gradient-to-br from-white to-[#F8FAFC] rounded-2xl p-6 sm:p-8 shadow-[0_2px_14px_rgba(13,25,43,0.04)] border border-slate-200/80">
            <div class="flex items-center gap-3.5 mb-4 pb-4 border-b border-slate-100">
              <div class="w-10 h-10 rounded-xl bg-[#0A1320] text-white flex items-center justify-center shrink-0 font-heading font-black text-sm">
                BP
              </div>
              <div>
                <h3 class="text-lg font-heading font-black text-[#17202A]">
                  Tentang Bina Project Construction
                </h3>
                <span class="text-xs font-technical font-semibold text-[#22416D]">
                  Kontraktor Konstruksi &amp; Rancang Bangun Malang
                </span>
              </div>
            </div>

            <p class="text-sm font-body text-slate-600 leading-relaxed mb-5">
              Bina Project adalah perusahaan kontraktor rancang-bangun (design &amp; build), konstruksi, dan interior yang berpusat di Kota Malang, Jawa Timur. Berpengalaman menangani 200+ proyek hunian dan komersial dengan komitmen amanah mutu, kepastian struktur, dan estetika desain kontemporer.
            </p>

            <!-- 3 Architectural Highlight Badges -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1 mb-5">
              <div class="p-2.5 rounded-xl bg-white border border-slate-200/70 text-center">
                <span class="block text-xs font-technical font-bold text-[#22416D]">200+ Proyek</span>
                <span class="text-[11px] text-slate-500 font-body">Portofolio Selesai</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white border border-slate-200/70 text-center">
                <span class="block text-xs font-technical font-bold text-[#22416D]">Kota Malang</span>
                <span class="text-[11px] text-slate-500 font-body">Studio &amp; Workshop</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white border border-slate-200/70 text-center">
                <span class="block text-xs font-technical font-bold text-[#22416D]">Garansi Mutu</span>
                <span class="text-[11px] text-slate-500 font-body">Ketahanan Struktur</span>
              </div>
            </div>

            <div>
              <a
                href="https://binaproject.id"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-technical font-bold text-[#22416D] hover:text-[#0D192B] hover:underline underline-offset-4 transition-colors"
              >
                <span>Lihat Portofolio Karya di binaproject.id</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>

        </div>

        <!-- ===================================================================
             RIGHT COLUMN (35%): Sticky Sidebar Info & Application Card
             =================================================================== -->
        <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">
          
          <!-- Summary Info Card (Blue & White Palette) -->
          <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-[0_2px_14px_rgba(13,25,43,0.04)] border border-slate-200/80">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
              <h3 class="text-base font-heading font-extrabold text-[#17202A]">
                Ringkasan Lowongan
              </h3>
              <span class="text-[11px] font-technical text-slate-400">
                Spesifikasi Posisi
              </span>
            </div>

            <!-- Clean Scannable Key-Value Table -->
            <div class="space-y-3 text-sm font-body divide-y divide-slate-100/80">
              
              <!-- Department -->
              <div class="flex items-center justify-between pt-1">
                <span class="inline-flex items-center gap-2 text-xs font-technical text-slate-500">
                  <svg class="w-4 h-4 text-[#22416D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  <span>Departemen:</span>
                </span>
                <span class="font-semibold text-[#17202A] text-right text-xs sm:text-sm">{displayDepartment}</span>
              </div>

              <!-- Job Type -->
              <div class="flex items-center justify-between pt-2.5">
                <span class="inline-flex items-center gap-2 text-xs font-technical text-slate-500">
                  <svg class="w-4 h-4 text-[#22416D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span>Tipe Pekerjaan:</span>
                </span>
                <span class="font-semibold text-[#17202A] text-right text-xs sm:text-sm">{job.job_type}</span>
              </div>

              <!-- Location -->
              <div class="flex items-center justify-between pt-2.5">
                <span class="inline-flex items-center gap-2 text-xs font-technical text-slate-500">
                  <svg class="w-4 h-4 text-[#22416D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>Lokasi Penempatan:</span>
                </span>
                <span class="font-semibold text-[#17202A] text-right text-xs sm:text-sm">{job.location}</span>
              </div>

              <!-- Experience -->
              <div class="flex items-center justify-between pt-2.5">
                <span class="inline-flex items-center gap-2 text-xs font-technical text-slate-500">
                  <svg class="w-4 h-4 text-[#22416D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  </svg>
                  <span>Pengalaman:</span>
                </span>
                <span class="font-semibold text-[#17202A] text-right text-xs sm:text-sm">{job.experience_level}</span>
              </div>

              <!-- Workplace Type -->
              <div class="flex items-center justify-between pt-2.5">
                <span class="inline-flex items-center gap-2 text-xs font-technical text-slate-500">
                  <svg class="w-4 h-4 text-[#22416D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  <span>Sistem Kerja:</span>
                </span>
                <span class="font-semibold text-[#17202A] text-right text-xs sm:text-sm">{job.workplace_type}</span>
              </div>

              <!-- Salary (if visible) -->
              {job.show_salary && job.salary_range && (
                <div class="flex items-center justify-between pt-2.5">
                  <span class="inline-flex items-center gap-2 text-xs font-technical text-slate-500">
                    <svg class="w-4 h-4 text-[#22416D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <span>Estimasi Gaji:</span>
                  </span>
                  <span class="font-technical font-bold text-[#22416D] text-right text-xs sm:text-sm">
                    {job.salary_range}
                  </span>
                </div>
              )}

              <!-- Application Deadline -->
              {job.application_deadline && (
                <div class="flex items-center justify-between pt-2.5">
                  <span class="inline-flex items-center gap-2 text-xs font-technical text-slate-500">
                    <svg class="w-4 h-4 text-[#22416D] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Batas Lamaran:</span>
                  </span>
                  <span class="font-technical font-bold text-[#22416D] text-right text-xs sm:text-sm">
                    {new Date(job.application_deadline).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </span>
                </div>
              )}

            </div>

            <!-- Share Buttons with Cohesive Blue & White Styling -->
            <div class="mt-6 pt-5 border-t border-slate-100">
              <span class="block text-xs font-technical text-slate-400 mb-2.5">Bagikan lowongan ini:</span>
              <div class="flex items-center gap-2">
                
                <!-- WhatsApp -->
                <a
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 py-2 px-3 rounded-xl bg-white hover:bg-[#EFF6FF] text-[#22416D] border border-slate-200/90 hover:border-[#84ACDF] font-technical text-xs font-bold text-center transition-colors flex items-center justify-center gap-1.5 shadow-2xs"
                  title="Bagikan ke WhatsApp"
                >
                  <svg class="w-4 h-4 fill-[#22416D] shrink-0" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.772.82 2.791.82 3.181 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.806-5.767-5.806zm7.415 5.766c0 4.093-3.328 7.421-7.416 7.421-1.258 0-2.457-.323-3.522-.919l-3.908 1.025 1.045-3.818c-.689-1.124-1.054-2.433-1.054-3.709 0-4.093 3.328-7.421 7.439-7.421 4.088 0 7.416 3.328 7.416 7.421z"/>
                  </svg>
                  <span>WhatsApp</span>
                </a>

                <!-- LinkedIn -->
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 py-2 px-3 rounded-xl bg-white hover:bg-[#EFF6FF] text-[#22416D] border border-slate-200/90 hover:border-[#84ACDF] font-technical text-xs font-bold text-center transition-colors flex items-center justify-center gap-1.5 shadow-2xs"
                  title="Bagikan ke LinkedIn"
                >
                  <svg class="w-3.5 h-3.5 fill-[#22416D] shrink-0" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                  <span>LinkedIn</span>
                </a>

                <!-- Copy Link -->
                <button
                  type="button"
                  id="copy-link-btn"
                  data-url={shareUrl}
                  class="py-2 px-3 rounded-xl bg-white hover:bg-[#EFF6FF] text-[#22416D] border border-slate-200/90 hover:border-[#84ACDF] font-technical text-xs font-bold transition-colors cursor-pointer flex items-center justify-center gap-1.5 shadow-2xs"
                  title="Salin tautan lowongan"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                  <span id="copy-btn-text">Salin</span>
                </button>
              </div>
            </div>

          </div>

          <!-- Application Status / Action Card (Blue & White Palette) -->
          {isClosed ? (
            <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-[0_2px_14px_rgba(13,25,43,0.04)] border border-slate-200/80 text-center space-y-4">
              <div class="w-13 h-13 rounded-2xl bg-[#EFF6FF] text-[#22416D] border border-blue-100 flex items-center justify-center mx-auto shadow-2xs">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="text-xs font-technical font-bold uppercase tracking-widest text-[#22416D] block">
                  Status: Pendaftaran Ditutup
                </span>
                <h3 class="text-lg font-heading font-extrabold text-[#17202A]">
                  Posisi Telah Diarsipkan
                </h3>
                <p class="text-xs font-body text-slate-500 mt-1.5 leading-relaxed">
                  Penerimaan berkas untuk posisi <strong class="text-slate-800">{job.title}</strong> saat ini telah ditutup karena periode pendaftaran telah berakhir atau kuota kandidat telah terpenuhi.
                </p>
              </div>
              <a
                href="/#lowongan"
                class="w-full th-btn py-3 px-4 gap-2 text-xs justify-center font-heading font-bold shadow-sm"
              >
                <span>Lihat Lowongan Kerja Lainnya</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          ) : (
            <div id="lamar-sekarang" class="bg-gradient-to-br from-white to-[#F8FAFC] rounded-2xl p-6 sm:p-7 shadow-[0_4px_20px_rgba(13,25,43,0.06)] border border-slate-200/90 scroll-mt-24">
              <div class="mb-5 pb-4 border-b border-slate-100">
                <span class="text-xs font-technical font-bold uppercase tracking-widest text-[#22416D] block mb-1">
                  Pendaftaran Resmi
                </span>
                <h3 class="text-xl font-heading font-black text-[#17202A]">
                  Tertarik Bergabung?
                </h3>
                <p class="text-xs font-body text-slate-500 mt-1 leading-relaxed">
                  Kirimkan berkas lamaran Anda sekarang melalui formulir online resmi Bina Project.
                </p>
              </div>

              <!-- Preparation Checklist (Clean Blue & White) -->
              <div class="space-y-2.5 mb-6 text-xs font-body text-slate-600">
                <div class="flex items-center gap-2">
                  <div class="w-4 h-4 rounded-full bg-[#EFF6FF] text-[#22416D] border border-blue-100 flex items-center justify-center shrink-0">
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>Siapkan file CV / Resume (Format PDF, maks 10MB)</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-4 h-4 rounded-full bg-[#EFF6FF] text-[#22416D] border border-blue-100 flex items-center justify-center shrink-0">
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>Lampirkan portofolio proyek (jika ada)</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-4 h-4 rounded-full bg-[#EFF6FF] text-[#22416D] border border-blue-100 flex items-center justify-center shrink-0">
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>Review berkas oleh HRD: 3–5 hari kerja</span>
                </div>
              </div>

              <!-- Big Primary CTA Button -->
              <a
                href={`/loker/${job.slug}/lamar`}
                class="w-full th-btn py-3.5 px-6 gap-2 text-sm justify-center shadow-md hover:shadow-lg font-heading font-bold"
              >
                <span>Isi Formulir Lamaran Kerja</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <p class="text-[11px] font-technical text-slate-400 text-center mt-3">
                Formulir pendaftaran resmi &bull; Estimasi &plusmn; 2 menit
              </p>
            </div>
          )}

        </div>

      </div>

    </div>
  </main>

  <!-- Sticky Floating Mobile Apply Bar -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur-md border-t border-slate-200/80 px-4 pt-3 pb-[calc(0.85rem+env(safe-area-inset-bottom,0px))] z-40 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] flex items-center justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-heading font-extrabold text-[#17202A] truncate">{job.title}</p>
      <p class="text-[11px] font-technical text-slate-500 truncate">{job.location} &bull; {job.job_type}</p>
    </div>
    {isClosed ? (
      <a
        href="/#lowongan"
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-[#22416D] font-technical text-xs font-bold shrink-0 transition-colors"
      >
        <span>Posisi Lain</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    ) : (
      <a
        href={`/loker/${job.slug}/lamar`}
        class="th-btn th-btn-sm shrink-0 gap-1.5 px-5 py-2.5 shadow-sm text-xs font-heading font-bold"
      >
        <span>Lamar Sekarang</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    )}
  </div>

  <Footer />
</CareerLayout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (copyBtnText) copyBtnText.innerText = 'Tersalin!';
        copyBtn.classList.add('text-[#22416D]', 'bg-[#EFF6FF]', 'border-[#84ACDF]');
        setTimeout(() => {
          if (copyBtnText) copyBtnText.innerText = 'Salin';
          copyBtn.classList.remove('text-[#22416D]', 'bg-[#EFF6FF]', 'border-[#84ACDF]');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }
</script>
