---
import CareerLayout from '../layouts/CareerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CultureSection from '../components/CultureSection.astro';
import JobCard from '../components/JobCard.astro';
import FaqSection from '../components/FaqSection.astro';
import { supabase } from '../lib/supabase';

// Fetch published and closed job postings (closed jobs remain visible with notification)
let jobs: any[] = [];
const departments = ['Semua', 'Arsitektur & Desain', 'Konstruksi & Lapangan', 'Estimator & RAB', 'Marketing & Finance', 'Magang'];

if (supabase) {
  const { data } = await supabase
    .from('job_postings')
    .select('*')
    .in('status', ['published', 'closed'])
    .order('created_at', { ascending: false });
  if (data) {
    // Keep published (open) jobs first, closed jobs at the bottom
    jobs = data.sort((a, b) => {
      const aClosed = a.status === 'closed';
      const bClosed = b.status === 'closed';
      if (!aClosed && bClosed) return -1;
      if (aClosed && !bClosed) return 1;
      return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
    });
  }
}

const openJobsCount = jobs.filter((j) => j.status === 'published' && (!j.application_deadline || new Date(j.application_deadline).getTime() >= Date.now())).length;

// Compute real job counts per department for quick candidate guidance
const deptCounts: Record<string, number> = {
  Semua: jobs.length,
};
departments.forEach((dept) => {
  if (dept !== 'Semua') {
    deptCounts[dept] = jobs.filter(
      (j) => j.department?.trim().toLowerCase() === dept.trim().toLowerCase()
    ).length;
  }
});
---

<CareerLayout title="Lowongan Kerja & Peluang Karir">
  <Header />

  <!-- =========================================================================
       HERO SECTION — Authentic Architectural Editorial with Real Project Visual
       ========================================================================= -->
  <section class="relative bg-[#0A1320] text-white pt-24 pb-28 sm:pt-32 sm:pb-36 overflow-hidden">
    
    <!-- Real Architectural Project Image -->
    <div 
      class="absolute inset-0 bg-cover bg-center sm:bg-right opacity-45 mix-blend-luminosity pointer-events-none"
      style="background-image: url('/assets/img/hero-career.webp');"
    ></div>
    <!-- Hero Dark Overlay Gradient -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A1320] via-[#0A1320]/85 to-[#0A1320]/45 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A1320]/60 via-transparent to-[#0A1320] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-left max-w-3xl">
        
        <!-- Clean Editorial Eyebrow -->
        <div class="mb-5 sm:mb-6">
          <span class="text-xs sm:text-sm font-technical font-medium uppercase tracking-widest text-[#84ACDF]">
            Portal Rekrutmen Resmi &bull; Bina Project Construction
          </span>
        </div>

        <!-- Solid Authoritative Headline (Lighter / Clean Weight) -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-medium tracking-tight leading-[1.15] mb-6 text-white">
          Bangun Mahakarya Arsitektur &amp; Karir Masa Depan Anda
        </h1>

        <!-- Hero Description -->
        <p class="text-base sm:text-lg font-body text-slate-300 leading-relaxed max-w-2xl mb-10">
          Bergabunglah bersama tim profesional Bina Project Construction. Berkolaborasi dalam proyek arsitektur, perencanaan kawasan, dan konstruksi modern di Jawa Timur.
        </p>

        <!-- CTA Action Button -->
        <div class="flex items-center justify-start">
          <a
            href="#lowongan"
            class="th-btn gap-2.5 px-8 py-3.5 shadow-lg"
          >
            <span>Lihat Lowongan Kerja ({openJobsCount > 0 ? `${openJobsCount} Terbuka` : `${jobs.length} Posisi`})</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>

      </div>


    </div>
  </section>

  <!-- =========================================================================
       JOB LISTINGS SECTION — Crisp Light Architectural Theme (#F8FAFC)
       ========================================================================= -->
  <section id="lowongan" class="py-20 bg-[#F8FAFC] scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <span class="text-xs font-technical font-bold uppercase tracking-widest text-[#22416D] block mb-2">
          Peluang Karir
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-extrabold text-[#17202A] tracking-tight">
          Temukan Posisi yang Sesuai Keahlian Anda
        </h2>
        <p class="text-[#475569] font-body text-sm sm:text-base mt-2">
          Pilih departemen untuk menyaring posisi kerja aktif di studio desain dan proyek lapangan kami.
        </p>
      </div>

      <!-- Filter Controls: Search & Category Tabs -->
      <div class="max-w-4xl mx-auto mb-12 space-y-4">
        
        <!-- Live Keyword Search Bar -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            placeholder="Cari judul posisi (contoh: Arsitek, Estimator, Site Supervisor, Drafter)..."
            class="bina-input w-full pl-12 pr-4 py-3.5 text-sm shadow-xs placeholder:text-slate-400"
          />
        </div>

        <!-- Department Filter Chips -->
        <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto" id="dept-filters">
          {departments.map((dept, i) => {
            const count = deptCounts[dept] ?? 0;
            const isActive = i === 0;
            return (
              <button
                type="button"
                data-dept={dept}
                class={`group inline-flex items-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl text-xs sm:text-sm font-heading font-semibold transition-all duration-200 cursor-pointer border ${
                  isActive
                    ? 'active-filter bg-[#22416D] text-white border-[#1E3A5F] shadow-sm shadow-[#22416D]/20'
                    : 'bg-white text-slate-600 border-slate-200 hover:border-[#22416D]/40 hover:text-[#22416D] hover:bg-slate-50/80 shadow-xs'
                }`}
              >
                <span>{dept}</span>
                <span
                  class={`count-badge px-2 py-0.5 rounded-md text-[11px] font-technical transition-colors ${
                    isActive
                      ? 'bg-white/20 text-white'
                      : 'bg-slate-100 text-slate-500 group-hover:bg-[#22416D]/10 group-hover:text-[#22416D]'
                  }`}
                >
                  {count}
                </span>
              </button>
            );
          })}
        </div>

      </div>

      <!-- Job Cards Grid -->
      {jobs.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="jobs-grid">
          {jobs.map((job) => (
            <div data-department={job.department} data-title={job.title.toLowerCase()} class="h-full flex flex-col">
              <JobCard
                slug={job.slug}
                title={job.title}
                department={job.department}
                jobType={job.job_type}
                workplaceType={job.workplace_type}
                location={job.location}
                experienceLevel={job.experience_level}
                thumbnailUrl={job.thumbnail_url}
                deadline={job.application_deadline}
                salaryRange={job.salary_range}
                showSalary={job.show_salary}
                status={job.status}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="bento-card p-12 text-center max-w-xl mx-auto bg-white border border-[#E2E8F0]">
          <div class="w-14 h-14 rounded-2xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-[#17202A] mb-2">
            Belum Ada Lowongan Aktif
          </h3>
          <p class="text-sm font-body text-[#475569] max-w-md mx-auto">
            Saat ini belum ada lowongan kerja yang dibuka. Silakan pantau halaman ini dan media sosial resmi Bina Project secara berkala untuk pembaruan posisi.
          </p>
        </div>
      )}

      <!-- No Search Results Found Message (Hidden by default) -->
      <div id="no-search-results" class="hidden bento-card p-10 text-center max-w-md mx-auto bg-white border border-[#E2E8F0] mt-8">
        <p class="text-base font-heading font-bold text-[#17202A] mb-1">
          Tidak ada posisi yang cocok
        </p>
        <p class="text-xs font-body text-[#64748B]">
          Coba gunakan kata kunci pencarian lain atau pilih tab 'Semua'.
        </p>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       CULTURE & LIFE AT BINA PROJECT
       ========================================================================= -->
  <CultureSection />



  <!-- =========================================================================
       FAQ SECTION
       ========================================================================= -->
  <FaqSection />

  <Footer />
</CareerLayout>

<script>
  // Dynamic Live Filtering (Department + Keyword Search)
  const filters = document.getElementById('dept-filters');
  const grid = document.getElementById('jobs-grid');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const noResults = document.getElementById('no-search-results');

  if (grid) {
    let currentDept = 'Semua';
    let currentSearch = '';

    const applyFilters = () => {
      const cards = grid.querySelectorAll<HTMLElement>('[data-department]');
      let visibleCount = 0;

      const normalizedCurrentDept = currentDept.trim().toLowerCase();

      cards.forEach((card) => {
        const cardDept = (card.getAttribute('data-department') || '').trim().toLowerCase();
        const cardTitle = (card.getAttribute('data-title') || '').trim().toLowerCase();

        const matchesDept = normalizedCurrentDept === 'semua' || cardDept === normalizedCurrentDept;
        const matchesSearch = currentSearch === '' || cardTitle.includes(currentSearch);

        if (matchesDept && matchesSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    };

    if (filters) {
      const buttons = filters.querySelectorAll<HTMLButtonElement>('button[data-dept]');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentDept = btn.getAttribute('data-dept') || 'Semua';

          buttons.forEach((b) => {
            const isTarget = b === btn;
            const badge = b.querySelector('.count-badge');

            if (isTarget) {
              b.className = 'group inline-flex items-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl text-xs sm:text-sm font-heading font-semibold transition-all duration-200 cursor-pointer border active-filter bg-[#22416D] text-white border-[#1E3A5F] shadow-sm shadow-[#22416D]/20';
              if (badge) {
                badge.className = 'count-badge px-2 py-0.5 rounded-md text-[11px] font-technical transition-colors bg-white/20 text-white';
              }
            } else {
              b.className = 'group inline-flex items-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl text-xs sm:text-sm font-heading font-semibold transition-all duration-200 cursor-pointer border bg-white text-slate-600 border-slate-200 hover:border-[#22416D]/40 hover:text-[#22416D] hover:bg-slate-50/80 shadow-xs';
              if (badge) {
                badge.className = 'count-badge px-2 py-0.5 rounded-md text-[11px] font-technical transition-colors bg-slate-100 text-slate-500 group-hover:bg-[#22416D]/10 group-hover:text-[#22416D]';
              }
            }
          });

          applyFilters();
        });
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
        applyFilters();
      });
    }
  }
</script>
