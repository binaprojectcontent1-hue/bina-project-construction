---
import CareerLayout from '../layouts/CareerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CultureSection from '../components/CultureSection.astro';
import JobCard from '../components/JobCard.astro';
import FaqSection from '../components/FaqSection.astro';
import { supabase } from '../lib/supabase';

// Fetch published job postings
let jobs: any[] = [];
const departments = ['Semua', 'Arsitektur & Desain', 'Konstruksi & Lapangan', 'Estimator & RAB', 'Marketing & Finance', 'Magang'];

if (supabase) {
  const { data } = await supabase
    .from('job_postings')
    .select('*')
    .eq('status', 'published')
    .order('created_at', { ascending: false });
  if (data) jobs = data;
}
---

<CareerLayout title="Lowongan Kerja & Peluang Karir">
  <Header />

  <!-- =========================================================================
       HERO SECTION — Architectural Blueprint & Dark Navy Mesh
       ========================================================================= -->
  <section class="relative bg-gradient-to-b from-[#0D192B] via-[#0E1E38] to-[#152B49] text-white pt-20 pb-24 sm:pt-28 sm:pb-32 overflow-hidden border-b border-[#22416D]">
    
    <!-- Subtle Architectural Blueprint Grid Overlay -->
    <div class="absolute inset-0 blueprint-grid pointer-events-none opacity-80"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        
        <!-- Kicker Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#1A3356] border border-[#2B4C7E] shadow-sm mb-6 sm:mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-[#84ACDF] animate-pulse"></span>
          <span class="text-xs sm:text-sm font-technical font-semibold tracking-wider text-[#BFDBFE] uppercase">
            Portal Rekrutmen Resmi &bull; {jobs.length} Posisi Tersedia
          </span>
        </div>

        <!-- Hero Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-black tracking-tight leading-[1.15] mb-6">
          Bangun Mahakarya Arsitektur &
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#84ACDF] via-[#BFDBFE] to-white">
            Karir Masa Depanmu
          </span>
        </h1>

        <!-- Hero Description -->
        <p class="text-base sm:text-lg font-body text-slate-300 leading-relaxed max-w-2xl mx-auto mb-10">
          Bergabunglah bersama tim profesional <strong class="text-white font-semibold">Bina Project Construction & Interior</strong>. Berkolaborasi dalam proyek arsitektur, perencanaan kawasan, dan konstruksi modern di Malang, Jawa Timur.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#lowongan"
            class="th-btn w-full sm:w-auto bg-[#345F99]! hover:bg-[#22416D]! border-[#84ACDF]/40 text-white gap-2 shadow-lg"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Jelajahi Lowongan Kerja</span>
          </a>

          <a
            href="/talent-pool"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white/10 hover:bg-white/15 border border-white/20 text-white font-heading font-bold text-sm transition-all"
          >
            <span>Kirim CV ke Talent Pool</span>
            <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Hero Proof / Stat Counters -->
      <div class="grid grid-cols-3 max-w-3xl mx-auto gap-4 sm:gap-6 mt-16 sm:mt-20 pt-10 border-t border-[#1E3A5F]">
        <div class="text-center">
          <div class="text-2xl sm:text-4xl font-heading font-black text-white">200+</div>
          <div class="text-xs sm:text-sm font-technical text-slate-300 mt-1">Proyek Konstruksi & Interior</div>
        </div>
        <div class="text-center border-x border-[#1E3A5F]">
          <div class="text-2xl sm:text-4xl font-heading font-black text-white">5+</div>
          <div class="text-xs sm:text-sm font-technical text-slate-300 mt-1">Tahun Rekam Jejak</div>
        </div>
        <div class="text-center">
          <div class="text-2xl sm:text-4xl font-heading font-black text-white">100%</div>
          <div class="text-xs sm:text-sm font-technical text-slate-300 mt-1">Kultur Tim Bergaransi</div>
        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       JOB LISTINGS SECTION — Crisp Light Architectural Theme (#F8FAFC)
       ========================================================================= -->
  <section id="lowongan" class="py-20 bg-[#F8FAFC] scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-technical font-bold uppercase tracking-wider bg-[#EFF6FF] text-[#22416D] border border-[#BFDBFE] mb-3">
          Peluang Terbuka
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-extrabold text-[#17202A] tracking-tight">
          Temukan Posisi yang Sesuai Keahlian Anda
        </h2>
        <p class="text-[#475569] font-body text-sm sm:text-base mt-2">
          Pilih departemen untuk menyaring posisi kerja aktif di kantor dan proyek lapangan kami.
        </p>
      </div>

      <!-- Filter Controls: Search & Category Tabs -->
      <div class="max-w-4xl mx-auto mb-12 space-y-4">
        
        <!-- Live Keyword Search Bar -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            placeholder="Cari judul posisi (contoh: Arsitek, Estimator, Site Supervisor, Drafter)..."
            class="bina-input w-full pl-12 pr-4 py-3.5 text-sm shadow-xs placeholder:text-slate-400"
          />
        </div>

        <!-- Department Tabs -->
        <div class="flex flex-wrap justify-center gap-2" id="dept-filters">
          {departments.map((dept, i) => (
            <button
              type="button"
              data-dept={dept}
              class={`px-4 py-2 rounded-full text-xs sm:text-sm font-heading font-semibold transition-all cursor-pointer ${
                i === 0
                  ? 'bg-[#22416D] text-white shadow-xs'
                  : 'bg-white text-[#475569] border border-[#E2E8F0] hover:bg-[#F1F5F9] hover:text-[#22416D]'
              }`}
            >
              {dept}
            </button>
          ))}
        </div>

      </div>

      <!-- Job Cards Grid -->
      {jobs.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="jobs-grid">
          {jobs.map((job) => (
            <div data-department={job.department} data-title={job.title.toLowerCase()}>
              <JobCard
                slug={job.slug}
                title={job.title}
                department={job.department}
                jobType={job.job_type}
                workplaceType={job.workplace_type}
                location={job.location}
                experienceLevel={job.experience_level}
                deadline={job.application_deadline}
                salaryRange={job.salary_range}
                showSalary={job.show_salary}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="bento-card p-12 text-center max-w-xl mx-auto bg-white border border-[#E2E8F0]">
          <div class="w-14 h-14 rounded-2xl bg-[#EFF6FF] text-[#22416D] flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-[#17202A] mb-2">
            Belum Ada Lowongan Aktif
          </h3>
          <p class="text-sm font-body text-[#475569] mb-6">
            Saat ini seluruh posisi telah terisi. Namun kami selalu menyambut talenta luar biasa. Kirimkan CV Anda ke Talent Pool untuk kami hubungi terlebih dahulu saat posisi dibuka.
          </p>
          <a href="/talent-pool" class="th-btn th-btn-sm">
            Kirimkan CV ke Talent Pool
          </a>
        </div>
      )}

      <!-- No Search Results Found Message (Hidden by default) -->
      <div id="no-search-results" class="hidden bento-card p-10 text-center max-w-md mx-auto bg-white border border-[#E2E8F0] mt-8">
        <p class="text-base font-heading font-bold text-[#17202A] mb-1">
          Tidak ada posisi yang cocok
        </p>
        <p class="text-xs font-body text-[#64748B]">
          Coba gunakan kata kunci pencarian lain atau pilih tab 'Semua'.
        </p>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       CULTURE & LIFE AT BINA PROJECT
       ========================================================================= -->
  <CultureSection />

  <!-- =========================================================================
       TALENT POOL BANNER
       ========================================================================= -->
  <section class="py-20 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl bg-gradient-to-br from-[#0D192B] via-[#152A47] to-[#22416D] p-8 sm:p-14 overflow-hidden border border-[#2B4C7E] shadow-xl text-white">
        
        <!-- Blueprint Grid Pattern in Banner -->
        <div class="absolute inset-0 blueprint-grid opacity-40 pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-technical font-semibold bg-[#345F99] text-[#BFDBFE] mb-4">
            Komunitas Bakat Bina Project
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-extrabold text-white tracking-tight mb-4">
            Belum Menemukan Posisi yang Tepat Hari Ini?
          </h2>
          <p class="text-sm sm:text-base text-slate-300 font-body leading-relaxed mb-8">
            Jangan biarkan kesempatan terlewat. Daftarkan resume Anda di <strong class="text-white">Talent Pool Resmi Bina Project</strong>. Tim People & Culture kami akan memprioritaskan profil Anda ketika posisi terkait dibuka.
          </p>
          <a
            href="/talent-pool"
            class="th-btn bg-white text-[#0D192B]! hover:bg-[#EFF6FF]! border-white shadow-lg font-bold gap-2"
          >
            <span>Daftar ke Talent Pool Kami</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       FAQ SECTION
       ========================================================================= -->
  <FaqSection />

  <Footer />
</CareerLayout>

<script>
  // Dynamic Live Filtering (Department + Keyword Search)
  const filters = document.getElementById('dept-filters');
  const grid = document.getElementById('jobs-grid');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const noResults = document.getElementById('no-search-results');

  if (grid) {
    let currentDept = 'Semua';
    let currentSearch = '';

    const applyFilters = () => {
      const cards = grid.querySelectorAll<HTMLElement>('[data-department]');
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardDept = card.getAttribute('data-department') || '';
        const cardTitle = card.getAttribute('data-title') || '';

        const matchesDept = currentDept === 'Semua' || cardDept === currentDept;
        const matchesSearch = currentSearch === '' || cardTitle.includes(currentSearch);

        if (matchesDept && matchesSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    };

    if (filters) {
      const buttons = filters.querySelectorAll('button');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentDept = btn.getAttribute('data-dept') || 'Semua';

          buttons.forEach((b) => {
            if (b === btn) {
              b.className = 'px-4 py-2 rounded-full text-xs sm:text-sm font-heading font-semibold transition-all cursor-pointer bg-[#22416D] text-white shadow-xs';
            } else {
              b.className = 'px-4 py-2 rounded-full text-xs sm:text-sm font-heading font-semibold transition-all cursor-pointer bg-white text-[#475569] border border-[#E2E8F0] hover:bg-[#F1F5F9] hover:text-[#22416D]';
            }
          });

          applyFilters();
        });
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
        applyFilters();
      });
    }
  }
</script>
