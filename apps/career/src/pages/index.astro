---
import CareerLayout from '../layouts/CareerLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CultureSection from '../components/CultureSection.astro';
import JobCard from '../components/JobCard.astro';
import FaqSection from '../components/FaqSection.astro';
import { supabase } from '../lib/supabase';

// Fetch published job postings
let jobs: any[] = [];
const departments = ['Semua', 'Arsitektur & Desain', 'Konstruksi & Lapangan', 'Estimator & RAB', 'Marketing & Finance', 'Magang'];

if (supabase) {
  const { data } = await supabase
    .from('job_postings')
    .select('*')
    .eq('status', 'published')
    .order('created_at', { ascending: false });
  if (data) jobs = data;
}
---

<CareerLayout title="Lowongan Kerja & Peluang Karir">
  <Header />

  <!-- Hero Section -->
  <section class="relative overflow-hidden py-20 sm:py-28 lg:py-36">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/20 mb-6 sm:mb-8">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="text-xs sm:text-sm font-bold text-amber-400">Sedang Membuka {jobs.length} Lowongan</span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black text-white leading-[1.1] mb-5 sm:mb-6">
          Bangun Mahakarya Arsitektur &
          <span class="text-gradient-amber"> Karir Masa Depanmu</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-400 leading-relaxed max-w-xl mx-auto mb-8 sm:mb-10">
          Bergabunglah bersama tim profesional Bina Project Construction & Interior.
          Ciptakan ruang dan bangunan yang menginspirasi di Malang, Jawa Timur.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          <a
            href="#lowongan"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-gradient-to-r from-[#F68A0A] to-[#E07800] text-white font-bold text-sm shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 transition-all hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            Lihat Lowongan
          </a>
          <a
            href="/talent-pool"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-white/5 border border-white/10 text-white font-bold text-sm hover:bg-white/10 transition-all"
          >
            Kirim CV ke Talent Pool
          </a>
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 sm:mt-20">
      <div class="grid grid-cols-3 gap-4 sm:gap-6">
        <div class="text-center p-4 sm:p-6 rounded-2xl bg-[#0E1E38]/60 border border-white/5">
          <div class="text-2xl sm:text-3xl font-black text-white mb-1">200+</div>
          <div class="text-xs sm:text-sm text-slate-400">Proyek Terselesaikan</div>
        </div>
        <div class="text-center p-4 sm:p-6 rounded-2xl bg-[#0E1E38]/60 border border-white/5">
          <div class="text-2xl sm:text-3xl font-black text-white mb-1">5+</div>
          <div class="text-xs sm:text-sm text-slate-400">Tahun Berkarya</div>
        </div>
        <div class="text-center p-4 sm:p-6 rounded-2xl bg-[#0E1E38]/60 border border-white/5">
          <div class="text-2xl sm:text-3xl font-black text-white mb-1">30+</div>
          <div class="text-xs sm:text-sm text-slate-400">Tim Profesional</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Culture Section -->
  <CultureSection />

  <!-- Job Listings Section -->
  <section id="lowongan" class="py-16 sm:py-24 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <span class="inline-block px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-4">
          Open Positions
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white">
          Lowongan Kerja Terbuka
        </h2>
      </div>

      <!-- Department Filter Tabs -->
      <div class="flex flex-wrap justify-center gap-2 mb-8 sm:mb-12" id="dept-filters">
        {departments.map((dept, i) => (
          <button
            type="button"
            data-dept={dept}
            class={`px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer ${
              i === 0
                ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30'
                : 'bg-white/5 text-slate-400 border border-white/5 hover:bg-white/10 hover:text-white'
            }`}
          >
            {dept}
          </button>
        ))}
      </div>

      <!-- Job Cards Grid -->
      {jobs.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6" id="jobs-grid">
          {jobs.map((job) => (
            <div data-department={job.department}>
              <JobCard
                slug={job.slug}
                title={job.title}
                department={job.department}
                jobType={job.job_type}
                workplaceType={job.workplace_type}
                location={job.location}
                experienceLevel={job.experience_level}
                deadline={job.application_deadline}
                salaryRange={job.salary_range}
                showSalary={job.show_salary}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16 rounded-2xl bg-[#0E1E38]/40 border border-white/5">
          <div class="text-4xl mb-4">🚧</div>
          <h3 class="text-lg font-bold text-white mb-2">Belum Ada Lowongan Terbuka</h3>
          <p class="text-sm text-slate-400 max-w-md mx-auto mb-6">
            Saat ini belum ada posisi yang tersedia. Kirimkan CV Anda ke Talent Pool agar kami bisa menghubungi Anda ketika ada kesempatan.
          </p>
          <a
            href="/talent-pool"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-[#F68A0A] to-[#E07800] text-white font-bold text-sm shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 transition-all"
          >
            Kirim CV ke Talent Pool
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Talent Pool Banner -->
  <section class="py-16 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl bg-gradient-to-br from-[#22416D] to-[#152B49] border border-blue-400/20 p-8 sm:p-12 overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-5">
          <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
        </div>

        <div class="relative z-10 text-center">
          <div class="text-3xl mb-4">💼</div>
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold text-white mb-3">
            Belum Menemukan Posisi yang Cocok?
          </h2>
          <p class="text-sm sm:text-base text-blue-200/70 max-w-lg mx-auto mb-6 leading-relaxed">
            Kirimkan CV Anda ke Talent Pool kami. Ketika ada posisi yang sesuai dengan profil Anda, tim HRD akan langsung menghubungi.
          </p>
          <a
            href="/talent-pool"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-white text-[#0E1E38] font-bold text-sm shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            Daftar Talent Pool
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FaqSection />

  <Footer />
</CareerLayout>

<script>
  // Client-side department filter
  const filters = document.getElementById('dept-filters');
  const grid = document.getElementById('jobs-grid');

  if (filters && grid) {
    const buttons = filters.querySelectorAll('button');
    const cards = grid.querySelectorAll('[data-department]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dept = btn.getAttribute('data-dept');

        // Update active button style
        buttons.forEach((b) => {
          b.className = b === btn
            ? 'px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer bg-amber-500/20 text-amber-400 border border-amber-500/30'
            : 'px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white/5 text-slate-400 border border-white/5 hover:bg-white/10 hover:text-white';
        });

        // Filter cards
        cards.forEach((card) => {
          const cardDept = card.getAttribute('data-department');
          if (dept === 'Semua' || cardDept === dept) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }
</script>
