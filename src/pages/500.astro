---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="500 - Server Error"
  description="Terjadi kesalahan pada server. Kami sedang memperbaikinya."
  noindex={true}
>
  <section class="min-h-screen flex items-center justify-center px-4 py-16 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-2xl mx-auto text-center">
      <div class="mb-8">
        <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-rose-100 mb-6">
          <svg class="w-12 h-12 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h1 class="text-6xl font-bold text-slate-900 mb-4">500</h1>
        <h2 class="text-2xl font-semibold text-slate-800 mb-3">Server Error</h2>
        <p class="text-lg text-slate-600 mb-8 max-w-md mx-auto">
          Maaf, terjadi kesalahan pada server kami. Tim teknis sudah diberitahu dan sedang menangani kendala ini.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 bg-[#22416D] text-white font-semibold rounded-lg hover:bg-[#1a3254] transition-colors shadow-md"
        >
          Kembali ke Beranda
        </a>
        <button
          onclick="window.location.reload()"
          class="inline-flex items-center justify-center px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-colors"
        >
          Muat Ulang Halaman
        </button>
      </div>

      <!-- Single Official Support & Contact Card -->
      <div class="mt-12 p-6 bg-slate-50 rounded-lg border border-slate-200">
        <h3 class="text-sm font-semibold text-slate-700 mb-2">Butuh Bantuan Segera?</h3>
        <p class="text-sm text-slate-600 mb-4">
          Jika kendala terus berlanjut, Anda dapat langsung menghubungi tim kami melalui:
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href={siteConfig.contact.phoneTel}
            class="text-sm text-[#22416D] hover:underline font-medium inline-flex items-center gap-1.5"
          >
            <Icon name="solar:phone-calling-linear" width="16" height="16" />
            {siteConfig.contact.phoneDisplay}
          </a>
          <a
            href={siteConfig.contact.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-[#008069] hover:underline font-medium inline-flex items-center gap-1.5"
          >
            <Icon name="simple-icons:whatsapp" width="16" height="16" />
            WhatsApp Resmi
          </a>
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="text-sm text-[#22416D] hover:underline font-medium inline-flex items-center gap-1.5"
          >
            <Icon name="solar:letter-linear" width="16" height="16" />
            {siteConfig.contact.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

