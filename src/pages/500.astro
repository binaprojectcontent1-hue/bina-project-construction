---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="500 - Server Error"
  description="Terjadi kesalahan pada server. Kami sedang memperbaikinya."
  noindex={true}
>
  <section class="min-h-screen flex items-center justify-center px-4 py-16 bg-gradient-to-b from-slate-50 to-white">
  <div class="max-w-2xl mx-auto text-center">
    <div class="mb-8">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-rose-100 mb-6">
        <svg class="w-12 h-12 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <h1 class="text-6xl font-bold text-slate-900 mb-4">500</h1>
      <h2 class="text-2xl font-semibold text-slate-800 mb-3">Server Error</h2>
      <p class="text-lg text-slate-600 mb-8 max-w-md mx-auto">
        Maaf, terjadi kesalahan pada server kami. Tim teknis sudah diberitahu dan sedang menangani masalah ini.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-3 bg-[#22416D] text-white font-semibold rounded-lg hover:bg-[#1a3254] transition-colors shadow-md"
      >
        Kembali ke Beranda
      </a>
      <button
        onclick="window.location.reload()"
        class="inline-flex items-center justify-center px-6 py-3 bg-slate-100 text-slate-700 font-semibold rounded-lg hover:bg-slate-200 transition-colors"
      >
        Muat Ulang Halaman
      </button>
    </div>

    <div class="mt-12 p-6 bg-slate-50 rounded-lg border border-slate-200">
      <h3 class="text-sm font-semibold text-slate-700 mb-2">Butuh Bantuan?</h3>
      <p class="text-sm text-slate-600 mb-4">
        Jika masalah terus berlanjut, hubungi kami di:
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:+6281234567890" class="text-sm text-[#22416D] hover:underline font-medium">
          📞 +62 812-3456-7890
        </a>
        <a href="mailto:info@binaproject.com" class="text-sm text-[#22416D] hover:underline font-medium">
          ✉️ info@binaproject.com
        </a>
      </div>
    </div>
    </div>
    
    <!-- Status & Contact Card -->
    <div class="mt-12 p-6 bg-slate-50 rounded-lg border border-slate-200">
      <h3 class="text-sm font-semibold text-slate-700 mb-2">Butuh Bantuan?</h3>
      <p class="text-sm text-slate-600 mb-4">
        Jika masalah terus berlanjut, hubungi kami di:
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:+6281234567890" class="text-sm text-[#22416D] hover:underline font-medium inline-flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.93a2 2 0 0 1-2 3.31l2 4A2 2 0 0 0 12 18a2 2 0 0 0 2-2 2 2 0 0 0-2-2l-4-2a2 2 0 0 1-1.18-3.09 12.84 12.84 0 0 0 .7-2.81 2 2 0 0 1 2.53-2.2l3 .7c1.1.28 2.2.6 3.31.7"/>
          </svg>
          +62 812-3456-7890
        </a>
        <a href="mailto:info@binaproject.com" class="text-sm text-[#22416D] hover:underline font-medium inline-flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          info@binaproject.com
        </a>
      </div>
    </div>
  </div>
  </section>
</BaseLayout>
