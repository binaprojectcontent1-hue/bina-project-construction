---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { Icon } from 'astro-icon/components';
import { supabase } from '@lib/supabase';

// Pre-fetch redirects from Supabase at build time for instant client-side resolution
let staticRedirects: Record<string, string> = {};
if (supabase) {
  try {
    const { data } = await supabase.from('redirects').select('source_path, target_path');
    if (data && Array.isArray(data)) {
      for (const r of data) {
        if (r.source_path && r.target_path) {
          const normalized = r.source_path.replace(/\/$/, '').toLowerCase();
          staticRedirects[normalized] = r.target_path;
        }
      }
    }
  } catch (err) {
    console.warn('Redirect pre-fetch notice (non-fatal):', err);
  }
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<BaseLayout
  title="404 - Halaman Tidak Ditemukan - Bina Project"
  description="Maaf, halaman yang Anda tuju tidak ditemukan atau telah dipindahkan."
  noindex={true}
>
  <script is:inline define:vars={{ staticRedirects, supabaseUrl, supabaseKey }}>
    (function () {
      try {
        var rawPath = window.location.pathname;
        var cleanPath = rawPath.replace(/\/$/, '').toLowerCase();
        if (!cleanPath) return;

        // 1. Instant static lookup (zero network latency)
        if (staticRedirects && staticRedirects[cleanPath]) {
          window.location.replace(staticRedirects[cleanPath] + window.location.search + window.location.hash);
          return;
        }

        // 2. Dynamic runtime lookup against Supabase REST API (for redirects added after SSG build)
        if (supabaseUrl && supabaseKey) {
          var encoded = encodeURIComponent(cleanPath);
          var apiUrl =
            supabaseUrl.replace(/\/$/, '') +
            '/rest/v1/redirects?or=(source_path.eq.' +
            encoded +
            ',source_path.eq.' +
            encodeURIComponent(cleanPath + '/') +
            ')&select=target_path&limit=1';

          fetch(apiUrl, {
            headers: {
              apikey: supabaseKey,
              Authorization: 'Bearer ' + supabaseKey,
            },
          })
            .then(function (res) {
              return res.json();
            })
            .then(function (records) {
              if (records && records.length > 0 && records[0].target_path) {
                window.location.replace(records[0].target_path + window.location.search + window.location.hash);
              }
            })
            .catch(function () {});
        }
      } catch (e) {}
    })();
  </script>

  <Breadcrumb title="404 - Halaman Tidak Ditemukan" />

  <section class="space">
    <div class="container">
      <div class="error-img text-center mb-40">
        <img
          src="/assets/img/theme-img/error.svg"
          alt="404 Halaman Tidak Ditemukan Bina Project"
          width="450"
          height="320"
          class="error-img-asset"
        />
      </div>
      <div class="error-content text-center">
        <h2 class="error-title">Oops! Halaman Tidak Ditemukan</h2>
        <p class="error-text mb-30 error-text-centered">
          Halaman yang Anda cari mungkin telah dipindahkan, dihapus, atau alamat URL yang Anda masukkan salah.
        </p>
        <a href="/" class="th-btn style1 th-icon">
          <Icon name="solar:home-2-linear" width="18" height="18" class="me-2" /> KEMBALI KE BERANDA
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-img-asset {
    max-width: 450px;
    height: auto;
  }
  .error-text-centered {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
