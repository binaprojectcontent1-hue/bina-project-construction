---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import aboutImg3 from '@assets/images/normal/about_3.jpg';
import LiveProjectsMap from '@components/LiveProjectsMap';
import SectionHeader from '@components/SectionHeader.astro';
import ProcessSection from '@components/sections/ProcessSection.astro';
import TeamSection from '@components/TeamSection.astro';
---

<BaseLayout
  title="Tentang Kami - Bina Project Construction"
  description="Mengenal Bina Project Construction, penyedia jasa arsitektur, interior, dan konstruksi terpercaya dengan pengalaman lebih dari 10 tahun di Jawa Timur."
>
  <Breadcrumb title="Tentang Kami" />

  <!--============================== About Area ==============================-->
  <div class="overflow-hidden space" id="about-sec">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-xl-6">
          <div class="img-box3">
            <div class="img1">
              <Image
                src={aboutImg3}
                alt="Profil Tim Arsitek dan Tenaga Ahli Konstruksi Bina Project Malang"
                loading="lazy"
                decoding="async"
                width={600}
                height={520}
                format="webp"
                quality={85}
              />
            </div>
          </div>
        </div>
        <div class="col-xl-6">
          <SectionHeader
            badge="Tentang Perusahaan Kami"
            badgeIcon="solar:buildings-2-bold"
            title="You Dream It, We Build It"
            description="Bina Project Construction merupakan usaha yang bergerak di bidang jasa Interior dan Konstruksi yang meliputi pembangunan gedung, perumahan, ruko hingga klinik. Kami hadir untuk menjadi solusi di setiap kebutuhan Interior & Konstruksi Anda. Kami siap bekerjasama dengan instansi dan seluruh sektor lain dengan komitmen mutu terbaik dan transparansi penuh."
            align="left"
            class="pe-xl-5 me-xl-5 mb-30"
          />

            <div class="about-item-wrap">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:users-group-rounded-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Tenaga Ahli Bersertifikasi</h3>
                  <p class="about-item_text">Ditangani oleh arsitek dan tim pengawas berdedikasi dengan jam terbang lebih dari 10 tahun di Jawa Timur.</p>
                </div>
              </div>
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:shield-check-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Garansi Konstruksi SPK</h3>
                  <p class="about-item_text">Komitmen tanggung jawab penuh dengan pemeliharaan fisik dan jaminan kebocoran dak tertulis.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Live Projects Map Section ==============================-->
  <section class="coverage-sec space-bottom" id="proyek-berjalan">
    <div class="container">
      <SectionHeader
        badge="Proyek Berjalan"
        badgeIcon="solar:map-point-wave-bold"
        title="Peta Progres Proyek Lapangan"
        description="Pantau proyek konstruksi dan interior yang sedang dikerjakan oleh tim Bina Project secara real-time di berbagai lokasi."
        align="center"
      />

      <!-- Full-Width Clean Interactive Map Visual -->
      <div class="row">
        <div class="col-12">
          <div class="coverage-map-presentation-wrapper">
            <LiveProjectsMap client:only="react" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Process Section (The Architectural Stacking Deck) ==============================-->
  <ProcessSection />

  <!--============================== Our Team Section ==============================-->
  <TeamSection />

  <!--============================== Refined Architectural CTA Section ==============================-->
  <section class="about-cta-section">
    <div class="about-cta-backdrop" aria-hidden="true"></div>
    <div class="container position-relative" style="z-index: 2;">
      <div class="row align-items-center justify-content-between gy-4">
        <div class="col-lg-7 col-xl-8">
          <div class="about-cta-content">
            <span class="about-cta-kicker">
              <Icon name="solar:buildings-bold" width="15" height="15" />
              <span>Studio Arsitektur & Pelaksana Konstruksi</span>
            </span>
            <h2 class="about-cta-title">
              Konsultasikan Rencana Bangunan <span class="about-cta-title-accent">Anda Bersama Kami</span>
            </h2>
            <p class="about-cta-desc">
              Mulai dari penyusunan konsep denah, visualisasi 3D interior, hingga estimasi anggaran biaya (RAB) yang transparan dan presisi bersama tim arsitek Bina Project.
            </p>
            <div class="about-cta-trust-row">
              <div class="trust-item">
                <Icon name="solar:check-circle-bold" width="16" height="16" class="trust-icon" />
                <span>Survei Tapak Gratis Malang Raya</span>
              </div>
              <div class="trust-item">
                <Icon name="solar:check-circle-bold" width="16" height="16" class="trust-icon" />
                <span>100% Transparansi Spesifikasi & RAB</span>
              </div>
              <div class="trust-item">
                <Icon name="solar:check-circle-bold" width="16" height="16" class="trust-icon" />
                <span>Garansi Resmi Konstruksi</span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5 col-xl-4">
          <div class="about-cta-actions">
            <a
              href="https://wa.me/6281335335304?text=Halo%20Bina%20Project,%20saya%20ingin%20konsultasi%20rencana%20bangunan"
              target="_blank"
              rel="noopener noreferrer"
              class="about-cta-btn about-cta-btn--primary"
            >
              <Icon name="simple-icons:whatsapp" width="18" height="18" />
              <span>Konsultasi via WhatsApp</span>
              <Icon name="solar:arrow-right-linear" width="16" height="16" class="arrow-icon" />
            </a>
            <a href="/portfolio" class="about-cta-btn about-cta-btn--secondary">
              <Icon name="solar:gallery-bold" width="18" height="18" />
              <span>Lihat Portofolio Proyek</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Zero-CLS Aspect Ratio Reservation for About Hero Image */
  .img-box3 .img1 {
    aspect-ratio: 600 / 520;
    width: 100%;
    max-width: 600px;
    background-color: #f1f5f9;
    border-radius: 8px;
    overflow: hidden;
    will-change: transform;
  }

  .img-box3 .img1 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ========================================================
     Clean Architectural Process Flow (Restrained & Non-Slop)
     ======================================================== */
  .process-clean-sec {
    background-color: var(--bina-slate-50, #F8FAFC);
    border-top: 1px solid var(--bina-slate-200, #E2E8F0);
    border-bottom: 1px solid var(--bina-slate-200, #E2E8F0);
    position: relative;
    padding: 90px 0;
  }

  .process-clean-desc {
    max-width: 640px;
    color: #334155;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
  }



  /* ========================================================
     Coverage Section & Architectural Map (Anti-AI Slop)
     ======================================================== */
  .coverage-sec {
    position: relative;
    padding-bottom: 90px;
    background-color: #FFFFFF;
  }

  .coverage-lead-desc {
    max-width: 680px;
    color: #334155;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
  }

  .coverage-map-presentation-wrapper {
    position: relative;
    width: 100%;
    min-height: 520px;
  }

  @media (max-width: 991px) {
    .coverage-sec {
      padding-bottom: 60px;
    }
    .coverage-map-presentation-wrapper {
      min-height: 440px;
    }
  }

  @media (max-width: 767px) {
    .coverage-map-presentation-wrapper {
      min-height: 400px;
    }
  }

  /* ========================================================
     Refined Architectural CTA Section
     ======================================================== */
  .about-cta-section {
    position: relative;
    padding: clamp(64px, 7vw, 92px) 0;
    background: linear-gradient(135deg, rgba(17, 32, 55, 0.95) 0%, rgba(26, 49, 82, 0.92) 50%, rgba(13, 24, 40, 0.96) 100%),
      url('/assets/img/bg/cta_bg_1.jpg') center center / cover no-repeat;
    overflow: hidden;
    color: #FFFFFF;
  }
  .about-cta-backdrop {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 80% 20%, rgba(132, 172, 223, 0.16) 0%, transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(37, 211, 102, 0.08) 0%, transparent 40%);
    pointer-events: none;
  }
  .about-cta-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    color: var(--bina-blue-ice, #84ACDF);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .about-cta-title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 800;
    line-height: 1.25;
    color: #FFFFFF !important;
    margin-top: 0;
    margin-bottom: 14px;
    letter-spacing: -0.02em;
  }
  .about-cta-title-accent {
    color: var(--bina-blue-ice, #84ACDF);
  }
  .about-cta-desc {
    font-size: clamp(14px, 1.1vw, 15.5px);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85) !important;
    max-width: 620px;
    margin-bottom: 22px;
  }
  .about-cta-trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }
  .trust-icon {
    color: #25D366;
    flex-shrink: 0;
  }
  .about-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 320px;
    margin-left: auto;
  }
  .about-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 12px;
    font-size: 13.5px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    font-family: var(--font-heading, 'Archivo', sans-serif);
  }
  .about-cta-btn--primary {
    background: #25D366;
    color: #064E3B;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
  }
  .about-cta-btn--primary:hover {
    background: #1EBE5D;
    color: #064E3B;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
  }
  .about-cta-btn--primary .arrow-icon {
    transition: transform 0.2s ease;
  }
  .about-cta-btn--primary:hover .arrow-icon {
    transform: translateX(4px);
  }
  .about-cta-btn--secondary {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.24);
  }
  .about-cta-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 991px) {
    .about-cta-content {
      text-align: center;
    }
    .about-cta-kicker {
      margin-left: auto;
      margin-right: auto;
    }
    .about-cta-desc {
      margin-left: auto;
      margin-right: auto;
    }
    .about-cta-trust-row {
      justify-content: center;
    }
    .about-cta-actions {
      margin-left: auto;
      margin-right: auto;
      max-width: 440px;
    }
  }

  @media (max-width: 575px) {
    .about-cta-actions {
      max-width: 100%;
    }
    .about-cta-btn {
      width: 100%;
    }
    .about-cta-trust-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  /* ========================================================
     Architectural Value Cards (Refined Solar Icons & Solid Box)
     ======================================================== */
  .about-item {
    background: #FFFFFF !important;
    border-radius: 14px;
    padding: 24px !important;
    box-shadow: 0 4px 20px rgba(34, 65, 109, 0.05);
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .about-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(34, 65, 109, 0.09);
  }
  .about-item_icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: rgba(34, 65, 109, 0.07);
    color: var(--bina-navy, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    transition: all 0.3s ease;
  }
  .about-item:hover .about-item_icon {
    background: var(--bina-navy, #22416D);
    color: #FFFFFF;
  }
</style>

<script>
  let aboutPageMatchMediaCtx: any = null;

  function initAboutPageScrollTrigger() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    // @ts-ignore
    const gsap = window.gsap;
    // @ts-ignore
    const ScrollTrigger = window.ScrollTrigger;

    if (!gsap || !ScrollTrigger) {
      let attempts = 0;
      const interval = setInterval(() => {
        attempts++;
        // @ts-ignore
        if (window.gsap && window.ScrollTrigger) {
          clearInterval(interval);
          initAboutPageScrollTrigger();
        } else if (attempts > 30) {
          clearInterval(interval);
        }
      }, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('#about-sec');
    if (!section) return;

    if (aboutPageMatchMediaCtx && typeof aboutPageMatchMediaCtx.revert === 'function') {
      aboutPageMatchMediaCtx.revert();
    }

    if (typeof gsap !== 'undefined' && typeof gsap.matchMedia === 'function') {
      aboutPageMatchMediaCtx = gsap.matchMedia();

      // Desktop (> 768px): Parallax Scrub + Stagger Reveal
      aboutPageMatchMediaCtx.add('(min-width: 769px)', () => {
      const imgBox = section.querySelector('.img-box3 .img1');
      if (imgBox) {
        gsap.to(imgBox, {
          yPercent: -12,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.2,
          },
        });
      }

      const headerEl = section.querySelector('.section-header');
      const items = section.querySelectorAll('.about-item');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      });

      if (headerEl) {
        tl.from(headerEl, {
          opacity: 0,
          y: 30,
          duration: 0.8,
          ease: 'power3.out',
        });
      }

      if (items.length) {
        tl.from(
          items,
          {
            opacity: 0,
            y: 25,
            stagger: 0.15,
            duration: 0.7,
            ease: 'power2.out',
          },
          '-=0.4'
        );
      }
    });

    // Mobile (<= 768px): Lightweight Reveal
    aboutPageMatchMediaCtx.add('(max-width: 768px)', () => {
      const imgBox = section.querySelector('.img-box3');
      const headerEl = section.querySelector('.section-header');
      const items = section.querySelectorAll('.about-item');

      const mobileTl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      });

      if (imgBox) {
        mobileTl.from(imgBox, {
          opacity: 0,
          y: 20,
          duration: 0.6,
          ease: 'power2.out',
        });
      }

      if (headerEl) {
        mobileTl.from(
          headerEl,
          {
            opacity: 0,
            y: 20,
            duration: 0.6,
            ease: 'power2.out',
          },
          '-=0.3'
        );
      }

      if (items.length) {
        mobileTl.from(
          items,
          {
            opacity: 0,
            y: 16,
            stagger: 0.12,
            duration: 0.5,
            ease: 'power2.out',
          },
          '-=0.2'
        );
      }
    });
  }
}

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAboutPageScrollTrigger();
  } else {
    window.addEventListener('DOMContentLoaded', initAboutPageScrollTrigger);
  }
  document.addEventListener('astro:page-load', initAboutPageScrollTrigger);
</script>
