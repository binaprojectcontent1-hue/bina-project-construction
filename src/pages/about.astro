---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import aboutImg3 from '@assets/images/normal/about_3.jpg';
import LiveProjectsMap from '@components/LiveProjectsMap';
import SectionHeader from '@components/SectionHeader.astro';
import ProcessSection from '@components/sections/ProcessSection.astro';
import VisionMissionSection from '@components/VisionMissionSection.astro';
import TeamSection from '@components/TeamSection.astro';
import TestimonialSection from '@components/TestimonialSection.astro';
import BrandMarquee from '@components/BrandMarquee.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout
  title={`${t('about.title')} - ${t('site.name')}`}
  description={t('about.subtitle')}
>
  <Breadcrumb title={t('nav.about')} />

  <!--============================== About Area ==============================-->
  <div class="overflow-hidden space" id="about-sec">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-xl-6">
          <div class="img-box3">
            <div class="img1">
              <Image
                src={aboutImg3}
                alt="Profil Tim Arsitek dan Tenaga Ahli Konstruksi Bina Project Malang"
                loading="lazy"
                decoding="async"
                width={600}
                height={520}
                format="webp"
                quality={85}
              />
            </div>
          </div>
        </div>
        <div class="col-xl-6">
          <SectionHeader
            badge="Kenapa Harus Memilih Bina Project ?"
            badgeIcon="solar:buildings-2-bold"
            title="Kenapa Harus Memilih Bina Project?"
            description="Bina Project merupakan Perusahaan profesional yang bergerak dibidang jasa desain perencanaan, kontraktor interior, kontraktor konstruksi dan waterproofing yang meliputi pembangunan rumah tinggal, bangunan komersial, gedung bertingkat hingga Gedung kesehatan. Kami hadir untuk menjadi mitra solusi aman membangun ruang impian bagi Anda. Kami siap bekerjasama dengan perorangan, instansi atau sektor lain dengan komitmen mutu dan transparansi penuh."
            align="left"
            class="why-choose-header mb-30"
          />

          <div class="row gy-4">
            <!-- Item 1: Tim Berkompeten -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:users-group-rounded-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Tim Berkompeten</h3>
                  <p class="about-item_text">Ditangani oleh tim yang berpengalaman dan bersertifikasi.</p>
                </div>
              </div>
            </div>

            <!-- Item 2: Bergaransi -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:shield-check-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Bergaransi</h3>
                  <p class="about-item_text">Setiap proyek terikat kontrak kerja resmi (SPK) dengan jaminan masa pemeliharaan terpercaya.</p>
                </div>
              </div>
            </div>

            <!-- Item 3: Lebih Rapi -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:ruler-cross-pen-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Lebih Rapi</h3>
                  <p class="about-item_text">Jaminan lebih rapi dalam setiap hasil pengerjaan dan ditangani oleh Tim berpengalaman sehingga selalu mendapatkan solusi dari setiap kendala yang ada.</p>
                </div>
              </div>
            </div>

            <!-- Item 4: Pemeliharaan Berkelanjutan -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:restart-circle-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Pemeliharaan Berkelanjutan</h3>
                  <p class="about-item_text">Menyediakan layanan pemeliharaan berkelanjutan pasca masa pemeliharaan selesai.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Vision, Mission & Core Values Section ==============================-->
  <VisionMissionSection />

  <!--============================== Live Projects Map Section ==============================-->
  <section class="coverage-sec space-bottom" id="proyek-berjalan">
    <div class="container">
      <SectionHeader
        badge="Proyek Berjalan"
        badgeIcon="solar:map-point-wave-bold"
        title="Peta Progres Proyek Lapangan"
        description="Pantau proyek konstruksi dan interior yang sedang dikerjakan oleh tim Bina Project secara real-time di berbagai lokasi."
        align="center"
      />

      <!-- Full-Width Clean Interactive Map Visual -->
      <div class="row">
        <div class="col-12">
          <div class="coverage-map-presentation-wrapper">
            <LiveProjectsMap client:only="react" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Process Section (The Architectural Stacking Deck) ==============================-->
  <ProcessSection />

  <!--============================== Our Team Section ==============================-->
  <TeamSection />

  <!--============================== Testimonials ==============================-->
  <TestimonialSection />

  <!--============================== Brand Partners ==============================-->
  <BrandMarquee />
</BaseLayout>

<style>
  /* Zero-CLS Aspect Ratio Reservation for About Hero Image */
  .img-box3 .img1 {
    aspect-ratio: 600 / 520;
    width: 100%;
    max-width: 600px;
    background-color: #f1f5f9;
    border-radius: 8px;
    overflow: hidden;
    will-change: transform;
  }

  .img-box3 .img1 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ========================================================
     Clean Architectural Process Flow (Restrained & Non-Slop)
     ======================================================== */
  .process-clean-sec {
    background-color: var(--bina-slate-50, #F8FAFC);
    border-top: 1px solid var(--bina-slate-200, #E2E8F0);
    border-bottom: 1px solid var(--bina-slate-200, #E2E8F0);
    position: relative;
    padding: 90px 0;
  }

  .process-clean-desc {
    max-width: 640px;
    color: #334155;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
  }

  :global(.why-choose-header .section-header__title) {
    font-size: clamp(1.25rem, 2.25vw, 2.15rem) !important;
  }
  @media (min-width: 576px) {
    :global(.why-choose-header .section-header__title) {
      white-space: nowrap !important;
    }
  }



  /* ========================================================
     Coverage Section & Architectural Map (Anti-AI Slop)
     ======================================================== */
  .coverage-sec {
    position: relative;
    padding-bottom: 90px;
    background-color: #FFFFFF;
  }

  .coverage-lead-desc {
    max-width: 680px;
    color: #334155;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
  }

  .coverage-map-presentation-wrapper {
    position: relative;
    width: 100%;
    min-height: 520px;
  }

  @media (max-width: 991px) {
    .coverage-sec {
      padding-bottom: 60px;
    }
    .coverage-map-presentation-wrapper {
      min-height: 440px;
    }
  }

  @media (max-width: 767px) {
    .coverage-map-presentation-wrapper {
      min-height: 400px;
    }
  }


  /* ========================================================
     Architectural Value Cards (Refined Solar Icons & Solid Box)
     ======================================================== */
  .about-item {
    background: #FFFFFF !important;
    border-radius: 14px;
    padding: 24px !important;
    box-shadow: 0 4px 20px rgba(34, 65, 109, 0.05);
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .about-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(34, 65, 109, 0.09);
  }
  .about-item_icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: rgba(34, 65, 109, 0.07);
    color: var(--bina-navy, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    transition: all 0.3s ease;
  }
  .about-item:hover .about-item_icon {
    background: var(--bina-navy, #22416D);
    color: #FFFFFF;
  }
  
  /* Samakan tinggi kolom - Flex basis equal */
  .row > [class*="col-lg-"], 
  .row > [class*="col-md-"] {
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  let aboutPageMatchMediaCtx: any = null;

  function initAboutPageScrollTrigger() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    // @ts-ignore
    const gsap = window.gsap;
    // @ts-ignore
    const ScrollTrigger = window.ScrollTrigger;

    if (!gsap || !ScrollTrigger) {
      let attempts = 0;
      const interval = setInterval(() => {
        attempts++;
        // @ts-ignore
        if (window.gsap && window.ScrollTrigger) {
          clearInterval(interval);
          initAboutPageScrollTrigger();
        } else if (attempts > 30) {
          clearInterval(interval);
        }
      }, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('#about-sec');
    if (!section) return;

    if (aboutPageMatchMediaCtx && typeof aboutPageMatchMediaCtx.revert === 'function') {
      aboutPageMatchMediaCtx.revert();
    }

    if (typeof gsap !== 'undefined' && typeof gsap.matchMedia === 'function') {
      aboutPageMatchMediaCtx = gsap.matchMedia();

      // Desktop (> 768px): Parallax Scrub + Stagger Reveal
      aboutPageMatchMediaCtx.add('(min-width: 769px)', () => {
      const imgBox = section.querySelector('.img-box3 .img1');
      if (imgBox) {
        gsap.to(imgBox, {
          yPercent: -12,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.2,
          },
        });
      }

      const headerEl = section.querySelector('.section-header');
      const items = section.querySelectorAll('.about-item');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      });

      if (headerEl) {
        tl.from(headerEl, {
          opacity: 0,
          y: 30,
          duration: 0.8,
          ease: 'power3.out',
        });
      }

      if (items.length) {
        tl.from(
          items,
          {
            opacity: 0,
            y: 25,
            stagger: 0.15,
            duration: 0.7,
            ease: 'power2.out',
          },
          '-=0.4'
        );
      }
    });

    // Mobile (<= 768px): Lightweight Reveal
    aboutPageMatchMediaCtx.add('(max-width: 768px)', () => {
      const imgBox = section.querySelector('.img-box3');
      const headerEl = section.querySelector('.section-header');
      const items = section.querySelectorAll('.about-item');

      const mobileTl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      });

      if (imgBox) {
        mobileTl.from(imgBox, {
          opacity: 0,
          y: 20,
          duration: 0.6,
          ease: 'power2.out',
        });
      }

      if (headerEl) {
        mobileTl.from(
          headerEl,
          {
            opacity: 0,
            y: 20,
            duration: 0.6,
            ease: 'power2.out',
          },
          '-=0.3'
        );
      }

      if (items.length) {
        mobileTl.from(
          items,
          {
            opacity: 0,
            y: 16,
            stagger: 0.12,
            duration: 0.5,
            ease: 'power2.out',
          },
          '-=0.2'
        );
      }
    });
  }
}

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAboutPageScrollTrigger();
  } else {
    window.addEventListener('DOMContentLoaded', initAboutPageScrollTrigger);
  }
  document.addEventListener('astro:page-load', initAboutPageScrollTrigger);
</script>
