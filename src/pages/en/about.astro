---
/**
 * @file about.astro (English)
 * @description English About Us page for Bina Project Construction & Interior
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import aboutImg3 from '@assets/images/normal/about_3.jpg';
import LiveProjectsMap from '@components/LiveProjectsMap';
import SectionHeader from '@components/SectionHeader.astro';
import ProcessSection from '@components/sections/ProcessSection.astro';
import VisionMissionSection from '@components/VisionMissionSection.astro';
import TeamSection from '@components/TeamSection.astro';
import TestimonialSection from '@components/TestimonialSection.astro';
import BrandMarquee from '@components/BrandMarquee.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout
  lang="en"
  title={`${t('about.title')} - ${t('site.name')}`}
  description={t('about.subtitle')}
>
  <Breadcrumb title={t('nav.about')} />

  <!--============================== About Area ==============================-->
  <div class="overflow-hidden space" id="about-sec">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-xl-6">
          <div class="img-box3">
            <div class="img1">
              <Image
                src={aboutImg3}
                alt="Bina Project Architects and Construction Engineering Team Malang"
                loading="lazy"
                decoding="async"
                width={600}
                height={520}
                format="webp"
                quality={85}
              />
            </div>
          </div>
        </div>
        <div class="col-xl-6">
          <SectionHeader
            badge="Why Choose Bina Project?"
            badgeIcon="solar:buildings-2-bold"
            title="Why Choose Bina Project?"
            description={[
              "Bina Project is a professional company specializing in design planning services, interior contracting, construction contracting, and waterproofing with warranty covering residential homes, commercial buildings, and multi-story structures.",
              "We are here to be your trusted partner in safely building your dream spaces. We are ready to collaborate with individuals, institutions, or other sectors with full commitment and responsibility."
            ]}
            align="left"
            class="why-choose-header mb-30"
          />

          <div class="row gy-4">
            <!-- Item 1: Qualified Team -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:users-group-rounded-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Qualified Team</h3>
                  <p class="about-item_text">Handled by experienced and certified professionals.</p>
                </div>
              </div>
            </div>

            <!-- Item 2: Warrantied Work -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:shield-check-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Warrantied Work</h3>
                  <p class="about-item_text">Every project is bound by official work contracts (SPK) with trusted maintenance period guarantees.</p>
                </div>
              </div>
            </div>

            <!-- Item 3: Neater Workmanship -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:ruler-cross-pen-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Neater Workmanship</h3>
                  <p class="about-item_text">Commitment to neat workmanship handled by experienced teams ensuring reliable solutions to any challenges that arise.</p>
                </div>
              </div>
            </div>

            <!-- Item 4: Continuous Maintenance -->
            <div class="col-lg-6 col-md-6">
              <div class="about-item">
                <div class="about-item_icon">
                  <Icon name="solar:restart-circle-bold" width="30" height="30" />
                </div>
                <div class="about-item_centent">
                  <h3 class="box-title">Continuous Maintenance</h3>
                  <p class="about-item_text">Provision of ongoing maintenance services even after the warranty period has concluded.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Vision, Mission & Core Values Section ==============================-->
  <VisionMissionSection />

  <!--============================== Live Projects Map Section ==============================-->
  <section class="coverage-sec space" id="proyek-berjalan">
    <div class="container">
      <SectionHeader
        badge="Live On-Going Projects"
        badgeIcon="solar:map-point-wave-bold"
        title="Field Project Progress Map"
        description="Monitor active construction and interior projects managed by Bina Project in real-time across various locations."
        align="center"
      />

      <!-- Full-Width Clean Interactive Map Visual -->
      <div class="row">
        <div class="col-12">
          <div class="coverage-map-presentation-wrapper">
            <LiveProjectsMap client:only="react" lang="en" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Process Section (The Architectural Stacking Deck) ==============================-->
  <ProcessSection />

  <!--============================== Our Team Section ==============================-->
  <TeamSection />

  <!--============================== Testimonials ==============================-->
  <TestimonialSection bg="slate" />

  <!--============================== Brand Partners ==============================-->
  <BrandMarquee bg="white" />
</BaseLayout>

<style>

  :global(.why-choose-header .section-header__title) {
    font-size: clamp(1.25rem, 2.25vw, 2.15rem) !important;
  }
  @media (min-width: 576px) {
    :global(.why-choose-header .section-header__title) {
      white-space: nowrap !important;
    }
  }

  .img-box3 .img1 {
    aspect-ratio: 600 / 520;
    width: 100%;
    max-width: 600px;
    background-color: #f1f5f9;
    border-radius: 8px;
    overflow: hidden;
    will-change: transform;
  }
  .img-box3 .img1 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  let enAboutPageMatchMediaCtx: any = null;

  function initEnAboutPageScrollTrigger() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    // @ts-ignore
    const gsap = window.gsap;
    // @ts-ignore
    const ScrollTrigger = window.ScrollTrigger;

    if (!gsap || !ScrollTrigger) {
      let attempts = 0;
      const interval = setInterval(() => {
        attempts++;
        // @ts-ignore
        if (window.gsap && window.ScrollTrigger) {
          clearInterval(interval);
          initEnAboutPageScrollTrigger();
        } else if (attempts > 30) {
          clearInterval(interval);
        }
      }, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector('#about-sec');
    if (!section) return;

    if (enAboutPageMatchMediaCtx && typeof enAboutPageMatchMediaCtx.revert === 'function') {
      enAboutPageMatchMediaCtx.revert();
    }

    if (typeof gsap !== 'undefined' && typeof gsap.matchMedia === 'function') {
      enAboutPageMatchMediaCtx = gsap.matchMedia();

      // Desktop (> 768px): Parallax Scrub + Stagger Reveal
      enAboutPageMatchMediaCtx.add('(min-width: 769px)', () => {
      const imgBox = section.querySelector('.img-box3 .img1');
      if (imgBox) {
        gsap.to(imgBox, {
          yPercent: -12,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.2,
          },
        });
      }

      const headerEl = section.querySelector('.section-header');
      const items = section.querySelectorAll('.about-item');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          toggleActions: 'play none none none',
        },
      });

      if (headerEl) {
        tl.from(headerEl, {
          opacity: 0,
          y: 30,
          duration: 0.8,
          ease: 'power3.out',
        });
      }

      if (items.length) {
        tl.from(
          items,
          {
            opacity: 0,
            y: 25,
            stagger: 0.15,
            duration: 0.7,
            ease: 'power2.out',
          },
          '-=0.4'
        );
      }
    });

    // Mobile (<= 768px): Lightweight Reveal
    enAboutPageMatchMediaCtx.add('(max-width: 768px)', () => {
      const imgBox = section.querySelector('.img-box3');
      const headerEl = section.querySelector('.section-header');
      const items = section.querySelectorAll('.about-item');

      const mobileTl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      });

      if (imgBox) {
        mobileTl.from(imgBox, {
          opacity: 0,
          y: 20,
          duration: 0.6,
          ease: 'power2.out',
        });
      }

      if (headerEl) {
        mobileTl.from(
          headerEl,
          {
            opacity: 0,
            y: 20,
            duration: 0.6,
            ease: 'power2.out',
          },
          '-=0.3'
        );
      }

      if (items.length) {
        mobileTl.from(
          items,
          {
            opacity: 0,
            y: 16,
            stagger: 0.12,
            duration: 0.5,
            ease: 'power2.out',
          },
          '-=0.2'
        );
      }
    });
  }
}

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initEnAboutPageScrollTrigger();
  } else {
    window.addEventListener('DOMContentLoaded', initEnAboutPageScrollTrigger);
  }
  document.addEventListener('astro:page-load', initEnAboutPageScrollTrigger);
</script>
