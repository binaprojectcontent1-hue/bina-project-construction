---
/**
 * @file index.astro (English Portfolio)
 * @description English Portfolio Listing for Bina Project Construction & Interior
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { getAllProjects } from '@lib/portfolioService';
import SectionHeader from '@components/SectionHeader.astro';
import EmptyState from '@components/EmptyState.astro';
import { Icon } from 'astro-icon/components';

import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const projects = await getAllProjects();

// Live project counts computed directly from database
const totalCount = projects.length;
const interiorCount = projects.filter((p) => {
  const c = (p.category || '').toLowerCase();
  const t = (p.title || '').toLowerCase();
  return c.includes('interior') || t.includes('interior') || c.includes('kitchen') || t.includes('kitchen') || c.includes('dapur') || t.includes('dapur');
}).length;
const eksteriorCount = projects.filter((p) => {
  const c = (p.category || '').toLowerCase();
  const t = (p.title || '').toLowerCase();
  return c.includes('eksterior') || t.includes('eksterior');
}).length;
const konstruksiCount = projects.filter((p) => {
  const c = (p.category || '').toLowerCase();
  const t = (p.title || '').toLowerCase();
  const isEks = c.includes('eksterior') || t.includes('eksterior');
  const isInt = c.includes('interior') || t.includes('interior') || c.includes('kitchen') || t.includes('kitchen') || c.includes('dapur') || t.includes('dapur');
  const isKon = c.includes('konstruksi') || t.includes('konstruksi');
  return isKon || (!isEks && !isInt);
}).length;
---

<BaseLayout
  lang="en"
  title={`${t('portfolio.title')} - ${t('site.name')}`}
  description={t('portfolio.subtitle')}
>
  <Breadcrumb title={t('nav.portfolio')} />

  <section class="space">
    <div class="container-fluid portfolio-fluid-container">
      <SectionHeader
        badge="Completed Client Works"
        badgeIcon="solar:gallery-wide-bold"
        title="Our Architectural Portfolio"
        description="Photographic records of residential buildings, structural renovations, custom interiors, and bespoke furniture crafted with the highest standards."
        align="center"
      />

      <!-- Architectural Segmented Island Filter Dock -->
      <div class="filter-dock-wrapper">
        <nav class="filter-dock filter-menu style2 indicator-active filter-menu-active" aria-label="Portfolio Category Filter">
          <button data-filter="*" class="filter-tab-pill tab-btn active" type="button">
            <Icon name="solar:widget-linear" width="16" height="16" class="tab-icon" />
            <span class="tab-label">All Works</span>
            <span class="tab-badge">{totalCount}</span>
          </button>
          
          <button data-filter=".cat2" class="filter-tab-pill tab-btn" type="button">
            <Icon name="solar:armchair-linear" width="16" height="16" class="tab-icon" />
            <span class="tab-label">Interior</span>
            <span class="tab-badge">{interiorCount}</span>
          </button>

          <button data-filter=".cat3" class="filter-tab-pill tab-btn" type="button">
            <Icon name="solar:buildings-2-linear" width="16" height="16" class="tab-icon" />
            <span class="tab-label">Construction</span>
            <span class="tab-badge">{konstruksiCount}</span>
          </button>

          <button data-filter=".cat1" class="filter-tab-pill tab-btn" type="button">
            <Icon name="solar:home-smile-linear" width="16" height="16" class="tab-icon" />
            <span class="tab-label">Exterior</span>
            <span class="tab-badge">{eksteriorCount}</span>
          </button>
        </nav>
      </div>

      {projects.length > 0 ? (
        <div class="row gallery-row filter-active gy-4 gx-4">
          {projects.map((project, index) => (
            <ProjectCard
              project={project}
              colClass="col-12 col-md-6 col-lg-4 filter-item"
              priority={index < 3}
              loading={index < 3 ? 'eager' : 'lazy'}
              lang="en"
            />
          ))}
        </div>
      ) : (
        <EmptyState
          icon="solar:gallery-wide-linear"
          title="No Portfolio Items Displayed"
          description="Documentation of our latest architectural construction and interior projects is currently being curated and uploaded by our editorial team."
          primaryActionText="Consult Your Project"
          primaryActionHref="/en/contact"
        />
      )}
    </div>
  </section>

  <!-- CTA Area -->
  <section class="cta-area2" data-overlay="title" data-opacity="9" data-bg-src="/assets/img/bg/cta_bg_1.jpg">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-8 mb-30 mb-lg-0">
          <h2 class="cta-title text-white">
            Have a Specific Architectural Vision?
          </h2>
          <p class="cta-text text-white-50 mb-0">
            Consult your building concept, floor plan requirements, and cost estimates directly with Bina Project's lead architects.
          </p>
        </div>
        <div class="col-lg-4 text-lg-end">
          <a href="/en/contact" class="th-btn style1">
            Free Consultation <Icon name="solar:arrow-right-up-linear" width="18" height="18" class="ms-2" />
          </a>
        </div>
      </div>
    </div>
  <!-- Native Responsive Category Filter Engine (Zero Dependency, Zero Jitter) -->
  <script is:inline>
    (function () {
      function initPortfolioFilter() {
        var tabButtons = document.querySelectorAll('.filter-tab-pill');
        var items = document.querySelectorAll('.gallery-row .filter-item');
        if (!tabButtons.length || !items.length) return;

        tabButtons.forEach(function (tab) {
          if (tab._hasFilterHandler) return;
          tab._hasFilterHandler = true;

          tab.addEventListener('click', function (e) {
            e.preventDefault();
            var filter = tab.getAttribute('data-filter') || '*';

            tabButtons.forEach(function (btn) {
              btn.classList.remove('active');
            });
            tab.classList.add('active');

            items.forEach(function (item) {
              if (filter === '*' || item.matches(filter)) {
                item.style.display = '';
              } else {
                item.style.display = 'none';
              }
            });
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPortfolioFilter);
      } else {
        initPortfolioFilter();
      }
      document.addEventListener('astro:page-load', initPortfolioFilter);
    })();
  </script>
</BaseLayout>

<style>
  .portfolio-fluid-container {
    max-width: 1440px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .filter-dock-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 40px;
  }
  .filter-dock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    padding: 6px;
    border-radius: 9999px;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
    border: 1px solid #E2E8F0;
  }
  .filter-tab-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #64748B;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-tab-pill:hover {
    color: #0F172A;
    background: #F8FAFC;
  }
  .filter-tab-pill.active {
    background: #183158;
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(24, 49, 88, 0.25);
  }
  .tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.06);
    font-size: 11px;
    font-weight: 800;
  }
  .filter-tab-pill.active .tab-badge {
    background: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
  }
</style>
