---
/**
 * @file contact.astro (English)
 * @description English Contact Us page for Bina Project Construction & Interior
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { getSiteSettings } from '@lib/siteSettingsService';
import { Icon } from 'astro-icon/components';

import { getLangFromUrl, useTranslations } from '@i18n/utils';

const siteConfig = await getSiteSettings();
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout
  lang="en"
  title={`${t('contact.title')} - ${t('site.name')}`}
  description={t('contact.subtitle')}
>
  <Breadcrumb title={t('nav.contact')} />

  <!--============================== Bento Contact Cards Grid ==============================-->
  <section class="space-top space-extra-bottom">
    <div class="container">
      <SectionHeader
        badge="Official Contact Information"
        badgeIcon="solar:user-id-bold"
        title="Get to Know Us Better"
        description="We are ready to be a safe solution partner in building your dream spaces"
        align="center"
      />

      <div class="row gy-4">
        <!-- Card 1: WhatsApp Inquiry -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="simple-icons:whatsapp" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Free Consultation & Collaboration</h3>
            <p class="contact-bento-desc">
              Responsive service for free consultation<br/>
              and B2B collaboration through<br/>
              Official WhatsApp of Bina Project Team
            </p>
            <div class="contact-bento-footer mt-auto">
              <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-bento-action">
                <span>{siteConfig.contact.phoneDisplay} (Chat Only)</span>
                <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
              </a>
            </div>
          </div>
        </div>

        <!-- Card 2: Official Email -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:letter-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Email</h3>
            <p class="contact-bento-desc">
              Send project supporting documents<br/>
              to Bina Project Team
            </p>
            <div class="contact-bento-footer mt-auto">
              <a href={`mailto:${siteConfig.contact.email}`} class="contact-bento-action">
                <span>{siteConfig.contact.email}</span>
                <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
              </a>
            </div>
          </div>
        </div>

        <!-- Card 3: Business Hours -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:clock-circle-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Business Hours</h3>
            <div class="contact-schedule-list">
              <div class="schedule-item">
                <span class="schedule-days">Monday – Saturday:</span>
                <span class="schedule-hours">08:00 – 16:00 WIB</span>
              </div>
              <div class="schedule-item holiday">
                <span class="schedule-days">Sunday / Public Holidays:</span>
                <span class="schedule-hours">Closed</span>
              </div>
            </div>
            <div class="contact-bento-footer mt-auto">
              <span class="contact-status-chip is-open" id="operational-status-chip" title="Business Hours: Monday – Saturday, 08:00 – 16:00 WIB">
                <Icon name="solar:check-circle-bold" width="15" height="15" class="me-1 status-icon status-icon-open" />
                <Icon name="solar:close-circle-bold" width="15" height="15" class="me-1 status-icon status-icon-closed" />
                <span id="operational-status-text">Open</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Office Location & Interactive Map ==============================-->
  <section class="space-bottom overflow-hidden">
    <div class="container">
      <div class="contact-map-wrapper">
        <div class="map-header">
          <div class="d-flex align-items-center">
            <div class="map-header-icon me-3">
              <Icon name="solar:map-point-wave-linear" width="22" height="22" />
            </div>
            <div>
              <h3 class="map-title mb-0">Office Location</h3>
              <p class="map-subtitle mb-0">{siteConfig.contact.city}, {siteConfig.contact.province}</p>
            </div>
          </div>
          <a href={siteConfig.contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="th-btn style1 map-direction-btn">
            Get Directions <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
          </a>
        </div>
        <div class="map-container">
          <iframe
            src={siteConfig.contact.googleMapsEmbedUrl}
            width="100%"
            height="100%"
            style="border:0; min-height: 450px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Google Maps Location ${siteConfig.name}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .map-direction-btn {
    font-size: 13px;
    border-radius: 8px;
    min-height: 48px;
    padding: 12px 18px;
    display: inline-flex;
    align-items: center;
  }
  .contact-bento-card {
    background: #FFFFFF;
    border-radius: 1.25rem;
    padding: 1.75rem 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.05);
    transition: all 0.3s ease;
  }
  .contact-bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(24, 49, 88, 0.12);
    border-color: #CBD5E1;
  }
  .contact-bento-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #F1F5F9;
    color: #183158;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: all 0.3s ease;
  }
  .contact-bento-card:hover .contact-bento-icon {
    background: #183158;
    color: #FFFFFF;
  }
  .contact-bento-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 0.5rem;
  }
  .contact-bento-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #64748B;
    margin-bottom: 22px;
    flex-grow: 1;
  }
  .contact-bento-action {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 700;
    color: #183158;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .contact-bento-action:hover {
    color: #D97706;
  }
  .contact-status-chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: #ECFDF5;
    color: #059669;
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 20px;
    font-size: 12.5px;
    font-weight: 600;
    transition: all 0.25s ease;
  }

  .contact-status-chip.is-open {
    background: #ECFDF5;
    color: #059669;
    border-color: rgba(16, 185, 129, 0.25);
  }

  .contact-status-chip.is-open .status-icon-open {
    display: inline-block;
    color: #10B981;
  }

  .contact-status-chip.is-open .status-icon-closed {
    display: none;
  }

  .contact-status-chip.is-closed {
    background: #FEF2F2;
    color: #DC2626;
    border-color: rgba(239, 68, 68, 0.25);
  }

  .contact-status-chip.is-closed .status-icon-open {
    display: none;
  }

  .contact-status-chip.is-closed .status-icon-closed {
    display: inline-block;
    color: #EF4444;
  }
  .contact-schedule-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }
  .schedule-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13.5px;
    padding-bottom: 8px;
    border-bottom: 1px dashed #E2E8F0;
  }
  .schedule-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .schedule-days {
    color: #64748B;
    font-weight: 500;
  }
  .schedule-hours {
    color: #0F172A;
    font-weight: 600;
  }
  .schedule-item.holiday .schedule-hours {
    color: #DC2626;
  }
  .contact-map-wrapper {
    background: #FFFFFF;
    border: none;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 30px rgba(34, 65, 109, 0.06);
  }
  .map-header {
    padding: 22px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #FFFFFF;
    border-bottom: 1px solid #F1F5F9;
  }
  .map-header-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #EFF6FF;
    color: var(--theme-color, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  .map-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--title-color, #17202A);
  }
  .map-subtitle {
    font-size: 14px;
    color: #334155;
  }
  .map-container {
    flex-grow: 1;
    height: 100%;
    min-height: 450px;
    position: relative;
  }
  .map-container iframe {
    width: 100%;
    height: 100%;
    min-height: 450px;
    border: 0;
    display: block;
  }
  @media (max-width: 767px) {
    .map-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 20px;
    }
  }
  @media (max-width: 575px) {
    .map-direction-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  function updateOperationalStatus() {
    const chip = document.getElementById('operational-status-chip');
    const text = document.getElementById('operational-status-text');
    if (!chip || !text) return;

    let isSunday = false;
    let isWorkDay = false;
    let isOpenHours = false;

    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Jakarta',
        hour12: false,
        weekday: 'short',
        hour: 'numeric',
        minute: 'numeric'
      });
      const parts = formatter.formatToParts(now);
      let weekday = '';
      let hour = 0;
      let minute = 0;
      for (const p of parts) {
        if (p.type === 'weekday') weekday = p.value;
        if (p.type === 'hour') hour = parseInt(p.value, 10);
        if (p.type === 'minute') minute = parseInt(p.value, 10);
      }
      if (hour === 24) hour = 0;

      isSunday = (weekday === 'Sun');
      isWorkDay = !isSunday;
      const totalMinutes = hour * 60 + minute;
      isOpenHours = totalMinutes >= (8 * 60) && totalMinutes < (16 * 60);
    } catch (e) {
      const now = new Date();
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const wib = new Date(utc + (7 * 3600000));
      const day = wib.getDay();
      const hour = wib.getHours();
      const minute = wib.getMinutes();

      isSunday = (day === 0);
      isWorkDay = (day >= 1 && day <= 6);
      const totalMinutes = hour * 60 + minute;
      isOpenHours = totalMinutes >= (8 * 60) && totalMinutes < (16 * 60);
    }

    const isOpen = isWorkDay && isOpenHours;
    const isEn = document.documentElement.lang === 'en' || window.location.pathname.startsWith('/en');

    if (isOpen) {
      chip.classList.remove('is-closed');
      chip.classList.add('is-open');
      text.textContent = isEn ? 'Open' : 'Buka';
    } else {
      chip.classList.remove('is-open');
      chip.classList.add('is-closed');
      text.textContent = isEn ? 'Closed' : 'Tutup';
    }
  }

  updateOperationalStatus();
  document.addEventListener('DOMContentLoaded', updateOperationalStatus);
  document.addEventListener('astro:page-load', updateOperationalStatus);
  setInterval(updateOperationalStatus, 30000);
</script>
