---
/**
 * @file contact.astro (English)
 * @description English Contact Us page for Bina Project Construction & Interior
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { getSiteSettings } from '@lib/siteSettingsService';
import { Icon } from 'astro-icon/components';

const siteConfig = await getSiteSettings();
---

<BaseLayout
  lang="en"
  title={`Contact Us - ${siteConfig.name} Studio`}
  description="Contact Bina Project architects and structural contractors for free consultation on residential building, architectural renovation, bespoke interior design, and kitchen sets in Malang and East Java."
>
  <Breadcrumb title="Contact Us" />

  <!--============================== Bento Contact Cards Grid ==============================-->
  <section class="space-top space-extra-bottom">
    <div class="container">
      <SectionHeader
        badge="Official Contact Information"
        badgeIcon="solar:user-id-bold"
        title="Connect With Our Studio"
        description="Our team of licensed architects and structural engineering specialists is ready to assist your building plans with the highest standards of craftsmanship."
        align="center"
      />

      <div class="row gy-4">
        <!-- Card 1: WhatsApp Consultation -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="simple-icons:whatsapp" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">WhatsApp Inquiry</h3>
            <p class="contact-bento-desc">
              Rapid response channel for project discussions, preliminary cost estimation, and on-site survey bookings.
            </p>
            <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-bento-action">
              {siteConfig.contact.phoneDisplay} <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
            </a>
          </div>
        </div>

        <!-- Card 2: Official Email -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:letter-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Email</h3>
            <p class="contact-bento-desc">
              Submit your project brief, floor plans, or tender documentation directly to our management team.
            </p>
            <a href={`mailto:${siteConfig.contact.email}`} class="contact-bento-action">
              {siteConfig.contact.email} <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
            </a>
          </div>
        </div>

        <!-- Card 3: Operating Hours -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:clock-circle-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Business Hours</h3>
            <p class="contact-bento-desc mb-2">
              Monday - Saturday: 08:00 - 16:00 WIB<br />Sunday & Holidays: Closed
            </p>
            <span class="contact-status-badge">
              <span class="status-indicator"></span> Active Studio
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Office Location & Interactive Map ==============================-->
  <section class="space-bottom overflow-hidden">
    <div class="container">
      <div class="contact-map-wrapper">
        <div class="map-header">
          <div class="d-flex align-items-center">
            <div class="map-header-icon me-3">
              <Icon name="solar:map-point-wave-linear" width="22" height="22" />
            </div>
            <div>
              <h3 class="map-title mb-0">Office Location</h3>
              <p class="map-subtitle mb-0">{siteConfig.contact.city}, {siteConfig.contact.province}</p>
            </div>
          </div>
          <a href={siteConfig.contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="th-btn style1 map-direction-btn">
            Get Directions <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
          </a>
        </div>
        <div class="map-container">
          <iframe
            src={siteConfig.contact.googleMapsEmbedUrl}
            width="100%"
            height="100%"
            style="border:0; min-height: 450px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Google Maps Location ${siteConfig.name}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .map-direction-btn {
    font-size: 13px;
    border-radius: 8px;
    min-height: 48px;
    padding: 12px 18px;
    display: inline-flex;
    align-items: center;
  }
  .contact-bento-card {
    background: #FFFFFF;
    border-radius: 1.25rem;
    padding: 1.75rem 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.05);
    transition: all 0.3s ease;
  }
  .contact-bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(24, 49, 88, 0.12);
    border-color: #CBD5E1;
  }
  .contact-bento-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #F1F5F9;
    color: #183158;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: all 0.3s ease;
  }
  .contact-bento-card:hover .contact-bento-icon {
    background: #183158;
    color: #FFFFFF;
  }
  .contact-bento-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 0.5rem;
  }
  .contact-bento-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #64748B;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .contact-bento-action {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 700;
    color: #183158;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .contact-bento-action:hover {
    color: #D97706;
  }
  .contact-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    background: #ECFDF5;
    color: #059669;
    font-size: 0.75rem;
    font-weight: 700;
    width: fit-content;
  }
  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
  }
  .contact-map-wrapper {
    background: #FFFFFF;
    border: none;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 30px rgba(34, 65, 109, 0.06);
  }
  .map-header {
    padding: 22px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #FFFFFF;
    border-bottom: 1px solid #F1F5F9;
  }
  .map-header-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #EFF6FF;
    color: var(--theme-color, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  .map-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--title-color, #17202A);
  }
  .map-subtitle {
    font-size: 14px;
    color: #334155;
  }
  .map-container {
    flex-grow: 1;
    height: 100%;
    min-height: 450px;
    position: relative;
  }
  .map-container iframe {
    width: 100%;
    height: 100%;
    min-height: 450px;
    border: 0;
    display: block;
  }
  @media (max-width: 767px) {
    .map-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 20px;
    }
  }
  @media (max-width: 575px) {
    .map-direction-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
