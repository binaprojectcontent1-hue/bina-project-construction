---
/**
 * @file contact.astro (English)
 * @description English Contact Us page for Bina Project Construction & Interior
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ContactForm from '@components/ContactForm.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { siteConfig } from '@config/site';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  lang="en"
  title={`Contact Us - ${siteConfig.name} Studio`}
  description="Contact Bina Project architects and structural contractors for free consultation on residential building, architectural renovation, bespoke interior design, and kitchen sets in Malang and East Java."
>
  <Breadcrumb title="Contact Us" />

  <!--============================== Bento Contact Cards Grid ==============================-->
  <section class="space-top space-extra-bottom">
    <div class="container">
      <SectionHeader
        badge="Official Contact Information"
        badgeIcon="solar:user-id-bold"
        title="Connect With Our Studio"
        description="Our team of licensed architects and structural engineering specialists is ready to assist your building plans with the highest standards of craftsmanship."
        align="center"
      />

      <div class="row gy-4">
        <!-- Card 1: Studio & Office -->
        <div class="col-xl-3 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:map-point-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Studio & Office</h3>
            <p class="contact-bento-desc">
              {siteConfig.contact.address}
            </p>
            <a href={siteConfig.contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="contact-bento-action">
              Google Maps Route <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
            </a>
          </div>
        </div>

        <!-- Card 2: WhatsApp Consultation -->
        <div class="col-xl-3 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="simple-icons:whatsapp" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">WhatsApp Inquiry</h3>
            <p class="contact-bento-desc">
              Rapid response channel for project discussions, preliminary cost estimation, and on-site survey bookings.
            </p>
            <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-bento-action">
              {siteConfig.contact.phoneDisplay} <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
            </a>
          </div>
        </div>

        <!-- Card 3: Official Email -->
        <div class="col-xl-3 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:letter-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Official Email</h3>
            <p class="contact-bento-desc">
              Submit your project brief, floor plans, or tender documentation directly to our management team.
            </p>
            <a href={`mailto:${siteConfig.contact.email}`} class="contact-bento-action">
              {siteConfig.contact.email} <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
            </a>
          </div>
        </div>

        <!-- Card 4: Operating Hours -->
        <div class="col-xl-3 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:clock-circle-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Business Hours</h3>
            <p class="contact-bento-desc mb-2">
              Monday - Saturday: 08:00 - 16:00 WIB<br />Sunday & Holidays: By Appointment
            </p>
            <span class="contact-status-badge">
              <span class="status-indicator"></span> Active Studio
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Split Section: Consultation Form & Map ==============================-->
  <section class="space-bottom overflow-hidden">
    <div class="container">
      <div class="row gy-5 align-items-stretch">
        <!-- Form Left Column -->
        <div class="col-lg-6">
          <div class="contact-form-glass-container h-100 d-flex flex-column justify-content-center">
            <div class="mb-4">
              <span class="contact-form-badge">
                <Icon name="solar:chat-round-dots-bold" width="14" height="14" class="me-1" /> Direct Consultation Form
              </span>
              <h2 class="contact-form-title">Send Your Project Details</h2>
              <p class="contact-form-subtitle">
                Fill in your project requirements below. Our lead architects will prepare a preliminary plan and contact you promptly.
              </p>
            </div>
            <ContactForm lang="en" />
          </div>
        </div>

        <!-- Map Right Column -->
        <div class="col-lg-6">
          <div class="contact-map-wrapper h-100">
            <div class="map-overlay-badge">
              <div class="d-flex align-items-center gap-2">
                <div class="pulse-point"></div>
                <div>
                  <h4 class="mb-0 text-white" style="font-size: 14px; font-weight: 700;">Studio Bina Project</h4>
                  <p class="mb-0 text-white-50" style="font-size: 12px;">Kota Malang, Jawa Timur</p>
                </div>
              </div>
            </div>
            <iframe
              src={siteConfig.contact.googleMapsEmbedUrl}
              width="100%"
              height="100%"
              style="border:0; min-height: 480px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Bina Project Office Map"
              class="contact-map-iframe"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-bento-card {
    background: #FFFFFF;
    border-radius: 1.25rem;
    padding: 1.75rem 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #E2E8F0;
    box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.05);
    transition: all 0.3s ease;
  }
  .contact-bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(24, 49, 88, 0.12);
    border-color: #CBD5E1;
  }
  .contact-bento-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #F1F5F9;
    color: #183158;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: all 0.3s ease;
  }
  .contact-bento-card:hover .contact-bento-icon {
    background: #183158;
    color: #FFFFFF;
  }
  .contact-bento-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 0.5rem;
  }
  .contact-bento-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #64748B;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .contact-bento-action {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 700;
    color: #183158;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .contact-bento-action:hover {
    color: #D97706;
  }
  .contact-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    background: #ECFDF5;
    color: #059669;
    font-size: 0.75rem;
    font-weight: 700;
    width: fit-content;
  }
  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
  }
  .contact-form-glass-container {
    background: #FFFFFF;
    border-radius: 1.5rem;
    padding: 2.5rem;
    border: 1px solid #E2E8F0;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
  }
  .contact-form-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 9999px;
    background: #F1F5F9;
    color: #183158;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .contact-form-title {
    font-size: clamp(22px, 2.5vw, 28px);
    font-weight: 800;
    color: #0F172A;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .contact-form-subtitle {
    font-size: 14px;
    color: #64748B;
    line-height: 1.6;
    margin-bottom: 0;
  }
  .contact-map-wrapper {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.06);
    border: 1px solid #E2E8F0;
  }
  .contact-map-iframe {
    width: 100%;
    height: 100%;
    min-height: 520px;
    border: none;
    display: block;
  }
  .map-overlay-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    background: rgba(14, 30, 56, 0.9);
    backdrop-filter: blur(8px);
    padding: 0.75rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }
  .pulse-point {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #F59E0B;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.3);
  }
  @media (max-width: 767px) {
    .contact-form-glass-container {
      padding: 1.5rem;
    }
  }
</style>
