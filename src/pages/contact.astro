---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { getSiteSettings } from '@lib/siteSettingsService';
import { Icon } from 'astro-icon/components';

import { getLangFromUrl, useTranslations } from '@i18n/utils';

const siteConfig = await getSiteSettings();
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<BaseLayout
  title={`${t('contact.title')} - ${t('site.name')}`}
  description={t('contact.subtitle')}
>
  <Breadcrumb title={t('nav.contact')} />

  <!--============================== Bento Contact Cards Grid ==============================-->
  <section class="space-top space-extra-bottom">
    <div class="container">
      <SectionHeader
        badge="Informasi Kontak Resmi"
        badgeIcon="solar:user-id-bold"
        title="Kenali Kami Lebih Dekat"
        description="Kami siap menjadi mitra solusi aman dalam membangun ruang impian Anda"
        align="center"
      />

      <div class="row gy-4">
        <!-- Card 1: Konsultasi Gratis & Kerjasama -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="simple-icons:whatsapp" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Konsultasi Gratis & Kerjasama</h3>
            <p class="contact-bento-desc">
              Layanan respon untuk konsultasi secara<br/>
              gratis dan kerjasama B2B melalui<br/>
              WhatsApp resmi Tim Bina Project
            </p>
            <div class="contact-bento-footer mt-auto">
              <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-bento-action">
                <span>{siteConfig.contact.phoneDisplay} (Chat Only)</span>
                <Icon name="solar:arrow-right-up-linear" width="15" height="15" class="ms-1" />
              </a>
            </div>
          </div>
        </div>

        <!-- Card 2: Email -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:letter-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Email</h3>
            <p class="contact-bento-desc">
              Kirimkan dokumen pendukung rencana<br/>
              Proyek Anda kepada Tim Bina Project
            </p>
            <div class="contact-bento-footer mt-auto">
              <a href={`mailto:${siteConfig.contact.email}`} class="contact-bento-action">
                <span>{siteConfig.contact.email}</span>
                <Icon name="solar:arrow-right-up-linear" width="15" height="15" class="ms-1" />
              </a>
            </div>
          </div>
        </div>

        <!-- Card 3: Jam Operasional -->
        <div class="col-lg-4 col-md-6">
          <div class="contact-bento-card">
            <div class="contact-bento-icon">
              <Icon name="solar:clock-circle-linear" width="24" height="24" />
            </div>
            <h3 class="contact-bento-title">Jam Operasional</h3>
            <div class="contact-schedule-list">
              <div class="schedule-item">
                <span class="schedule-days">Hari Senin – Sabtu:</span>
                <span class="schedule-hours">08:00 – 16:00 WIB</span>
              </div>
              <div class="schedule-item holiday">
                <span class="schedule-days">Hari Minggu / Tanggal Merah:</span>
                <span class="schedule-hours">Libur</span>
              </div>
            </div>
            <div class="contact-bento-footer mt-auto">
              <span class="contact-status-chip is-open" id="operational-status-chip" title="Jam Operasional: Senin – Sabtu, 08:00 – 16:00 WIB">
                <Icon name="solar:check-circle-bold" width="15" height="15" class="me-1 status-icon status-icon-open" />
                <Icon name="solar:close-circle-bold" width="15" height="15" class="me-1 status-icon status-icon-closed" />
                <span id="operational-status-text">Buka</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Lokasi Kantor & Peta Interaktif ==============================-->
  <section class="space-bottom overflow-hidden">
    <div class="container">
      <div class="contact-map-wrapper">
        <div class="map-header">
          <div class="d-flex align-items-center">
            <div class="map-header-icon me-3">
              <Icon name="solar:map-point-wave-linear" width="22" height="22" />
            </div>
            <div>
              <h3 class="map-title mb-0">Lokasi Kantor</h3>
              <p class="map-subtitle mb-0">{siteConfig.contact.city}, {siteConfig.contact.province}</p>
            </div>
          </div>
          <a href={siteConfig.contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="th-btn style1 map-direction-btn">
            Petunjuk Arah <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="ms-1" />
          </a>
        </div>
        <div class="map-container">
          <iframe
            src={siteConfig.contact.googleMapsEmbedUrl}
            width="100%"
            height="100%"
            style="border:0; min-height: 450px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Google Maps Lokasi Kantor ${siteConfig.legalName}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!--============================== Trust Strip: 3 Pilar Konsultasi ==============================-->
  <section class="space-bottom">
    <div class="container">
      <div class="trust-strip-wrapper">
        <div class="row g-4">
          <div class="col-md-4">
            <div class="trust-item">
              <div class="trust-icon">
                <Icon name="solar:calculator-linear" width="24" height="24" />
              </div>
              <div>
                <h3 class="trust-title">100% Konsultasi Gratis</h3>
                <p class="trust-text mb-0">Diskusi konsep desain dan kalkulasi anggaran transparan tanpa biaya komitmen di awal.</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="trust-item">
              <div class="trust-icon">
                <Icon name="solar:pen-new-square-linear" width="24" height="24" />
              </div>
              <div>
                <h3 class="trust-title">Survei Lokasi Langsung</h3>
                <p class="trust-text mb-0">Tim siap melakukan pengukuran lahan dan analisis lapangan ke lokasi proyek Anda di seluruh Jawa Timur.</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="trust-item">
              <div class="trust-icon">
                <Icon name="solar:shield-check-linear" width="24" height="24" />
              </div>
              <div>
                <h3 class="trust-title">Garansi Retensi Pekerjaan</h3>
                <p class="trust-text mb-0">Setiap proyek terikat kontrak kerja resmi (SPK) dengan jaminan masa pemeliharaan terpercaya.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Contact intro text */
  .contact-intro-text {
    max-width: 640px;
    margin: 10px auto 0;
    font-size: 16px;
  }
  .map-direction-btn {
    font-size: 13px;
    border-radius: 8px;
    min-height: 48px;
    padding: 12px 18px;
    display: inline-flex;
    align-items: center;
  }

  /* Bento Cards */
  .contact-bento-card {
    position: relative;
    background: #FFFFFF;
    border: none;
    border-radius: 24px;
    padding: 32px 28px;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(13, 25, 43, 0.05);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .contact-bento-card:hover {
    box-shadow: 0 12px 32px rgba(13, 25, 43, 0.09);
    transform: translateY(-2px);
  }

  .contact-bento-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: #EFF6FF;
    color: var(--theme-color, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 20px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .contact-bento-card:hover .contact-bento-icon {
    background: var(--theme-color, #22416D);
    color: #FFFFFF;
  }

  .contact-bento-title {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--title-color, #17202A);
  }

  .contact-bento-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--bina-slate-700, #334155);
    margin-bottom: 22px;
  }

  .contact-schedule-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }

  .schedule-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13.5px;
    padding-bottom: 8px;
    border-bottom: 1px dashed #E2E8F0;
  }

  .schedule-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .schedule-days {
    color: #64748B;
    font-weight: 500;
  }

  .schedule-hours {
    color: #0F172A;
    font-weight: 600;
  }

  .schedule-item.holiday .schedule-hours {
    color: #DC2626;
  }

  .contact-bento-footer {
    display: flex;
    align-items: center;
    padding-top: 8px;
  }

  .contact-bento-action {
    font-size: 14px;
    font-weight: 600;
    color: var(--theme-color, #22416D);
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .contact-bento-action:hover {
    color: #345F99;
    transform: translateX(2px);
  }

  .contact-status-chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: #ECFDF5;
    color: #059669;
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 20px;
    font-size: 12.5px;
    font-weight: 600;
    transition: all 0.25s ease;
  }

  .contact-status-chip.is-open {
    background: #ECFDF5;
    color: #059669;
    border-color: rgba(16, 185, 129, 0.25);
  }

  .contact-status-chip.is-open .status-icon-open {
    display: inline-block;
    color: #10B981;
  }

  .contact-status-chip.is-open .status-icon-closed {
    display: none;
  }

  .contact-status-chip.is-closed {
    background: #FEF2F2;
    color: #DC2626;
    border-color: rgba(239, 68, 68, 0.25);
  }

  .contact-status-chip.is-closed .status-icon-open {
    display: none;
  }

  .contact-status-chip.is-closed .status-icon-closed {
    display: inline-block;
    color: #EF4444;
  }

  /* Map Section */
  .contact-map-wrapper {
    background: #FFFFFF;
    border: none;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 30px rgba(34, 65, 109, 0.06);
  }

  .map-header {
    padding: 22px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #FFFFFF;
    border-bottom: 1px solid #F1F5F9;
  }

  .map-header-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #EFF6FF;
    color: var(--theme-color, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .map-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--title-color, #17202A);
  }

  .map-subtitle {
    font-size: 14px;
    color: #334155;
  }

  .map-container {
    flex-grow: 1;
    height: 100%;
    min-height: 480px;
    position: relative;
  }

  .map-container iframe {
    width: 100%;
    height: 100%;
    min-height: 480px;
    border: 0;
    display: block;
  }

  /* Trust Strip */
  .trust-strip-wrapper {
    background: var(--bina-gradient-navy, linear-gradient(135deg, #22416D 0%, #0D192B 100%));
    border-radius: 24px;
    padding: 40px 36px;
    color: #FFFFFF;
    box-shadow: 0 12px 35px rgba(34, 65, 109, 0.15);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .trust-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: #84ACDF;
    flex-shrink: 0;
  }

  .trust-title {
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 6px;
  }

  .trust-text {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 991px) {
    .trust-strip-wrapper {
      padding: 30px 24px;
    }
  }

  @media (max-width: 767px) {
    .map-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 20px;
    }
  }

  @media (max-width: 575px) {
    .map-direction-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  function updateOperationalStatus() {
    const chip = document.getElementById('operational-status-chip');
    const text = document.getElementById('operational-status-text');
    if (!chip || !text) return;

    let isSunday = false;
    let isWorkDay = false;
    let isOpenHours = false;

    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Jakarta',
        hour12: false,
        weekday: 'short',
        hour: 'numeric',
        minute: 'numeric'
      });
      const parts = formatter.formatToParts(now);
      let weekday = '';
      let hour = 0;
      let minute = 0;
      for (const p of parts) {
        if (p.type === 'weekday') weekday = p.value;
        if (p.type === 'hour') hour = parseInt(p.value, 10);
        if (p.type === 'minute') minute = parseInt(p.value, 10);
      }
      if (hour === 24) hour = 0;

      isSunday = (weekday === 'Sun');
      isWorkDay = !isSunday;
      const totalMinutes = hour * 60 + minute;
      isOpenHours = totalMinutes >= (8 * 60) && totalMinutes < (16 * 60);
    } catch (e) {
      const now = new Date();
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const wib = new Date(utc + (7 * 3600000));
      const day = wib.getDay();
      const hour = wib.getHours();
      const minute = wib.getMinutes();

      isSunday = (day === 0);
      isWorkDay = (day >= 1 && day <= 6);
      const totalMinutes = hour * 60 + minute;
      isOpenHours = totalMinutes >= (8 * 60) && totalMinutes < (16 * 60);
    }

    const isOpen = isWorkDay && isOpenHours;
    const isEn = document.documentElement.lang === 'en' || window.location.pathname.startsWith('/en');

    if (isOpen) {
      chip.classList.remove('is-closed');
      chip.classList.add('is-open');
      text.textContent = isEn ? 'Open' : 'Buka';
    } else {
      chip.classList.remove('is-open');
      chip.classList.add('is-closed');
      text.textContent = isEn ? 'Closed' : 'Tutup';
    }
  }

  updateOperationalStatus();
  document.addEventListener('DOMContentLoaded', updateOperationalStatus);
  document.addEventListener('astro:page-load', updateOperationalStatus);
  setInterval(updateOperationalStatus, 30000);
</script>
