---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import BlogCard from '@components/BlogCard.astro';
import SectionHeader from '@components/SectionHeader.astro';
import EmptyState from '@components/EmptyState.astro';
import { getAllArticles } from '@lib/blogService';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const articles = await getAllArticles();
---

<BaseLayout
  title={`${t('blog.title')} - ${t('site.name')}`}
  description={t('blog.desc')}
>
  <Breadcrumb title={t('nav.articles')} />

  <section class="space">
    <div class="container-fluid blog-fluid-container">
      <SectionHeader
        badge={t('blog.badge')}
        badgeIcon="solar:document-text-bold"
        title={t('blog.title')}
        description={t('blog.desc')}
        align="center"
      />

      {articles.length > 0 ? (
        <div class="row blog-row gy-4 gx-4">
          {articles.map((article, index) => (
            <BlogCard
              article={article}
              colClass="col-12 col-md-6 col-lg-4 blog-item"
              loading={index < 3 ? 'eager' : 'lazy'}
              priority={index < 3}
            />
          ))}
        </div>
      ) : (
        <EmptyState
          icon="solar:document-text-linear"
          title="Belum Ada Artikel Tersedia"
          description="Tim kami sedang menyusun artikel edukatif dan tren desain arsitektur terbaru. Nantikan update tulisan menarik kami segera."
          primaryActionText="Konsultasi Desain Gratis"
          primaryActionHref="/contact"
        />
      )}
    </div>
  </section>

  <style>
    /* ==========================================================================
       Blog Fluid Container & Match Portfolio Grid Widths
       ========================================================================== */
    .blog-fluid-container {
      padding-left: clamp(24px, 6vw, 110px);
      padding-right: clamp(24px, 6vw, 110px);
    }

    .blog-row :global(.blog-item) {
      width: 100%;
    }

    @media (min-width: 768px) {
      .blog-row :global(.blog-item) {
        width: 49.9% !important;
      }
    }

    @media (min-width: 992px) {
      .blog-row :global(.blog-item) {
        width: 33.3% !important;
      }
    }
  </style>
</BaseLayout>
