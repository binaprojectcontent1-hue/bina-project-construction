---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { getAllArticles, getArticleBySlug } from '@lib/blogService';
import { getMediaUrl } from '@lib/cdn';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@config/site';

// Explicitly declare prerender for clarity (optional in static mode)
export const prerender = true;

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article: initialArticle } = Astro.props;
const { slug } = Astro.params;

// Prioritize fresh data by slug (for real-time dev synchronization), fallback to build-time props
const article = (slug ? await getArticleBySlug(slug) : undefined) || initialArticle;

if (!article) {
  return Astro.redirect('/404');
}

const allArticles = await getAllArticles();
const recentArticles = allArticles.filter((a) => a.slug !== article.slug).slice(0, 3);
const coverUrl = getMediaUrl(article.cover_image);
const coverAlt = article.alt_cover_image || `Cover Artikel ${article.title} - Bina Project`;
const pageTitle = article.meta_title || `${article.title} - Blog Bina Project`;
const pageDescription = article.meta_description || article.excerpt;
const canonicalSlugUrl = `${siteConfig.siteUrl}/blog/${article.slug}`;

// Schema.org BlogPosting & Article with Rich Snippet details
const articleSchema = {
  "@context": "https://schema.org",
  "@type": ["BlogPosting", "Article"],
  "headline": pageTitle,
  "name": article.title,
  "description": pageDescription,
  "image": coverUrl,
  "url": canonicalSlugUrl,
  "mainEntityOfPage": canonicalSlugUrl,
  "datePublished": article.published_at || article.publish_date,
  "dateModified": article.updated_at || article.published_at || article.publish_date,
  "author": {
    "@type": "Person",
    "name": article.author || "Bina Project"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bina Project",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteConfig.siteUrl}/assets/img/logo.svg`
    }
  },
  "inLanguage": "id-ID",
  ...(article.focus_keyword ? { "keywords": article.focus_keyword } : {})
};

import { formatAndSanitizeArticleContent } from '@lib/formatContent';

const sanitizedContent = formatAndSanitizeArticleContent(article.content);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={coverUrl}
  canonicalUrl={canonicalSlugUrl}
  type="article"
  preloadImage={coverUrl}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <Breadcrumb
    title={article.title}
    parent={{ title: 'Artikel', url: '/blog' }}
    isH1={false}
  />

  <section class="th-blog-wrapper space-top space-extra-bottom">
    <div class="container">
      <div class="row">
        <div class="col-xxl-8 col-lg-8">
          <article class="th-blog blog-single">
            <div class="blog-img">
              <img
                src={coverUrl}
                alt={coverAlt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1000"
                height="500"
              />
            </div>
            <div class="blog-content">
              <div class="blog-meta">
                <a href="#"><Icon name="solar:user-linear" width="16" height="16" class="me-1" /> Oleh {article.author}</a>
                <a href="#"><Icon name="solar:calendar-date-linear" width="16" height="16" class="me-1" /> {article.publish_date}</a>
                <a href="#"><Icon name="solar:tag-linear" width="16" height="16" class="me-1" /> {article.category}</a>
              </div>
              <h1 class="blog-title article-main-title">
                {article.title}
              </h1>

              <div class="article-body" set:html={sanitizedContent} />

              <div class="share-links clearfix mt-40 pt-20 border-top">
                <div class="row justify-content-between align-items-center">
                  <div class="col-md-auto">
                    <span class="share-links-title">Bagikan:</span>
                    <div class="th-social style2">
                      <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' - ' + canonicalSlugUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share WhatsApp"><Icon name="simple-icons:whatsapp" width="16" height="16" /></a>
                      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalSlugUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share Facebook"><Icon name="simple-icons:facebook" width="16" height="16" /></a>
                      <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalSlugUrl)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share Twitter"><Icon name="simple-icons:x" width="16" height="16" /></a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        </div>

        <div class="col-xxl-4 col-lg-4">
          <aside class="sidebar-area">
            {recentArticles.length > 0 && (
              <div class="widget">
                <h3 class="widget_title">Artikel Terbaru</h3>
                <div class="recent-post-wrap">
                  {recentArticles.map((recent) => (
                    <div class="recent-post">
                      <div class="media-img">
                        <a href={`/blog/${recent.slug}`}>
                          <img
                            src={getMediaUrl(recent.cover_image)}
                            alt={recent.title}
                            loading="lazy"
                            decoding="async"
                            width="100"
                            height="80"
                          />
                        </a>
                      </div>
                      <div class="media-body">
                        <h4 class="post-title">
                          <a class="text-inherit" href={`/blog/${recent.slug}`}>{recent.title}</a>
                        </h4>
                        <div class="recent-post-meta">
                          <a href={`/blog/${recent.slug}`}><Icon name="solar:calendar-date-linear" width="14" height="14" class="me-1" /> {recent.publish_date}</a>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div class="widget widget_banner" data-bg-src="/assets/img/bg/cta_bg_1.jpg">
              <div class="widget-banner">
                <h4 class="title text-white">Konsultasi Rencana Bangunan Anda Sekarang</h4>
                <a href="/contact" class="th-btn style1 mt-20">Hubungi Kami</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ==========================================================================
       Article Title & Editorial Typography Hierarchy
       ========================================================================== */
    .article-main-title {
      font-family: var(--font-heading, 'Archivo', sans-serif) !important;
      font-size: clamp(2rem, 3.5vw, 2.5rem) !important;
      line-height: 1.3 !important;
      font-weight: 800 !important;
      color: var(--bina-slate-900, #17202A) !important;
      letter-spacing: -0.02em !important;
      margin-bottom: 25px !important;
    }

    .article-body {
      font-size: 1.125rem;
      line-height: 1.85;
      color: var(--bina-slate-700, #334155);
      font-family: var(--font-body, 'Archivo', sans-serif);
      word-break: break-word;
    }

    .article-body :global(p) {
      margin-top: 0 !important;
      margin-bottom: 1.65rem !important;
      line-height: 1.85 !important;
      font-size: 1.0625rem !important;
      color: var(--bina-slate-700, #334155) !important;
    }

    .article-body :global(h2) {
      font-family: var(--font-heading, 'Archivo', sans-serif) !important;
      font-size: 1.45rem !important;
      font-weight: 700 !important;
      color: var(--bina-slate-900, #17202A) !important;
      margin-top: 2.5rem !important;
      margin-bottom: 1rem !important;
      line-height: 1.4 !important;
      letter-spacing: -0.01em !important;
      padding-bottom: 0.5rem !important;
      border-bottom: 2px solid var(--bina-slate-200, #E2E8F0) !important;
    }

    .article-body :global(h3) {
      font-family: var(--font-heading, 'Archivo', sans-serif) !important;
      font-size: 1.25rem !important;
      font-weight: 700 !important;
      color: var(--bina-slate-900, #17202A) !important;
      margin-top: 2rem !important;
      margin-bottom: 0.75rem !important;
      line-height: 1.4 !important;
      letter-spacing: -0.01em !important;
    }

    .article-body :global(h4) {
      font-family: var(--font-heading, 'Archivo', sans-serif) !important;
      font-size: 1.1rem !important;
      font-weight: 600 !important;
      color: var(--bina-slate-900, #17202A) !important;
      margin-top: 1.5rem !important;
      margin-bottom: 0.5rem !important;
    }

    .article-body :global(strong),
    .article-body :global(b) {
      font-weight: 700 !important;
      color: var(--bina-slate-900, #17202A) !important;
    }

    .article-body :global(em),
    .article-body :global(i) {
      font-style: italic;
    }

    .article-body :global(ul),
    .article-body :global(ol) {
      margin-top: 0.75rem;
      margin-bottom: 1.75rem;
      padding-left: 1.75rem;
    }

    .article-body :global(ul) {
      list-style-type: disc;
    }

    .article-body :global(ol) {
      list-style-type: decimal;
    }

    .article-body :global(li) {
      margin-bottom: 0.65rem;
      line-height: 1.75;
      color: var(--bina-slate-700, #334155);
    }

    .article-body :global(li strong) {
      color: var(--bina-navy, #22416D);
    }

    .article-body :global(blockquote),
    .article-body :global(.article-reference) {
      margin: 2rem 0;
      padding: 1.25rem 1.75rem;
      background: var(--bina-slate-50, #F8FAFC);
      border-left: 4px solid var(--bina-navy, #22416D);
      border-radius: 0 12px 12px 0;
      font-style: normal;
      color: var(--bina-slate-700, #334155);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .article-body :global(blockquote p),
    .article-body :global(.article-reference p) {
      margin-bottom: 0;
      line-height: 1.7;
      font-size: 1.05rem;
    }

    .article-body :global(a) {
      color: var(--bina-navy, #22416D);
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .article-body :global(a:hover) {
      color: var(--bina-blue-accent, #345F99);
    }

    .article-body :global(hr) {
      border: 0;
      height: 1px;
      background: var(--bina-slate-200, #E2E8F0);
      margin: 2.75rem 0;
    }

    .article-body :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      margin: 2rem auto;
      display: block;
      box-shadow: 0 6px 24px rgba(13, 25, 43, 0.08);
    }

    /* Green callout box */
    .article-body :global(.article-callout),
    .article-body :global(.callout-box) {
      background: #F0FDF4;
      border-left: 4px solid #10B981;
      padding: 1.25rem 1.5rem;
      border-radius: 8px;
      margin: 1.75rem 0;
    }

    /* Blue CTA consultation box */
    .article-body :global(.article-cta-box) {
      background: linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 100%);
      border: 1px solid #BFDBFE;
      border-radius: 16px;
      padding: 2rem;
      margin: 2.5rem 0;
      text-align: center;
    }

    .article-body :global(.article-cta-box h4) {
      font-family: var(--font-heading, 'Archivo', sans-serif);
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--bina-navy, #22416D);
      margin-top: 0;
      margin-bottom: 0.75rem;
      border-bottom: none;
      padding-bottom: 0;
    }

    .article-body :global(.article-cta-box p) {
      font-size: 1.05rem;
      color: var(--bina-slate-700, #334155);
      margin-bottom: 1.25rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .article-body :global(.article-cta-btn) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.85rem 1.75rem;
      background: var(--bina-navy, #22416D);
      color: #FFFFFF !important;
      text-decoration: none !important;
      font-weight: 600;
      font-size: 0.95rem;
      border-radius: 10px;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(34, 65, 109, 0.25);
    }

    .article-body :global(.article-cta-btn:hover) {
      background: var(--bina-navy-hover, #1B3457);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(34, 65, 109, 0.35);
    }

    @media (max-width: 767px) {
      .article-main-title {
        font-size: 1.65rem !important;
        line-height: 1.35 !important;
      }
      .article-body {
        font-size: 1rem !important;
      }
      .article-body :global(h2) {
        font-size: 1.25rem !important;
        margin-top: 1.75rem !important;
      }
      .article-body :global(h3) {
        font-size: 1.125rem !important;
        margin-top: 1.5rem !important;
      }
      .article-body :global(p) {
        font-size: 1rem !important;
        line-height: 1.8 !important;
      }
      .article-body :global(ul),
      .article-body :global(ol) {
        padding-left: 1.35rem !important;
      }
    }

    .share-links .th-social {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .share-links .th-social a {
      width: 44px !important;
      height: 44px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      border-radius: 12px !important;
      background-color: #F1F5F9 !important;
      color: #22416D !important;
      transition: all 0.25s ease !important;
    }

    .share-links .th-social a:hover {
      background-color: #22416D !important;
      color: #FFFFFF !important;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(34, 65, 109, 0.25);
    }
  </style>
</BaseLayout>
