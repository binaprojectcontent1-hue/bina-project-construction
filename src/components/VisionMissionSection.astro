---
/**
 * @file VisionMissionSection.astro
 * @description Bulletproof, strictly borderless architectural layout for Visi, 9 Misi, and Nilai K-P-I.
 * Strictly uses #22416D (Bina Navy), Bootstrap grid resilience, zero strokes/outlines,
 * and complete elimination of AI-slop or blockquote conflicts.
 */

import SectionHeader from '@components/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '@i18n/utils';
import { VISION_DATA, CORE_VALUES_DATA, MISSIONS_DATA } from '@data/visionMission';

const currentLang = getLangFromUrl(Astro.url);
const isEn = currentLang === 'en';
---

<section class="vm-section" id="visi-misi" style="background: var(--bina-slate-50, #F8FAFC); position: relative; padding: clamp(50px, 6vw, 85px) 0;">
  <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- Section Header -->
    <div class="row justify-content-center">
      <div class="col-xl-8 col-lg-9 text-center mb-40">
        <SectionHeader
          badge={isEn ? "Vision, Mission & Core Values" : "Visi, Misi & Nilai Inti"}
          badgeIcon="solar:compass-bold"
          title={isEn ? "Our Principles &" : "Fondasi Prinsip &"}
          titleAccent={isEn ? "Commitment" : "Komitmen Kami"}
          description={isEn 
            ? "Defining our direction, standards of work, and dedication to building spaces that ensure safety and client satisfaction."
            : "Arah langkah, standar kerja terukur, dan dedikasi kami dalam membangun ruang yang aman dan memuaskan bagi setiap klien."}
          align="center"
        />
      </div>
    </div>

    <!-- 1. Visi Perusahaan (Full-Width Architectural Focus Banner - Solid Bina Navy, Zero Borders) -->
    <div 
      class="vm-visi-card mb-40" 
      style="background: #22416D !important; border-radius: 20px; border: none !important; outline: none !important; padding: clamp(28px, 4vw, 42px) clamp(24px, 4.5vw, 48px); box-shadow: 0 10px 30px rgba(34, 65, 109, 0.12); display: flex; flex-direction: column; gap: 14px;"
    >
      <div class="d-flex align-items-center justify-content-between">
        <span 
          class="vm-visi-eyebrow"
          style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #84ACDF;"
        >
          {isEn ? "Company Vision" : "Visi Perusahaan"}
        </span>
        <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.1); color: #84ACDF;">
          <Icon name="solar:flag-2-bold" width="18" height="18" />
        </span>
      </div>

      <!-- Native paragraph to eliminate global blockquote borders -->
      <p 
        class="vm-visi-text"
        style="font-family: var(--font-heading, 'Archivo', sans-serif); font-size: clamp(18px, 1.8vw, 23px); font-weight: 600; line-height: 1.6; color: #FFFFFF !important; margin: 0; padding: 0; border: none !important; outline: none !important; font-style: normal;"
      >
        “{isEn ? VISION_DATA.textEn : VISION_DATA.text}”
      </p>

      <div class="vm-visi-footer" style="display: flex; align-items: center; gap: 8px; margin-top: 4px;">
        <span 
          class="vm-visi-tagline"
          style="font-size: 13px; font-weight: 600; color: #CBD5E1; letter-spacing: 0.02em;"
        >
          {isEn ? VISION_DATA.taglineEn : VISION_DATA.tagline}
        </span>
      </div>
    </div>

    <!-- 2. 9 Misi Strategis (Bootstrap 3-Column Grid, Borderless Cards) -->
    <div class="vm-mission-block mb-50">
      <div class="mb-25">
        <h3 
          class="vm-mission-title mb-1"
          style="font-family: var(--font-heading, 'Archivo', sans-serif); font-size: clamp(18px, 1.6vw, 22px); font-weight: 800; color: #17202A;"
        >
          {isEn ? "9 Strategic Missions" : "9 Misi Strategis"}
        </h3>
        <p 
          class="vm-mission-subtitle mb-0"
          style="font-size: 14px; color: #64748B;"
        >
          {isEn 
            ? "Our actionable operational roadmap to deliver consistent quality, schedule discipline, and transparency."
            : "Langkah operasional nyata yang kami jalankan demi menjamin mutu, disiplin waktu, dan transparansi."}
        </p>
      </div>

      <!-- Bootstrap Row for guaranteed 3x3 layout -->
      <div class="row g-3">
        {MISSIONS_DATA.map((item) => (
          <div class="col-lg-4 col-md-6 col-12">
            <div 
              class="vm-mission-card"
              style="background: #FFFFFF !important; border-radius: 16px; border: none !important; outline: none !important; padding: 22px 22px; box-shadow: 0 4px 16px rgba(34, 65, 109, 0.04); height: 100%; display: flex; flex-direction: column;"
            >
              <div class="d-flex align-items-center justify-content-between mb-10">
                <span 
                  class="vm-mission-num"
                  style="font-family: var(--font-heading, 'Archivo', sans-serif); font-size: 13px; font-weight: 800; color: #22416D;"
                >
                  {item.number}
                </span>
                <span style="color: #22416D; opacity: 0.7;">
                  <Icon name={item.icon} width="18" height="18" />
                </span>
              </div>
              <h4 
                class="vm-mission-keyword mb-1"
                style="font-family: var(--font-heading, 'Archivo', sans-serif); font-size: 15px; font-weight: 700; color: #17202A;"
              >
                {isEn ? item.keywordEn : item.keyword}
              </h4>
              <p 
                class="vm-mission-desc mb-0"
                style="font-size: 13px; line-height: 1.55; color: #475569;"
              >
                {isEn ? item.textEn : item.text}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. Nilai Inti "K-P-I" (3 Bootstrap Columns, Borderless Cards - Placed below Misi) -->
    <div class="vm-kpi-block">
      <div class="d-flex flex-column mb-25">
        <h3 
          class="vm-kpi-title mb-1"
          style="font-family: var(--font-heading, 'Archivo', sans-serif); font-size: clamp(18px, 1.6vw, 22px); font-weight: 800; color: #17202A;"
        >
          {isEn ? "Our Work Culture: K-P-I" : "Nilai Perusahaan"}
        </h3>
        <p 
          class="vm-kpi-quote mb-0 text-start"
          style="font-size: 14px; font-weight: 700; color: #22416D; font-style: italic;"
        >
          {isEn ? CORE_VALUES_DATA.quoteEn : CORE_VALUES_DATA.quote}
        </p>
      </div>

      <!-- Bootstrap Row for guaranteed responsive column layout -->
      <div class="row g-4">
        {CORE_VALUES_DATA.items.map((val) => (
          <div class="col-lg-4 col-md-6 col-12">
            <div 
              class="vm-kpi-card"
              style="background: #FFFFFF !important; border-radius: 16px; border: none !important; outline: none !important; padding: 26px 24px; box-shadow: 0 4px 20px rgba(34, 65, 109, 0.05); height: 100%; display: flex; flex-direction: column;"
            >
              <div class="d-flex align-items-center justify-content-between mb-15">
                <span 
                  class="vm-kpi-char"
                  style="width: 38px; height: 38px; border-radius: 10px; background: #22416D; color: #FFFFFF; font-family: var(--font-heading, 'Archivo', sans-serif); font-size: 20px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center;"
                >
                  {val.letter}
                </span>
                <span style="color: #22416D; opacity: 0.8;">
                  <Icon name={val.icon} width="22" height="22" />
                </span>
              </div>
              <h4 
                class="vm-kpi-card-title mb-2"
                style="font-family: var(--font-heading, 'Archivo', sans-serif); font-size: 18px; font-weight: 800; color: #17202A;"
              >
                {isEn ? val.titleEn : val.title}
              </h4>
              <p 
                class="vm-kpi-card-desc mb-0"
                style="font-size: 13.5px; line-height: 1.6; color: #475569;"
              >
                {isEn ? val.descEn : val.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* ========================================================
     Strictly Borderless Architectural Design
     Zero stroke/outline. Pure, purposeful typography.
     ======================================================== */
  .vm-section {
    background: var(--bina-slate-50, #F8FAFC);
    position: relative;
    padding: clamp(50px, 6vw, 85px) 0;
  }

  .vm-visi-card,
  .vm-kpi-card,
  .vm-mission-card {
    border: none !important;
    outline: none !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .vm-kpi-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(34, 65, 109, 0.09) !important;
  }

  .vm-mission-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(34, 65, 109, 0.08) !important;
  }

  /* Defend against any global theme blockquote or text borders */
  .vm-section blockquote,
  .vm-section p,
  .vm-section div {
    outline: none !important;
  }
</style>
