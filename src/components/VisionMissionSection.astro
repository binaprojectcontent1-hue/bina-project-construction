---
/**
 * @file VisionMissionSection.astro
 * @description Bulletproof, strictly borderless architectural layout for Visi, 9 Misi, and Nilai K-P-I.
 * Strictly uses #22416D (Bina Navy), Bootstrap grid resilience, zero strokes/outlines,
 * and complete elimination of inline styles in compliance with PageSpeed and SEO best practices.
 */

import SectionHeader from '@components/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl } from '@i18n/utils';
import { VISION_DATA, CORE_VALUES_DATA, MISSIONS_DATA } from '@data/visionMission';

const currentLang = getLangFromUrl(Astro.url);
const isEn = currentLang === 'en';
---

<section class="vm-section" id="visi-misi">
  <div class="container vm-container">
    
    <!-- Section Header -->
    <div class="row justify-content-center">
      <div class="col-xl-8 col-lg-9 text-center mb-40">
        <SectionHeader
          badge={isEn ? "Vision, Mission & Core Values" : "Visi, Misi & Nilai Inti"}
          badgeIcon="solar:compass-bold"
          title={isEn ? "Our Principles &" : "Fondasi Prinsip &"}
          titleAccent={isEn ? "Commitment" : "Komitmen Kami"}
          description={isEn 
            ? "Defining our direction, standards of work, and dedication to building spaces that ensure safety and client satisfaction."
            : "Arah langkah, standar kerja terukur, dan dedikasi kami dalam membangun ruang yang aman dan memuaskan bagi setiap klien."}
          align="center"
        />
      </div>
    </div>

    <!-- 1. Visi Perusahaan (Full-Width Architectural Focus Banner - Solid Bina Navy, Zero Borders) -->
    <div class="vm-visi-card mb-40">
      <div class="d-flex align-items-center justify-content-between">
        <span class="vm-visi-eyebrow">
          {isEn ? "Company Vision" : "Visi Perusahaan"}
        </span>
        <span class="vm-visi-icon-badge">
          <Icon name="solar:flag-2-bold" width="18" height="18" />
        </span>
      </div>

      <!-- Native paragraph to eliminate global blockquote borders -->
      <p class="vm-visi-text">
        “{isEn ? VISION_DATA.textEn : VISION_DATA.text}”
      </p>

      <div class="vm-visi-footer">
        <span class="vm-visi-tagline">
          {isEn ? VISION_DATA.taglineEn : VISION_DATA.tagline}
        </span>
      </div>
    </div>

    <!-- 2. 9 Misi Strategis (Bootstrap 3-Column Grid, Borderless Cards) -->
    <div class="vm-mission-block mb-50">
      <div class="mb-25">
        <h3 class="vm-mission-title mb-1">
          {isEn ? "9 Strategic Missions" : "9 Misi Strategis"}
        </h3>
        <p class="vm-mission-subtitle mb-0">
          {isEn 
            ? "Our actionable operational roadmap to deliver consistent quality, schedule discipline, and transparency."
            : "Langkah operasional nyata yang kami jalankan demi menjamin mutu, disiplin waktu, dan transparansi."}
        </p>
      </div>

      <!-- Bootstrap Row for guaranteed 3x3 layout -->
      <div class="row g-3">
        {MISSIONS_DATA.map((item) => (
          <div class="col-lg-4 col-md-6 col-12">
            <div class="vm-mission-card">
              <div class="d-flex align-items-center justify-content-between mb-10">
                <span class="vm-mission-num">
                  {item.number}
                </span>
                <span class="vm-mission-icon">
                  <Icon name={item.icon} width="18" height="18" />
                </span>
              </div>
              <h4 class="vm-mission-keyword mb-1">
                {isEn ? item.keywordEn : item.keyword}
              </h4>
              <p class="vm-mission-desc mb-0">
                {isEn ? item.textEn : item.text}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. Nilai Inti "K-P-I" (3 Bootstrap Columns, Borderless Cards - Placed below Misi) -->
    <div class="vm-kpi-block">
      <div class="d-flex flex-column mb-25">
        <h3 class="vm-kpi-title mb-1">
          {isEn ? "Our Work Culture: K-P-I" : "Nilai Perusahaan"}
        </h3>
        <p class="vm-kpi-quote mb-0 text-start">
          {isEn ? CORE_VALUES_DATA.quoteEn : CORE_VALUES_DATA.quote}
        </p>
      </div>

      <!-- Bootstrap Row for guaranteed responsive column layout -->
      <div class="row g-4">
        {CORE_VALUES_DATA.items.map((val) => (
          <div class="col-lg-4 col-md-6 col-12">
            <div class="vm-kpi-card">
              <!-- Architectural Blueprint Drafting Grid Pattern Overlay -->
              <div class="vm-kpi-grid-pattern" aria-hidden="true"></div>

              <!-- CAD Precision Corner Crosshairs -->
              <div class="vm-kpi-corner-tl" aria-hidden="true"></div>
              <div class="vm-kpi-corner-br" aria-hidden="true"></div>

              <!-- Card Header (Letter Badge on Left of Title + Decorative Icon on Right) -->
              <div class="vm-kpi-header mb-3">
                <div class="d-flex align-items-center gap-3">
                  <span class="vm-kpi-char">
                    {val.letter}
                  </span>
                  <h4 class="vm-kpi-card-title m-0">
                    {isEn ? val.titleEn : val.title}
                  </h4>
                </div>
                <span class="vm-kpi-icon-wrap">
                  <Icon name={val.icon} width="20" height="20" />
                </span>
              </div>

              <!-- Card Description -->
              <div class="vm-kpi-content">
                <p class="vm-kpi-card-desc">
                  {isEn ? val.descEn : val.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* ========================================================
     Strictly Borderless Architectural Design
     Zero stroke/outline. Pure, purposeful typography.
     ======================================================== */
  .vm-section {
    background: var(--bina-slate-50, #F8FAFC);
    position: relative;
    padding: clamp(50px, 6vw, 85px) 0;
  }

  .vm-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .vm-visi-card {
    background: #22416D !important;
    border-radius: 20px;
    border: none !important;
    outline: none !important;
    padding: clamp(28px, 4vw, 42px) clamp(24px, 4.5vw, 48px);
    box-shadow: 0 10px 30px rgba(34, 65, 109, 0.12);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .vm-visi-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #84ACDF;
  }

  .vm-visi-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    color: #84ACDF;
  }

  .vm-visi-text {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: clamp(18px, 1.8vw, 23px);
    font-weight: 600;
    line-height: 1.6;
    color: #FFFFFF !important;
    margin: 0;
    padding: 0;
    border: none !important;
    outline: none !important;
    font-style: normal;
  }

  .vm-visi-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .vm-visi-tagline {
    font-size: 13px;
    font-weight: 600;
    color: #CBD5E1;
    letter-spacing: 0.02em;
  }

  .vm-mission-title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 800;
    color: #17202A;
  }

  .vm-mission-subtitle {
    font-size: 14px;
    color: #64748B;
  }

  .vm-mission-card {
    background: #FFFFFF !important;
    border-radius: 16px;
    border: none !important;
    outline: none !important;
    padding: 22px 22px;
    box-shadow: 0 4px 16px rgba(34, 65, 109, 0.04);
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .vm-mission-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(34, 65, 109, 0.08) !important;
  }

  .vm-mission-num {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: 13px;
    font-weight: 800;
    color: #22416D;
  }

  .vm-mission-icon {
    color: #22416D;
    opacity: 0.7;
  }

  .vm-mission-keyword {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: #17202A;
  }

  .vm-mission-desc {
    font-size: 13px;
    line-height: 1.55;
    color: #475569;
  }

  .vm-kpi-title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 800;
    color: #17202A;
  }

  .vm-kpi-quote {
    font-size: 14px;
    font-weight: 700;
    color: #22416D;
    font-style: italic;
  }

  /* --------------------------------------------------------
     ARCHITECTURAL BLUEPRINT CARD (NILAI K-P-I)
     -------------------------------------------------------- */
  .vm-kpi-card {
    position: relative;
    background: linear-gradient(145deg, #152742 0%, #1A3459 55%, #22416D 100%) !important;
    border-radius: 18px;
    border: 1px solid rgba(132, 172, 223, 0.25) !important;
    box-shadow: 0 10px 30px rgba(18, 44, 73, 0.16);
    padding: 26px 24px;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  /* Blueprint Grid Pattern */
  .vm-kpi-grid-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-image: 
      linear-gradient(to right, rgba(132, 172, 223, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(132, 172, 223, 0.08) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.65;
    mask-image: radial-gradient(circle at 50% 35%, black 45%, transparent 88%);
    -webkit-mask-image: radial-gradient(circle at 50% 35%, black 45%, transparent 88%);
    transition: opacity 0.3s ease;
  }

  /* CAD Precision Corner Crosshairs */
  .vm-kpi-corner-tl {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 12px;
    height: 12px;
    border-top: 1.5px solid rgba(132, 172, 223, 0.45);
    border-left: 1.5px solid rgba(132, 172, 223, 0.45);
    pointer-events: none;
    z-index: 2;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .vm-kpi-corner-br {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 12px;
    height: 12px;
    border-bottom: 1.5px solid rgba(132, 172, 223, 0.45);
    border-right: 1.5px solid rgba(132, 172, 223, 0.45);
    pointer-events: none;
    z-index: 2;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  /* Header inside Card */
  .vm-kpi-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .vm-kpi-char {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: #FFFFFF;
    color: #152742;
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: 22px;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    flex-shrink: 0;
  }

  .vm-kpi-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #84ACDF;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  /* Content inside Card */
  .vm-kpi-content {
    position: relative;
    z-index: 2;
  }

  .vm-kpi-card-title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: 20px;
    font-weight: 800;
    color: #FFFFFF !important;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .vm-kpi-card-desc {
    font-size: 13.5px;
    line-height: 1.68;
    color: #CBD5E1 !important;
    margin: 0;
  }

  /* Hover Interaction */
  .vm-kpi-card:hover {
    transform: translateY(-5px);
    border-color: rgba(56, 189, 248, 0.5) !important;
    box-shadow: 0 16px 38px rgba(15, 36, 64, 0.32) !important;
  }

  .vm-kpi-card:hover .vm-kpi-grid-pattern {
    opacity: 0.95;
  }

  .vm-kpi-card:hover .vm-kpi-corner-tl,
  .vm-kpi-card:hover .vm-kpi-corner-br {
    border-color: #38BDF8;
    transform: scale(1.15);
  }

  .vm-kpi-card:hover .vm-kpi-icon-wrap {
    background: rgba(56, 189, 248, 0.16);
    color: #38BDF8;
  }

  /* Defend against any global theme blockquote or text borders */
  .vm-section blockquote,
  .vm-section p,
  .vm-section div {
    outline: none !important;
  }
</style>
