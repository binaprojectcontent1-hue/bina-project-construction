---
import { Icon } from 'astro-icon/components';

interface Props {
  badge?: string;
  badgeIcon?: string;
  title: string;
  titleAccent?: string;
  description?: string;
  align?: 'center' | 'left';
  variant?: 'light' | 'dark';
  class?: string;
  id?: string;
}

const {
  badge,
  badgeIcon,
  title,
  titleAccent,
  description,
  align = 'center',
  variant = 'light',
  class: className = '',
  id,
} = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`, `section-header--${variant}`, className]} id={id}>
  {badge && (
    <div class="section-header__badge">
      {badgeIcon && <Icon name={badgeIcon} width="16" height="16" class="section-header__badge-icon" />}
      <span>{badge}</span>
    </div>
  )}

  <h2 class="section-header__title">
    {title}
    {titleAccent && <span class="section-header__title-accent"> {titleAccent}</span>}
    <slot name="title-extra" />
  </h2>

  {description && (
    <p class="section-header__desc">{description}</p>
  )}

  <slot />
</div>

<style>
  .section-header {
    margin-bottom: var(--title-area-mb, 40px);
    position: relative;
    z-index: 2;
  }

  .section-header--center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-header--left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* 1. Pill Badge / Eyebrow */
  .section-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: var(--radius-pill, 9999px);
    background: var(--bina-blue-50, #EFF6FF);
    border: 1px solid rgba(34, 65, 109, 0.12);
    color: var(--bina-navy, #22416D);
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: var(--text-xs, 0.75rem);
    font-weight: 700;
    letter-spacing: var(--tracking-kicker, 0.12em);
    text-transform: uppercase;
    margin-bottom: 14px;
    width: fit-content;
    line-height: 1;
    box-shadow: 0 1px 2px rgba(34, 65, 109, 0.04);
  }

  .section-header__badge-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--bina-navy, #22416D);
  }

  /* 2. Main Title (H2) */
  .section-header__title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: var(--fluid-h2, clamp(1.75rem, 3.5vw, 2.375rem));
    font-weight: 800;
    line-height: var(--leading-tight, 1.2);
    letter-spacing: -0.02em;
    color: var(--bina-slate-900, #17202A);
    margin-top: 0;
    margin-bottom: 12px;
  }

  .section-header__title-accent {
    color: var(--bina-navy, #22416D);
    background: linear-gradient(135deg, #22416D 0%, #345F99 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 3. Sub-description */
  .section-header__desc {
    font-family: var(--font-body, 'Archivo', sans-serif);
    font-size: var(--text-base, 1rem);
    line-height: var(--leading-relaxed, 1.75);
    color: var(--bina-slate-500, #475569);
    margin: 0;
  }

  .section-header--center .section-header__desc {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-header--left .section-header__desc {
    max-width: 620px;
  }

  /* Dark Variant (e.g. CTA Sections) */
  .section-header--dark .section-header__badge {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
  }

  .section-header--dark .section-header__badge-icon {
    color: #FFFFFF;
  }

  .section-header--dark .section-header__title {
    color: #FFFFFF;
  }

  .section-header--dark .section-header__title-accent {
    color: var(--bina-blue-ice, #84ACDF);
    background: linear-gradient(135deg, #FFFFFF 0%, #84ACDF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header--dark .section-header__desc {
    color: rgba(255, 255, 255, 0.85);
  }

  /* Mobile Responsive Fine-Tuning */
  @media (max-width: 767px) {
    .section-header {
      margin-bottom: 28px;
    }

    .section-header__badge {
      font-size: 11px;
      padding: 5px 12px;
      gap: 6px;
      margin-bottom: 10px;
    }

    .section-header__badge-icon {
      width: 14px;
      height: 14px;
    }

    .section-header__desc {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }
</style>
