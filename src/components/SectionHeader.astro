---
interface Props {
  badge?: string;
  badgeIcon?: string;
  title: string;
  titleAccent?: string;
  description?: string;
  align?: 'center' | 'left';
  variant?: 'light' | 'dark';
  class?: string;
  id?: string;
}

const {
  title,
  titleAccent,
  description,
  align = 'center',
  variant = 'light',
  class: className = '',
  id,
} = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`, `section-header--${variant}`, className]} id={id}>
  <h2 class="section-header__title">
    {title}
    {titleAccent && <span class="section-header__title-accent"> {titleAccent}</span>}
    <slot name="title-extra" />
  </h2>

  {description && (
    <p class="section-header__desc">{description}</p>
  )}

  <slot />
</div>

<style>
  .section-header {
    margin-bottom: var(--title-area-mb, 40px);
    position: relative;
    z-index: 2;
  }

  .section-header--center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-header--left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* 2. Main Title (H2) */
  .section-header__title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: var(--fluid-h2, clamp(1.75rem, 3.5vw, 2.375rem));
    font-weight: 800;
    line-height: var(--leading-tight, 1.2);
    letter-spacing: -0.02em;
    color: var(--bina-slate-900, #17202A);
    margin-top: 0;
    margin-bottom: 12px;
  }

  .section-header__title-accent {
    color: var(--bina-navy, #22416D);
    background: linear-gradient(135deg, #22416D 0%, #345F99 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 3. Sub-description */
  .section-header__desc {
    font-family: var(--font-body, 'Archivo', sans-serif);
    font-size: var(--text-base, 1rem);
    line-height: var(--leading-relaxed, 1.75);
    color: var(--bina-slate-500, #475569);
    margin: 0;
  }

  .section-header--center .section-header__desc {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-header--left .section-header__desc {
    max-width: 620px;
  }

  /* Dark Variant (e.g. CTA & Counter Sections) */
  .section-header--dark .section-header__title {
    color: #FFFFFF;
  }

  .section-header--dark .section-header__title-accent {
    color: #FFFFFF;
    background: none;
    -webkit-background-clip: unset;
    -webkit-text-fill-color: #FFFFFF;
  }

  .section-header--dark .section-header__desc {
    color: #FFFFFF;
  }

  /* Mobile Responsive Fine-Tuning */
  @media (max-width: 767px) {
    .section-header {
      margin-bottom: 28px;
    }

    .section-header__desc {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }
</style>
