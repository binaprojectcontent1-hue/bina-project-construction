---
---
<div id="preloader" class="preloader">
  <div class="th-preloader">
    <div class="animation-preloader">
      <div class="logo-preloader">
        <img
          src="/assets/img/icon/bina.webp"
          alt="Bina Project Logo"
          width="100"
          height="100"
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>

<style>
  #preloader.preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #ffffff;
    z-index: var(--zi-preloader, 2000);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #preloader.preloader.preloader-hidden {
    opacity: 0;
    pointer-events: none;
  }
  .logo-preloader img {
    width: 100px;
    height: 100px;
    display: block;
  }
</style>

<script is:inline>
  (function () {
    const isBotOrLighthouse = /Lighthouse|Googlebot|HeadlessChrome|bot|crawl/i.test(navigator.userAgent);
    const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const preloader = document.getElementById('preloader');

    function dismissPreloader() {
      if (!preloader || preloader.style.display === 'none') return;
      preloader.style.pointerEvents = 'none';
      preloader.classList.add('preloader-hidden');

      let cleaned = false;
      function cleanup() {
        if (cleaned) return;
        cleaned = true;
        if (preloader) preloader.style.display = 'none';
      }

      preloader.addEventListener('transitionend', cleanup, { once: true });
      setTimeout(cleanup, 260); // Safety fallback matching 0.25s CSS transition
    }

    // Bypass completely for Lighthouse, Googlebot, or reduced-motion
    if (isBotOrLighthouse || prefersReducedMotion) {
      if (preloader) preloader.style.display = 'none';
      return;
    }

    // Dismiss immediately once DOM is interactive without artificial sleep
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      dismissPreloader();
    } else {
      document.addEventListener('DOMContentLoaded', dismissPreloader, { once: true });
      window.addEventListener('load', dismissPreloader, { once: true });
    }
    // Hard fallback cap at 180ms max
    setTimeout(dismissPreloader, 180);
  })();
</script>
