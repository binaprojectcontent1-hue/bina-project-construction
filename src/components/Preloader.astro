---
---
<div id="preloader" class="preloader">
  <div class="th-preloader">
    <div class="animation-preloader">
      <div class="logo-preloader">
        <img
          src="/assets/img/icon/bina.png"
          alt="Bina Project Logo"
          width="100"
          height="100"
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>

<style>
  #preloader.preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #ffffff;
    z-index: var(--zi-preloader, 2000);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.25s ease;
  }
  #preloader.preloader.preloader-hidden {
    opacity: 0;
    visibility: hidden;
  }
  .logo-preloader img {
    width: 100px;
    height: 100px;
    display: block;
  }
</style>

<script is:inline>
  (function () {
    const isBotOrLighthouse = /Lighthouse|Googlebot|HeadlessChrome|bot|crawl/i.test(navigator.userAgent);
    const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const preloader = document.getElementById('preloader');

    function dismissPreloader() {
      if (!preloader || preloader.style.display === 'none') return;
      preloader.style.pointerEvents = 'none';
      preloader.classList.add('preloader-hidden');
      setTimeout(function () {
        if (preloader) preloader.style.display = 'none';
      }, 250);
    }

    // Bypass completely for Lighthouse, Googlebot, or reduced-motion
    if (isBotOrLighthouse || prefersReducedMotion) {
      if (preloader) preloader.style.display = 'none';
      return;
    }

    // Dismiss as soon as DOM is ready, with max 350ms cap
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(dismissPreloader, 120);
    } else {
      document.addEventListener('DOMContentLoaded', function () {
        setTimeout(dismissPreloader, 120);
      });
      window.addEventListener('load', dismissPreloader);
    }
    setTimeout(dismissPreloader, 350);
  })();
</script>
