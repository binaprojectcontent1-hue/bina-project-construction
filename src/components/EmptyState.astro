---
import { Icon } from 'astro-icon/components';

interface Props {
  icon?: string;
  title: string;
  description: string;
  primaryActionText?: string;
  primaryActionHref?: string;
  secondaryActionText?: string;
  secondaryActionHref?: string;
}

const {
  icon = 'solar:folder-open-linear',
  title,
  description,
  primaryActionText = 'Konsultasikan Proyek Anda',
  primaryActionHref = '/contact',
  secondaryActionText = 'Kembali ke Beranda',
  secondaryActionHref = '/',
} = Astro.props;
---

<div class="empty-state-card">
  <div class="empty-icon-wrap">
    <Icon name={icon} width="36" height="36" class="empty-icon" />
  </div>

  <h3 class="empty-title">{title}</h3>
  <p class="empty-desc">{description}</p>

  <div class="empty-actions">
    {primaryActionText && primaryActionHref && (
      <a href={primaryActionHref} class="th-btn style1 th-icon">
        <span>{primaryActionText}</span>
        <Icon name="solar:arrow-right-linear" width="16" height="16" class="ms-2" />
      </a>
    )}
    {secondaryActionText && secondaryActionHref && (
      <a href={secondaryActionHref} class="empty-btn-secondary">
        <span>{secondaryActionText}</span>
      </a>
    )}
  </div>
</div>

<style>
  .empty-state-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 24px;
    background: #FFFFFF;
    border: 1.5px dashed #E2E8F0;
    border-radius: 20px;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    max-width: 680px;
    margin: 20px auto 40px;
    width: 100%;
  }

  .empty-icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: #EFF6FF;
    color: #22416D;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border: 1px solid #DBEAFE;
  }

  .empty-title {
    font-family: var(--font-heading, 'Archivo', sans-serif);
    font-size: 20px;
    font-weight: 700;
    color: #1E293B;
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .empty-desc {
    font-size: 14px;
    color: #64748B;
    max-width: 440px;
    line-height: 1.6;
    margin: 0 0 28px 0;
  }

  .empty-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .empty-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    font-size: 13.5px;
    font-weight: 600;
    color: #475569;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .empty-btn-secondary:hover {
    background: #F1F5F9;
    color: #1E293B;
    border-color: #CBD5E1;
  }

  @media (max-width: 575px) {
    .empty-state-card {
      padding: 40px 18px;
    }
    .empty-actions {
      flex-direction: column;
      width: 100%;
    }
    .empty-actions .th-btn,
    .empty-actions .empty-btn-secondary {
      width: 100%;
    }
  }
</style>
