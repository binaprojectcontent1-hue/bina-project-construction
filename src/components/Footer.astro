---
import { getSiteSettings } from '@lib/siteSettingsService';
import { Icon } from 'astro-icon/components';
import { createWhatsAppUrl } from '@utils/whatsapp';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';

const siteConfig = await getSiteSettings();
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: t('nav.home'), href: getLocalizedPath('/', currentLang) },
  { name: t('nav.about'), href: getLocalizedPath('/about', currentLang) },
  { name: t('nav.portfolio'), href: getLocalizedPath('/portfolio', currentLang) },
  { name: t('nav.liveProjects'), href: `${getLocalizedPath('/about', currentLang)}#proyek-berjalan` },
  { name: t('nav.articles'), href: getLocalizedPath('/blog', currentLang) },
  { name: currentLang === 'en' ? 'Careers' : 'Karir', href: 'https://karir.binaproject.id' },
  { name: t('nav.contact'), href: getLocalizedPath('/contact', currentLang) },
  { name: currentLang === 'en' ? 'Terms & Conditions' : 'Syarat & Ketentuan', href: getLocalizedPath('/syarat-ketentuan', currentLang) },
];

const servicesList = currentLang === 'en' ? [
  { name: 'Planning Drawings', href: getLocalizedPath('/contact', currentLang) },
  { name: 'Area Siteplan Drawings', href: getLocalizedPath('/contact', currentLang) },
  { name: 'Cost Estimation (BOQ/RAB)', href: getLocalizedPath('/contact', currentLang) },
  { name: 'Geoelectric Soil Testing', href: getLocalizedPath('/contact', currentLang) },
  { name: 'Structural Calculations', href: getLocalizedPath('/contact', currentLang) },
  { name: 'Residential/Commercial Building Renovation', href: getLocalizedPath('/contact', currentLang) },
  { name: 'Housing/Commercial Area Development', href: getLocalizedPath('/portfolio', currentLang) },
  { name: 'Leakage Repair', href: getLocalizedPath('/contact', currentLang) },
  { name: 'Waterproofing Works', href: getLocalizedPath('/contact', currentLang) },
  { name: 'PBG/SLF Permit Processing', href: getLocalizedPath('/contact', currentLang) },
  { name: '3D Model Making', href: getLocalizedPath('/contact', currentLang) },
] : [
  { name: 'Gambar Perencanaan', href: '/contact' },
  { name: 'Gambar Siteplan Kawasan', href: '/contact' },
  { name: 'Pembuatan RAB', href: '/contact' },
  { name: 'Uji Tanah Geolistrik', href: '/contact' },
  { name: 'Perhitungan Struktur', href: '/contact' },
  { name: 'Renovasi Rumah Tinggal/Gedung Bertingkat', href: '/contact' },
  { name: 'Pembangunan Kawasan Perumahan/Komersial', href: '/portfolio' },
  { name: 'Perbaikan Kebocoran', href: '/contact' },
  { name: 'Pekerjaan Waterproofing', href: '/contact' },
  { name: 'Pengurusan PBG/SLF', href: '/contact' },
  { name: 'Pembuatan Maket', href: '/contact' },
];

const waFooterMessage = currentLang === 'en'
  ? 'Hello Bina Project Team, I would like to consult on my building project and cost estimation.'
  : 'Halo Tim Arsitek Bina Project, saya ingin konsultasi rencana proyek konstruksi/interior dan estimasi RAB gratis.';
---

<footer class="modern-footer">
  <!--============================== Top Callout Strip (shadcn Style) ==============================-->
  <div class="footer-callout-wrapper">
    <div class="container">
      <div class="footer-callout-card">
        <div class="row align-items-center justify-content-between gy-4">
          <div class="col-lg-7">
            <h3 class="callout-title mb-2">
              {currentLang === 'en' ? 'Safe Solution, Building Your Dream Space' : 'Solusi Aman Membangun Ruang Impian Anda'}
            </h3>
            <p class="callout-desc mb-0">
              {currentLang === 'en' 
                ? 'Discuss design concepts, land surveys and budget calculations with no commitment costs upfront with Bina Project Team.'
                : 'Diskusikan konsep desain, survey lokasi lahan dan kalkulasi anggaran tanpa biaya komitmen di awal Bersama Tim Bina Project'
              }
            </p>
          </div>
          <div class="col-lg-auto">
            <a
              href={createWhatsAppUrl({ customMessage: waFooterMessage, whatsappNumber: siteConfig.contact.whatsappNumber })}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-cta-btn"
            >
              <Icon name="simple-icons:whatsapp" width="20" height="20" class="me-2" />
              <span>{t('footer.ctaButton')}</span>
              <Icon name="solar:arrow-right-up-linear" width="16" height="16" class="ms-2 arrow-icon" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Main 4-Column Bento Area ==============================-->
  <div class="footer-main-area">
    <div class="container">
      <div class="row gy-5 justify-content-between">
        <!-- Col 1: Brand & Profile -->
        <div class="col-lg-4 col-md-6">
          <div class="footer-col pe-xl-4">
            <div class="footer-logo mb-25">
              <a href={getLocalizedPath('/', currentLang)} class="d-inline-block">
                <img src="/assets/img/logo.svg" alt="Bina Project Logo" width="200" height="70" class="logo-brightness" />
              </a>
            </div>
            <p class="footer-bio mb-25">
              {currentLang === 'en'
                ? 'A professional company in planning design, interior contractor,'
                : 'Perusahaan profesional yang bergerak di bidang'
              }<br />
              {currentLang === 'en'
                ? 'construction contractor, and guaranteed waterproofing.'
                : 'desain perencanaan, kontraktor interior,'
              }<br />
              {currentLang === 'en'
                ? ''
                : 'kontraktor konstruksi dan waterproofing dengan'
              }<br />
              {currentLang === 'en'
                ? ''
                : 'garansi'
              }
            </p>
            <div class="footer-social-row">
              {siteConfig.socials.map((social) => (
                <a
                  target="_blank"
                  href={social.url}
                  aria-label={social.label}
                  class="footer-social-circle"
                  rel="noopener noreferrer"
                >
                  <Icon name={social.icon} width="16" height="16" />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Col 2: Navigasi Cepat -->
        <div class="col-lg-2 col-md-6 col-sm-6 col-12">
          <div class="footer-col">
            <h4 class="footer-col-title mb-25">{t('footer.quickLinks')}</h4>
            <ul class="footer-link-list p-0 m-0">
              {quickLinks.map((nav, index) => (
                <li>
                  <a href={nav.href} class="footer-link">
                    <Icon name="solar:alt-arrow-right-linear" width="14" height="14" class="link-chevron me-2" />
                    <span>{index === 0 && currentLang === 'id' ? 'Beranda' : nav.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Col 3: Jasa Layanan -->
        <div class="col-lg-3 col-md-6 col-sm-6 col-12">
          <div class="footer-col">
            <h4 class="footer-col-title mb-25">{currentLang === 'en' ? 'Services' : 'Jasa Layanan'}</h4>
            <ul class="footer-link-list p-0 m-0">
              {servicesList.map((service) => (
                <li>
                  <a href={service.href} class="footer-link">
                    <Icon name="solar:alt-arrow-right-linear" width="14" height="14" class="link-chevron me-2" />
                    <span>{service.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Col 4: Informasi Kontak & Status -->
        <div class="col-lg-3 col-md-6">
          <div class="footer-col">
            <h4 class="footer-col-title mb-25">{currentLang === 'en' ? 'Contact Us' : 'Kontak Kami'}</h4>
            <div class="footer-contact-cards">
              <!-- Address -->
              <a href={siteConfig.contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-card">
                <div class="contact-card-icon">
                  <Icon name="solar:map-point-linear" width="16" height="16" />
                </div>
                <div>
                  <span class="contact-card-label">{currentLang === 'en' ? 'Office' : 'Kantor'}</span>
                  <p class="contact-card-value mb-0">{siteConfig.contact.address}</p>
                </div>
              </a>

              <!-- Phone / WhatsApp -->
              <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-card">
                <div class="contact-card-icon">
                  <Icon name="simple-icons:whatsapp" width="16" height="16" />
                </div>
                <div>
                  <span class="contact-card-label">WhatsApp</span>
                  <p class="contact-card-value mb-0">{siteConfig.contact.phoneDisplay}</p>
                </div>
              </a>

              <!-- Email -->
              <a href={`mailto:${siteConfig.contact.email}`} class="footer-contact-card">
                <div class="contact-card-icon">
                  <Icon name="solar:letter-linear" width="16" height="16" />
                </div>
                <div>
                  <span class="contact-card-label">Email</span>
                  <p class="contact-card-value mb-0">{siteConfig.contact.email}</p>
                </div>
              </a>

               <!-- Jam Operasional -->
               <div class="footer-contact-card">
                 <div class="contact-card-icon">
                   <Icon name="solar:clock-circle-linear" width="16" height="16" />
                 </div>
                 <div>
                   <span class="contact-card-label">{t('footer.officeHoursTitle')}</span>
                   {currentLang === 'en' ? (
                     <>
                       <p class="contact-card-value mb-0">Monday - Saturday: 08.00 - 16.00 WIB</p>
                       <p class="contact-card-value mb-0">Sunday / Public Holidays: Closed</p>
                     </>
                   ) : (
                     <>
                       <p class="contact-card-value mb-0">Hari Senin – Sabtu: 08.00-16.00 WIB</p>
                       <p class="contact-card-value mb-0">Hari Minggu / Tanggal Merah: Libur</p>
                     </>
                   )}
                 </div>
               </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Bottom Copyright Bar ==============================-->
  <div class="footer-copyright-bar">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <p class="copyright-text mb-0">
          &copy; {currentYear} Bina Project
        </p>
        <div class="copyright-links d-flex align-items-center gap-4">
          <a href={getLocalizedPath('/syarat-ketentuan', currentLang)} class="bottom-link">
            {currentLang === 'en' ? 'Terms & Conditions' : 'Syarat & Ketentuan'}
          </a>
          <span class="link-dot">•</span>
          <a href={getLocalizedPath('/about', currentLang)} class="bottom-link">
            {t('nav.about')}
          </a>
          <span class="link-dot">•</span>
          <a href={getLocalizedPath('/contact', currentLang)} class="bottom-link">
            {t('nav.contact')}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .modern-footer {
    position: relative;
    background: var(--bina-gradient-dark, linear-gradient(180deg, #0D192B 0%, #0A1320 100%));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #94A3B8;
    overflow: hidden;
  }

  .footer-callout-wrapper,
  .footer-main-area,
  .footer-copyright-bar {
    position: relative;
    z-index: 2;
  }

  /* Top Callout Strip */
  .footer-callout-wrapper {
    padding-top: 60px;
    padding-bottom: 20px;
  }

  .footer-callout-card {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl, 24px);
    padding: 35px 45px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
  }

  .callout-title {
    color: #FFFFFF;
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .callout-desc {
    color: #94A3B8;
    font-size: 15px;
    line-height: 1.6;
    max-width: 600px;
  }

  .footer-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #008069;
    color: #FFFFFF !important;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    padding: 14px 26px;
    border-radius: var(--radius-full, 9999px);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0, 128, 105, 0.35);
  }

  .footer-cta-btn:hover {
    background-color: #075E54;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 128, 105, 0.5);
    color: #FFFFFF !important;
  }

  .arrow-icon {
    transition: transform 0.3s ease;
  }

  .footer-cta-btn:hover .arrow-icon {
    transform: translate(2px, -2px);
  }

  /* Main Area */
  .footer-main-area {
    padding-top: 40px;
    padding-bottom: 60px;
  }

  .footer-col-title {
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    position: relative;
    display: inline-block;
  }

  .footer-bio {
    font-size: 14px;
    line-height: 1.7;
    color: #94A3B8;
    white-space: pre-wrap;
  }

  .logo-brightness {
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  /* Social Icons */
  .footer-social-row {
    display: flex;
    gap: 10px;
  }

  .footer-social-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #CBD5E1;
    transition: all 0.25s ease;
  }

  .footer-social-circle:hover {
    background: var(--bina-gold, #F68A0A);
    border-color: var(--bina-gold, #F68A0A);
    color: #FFFFFF;
    transform: translateY(-3px);
  }

  /* Links */
  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: #94A3B8;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .link-chevron {
    color: var(--bina-gold, #F68A0A);
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  .footer-link:hover {
    color: #FFFFFF;
    transform: translateX(4px);
  }

  .footer-link:hover .link-chevron {
    opacity: 1;
    transform: translateX(2px);
  }

  /* Contact Cards */
  .footer-contact-cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-contact-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .footer-contact-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
  }

  .contact-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(246, 138, 10, 0.12);
    color: var(--bina-gold, #F68A0A);
    flex-shrink: 0;
  }

  .contact-card-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748B;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .contact-card-value {
    font-size: 13px;
    font-weight: 500;
    color: #CBD5E1;
    line-height: 1.4;
  }

  /* Copyright Bar */
  .footer-copyright-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 24px 0;
    font-size: 13px;
  }

  .copyright-text {
    color: #64748B;
  }

  .copyright-text strong {
    color: #94A3B8;
  }

  .bottom-link {
    color: #64748B;
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 6px;
  }

  .bottom-link:hover {
    color: #F8FAFC;
  }

  .link-dot {
    color: #334155;
    font-size: 10px;
  }

  @media (max-width: 991px) {
    .footer-callout-card {
      padding: 28px 24px;
      text-align: center;
    }
    .callout-desc {
      margin: 0 auto;
    }
    .footer-callout-card .col-lg-auto {
      margin-top: 10px;
    }
  }
</style>
