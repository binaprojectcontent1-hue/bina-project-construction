---
import { siteConfig } from '@config/site';
import { Icon } from 'astro-icon/components';
import { FOOTER_SERVICES, FOOTER_QUICK_LINKS } from '@data/navigation';
import { createWhatsAppUrl } from '@utils/whatsapp';

const currentYear = new Date().getFullYear();
const servicesList = FOOTER_SERVICES;
const quickLinks = FOOTER_QUICK_LINKS;
---

<footer class="modern-footer">
  <!--============================== Top Callout Strip (shadcn Style) ==============================-->
  <div class="footer-callout-wrapper">
    <div class="container">
      <div class="footer-callout-card">
        <div class="row align-items-center justify-content-between gy-4">
          <div class="col-lg-7">
            <h3 class="callout-title mb-2">Siap Mewujudkan Bangunan & Interior Impian Anda?</h3>
            <p class="callout-desc mb-0">
              Diskusikan konsep desain, survei lokasi lahan, dan estimasi anggaran biaya (RAB) tanpa komitmen di awal bersama arsitek kami.
            </p>
          </div>
          <div class="col-lg-auto">
            <a
              href={createWhatsAppUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-cta-btn"
            >
              <Icon name="simple-icons:whatsapp" width="20" height="20" class="me-2" />
              <span>KONSULTASI VIA WHATSAPP</span>
              <Icon name="solar:arrow-right-up-linear" width="16" height="16" class="ms-2 arrow-icon" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Main 4-Column Bento Area ==============================-->
  <div class="footer-main-area">
    <div class="container">
      <div class="row gy-5 justify-content-between">
        <!-- Col 1: Brand & Profile -->
        <div class="col-lg-4 col-md-6">
          <div class="footer-col pe-xl-4">
            <div class="footer-logo mb-25">
              <a href="/" class="d-inline-block">
                <img src="/assets/img/logo.svg" alt="Bina Project Logo" width="200" height="70" class="logo-brightness" />
              </a>
            </div>
            <p class="footer-bio mb-25">
              {siteConfig.description}
            </p>
            <div class="footer-social-row">
              {siteConfig.socials.map((social) => (
                <a
                  target="_blank"
                  href={social.url}
                  aria-label={social.label}
                  class="footer-social-circle"
                  rel="noopener noreferrer"
                >
                  <Icon name={social.icon} width="16" height="16" />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Col 2: Navigasi Cepat -->
        <div class="col-lg-2 col-md-6 col-sm-6 col-12">
          <div class="footer-col">
            <h4 class="footer-col-title mb-25">Navigasi</h4>
            <ul class="footer-link-list p-0 m-0">
              {quickLinks.map((nav) => (
                <li>
                  <a href={nav.href} class="footer-link">
                    <Icon name="solar:alt-arrow-right-linear" width="14" height="14" class="link-chevron me-2" />
                    <span>{nav.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Col 3: Layanan Spesialis -->
        <div class="col-lg-3 col-md-6 col-sm-6 col-12">
          <div class="footer-col">
            <h4 class="footer-col-title mb-25">Layanan Spesialis</h4>
            <ul class="footer-link-list p-0 m-0">
              {servicesList.map((service) => (
                <li>
                  <a href={service.href} class="footer-link">
                    <Icon name="solar:alt-arrow-right-linear" width="14" height="14" class="link-chevron me-2" />
                    <span>{service.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Col 4: Informasi Kontak & Status -->
        <div class="col-lg-3 col-md-6">
          <div class="footer-col">
            <h4 class="footer-col-title mb-25">Kontak & Workshop</h4>
            <div class="footer-contact-cards">
              <!-- Address -->
              <a href={siteConfig.contact.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-card">
                <div class="contact-card-icon">
                  <Icon name="solar:map-point-linear" width="16" height="16" />
                </div>
                <div>
                  <span class="contact-card-label">Studio & Kantor</span>
                  <p class="contact-card-value mb-0">{siteConfig.contact.address}</p>
                </div>
              </a>

              <!-- Phone / WhatsApp -->
              <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-card">
                <div class="contact-card-icon">
                  <Icon name="simple-icons:whatsapp" width="16" height="16" />
                </div>
                <div>
                  <span class="contact-card-label">WhatsApp Hotline</span>
                  <p class="contact-card-value mb-0">{siteConfig.contact.phoneDisplay}</p>
                </div>
              </a>

              <!-- Email -->
              <a href={`mailto:${siteConfig.contact.email}`} class="footer-contact-card">
                <div class="contact-card-icon">
                  <Icon name="solar:letter-linear" width="16" height="16" />
                </div>
                <div>
                  <span class="contact-card-label">Email Resmi</span>
                  <p class="contact-card-value mb-0">{siteConfig.contact.email}</p>
                </div>
              </a>

              <!-- Jam Operasional -->
              <div class="footer-contact-card">
                <div class="contact-card-icon">
                  <Icon name="solar:clock-circle-linear" width="16" height="16" />
                </div>
                <div>
                  <span class="contact-card-label">Jam Operasional</span>
                  <p class="contact-card-value mb-0">{siteConfig.contact.openingHours}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--============================== Bottom Copyright Bar ==============================-->
  <div class="footer-copyright-bar">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <p class="copyright-text mb-0">
          &copy; {currentYear} <strong>{siteConfig.legalName}</strong>. Hak Cipta Dilindungi.
        </p>
        <div class="copyright-links d-flex align-items-center gap-4">
          <a href="/syarat-ketentuan" class="bottom-link">Syarat & Ketentuan</a>
          <span class="link-dot">•</span>
          <a href="/about" class="bottom-link">Tentang Kami</a>
          <span class="link-dot">•</span>
          <a href="/contact" class="bottom-link">Kontak Kami</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .modern-footer {
    position: relative;
    background: var(--bina-gradient-dark, linear-gradient(180deg, #0D192B 0%, #0A1320 100%));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #94A3B8;
    overflow: hidden;
  }

  .footer-callout-wrapper,
  .footer-main-area,
  .footer-copyright-bar {
    position: relative;
    z-index: 2;
  }

  /* Top Callout Strip */
  .footer-callout-wrapper {
    padding-top: 60px;
    padding-bottom: 20px;
  }

  .footer-callout-card {
    background: rgba(34, 65, 109, 0.45);
    border: none;
    border-radius: 20px;
    padding: 35px 40px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .callout-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    background: rgba(132, 172, 223, 0.12);
    border: 1px solid rgba(132, 172, 223, 0.25);
    color: #84ACDF;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
  }

  .callout-title {
    font-size: 26px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.35;
  }

  .callout-desc {
    font-size: 14px;
    color: #94A3B8;
    max-width: 600px;
    line-height: 1.6;
  }

  .footer-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #22416D;
    color: #FFFFFF !important;
    padding: 15px 30px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    border: 1.5px solid #84ACDF;
    box-shadow: 0 4px 16px rgba(34, 65, 109, 0.3);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .footer-cta-btn:hover {
    background: #345F99;
    border-color: #84ACDF;
  }

  .footer-cta-btn .arrow-icon {
    transition: transform 0.2s ease;
  }

  .footer-cta-btn:hover .arrow-icon {
    transform: translate(2px, -2px);
  }

  /* Main Area */
  .footer-main-area {
    padding: 50px 0 60px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .logo-brightness {
    filter: brightness(0) invert(1);
    opacity: 0.95;
    transition: opacity 0.2s ease;
  }

  .logo-brightness:hover {
    opacity: 1;
  }

  .footer-bio {
    font-size: 14px;
    line-height: 1.65;
    color: #94A3B8;
  }

  .footer-social-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-social-circle {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #CBD5E1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .footer-social-circle:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
  }

  .footer-col-title {
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.3px;
    position: relative;
    padding-bottom: 12px;
  }

  .footer-col-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 2px;
    background: #84ACDF;
    border-radius: 2px;
  }

  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    color: #94A3B8;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .link-chevron {
    font-size: 11px;
    color: #94A3B8;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: #84ACDF;
  }

  .footer-link:hover .link-chevron {
    color: #84ACDF;
  }

  /* Contact Cards in Col 4 */
  .footer-contact-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-contact-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: none;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .footer-contact-card:hover {
    background: rgba(132, 172, 223, 0.1);
  }

  .contact-card-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: #84ACDF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .footer-contact-card:hover .contact-card-icon {
    background: #22416D;
    color: #FFFFFF;
  }

  .contact-card-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #94A3B8;
    margin-bottom: 2px;
  }

  .contact-card-value {
    font-size: 13px;
    font-weight: 600;
    color: #E2E8F0;
    line-height: 1.4;
  }

  .footer-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 20px;
    font-size: 13px;
    color: var(--bina-success, #10B981);
    font-weight: 600;
    margin-top: 4px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.05); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }


  /* Copyright Bar */
  .footer-copyright-bar {
    padding: 22px 0;
    background: rgba(0, 0, 0, 0.3);
    font-size: 14px;
    color: #CBD5E1;
  }

  .copyright-text strong {
    color: #FFFFFF;
  }

  .bottom-link {
    color: #CBD5E1;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 8px 6px;
    transition: color 0.2s ease;
  }

  .bottom-link:hover {
    color: #84ACDF;
  }

  .link-dot {
    color: #334155;
    user-select: none;
  }

  .text-cyan {
    color: #84ACDF !important;
  }
</style>
