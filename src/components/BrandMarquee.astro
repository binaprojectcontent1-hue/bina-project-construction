---
import { Image } from 'astro:assets';
import SectionHeader from '@components/SectionHeader.astro';
import partnerBrandsImg from '@assets/images/brand/klien-binaproject.webp';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

interface Props {
  bg?: 'white' | 'slate';
}

const { bg = 'slate' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class:list={['brand-partner-section space', { 'brand-partner-section--white': bg === 'white' }]} id="partner-sec">
  <div class="container text-center">
    <SectionHeader
      badge={t('brandMarquee.badge')}
      badgeIcon="solar:hand-shake-bold"
      title={t('brandMarquee.title')}
      description={t('brandMarquee.desc')}
      align="center"
    />

    <div class="brand-single-wrapper d-flex justify-content-center align-items-center mx-auto text-center">
      <Image
        src={partnerBrandsImg}
        alt={t('brandMarquee.title')}
        class="brand-single-img img-fluid mx-auto d-block"
        loading="lazy"
        decoding="async"
        width={1080}
        height={506}
        quality={92}
        format="webp"
      />
    </div>
  </div>
</section>

<style is:global>
  .brand-partner-section {
    background: var(--bina-slate-50, #F8FAFC);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .brand-partner-section--white {
    background: #FFFFFF !important;
  }

  #partner-sec .brand-single-wrapper {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
    width: 100% !important;
    max-width: 1000px !important;
    padding: 10px 15px;
  }

  #partner-sec .brand-single-img {
    display: block !important;
    margin-left: auto !important;
    margin-right: auto !important;
    width: 100% !important;
    height: auto !important;
    max-width: 960px !important;
    object-fit: contain !important;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  #partner-sec .brand-single-img:hover {
    transform: scale(1.015);
  }

  @media (max-width: 767px) {
    #partner-sec .brand-single-wrapper {
      padding: 5px 10px;
    }
  }
</style>
