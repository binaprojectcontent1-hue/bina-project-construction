---
import { getSiteSettings } from '@lib/siteSettingsService';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';

const siteConfig = await getSiteSettings();

const currentPath = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const navLinks = [
  { name: t('nav.home'), href: getLocalizedPath('/', currentLang), icon: 'solar:home-smile-linear' },
  { name: t('nav.about'), href: getLocalizedPath('/about', currentLang), icon: 'solar:buildings-2-linear' },
  { name: t('nav.portfolio'), href: getLocalizedPath('/portfolio', currentLang), icon: 'solar:gallery-wide-linear' },
  { name: t('nav.liveProjects'), href: `${getLocalizedPath('/about', currentLang)}#proyek-berjalan`, icon: 'solar:map-point-linear' },
  { name: t('nav.articles'), href: getLocalizedPath('/blog', currentLang), icon: 'solar:document-text-linear' },
  { name: t('nav.contact'), href: getLocalizedPath('/contact', currentLang), icon: 'solar:chat-round-dots-linear' },
].map((item) => {
  const isHome = item.href === '/' || item.href === '/en';
  const isActive = isHome ? (currentPath === '/' || currentPath === '/en') : currentPath.startsWith(item.href);
  return { ...item, isActive };
});
---

<div class="th-menu-wrapper custom-mobile-menu">
  <div class="th-menu-area custom-drawer-body">
    <!-- Top Header -->
    <div class="drawer-header d-flex align-items-center justify-content-between pb-20 mb-20 border-bottom">
      <a href={getLocalizedPath('/', currentLang)} class="d-inline-flex align-items-center">
        <img src="/assets/img/logo.svg" alt="Bina Project Logo" width="160" height="56" />
      </a>
      <div class="d-flex align-items-center gap-2">
        <LanguageSwitcher />
        <button type="button" class="th-menu-toggle drawer-close-btn" aria-label={currentLang === 'en' ? 'Close Mobile Menu' : 'Tutup Menu Mobile'}>
          <Icon name="solar:close-circle-linear" width="22" height="22" />
        </button>
      </div>
    </div>

    <!-- Navigation Menu Landmark -->
    <nav class="drawer-nav-section flex-grow-1" aria-label={currentLang === 'en' ? 'Mobile Navigation' : 'Navigasi Menu Mobile'}>
      <div class="drawer-nav-list">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class={`drawer-nav-link ${item.isActive ? 'active' : ''}`}
          >
            <div class="d-flex align-items-center drawer-item-content">
              <div class="drawer-item-icon">
                <Icon name={item.icon} width="18" height="18" />
              </div>
              <span class="drawer-item-text">{item.name}</span>
            </div>
            <Icon name="solar:arrow-right-up-linear" width="16" height="16" class="drawer-arrow" />
          </a>
        ))}
      </div>

      <!-- Micro Studio Info -->
      <div class="drawer-studio-info mt-25 p-3 rounded-3 bg-light border">
        <div class="d-flex align-items-center mb-2">
          <Icon name="solar:pen-new-square-linear" width="14" height="14" class="text-theme me-2" />
          <span class="drawer-studio-name">Bina Project Studio</span>
        </div>
        <p class="mb-0 drawer-studio-address">
          {siteConfig.contact.address}
        </p>
      </div>
    </nav>

    <!-- Bottom Footer Section -->
    <div class="drawer-footer pt-20 mt-auto border-top">
      <a
        href={siteConfig.contact.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="th-btn style1 w-100 py-3 mb-15 text-center d-flex align-items-center justify-content-center drawer-cta-btn"
        onclick="if(typeof window.trackLead==='function') window.trackLead('mobile_drawer_wa', 'mobile_menu');"
      >
        <Icon name="simple-icons:whatsapp" width="18" height="18" class="me-2" /> {t('cta.consultation')}
      </a>

      <div class="d-flex justify-content-center gap-3">
        {siteConfig.socials.map((social) => (
          <a
            target="_blank"
            href={social.url}
            aria-label={social.label}
            class="drawer-social-btn"
            rel="noopener noreferrer"
          >
            <Icon name={social.icon} width="16" height="16" />
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .custom-mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(13, 25, 43, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: var(--zi-drawer, 99999);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    display: flex;
    justify-content: flex-start;
  }

  .custom-mobile-menu.th-body-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .custom-drawer-body {
    width: 85%;
    max-width: 380px;
    height: 100%;
    background: #FFFFFF;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    box-shadow: 8px 0 40px rgba(0, 0, 0, 0.15);
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .custom-mobile-menu.th-body-visible .custom-drawer-body {
    transform: translateX(0);
  }

  .drawer-close-btn {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 1.5px solid #E2E8F0;
    background: #F8FAFC;
    color: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .drawer-close-btn:hover {
    background: #EF4444;
    border-color: #EF4444;
    color: #FFFFFF;
  }

  .drawer-nav-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .drawer-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--bina-slate-700, #334155);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .drawer-nav-link:hover,
  .drawer-nav-link.active {
    background: var(--bina-blue-50, #EFF6FF);
    color: var(--bina-navy, #22416D);
  }

  .drawer-item-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #F1F5F9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bina-navy, #22416D);
  }

  .drawer-arrow {
    color: #94A3B8;
  }

  .drawer-social-btn {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    color: var(--bina-navy, #22416D);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .drawer-social-btn:hover {
    background: var(--bina-navy, #22416D);
    border-color: var(--bina-navy, #22416D);
    color: #FFFFFF;
  }

  .drawer-item-content {
    gap: 12px;
  }

  .drawer-studio-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--bina-slate-900, #17202A);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .drawer-studio-address {
    font-size: 13px;
    color: #334155;
    line-height: 1.5;
  }

  .drawer-cta-btn {
    border-radius: 12px !important;
    font-weight: 700 !important;
    font-size: 14px !important;
  }
</style>

<script>
  // Native Zero-Dependency Mobile Menu Handler
  function initMobileMenu() {
    const menuWrapper = document.querySelector('.custom-mobile-menu') as HTMLElement | null;
    const toggleButtons = document.querySelectorAll('.th-menu-toggle');

    if (!menuWrapper) return;
    if ((menuWrapper as any)._hasMenuHandler) return;
    (menuWrapper as any)._hasMenuHandler = true;

    const closeMenu = () => {
      menuWrapper.classList.remove('th-body-visible');
      document.body.style.overflow = '';
    };

    const toggleMenu = () => {
      const isVisible = menuWrapper.classList.toggle('th-body-visible');
      document.body.style.overflow = isVisible ? 'hidden' : '';
    };

    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        toggleMenu();
      });
    });

    // Close on backdrop click (click outside drawer body)
    menuWrapper.addEventListener('click', (e) => {
      if (e.target === menuWrapper) {
        closeMenu();
      }
    });

    // Close on Escape key press
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuWrapper.classList.contains('th-body-visible')) {
        closeMenu();
      }
    });

    // Close menu when navigating internal link
    const navLinks = menuWrapper.querySelectorAll('.drawer-nav-link');
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>

