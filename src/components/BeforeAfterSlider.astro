---
/**
 * BeforeAfterSlider.astro
 * Interactive Split-Screen Image Comparison Component
 * Apple-grade fluid drag physics, tactile handle, and auto-peek sweep animation.
 */
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';

interface Props {
  beforeImage: any;
  afterImage: any;
  beforeAlt?: string;
  afterAlt?: string;
  title?: string;
  subtitle?: string;
  location?: string;
  duration?: string;
  scope?: string;
  warranty?: string;
  ctaText?: string;
  ctaMessage?: string;
  id?: string;
}

const {
  beforeImage,
  afterImage,
  beforeAlt = 'Kondisi Rumah Sebelum Renovasi',
  afterAlt = 'Hasil Renovasi Fasad Arsitektur Modern Bina Project',
  title = 'Renovasi Total Fasad Rumah Tinggal Tropis',
  subtitle = 'Studi Kasus Transformasi Arsitektur Nyata',
  location = 'Malang, Jawa Timur',
  duration = '60 Hari Kalender',
  scope = 'Fasad Eksterior, Kisi Woodplank & Pagar Modern',
  warranty = 'Garansi Pemeliharaan Resmi SPK',
  ctaText = 'Konsultasi Renovasi Fasad Seperti Ini',
  ctaMessage = 'Halo Tim Arsitek Bina Project, saya melihat studi kasus Before-After Renovasi Fasad di website dan tertarik untuk konsultasi renovasi fasad rumah saya.',
  id = 'showcaseBeforeAfter',
} = Astro.props;

// Optimize images if ImageMetadata is passed
let optimizedBeforeSrc = typeof beforeImage === 'string' ? beforeImage : '';
let optimizedAfterSrc = typeof afterImage === 'string' ? afterImage : '';

if (typeof beforeImage === 'object' && beforeImage !== null) {
  const optBefore = await getImage({ src: beforeImage, format: 'webp', quality: 90, width: 1600 });
  optimizedBeforeSrc = optBefore.src;
}
if (typeof afterImage === 'object' && afterImage !== null) {
  const optAfter = await getImage({ src: afterImage, format: 'webp', quality: 90, width: 1600 });
  optimizedAfterSrc = optAfter.src;
}

const waUrl = `https://wa.me/6281335335304?text=${encodeURIComponent(ctaMessage)}`;
---

<div class="ba-card-wrapper" id={id}>
  <!-- Top Showcase Header -->
  <div class="ba-header-block">
    <div class="ba-kicker-pill">
      <Icon name="solar:magic-stick-3-linear" width="16" height="16" class="kicker-icon" />
      <span>TRANSFORMASI NYATA</span>
    </div>
    <h3 class="ba-main-title">{title}</h3>
    <p class="ba-sub-title">{subtitle}</p>
  </div>

  <!-- Interactive Comparison Canvas -->
  <div class="ba-slider-container" data-ba-slider>
    <div class="ba-viewport">
      <!-- Bottom Layer: AFTER (Transformed) Image -->
      <div class="ba-layer ba-layer-after">
        <img
          src={optimizedAfterSrc}
          alt={afterAlt}
          class="ba-img"
          loading="lazy"
          decoding="async"
        />
        <div class="ba-floating-badge badge-after">
          <span class="badge-dot"></span>
          <span>HASIL BANGUN BINA PROJECT</span>
        </div>
      </div>

      <!-- Top Layer: BEFORE (Existing) Image with Dynamic Clip Path -->
      <div class="ba-layer ba-layer-before" data-before-layer>
        <img
          src={optimizedBeforeSrc}
          alt={beforeAlt}
          class="ba-img"
          loading="lazy"
          decoding="async"
        />
        <div class="ba-floating-badge badge-before">
          <span>SEBELUM (BEFORE)</span>
        </div>
      </div>

      <!-- Tactile Split Handle -->
      <div
        class="ba-handle"
        data-handle
        role="slider"
        tabindex="0"
        aria-label="Geser untuk membandingkan foto sebelum dan sesudah"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
      >
        <div class="ba-line"></div>
        <div class="ba-knob">
          <Icon name="solar:alt-arrow-left-linear" width="13" height="13" class="arrow-left" />
          <Icon name="solar:alt-arrow-right-linear" width="13" height="13" class="arrow-right" />
        </div>
      </div>

      <!-- Hint Tooltip (disappears on first interaction) -->
      <div class="ba-interaction-hint" data-hint>
        <Icon name="solar:hand-shake-linear" width="15" height="15" />
        <span>Geser ke kiri / kanan</span>
      </div>
    </div>
  </div>

  <!-- Project Specs & Action Strip -->
  <div class="ba-specs-footer">
    <div class="ba-specs-grid">
      <div class="spec-item">
        <Icon name="solar:map-point-linear" width="18" height="18" class="spec-icon" />
        <div class="spec-text">
          <span class="spec-label">Lokasi Proyek</span>
          <strong class="spec-value">{location}</strong>
        </div>
      </div>

      <div class="spec-item">
        <Icon name="solar:clock-circle-linear" width="18" height="18" class="spec-icon" />
        <div class="spec-text">
          <span class="spec-label">Durasi Pengerjaan</span>
          <strong class="spec-value">{duration}</strong>
        </div>
      </div>

      <div class="spec-item">
        <Icon name="solar:shield-check-linear" width="18" height="18" class="spec-icon" />
        <div class="spec-text">
          <span class="spec-label">Jaminan Mutu</span>
          <strong class="spec-value">{warranty}</strong>
        </div>
      </div>

      <div class="spec-item d-none d-md-flex">
        <Icon name="solar:settings-linear" width="18" height="18" class="spec-icon" />
        <div class="spec-text">
          <span class="spec-label">Lingkup Pekerjaan</span>
          <strong class="spec-value">{scope}</strong>
        </div>
      </div>
    </div>

    <div class="ba-cta-action">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ba-wa-cta-btn"
        onclick="if(typeof window.trackLead==='function') window.trackLead('before_after_wa_cta', 'portfolio_showcase');"
      >
        <Icon name="simple-icons:whatsapp" width="18" height="18" class="btn-wa-icon" />
        <span>{ctaText}</span>
        <Icon name="solar:arrow-right-up-linear" width="15" height="15" class="btn-arrow" />
      </a>
    </div>
  </div>
</div>

<script>
  function initBeforeAfterSliders() {
    const sliders = document.querySelectorAll('[data-ba-slider]');

    sliders.forEach((sliderEl) => {
      const container = sliderEl as HTMLElement;
      if (container.dataset.baInitialized === 'true') return;
      container.dataset.baInitialized = 'true';

      const handle = container.querySelector('[data-handle]') as HTMLElement;
      const beforeLayer = container.querySelector('[data-before-layer]') as HTMLElement;
      const hint = container.querySelector('[data-hint]') as HTMLElement;

      if (!handle || !beforeLayer) return;

      let isDragging = false;
      let hasInteracted = false;
      let currentPos = 50; // percentage (0 - 100)
      let autoPeekAnimationId: number | null = null;

      // Update position helper
      function setPosition(pos: number) {
        currentPos = Math.max(0, Math.min(100, pos));
        container.style.setProperty('--slider-pos', `${currentPos}%`);
        handle.setAttribute('aria-valuenow', Math.round(currentPos).toString());
      }

      // Initialize at 50%
      setPosition(50);

      // Dismiss interaction hint
      function dismissHint() {
        if (!hasInteracted) {
          hasInteracted = true;
          if (hint) {
            hint.style.opacity = '0';
            setTimeout(() => hint.remove(), 300);
          }
        }
      }

      // Calculate position from pointer event
      function getPosFromEvent(e: MouseEvent | TouchEvent): number {
        const rect = container.getBoundingClientRect();
        const clientX = 'touches' in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
        const relativeX = clientX - rect.left;
        return (relativeX / rect.width) * 100;
      }

      // Drag Handlers
      function onStart(e: MouseEvent | TouchEvent) {
        cancelAutoPeek();
        dismissHint();
        isDragging = true;
        container.classList.add('is-dragging');
        setPosition(getPosFromEvent(e));
      }

      function onMove(e: MouseEvent | TouchEvent) {
        if (!isDragging) return;
        e.preventDefault();
        setPosition(getPosFromEvent(e));
      }

      function onEnd() {
        if (isDragging) {
          isDragging = false;
          container.classList.remove('is-dragging');
        }
      }

      // Touch Events (passive: false to prevent scrolling while dragging)
      handle.addEventListener('touchstart', onStart, { passive: true });
      window.addEventListener('touchmove', onMove, { passive: false });
      window.addEventListener('touchend', onEnd);
      window.addEventListener('touchcancel', onEnd);

      // Mouse Events
      handle.addEventListener('mousedown', onStart);
      container.addEventListener('mousedown', onStart);
      window.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      // Keyboard Accessibility
      handle.addEventListener('keydown', (e: KeyboardEvent) => {
        cancelAutoPeek();
        dismissHint();
        if (e.key === 'ArrowLeft') {
          setPosition(currentPos - 5);
          e.preventDefault();
        } else if (e.key === 'ArrowRight') {
          setPosition(currentPos + 5);
          e.preventDefault();
        } else if (e.key === 'Home') {
          setPosition(0);
          e.preventDefault();
        } else if (e.key === 'End') {
          setPosition(100);
          e.preventDefault();
        }
      });

      // Auto-Peek Sweep Animation (Apple-Grade Fluid Demo)
      function cancelAutoPeek() {
        if (autoPeekAnimationId !== null) {
          cancelAnimationFrame(autoPeekAnimationId);
          autoPeekAnimationId = null;
        }
      }

      function runAutoPeekSweep() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion || hasInteracted) return;

        const duration = 2200; // ms
        const startTime = performance.now();

        function sweepStep(now: number) {
          if (hasInteracted) return;
          const elapsed = now - startTime;
          const progress = Math.min(1, elapsed / duration);

          // Sine-wave oscillation centered around 50% with amplitude 26%
          const offset = Math.sin(progress * Math.PI * 2) * 26 * Math.sin(progress * Math.PI);
          setPosition(50 - offset);

          if (progress < 1) {
            autoPeekAnimationId = requestAnimationFrame(sweepStep);
          } else {
            setPosition(50);
            autoPeekAnimationId = null;
          }
        }

        autoPeekAnimationId = requestAnimationFrame(sweepStep);
      }

      // Trigger auto-peek once when entering viewport
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !hasInteracted) {
              runAutoPeekSweep();
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );

      observer.observe(container);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBeforeAfterSliders);
  } else {
    initBeforeAfterSliders();
  }

  document.addEventListener('astro:page-load', initBeforeAfterSliders);
</script>

<style>
  /* ========================================================
     Before-After Card Shell & Layout
     ======================================================== */
  .ba-card-wrapper {
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    border: 1px solid #E2E8F0;
    border-radius: 24px;
    padding: 32px 32px 28px 32px;
    box-shadow: 0 16px 48px -12px rgba(13, 25, 43, 0.08);
    margin-bottom: 50px;
    position: relative;
    overflow: hidden;
  }

  /* Header Block */
  .ba-header-block {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 28px auto;
  }

  .ba-kicker-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(34, 65, 109, 0.08);
    color: var(--bina-navy, #22416D);
    padding: 6px 14px;
    border-radius: 999px;
    font-family: 'Archivo', sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .kicker-icon {
    color: #0099FF;
  }

  .ba-main-title {
    font-family: 'Titillium Web', 'Archivo', sans-serif;
    font-size: clamp(22px, 3.2vw, 32px);
    font-weight: 700;
    color: #0D192B;
    line-height: 1.25;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .ba-sub-title {
    font-family: 'Archivo', sans-serif;
    font-size: 15px;
    color: #64748B;
    margin-bottom: 0;
    line-height: 1.5;
  }

  /* ========================================================
     Interactive Comparison Canvas (GPU-Accelerated)
     ======================================================== */
  .ba-slider-container {
    --slider-pos: 50%;
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 12px 36px -8px rgba(13, 25, 43, 0.2);
    border: 1px solid rgba(226, 232, 240, 0.8);
    background-color: #0D192B;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }

  .ba-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 580px;
    overflow: hidden;
  }

  .ba-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ba-layer-after {
    z-index: 1;
  }

  .ba-layer-before {
    z-index: 2;
    clip-path: polygon(0 0, var(--slider-pos, 50%) 0, var(--slider-pos, 50%) 100%, 0 100%);
    will-change: clip-path;
  }

  .ba-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    pointer-events: none;
  }

  /* Floating Glass Badges */
  .ba-floating-badge {
    position: absolute;
    top: 20px;
    z-index: 5;
    padding: 7px 16px;
    border-radius: 999px;
    font-family: 'Archivo', sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .badge-before {
    left: 20px;
    background: rgba(13, 25, 43, 0.78);
    color: #F1F5F9;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .badge-after {
    right: 20px;
    background: rgba(13, 25, 43, 0.85);
    color: #FFFFFF;
    border: 1px solid rgba(0, 210, 255, 0.45);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #00D2FF;
    box-shadow: 0 0 8px #00D2FF;
  }

  /* Split Drag Handle */
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--slider-pos, 50%);
    transform: translateX(-50%);
    width: 44px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
    touch-action: none;
    will-change: left;
    outline: none;
  }

  .ba-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5px;
    background: linear-gradient(180deg, rgba(255,255,255,0.4) 0%, #FFFFFF 30%, #00D2FF 70%, rgba(255,255,255,0.4) 100%);
    box-shadow: 0 0 10px rgba(0, 210, 255, 0.8), 0 0 20px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  .ba-knob {
    position: relative;
    z-index: 2;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(8, 20, 38, 0.92);
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5), 0 0 14px rgba(0, 210, 255, 0.6);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease,
                box-shadow 0.25s ease;
  }

  .ba-slider-container.is-dragging .ba-knob,
  .ba-handle:hover .ba-knob,
  .ba-handle:focus-visible .ba-knob {
    transform: scale(1.14);
    border-color: #00D2FF;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.6), 0 0 22px rgba(0, 210, 255, 0.9);
  }

  .ba-knob .arrow-left,
  .ba-knob .arrow-right {
    transition: transform 0.2s ease;
  }

  .ba-slider-container.is-dragging .arrow-left {
    transform: translateX(-1px);
  }
  .ba-slider-container.is-dragging .arrow-right {
    transform: translateX(1px);
  }

  /* Interaction Tooltip Hint */
  .ba-interaction-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 6;
    background: rgba(8, 20, 38, 0.85);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 6px 14px;
    border-radius: 999px;
    font-family: 'Archivo', sans-serif;
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    transition: opacity 0.3s ease;
    animation: hintPulse 2.5s infinite ease-in-out;
  }

  @keyframes hintPulse {
    0%, 100% {
      transform: translateX(-50%) scale(1);
      opacity: 0.9;
    }
    50% {
      transform: translateX(-50%) scale(1.05);
      opacity: 1;
    }
  }

  /* ========================================================
     Project Specs & Direct Action Footer
     ======================================================== */
  .ba-specs-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    margin-top: 10px;
    flex-wrap: wrap;
  }

  .ba-specs-grid {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    flex: 1;
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .spec-icon {
    color: var(--theme-color, #22416D);
    flex-shrink: 0;
  }

  .spec-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .spec-label {
    font-family: 'Archivo', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .spec-value {
    font-family: 'Archivo', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    color: #1E293B;
  }

  /* WhatsApp CTA Button */
  .ba-cta-action {
    flex-shrink: 0;
  }

  .ba-wa-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #22416D 0%, #152B4B 100%);
    color: #FFFFFF !important;
    padding: 12px 24px;
    border-radius: 999px;
    font-family: 'Archivo', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(34, 65, 109, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s ease;
    will-change: transform;
  }

  .ba-wa-cta-btn:hover {
    background: linear-gradient(135deg, #1d3960 0%, #0d1a2d 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(34, 65, 109, 0.35);
  }

  .ba-wa-cta-btn:active {
    transform: scale(0.97) translateY(1px);
    transition: transform 0.12s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-wa-icon {
    color: #25D366;
    flex-shrink: 0;
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .ba-wa-cta-btn:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  /* ========================================================
     Responsive Media Queries
     ======================================================== */
  @media (max-width: 991px) {
    .ba-card-wrapper {
      padding: 24px 20px 20px 20px;
      border-radius: 20px;
    }
    .ba-specs-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }
    .ba-specs-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .ba-wa-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 575px) {
    .ba-viewport {
      aspect-ratio: 4 / 3;
    }
    .ba-floating-badge {
      top: 12px;
      padding: 5px 12px;
      font-size: 10px;
    }
    .badge-before {
      left: 12px;
    }
    .badge-after {
      right: 12px;
    }
    .ba-knob {
      width: 36px;
      height: 36px;
    }
    .ba-specs-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ba-layer-before,
    .ba-handle,
    .ba-knob,
    .ba-wa-cta-btn {
      transition: none !important;
    }
    .ba-interaction-hint {
      animation: none !important;
    }
  }
</style>
