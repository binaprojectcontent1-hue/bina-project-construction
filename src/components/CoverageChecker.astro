---
import { DISTRICT_LOOKUP } from '@data/coverage';

const defaultDistrict = DISTRICT_LOOKUP[0];

const getWaUrl = (district: string) => {
  const text = `Halo Bina Project, saya ingin konsultasi pembangunan/renovasi untuk lokasi saya di ${district}. Apakah bisa dijadwalkan survei lokasi?`;
  return `https://wa.me/6281335335304?text=${encodeURIComponent(text)}`;
};
---

<div class="coverage-checker-card" id="coverageCheckerRoot">
  <div class="checker-card-header">
    <div class="checker-icon-badge">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path><circle cx="12" cy="10" r="3"></circle></svg>
    </div>
    <div>
      <span class="checker-kicker">INTERACTIVE LOGISTICS CALCULATOR</span>
      <h3 class="checker-title">Cek Jangkauan & Estimasi Waktu ke Lokasi Anda</h3>
      <p class="checker-subtitle">
        Pilih atau cari kecamatan proyek Anda di Jawa Timur untuk memeriksa status survei gratis dan estimasi respon tim armada kami.
      </p>
    </div>
  </div>

  <div class="checker-body-grid">
    {/* Form Selection Side */}
    <div class="checker-input-section">
      <label for="district-select" class="checker-label">
        Pilih Kota / Kecamatan Lokasi Proyek:
      </label>
      <div class="select-wrapper">
        <select
          id="district-select"
          class="checker-select-dropdown"
        >
          {DISTRICT_LOOKUP.map((item) => (
            <option value={item.district} selected={item.district === defaultDistrict.district}>
              {item.district} ({item.regionName})
            </option>
          ))}
        </select>
      </div>

      <div class="quick-select-pills">
        <span class="quick-label">Pilihan Populer:</span>
        <button
          type="button"
          class="pill-option active"
          data-district="Lowokwaru"
        >
          Malang Kota
        </button>
        <button
          type="button"
          class="pill-option"
          data-district="Batu"
        >
          Kota Batu
        </button>
        <button
          type="button"
          class="pill-option"
          data-district="Pandaan"
        >
          Pandaan
        </button>
        <button
          type="button"
          class="pill-option"
          data-district="Citraland"
        >
          Surabaya Barat
        </button>
        <button
          type="button"
          class="pill-option"
          data-district="Sidoarjo"
        >
          Sidoarjo
        </button>
      </div>
    </div>

    {/* Dynamic Result Card */}
    <div class="checker-result-section">
      <div class="result-status-banner">
        <div class="status-indicator-badge">
          <span class="status-ping"></span>
          <span class="status-text">TERCAKUP PENUH OLEH TIM OPERASIONAL</span>
        </div>
        <h4 class="result-district-name" id="resDistrictName">{defaultDistrict.district}</h4>
      </div>

      <div class="result-details-grid">
        <div class="result-detail-box">
          <span class="res-label">Status Biaya Survei Tapak:</span>
          <strong class="res-value text-success" id="resSurveyFee">{defaultDistrict.surveyFee}</strong>
        </div>

        <div class="result-detail-box">
          <span class="res-label">Estimasi Waktu Tempuh Armada:</span>
          <strong class="res-value text-theme" id="resTravelEstimate">{defaultDistrict.travelEstimate}</strong>
        </div>

        <div class="result-detail-box full-width">
          <span class="res-label">Pusat Base & Bengkel Fabrikasi:</span>
          <span class="res-desc">
            Studio Arsitek & Workshop Bina Project (Jl. Watumujur II No.6, Kota Malang)
          </span>
        </div>

        <div class="result-detail-box full-width note-box">
          <span class="res-label">Catatan Operasional:</span>
          <p class="res-note-text" id="resNote">{defaultDistrict.note}</p>
        </div>
      </div>

      <div class="result-cta-footer">
        <a
          href={getWaUrl(defaultDistrict.district)}
          target="_blank"
          rel="noopener noreferrer"
          class="checker-submit-cta"
          id="resCtaLink"
        >
          <span>Jadwalkan Survei Tapak di Area Ini</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"></path></svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { DISTRICT_LOOKUP } from '@data/coverage';

  function initCoverageChecker() {
    const root = document.getElementById('coverageCheckerRoot');
    if (!root) return;

    if ((root as any)._isInitialized) return;
    (root as any)._isInitialized = true;

    const selectEl = root.querySelector('#district-select') as HTMLSelectElement | null;
    const nameEl = root.querySelector('#resDistrictName');
    const feeEl = root.querySelector('#resSurveyFee');
    const travelEl = root.querySelector('#resTravelEstimate');
    const noteEl = root.querySelector('#resNote');
    const ctaEl = root.querySelector('#resCtaLink') as HTMLAnchorElement | null;
    const pillButtons = root.querySelectorAll('.pill-option');

    const updateUI = (districtName: string) => {
      const found = DISTRICT_LOOKUP.find((d) => d.district === districtName) || DISTRICT_LOOKUP[0];
      if (!found) return;

      if (nameEl) nameEl.textContent = found.district;
      if (feeEl) feeEl.textContent = found.surveyFee;
      if (travelEl) travelEl.textContent = found.travelEstimate;
      if (noteEl) noteEl.textContent = found.note;

      if (ctaEl) {
        const text = `Halo Bina Project, saya ingin konsultasi pembangunan/renovasi untuk lokasi saya di ${found.district}. Apakah bisa dijadwalkan survei lokasi?`;
        ctaEl.href = `https://wa.me/6281335335304?text=${encodeURIComponent(text)}`;
      }

      if (selectEl && selectEl.value !== found.district) {
        selectEl.value = found.district;
      }

      pillButtons.forEach((btn) => {
        const query = btn.getAttribute('data-district') || '';
        if (query && found.district.toLowerCase().includes(query.toLowerCase())) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    };

    if (selectEl) {
      selectEl.addEventListener('change', () => {
        updateUI(selectEl.value);
      });
    }

    pillButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const query = btn.getAttribute('data-district') || '';
        const match = DISTRICT_LOOKUP.find((d) => d.district.toLowerCase().includes(query.toLowerCase()));
        if (match) {
          updateUI(match.district);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCoverageChecker);
  } else {
    initCoverageChecker();
  }

  document.addEventListener('astro:page-load', initCoverageChecker);
</script>
