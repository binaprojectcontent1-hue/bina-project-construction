---
interface Props {
  colClass?: string;
  type?: 'project' | 'blog';
}

const {
  colClass = 'col-12 col-md-6 col-lg-4',
  type = 'project',
} = Astro.props;
---

<div class={colClass}>
  <div class="skeleton-card-container" aria-hidden="true">
    <div class="skeleton-thumb skeleton-shimmer"></div>
    <div class="skeleton-body">
      {type === 'project' && (
        <div class="skeleton-line skeleton-line--meta skeleton-shimmer"></div>
      )}
      <div class="skeleton-line skeleton-line--title skeleton-shimmer"></div>
      <div class="skeleton-line skeleton-line--sub skeleton-shimmer"></div>
      <div class="skeleton-footer">
        <div class="skeleton-line skeleton-line--btn skeleton-shimmer"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .skeleton-card-container {
    background: #FFFFFF;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    pointer-events: none;
    user-select: none;
  }

  .skeleton-thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: #F1F5F9;
  }

  .skeleton-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .skeleton-line {
    border-radius: 6px;
    background-color: #F1F5F9;
  }

  .skeleton-line--meta {
    width: 35%;
    height: 12px;
  }

  .skeleton-line--title {
    width: 80%;
    height: 18px;
  }

  .skeleton-line--sub {
    width: 60%;
    height: 14px;
  }

  .skeleton-footer {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid #F8FAFC;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .skeleton-line--btn {
    width: 30%;
    height: 14px;
  }
</style>
