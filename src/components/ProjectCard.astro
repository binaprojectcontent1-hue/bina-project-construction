---
import type { Project } from '../types/database';
import { Image } from 'astro:assets';
import { getMediaUrl } from '../lib/cdn';
import { Icon } from 'astro-icon/components';

interface Props {
  project: Project;
  colClass?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
}

const {
  project,
  colClass = 'col-12 col-md-6 col-lg-4 filter-item',
  loading: explicitLoading,
  priority = false,
} = Astro.props;

// Optimized loading strategy for Core Web Vitals (LCP & zero CLS)
const loading = explicitLoading ?? (priority ? 'eager' : 'lazy');
const fetchpriority = priority || loading === 'eager' ? 'high' : 'auto';

// Determine category filter class
const catClass = project.category.toLowerCase().includes('eksterior') 
  ? 'cat1' 
  : project.category.toLowerCase().includes('interior') 
  ? 'cat2' 
  : project.category.toLowerCase().includes('kitchen')
  ? 'cat4'
  : 'cat3';

const coverUrl = getMediaUrl(project.cover_image) || '/assets/img/project/project_1_1.jpg';
---

<div class={`${colClass} ${catClass}`}>
  <article class="editorial-card">
    <!-- Image Media Container (100% Clear & Unshaded) -->
    <div class="card-media">
      <Image
        src={coverUrl}
        alt={`Portofolio ${project.title} - ${project.category} Bina Project`}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        width={600}
        height={400}
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 400px"
      />

      <!-- Floating Category Tag -->
      {project.category && (
        <div class="media-badge-pill">
          <span>{project.category}</span>
        </div>
      )}

      <!-- Floating Lightbox Zoom Button -->
      <a 
        href={coverUrl} 
        class="media-zoom-btn popup-image" 
        aria-label={`Perbesar foto ${project.title}`}
        title="Perbesar Foto"
      >
        <Icon name="solar:magnifer-linear" width="16" height="16" aria-hidden="true" />
      </a>
    </div>

    <!-- Content Tray (Clean & Refined) -->
    <div class="card-body-tray">
      {project.location && (
        <div class="tray-meta">
          <span class="location-tag">
            <Icon name="solar:map-point-linear" width="13" height="13" class="loc-icon" />
            <span>{project.location}</span>
          </span>
        </div>
      )}

      <h3 class="tray-title">
        <a href={`/portfolio/${project.slug}`} class="stretched-link">
          {project.title}
        </a>
      </h3>

      <div class="tray-divider"></div>

      <div class="tray-footer">
        <span class="view-detail-label">Lihat Proyek</span>
        <span class="view-detail-btn" aria-hidden="true">
          <Icon name="solar:arrow-right-linear" width="14" height="14" class="arrow-icon" />
        </span>
      </div>
    </div>
  </article>
</div>

<style>
  /* ==========================================================================
     Architectural Editorial / Minimalist Luxury Portfolio Card (Split Layout)
     Brand Palette strictly derived from #22416D (Bina Project Navy)
     Borderless Luxury Philosophy - Zero Outline / Zero Stroke
     Captivating Micro-Interactions & Shimmer Light Sweep on Hover
     ========================================================================== */
  .editorial-card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background-color: #FFFFFF;
    border: none;
    outline: none;
    box-shadow: 0 4px 20px rgba(34, 65, 109, 0.07), 0 1px 3px rgba(0, 0, 0, 0.04);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .editorial-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 42px -10px rgba(34, 65, 109, 0.22), 0 8px 18px -4px rgba(34, 65, 109, 0.08);
  }

  /* Media Box - 100% Unobstructed, Bright & Sharp */
  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #F1F5F9;
  }

  /* Shimmer / Gleam Sweep on Hover across Photo */
  .card-media::after {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      105deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.28) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-20deg);
    transition: none;
    pointer-events: none;
    z-index: 2;
  }

  .editorial-card:hover .card-media::after {
    left: 160%;
    transition: left 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(1) saturate(1);
    transform: scale(1);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
  }

  .editorial-card:hover .card-media :global(img) {
    transform: scale(1.07);
    filter: brightness(1.02) saturate(1.04);
  }

  /* Floating Category Badge (Frosted Glass Navy Pill) */
  .media-badge-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 3;
    background: rgba(13, 25, 43, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    pointer-events: none;
    transition: background-color 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }

  .editorial-card:hover .media-badge-pill {
    background: #22416D;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(34, 65, 109, 0.3);
  }

  /* Floating Lightbox Zoom Button */
  .media-zoom-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #22416D;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease, color 0.25s ease, box-shadow 0.35s ease, opacity 0.25s ease;
    opacity: 0.85;
    text-decoration: none;
    border: none;
    outline: none;
  }

  .editorial-card:hover .media-zoom-btn {
    opacity: 1;
    background: #FFFFFF;
    color: #22416D;
    transform: scale(1.12) rotate(8deg);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  }

  .media-zoom-btn:hover {
    background: #22416D !important;
    color: #FFFFFF !important;
    transform: scale(1.18) rotate(0deg) !important;
  }

  /* Content Tray - Clean, Elegant & Refined */
  .card-body-tray {
    padding: 18px 20px 18px;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tray-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .location-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #334155;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    transition: color 0.3s ease;
  }

  .loc-icon {
    color: #475569;
    flex-shrink: 0;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .editorial-card:hover .loc-icon {
    color: #22416D;
    transform: translateY(-1px);
  }

  /* Tray Title - Subtle & Balanced */
  .tray-title {
    font-family: var(--title-font, "Titillium Web", sans-serif);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    color: #1E293B;
    margin: 0 0 14px 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tray-title a {
    color: #1E293B;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .editorial-card:hover .tray-title a {
    color: #22416D;
  }

  /* Stretched link covers the entire card */
  .stretched-link::after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    content: "";
  }

  /* Architectural Drafting Line Animation */
  .tray-divider {
    position: relative;
    height: 1px;
    background: #F1F5F9;
    margin-top: auto;
    margin-bottom: 14px;
    overflow: hidden;
    border-radius: 1px;
  }

  .tray-divider::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #22416D 0%, #3B82F6 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-card:hover .tray-divider::after {
    transform: scaleX(1);
  }

  /* Interactive Footer */
  .tray-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2px;
  }

  .view-detail-label {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    color: #475569;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .editorial-card:hover .view-detail-label {
    color: #22416D;
    transform: translateX(2px);
  }

  .view-detail-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #F1F5F9;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .arrow-icon {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-card:hover .view-detail-btn {
    background: #22416D;
    color: #FFFFFF;
    transform: translateX(4px);
    box-shadow: 0 4px 12px rgba(34, 65, 109, 0.28);
  }

  .editorial-card:hover .arrow-icon {
    transform: translateX(2px);
  }

  /* Responsive Design for Mobile & Tablets */
  @media (max-width: 767px) {
    .editorial-card {
      border-radius: 14px;
    }

    .card-body-tray {
      padding: 14px 16px 16px;
    }

    .tray-title {
      font-size: 15.5px;
      margin-bottom: 10px;
    }

    .media-badge-pill {
      top: 10px;
      left: 10px;
      font-size: 9.5px;
      padding: 3px 8px;
    }

    .media-zoom-btn {
      top: 10px;
      right: 10px;
      width: 30px;
      height: 30px;
    }

    .view-detail-btn {
      width: 26px;
      height: 26px;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .editorial-card,
    .card-media :global(img),
    .card-media::after,
    .tray-divider::after,
    .view-detail-label,
    .view-detail-btn,
    .arrow-icon,
    .media-zoom-btn,
    .media-badge-pill {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
