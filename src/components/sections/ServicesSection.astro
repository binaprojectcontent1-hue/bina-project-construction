---
// Services Section with Swiper Carousel
import SectionHeader from '@components/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const services = [
  {
    num: '01',
    icon: 'solar:ruler-cross-pen-bold',
    title: t('servicesSection.s1Title'),
    desc: t('servicesSection.s1Desc'),
  },
  {
    num: '02',
    icon: 'solar:map-point-wave-bold',
    title: t('servicesSection.s2Title'),
    desc: t('servicesSection.s2Desc'),
  },
  {
    num: '03',
    icon: 'solar:calculator-bold',
    title: t('servicesSection.s3Title'),
    desc: t('servicesSection.s3Desc'),
  },
  {
    num: '04',
    icon: 'solar:layers-minimalistic-bold',
    title: t('servicesSection.s4Title'),
    desc: t('servicesSection.s4Desc'),
  },
  {
    num: '05',
    icon: 'solar:structure-bold',
    title: t('servicesSection.s5Title'),
    desc: t('servicesSection.s5Desc'),
  },
  {
    num: '06',
    icon: 'solar:home-add-bold',
    title: t('servicesSection.s6Title'),
    desc: t('servicesSection.s6Desc'),
  },
  {
    num: '07',
    icon: 'solar:city-bold',
    title: t('servicesSection.s7Title'),
    desc: t('servicesSection.s7Desc'),
  },
  {
    num: '08',
    icon: 'solar:waterdrop-bold',
    title: t('servicesSection.s8Title'),
    desc: t('servicesSection.s8Desc'),
  },
  {
    num: '09',
    icon: 'solar:shield-check-bold',
    title: t('servicesSection.s9Title'),
    desc: t('servicesSection.s9Desc'),
  },
  {
    num: '10',
    icon: 'solar:diploma-verified-bold',
    title: t('servicesSection.s10Title'),
    desc: t('servicesSection.s10Desc'),
  },
  {
    num: '11',
    icon: 'solar:box-minimalistic-bold',
    title: t('servicesSection.s11Title'),
    desc: t('servicesSection.s11Desc'),
  },
];
---

<section class="service-area overflow-hidden space" id="service-sec">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <SectionHeader
          badge={t('servicesSection.badge')}
          badgeIcon="solar:widget-2-bold"
          title={t('servicesSection.title')}
          description={t('servicesSection.desc')}
          align="center"
        />
      </div>
    </div>

    <div class="slider-area position-relative">
      <div class="swiper th-slider has-shadow" id="serviceSlider1" data-slider-options='{"breakpoints":{"0":{"slidesPerView":1.18,"spaceBetween":16},"576":{"slidesPerView":1.3,"spaceBetween":20},"768":{"slidesPerView":2,"spaceBetween":24},"992":{"slidesPerView":2,"spaceBetween":24},"1200":{"slidesPerView":3,"spaceBetween":24}}}'>
        <div class="swiper-wrapper">
          {services.map((item) => (
            <div class="swiper-slide">
              <div class="service-box">
                <div class="service-content">
                  <div class="service-box_icon">
                    <Icon name={item.icon} width="32" height="32" />
                  </div>
                  <div class="service-box_number">{item.num}</div>
                </div>
                <h3 class="box-title">{item.title}</h3>
                <p class="service-box_text">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation Arrows for Slider -->
      <div class="service-slider-nav d-flex justify-content-center align-items-center gap-3">
        <button
          type="button"
          data-slider-prev="#serviceSlider1"
          class="service-nav-btn prev-btn"
          aria-label={currentLang === 'en' ? 'Previous Service' : 'Layanan Sebelumnya'}
        >
          <Icon name="solar:alt-arrow-left-linear" width="18" height="18" />
        </button>
        <button
          type="button"
          data-slider-next="#serviceSlider1"
          class="service-nav-btn next-btn"
          aria-label={currentLang === 'en' ? 'Next Service' : 'Layanan Berikutnya'}
        >
          <Icon name="solar:alt-arrow-right-linear" width="18" height="18" />
        </button>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ========================================================
     Services Section - Equal Heights & Zero Layout Shift Fix
     ======================================================== */
  #service-sec {
    background-color: var(--bina-slate-50, #F8FAFC) !important;
    background-image: none !important;
  }

  /* 1. Ensure Swiper tracks stretch slides to uniform height */
  #serviceSlider1 .swiper-wrapper {
    display: flex !important;
    align-items: stretch !important;
  }

  #serviceSlider1 .swiper-slide {
    height: auto !important;
    display: flex !important;
    flex-direction: column !important;
  }

  /* 2. Service Box Base - Scoped to #serviceSlider1, uniform dimensions, hardware acceleration */
  #serviceSlider1 .service-box {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    background-color: #22416D !important;
    background-image: none !important;
    border-radius: 16px !important;
    border: 1px solid var(--bina-slate-200, #E2E8F0) !important;
    overflow: hidden !important;
    position: relative !important;
    z-index: 1 !important;
    padding: 32px 28px !important;
    transform: translateY(0) translateZ(0);
    will-change: transform, box-shadow;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04) !important;
  }

  /* 3. Smooth background fade - eliminates abrupt horizontal wipe */
  #serviceSlider1 .service-box:before {
    content: '' !important;
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background-color: #FFFFFF !important;
    border-radius: 16px !important;
    z-index: 1 !important;
    opacity: 1 !important;
    transition: opacity 0.35s ease !important;
    pointer-events: none !important;
  }

  /* 4. Ensure all inner content sits above background layers */
  #serviceSlider1 .service-box .service-content,
  #serviceSlider1 .service-box .box-title,
  #serviceSlider1 .service-box .service-box_text {
    position: relative !important;
    z-index: 2 !important;
  }

  /* 5. Top Header with Icon & Number */
  #serviceSlider1 .service-box .service-content {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    border-bottom: 2px solid var(--bina-slate-200, #E2E8F0) !important;
    margin-bottom: 24px !important;
    padding-bottom: 24px !important;
    transition: border-color 0.35s ease !important;
  }

  #serviceSlider1 .service-box .service-box_icon {
    width: 58px !important;
    height: 58px !important;
    border-radius: 12px !important;
    background: #EFF6FF !important;
    color: #22416D !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    transition: all 0.35s ease !important;
  }

  #serviceSlider1 .service-box:hover .service-box_icon {
    background: rgba(255, 255, 255, 0.18) !important;
    color: #FFFFFF !important;
    transform: scale(1.06);
  }

  #serviceSlider1 .service-box .box-title {
    margin-bottom: 10px !important;
    font-size: 19px !important;
    font-weight: 700 !important;
    color: var(--bina-slate-900, #17202A) !important;
    transition: color 0.35s ease !important;
    line-height: 1.3 !important;
  }

  #serviceSlider1 .service-box .service-box_number {
    font-size: 18px !important;
    font-weight: 700 !important;
    line-height: 28px !important;
    color: #475569 !important;
    transition: color 0.35s ease !important;
  }

  /* 6. Service Description - Strictly preserved line-height and metrics */
  #serviceSlider1 .service-box .service-box_text {
    font-size: 14px !important;
    line-height: 1.7 !important;
    color: #475569 !important;
    margin-bottom: 0 !important;
    flex-grow: 1 !important;
    transition: color 0.35s ease !important;
  }

  /* ========================================================
     HOVER STATES - Purely Visual (Zero Layout Shifts)
     ======================================================== */
  #serviceSlider1 .service-box:hover {
    transform: translateY(-6px) translateZ(0) !important;
    background-image: none !important;
    box-shadow: 0 16px 36px rgba(34, 65, 109, 0.28) !important;
  }

  #serviceSlider1 .service-box:hover:before {
    opacity: 0 !important;
    width: 100% !important;
  }

  #serviceSlider1 .service-box:hover .box-title {
    color: #FFFFFF !important;
  }

  #serviceSlider1 .service-box:hover .service-box_text {
    color: #E2E8F0 !important;
    line-height: 1.7 !important;
  }

  #serviceSlider1 .service-box:hover .service-box_number {
    color: #84ACDF !important; /* Soft ice blue accent */
    font-weight: 700 !important; /* Strictly matching default state */
  }

  #serviceSlider1 .service-box:hover .service-content {
    border-bottom-color: rgba(255, 255, 255, 0.18) !important;
  }

  /* Slider Navigation Buttons */
  .service-slider-nav {
    margin-top: 36px;
  }

  .service-nav-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    color: #22416D;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(34, 65, 109, 0.08);
    transition: all 0.25s ease;
  }

  .service-nav-btn:hover {
    background: #22416D;
    color: #FFFFFF;
    border-color: #22416D;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(34, 65, 109, 0.25);
  }

  @media (max-width: 575px) {
    #serviceSlider1 .service-box {
      padding: 24px 20px !important;
      border-radius: 14px !important;
    }
    #serviceSlider1 .service-box .service-box_icon {
      width: 48px !important;
      height: 48px !important;
      border-radius: 10px !important;
    }
    #serviceSlider1 .service-box .box-title {
      font-size: 18px !important;
      margin-bottom: 10px !important;
    }
    #serviceSlider1 .service-box .service-box_text {
      font-size: 13.5px !important;
      line-height: 1.6 !important;
    }
    #serviceSlider1 .service-content {
      padding-bottom: 16px !important;
      margin-bottom: 16px !important;
    }
  }
</style>

