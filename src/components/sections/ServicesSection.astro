---
// Services Section with Swiper Carousel
import SectionHeader from '@components/SectionHeader.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="service-area overflow-hidden space" id="service-sec" data-bg-src="/assets/img/bg/service_bg_1.jpg">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <SectionHeader
          badge={t('servicesSection.badge')}
          badgeIcon="solar:widget-2-bold"
          title={t('servicesSection.title')}
          description={t('servicesSection.desc')}
          align="center"
        />
      </div>
    </div>

    <div class="slider-area">
      <div class="swiper th-slider has-shadow" id="serviceSlider1" data-slider-options='{"breakpoints":{"0":{"slidesPerView":1},"576":{"slidesPerView":1},"768":{"slidesPerView":2},"992":{"slidesPerView":2},"1200":{"slidesPerView":3}}}'>
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="service-box">
              <div class="service-content">
                <div class="service-box_icon">
                  <img src="/assets/img/icon/service_1_1.svg" alt="Konstruksi Icon" width="60" height="60" />
                </div>
                <div class="service-box_number">01</div>
              </div>
              <h3 class="box-title">{t('servicesSection.s1Title')}</h3>
              <p class="service-box_text">
                {t('servicesSection.s1Desc')}
              </p>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="service-box">
              <div class="service-content">
                <div class="service-box_icon">
                  <img src="/assets/img/icon/service_1_2.svg" alt="Interior Icon" width="60" height="60" />
                </div>
                <div class="service-box_number">02</div>
              </div>
              <h3 class="box-title">{t('servicesSection.s2Title')}</h3>
              <p class="service-box_text">
                {t('servicesSection.s2Desc')}
              </p>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="service-box">
              <div class="service-content">
                <div class="service-box_icon">
                  <img src="/assets/img/icon/service_1_3.svg" alt="Developer Icon" width="60" height="60" />
                </div>
                <div class="service-box_number">03</div>
              </div>
              <h3 class="box-title">{t('servicesSection.s3Title')}</h3>
              <p class="service-box_text">
                {t('servicesSection.s3Desc')}
              </p>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="service-box">
              <div class="service-content">
                <div class="service-box_icon">
                  <img src="/assets/img/icon/service_1_4.svg" alt="Desain Perencanaan Icon" width="60" height="60" />
                </div>
                <div class="service-box_number">04</div>
              </div>
              <h3 class="box-title">{t('servicesSection.s4Title')}</h3>
              <p class="service-box_text">
                {t('servicesSection.s4Desc')}
              </p>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="service-box">
              <div class="service-content">
                <div class="service-box_icon">
                  <img src="/assets/img/icon/service_1_5.svg" alt="Maket Icon" width="60" height="60" />
                </div>
                <div class="service-box_number">05</div>
              </div>
              <h3 class="box-title">{currentLang === 'en' ? 'Architectural Model & Scale Maquette' : 'Maket'}</h3>
              <p class="service-box_text">
                {currentLang === 'en' ? 'Accurate scale models for architectural visualization, residential developments, and commercial planning.' : 'Miniatur 3D berskala akurat untuk visualisasi arsitektur, kawasan perumahan, dan fasilitas publik secara nyata.'}
              </p>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="service-box">
              <div class="service-content">
                <div class="service-box_icon">
                  <img src="/assets/img/icon/service_1_6.svg" alt="Waterproofing Icon" width="60" height="60" />
                </div>
                <div class="service-box_number">06</div>
              </div>
              <h3 class="box-title">{t('servicesSection.s6Title')}</h3>
              <p class="service-box_text">
                {t('servicesSection.s6Desc')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ========================================================
     Services Section - Equal Heights & Zero Layout Shift Fix
     ======================================================== */
  /* 1. Ensure Swiper tracks stretch slides to uniform height */
  #serviceSlider1 .swiper-wrapper {
    display: flex !important;
    align-items: stretch !important;
  }

  #serviceSlider1 .swiper-slide {
    height: auto !important;
    display: flex !important;
    flex-direction: column !important;
  }

  /* 2. Service Box Base - Scoped to #serviceSlider1, uniform dimensions, hardware acceleration */
  #serviceSlider1 .service-box {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    background-color: #22416D !important;
    background-image: none !important;
    border-radius: 16px !important;
    overflow: hidden !important;
    position: relative !important;
    z-index: 1 !important;
    padding: 32px 28px !important;
    transform: translateY(0) translateZ(0);
    will-change: transform, box-shadow;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04) !important;
  }

  /* 3. Smooth background fade - eliminates abrupt horizontal wipe */
  #serviceSlider1 .service-box:before {
    content: '' !important;
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background-color: #FFFFFF !important;
    border-radius: 16px !important;
    z-index: 1 !important;
    opacity: 1 !important;
    transition: opacity 0.35s ease !important;
    pointer-events: none !important;
  }

  /* 4. Ensure all inner content sits above background layers */
  #serviceSlider1 .service-box .service-content,
  #serviceSlider1 .service-box .box-title,
  #serviceSlider1 .service-box .service-box_text {
    position: relative !important;
    z-index: 2 !important;
  }

  /* 5. Top Header with Icon & Number */
  #serviceSlider1 .service-box .service-content {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    border-bottom: 2px solid var(--bina-slate-200, #E2E8F0) !important;
    margin-bottom: 24px !important;
    padding-bottom: 24px !important;
    transition: border-color 0.35s ease !important;
  }

  #serviceSlider1 .service-box .box-title {
    margin-bottom: 10px !important;
    font-size: 19px !important;
    font-weight: 700 !important;
    color: var(--bina-slate-900, #17202A) !important;
    transition: color 0.35s ease !important;
    line-height: 1.3 !important;
  }

  #serviceSlider1 .service-box .service-box_number {
    font-size: 18px !important;
    font-weight: 700 !important;
    line-height: 28px !important;
    color: #475569 !important;
    transition: color 0.35s ease !important;
  }

  /* 6. Service Description - Strictly preserved line-height and metrics */
  #serviceSlider1 .service-box .service-box_text {
    font-size: 14px !important;
    line-height: 1.7 !important;
    color: #475569 !important;
    margin-bottom: 0 !important;
    flex-grow: 1 !important;
    transition: color 0.35s ease !important;
  }

  /* ========================================================
     HOVER STATES - Purely Visual (Zero Layout Shifts)
     ======================================================== */
  #serviceSlider1 .service-box:hover {
    transform: translateY(-6px) translateZ(0) !important;
    background-image: none !important;
    box-shadow: 0 16px 36px rgba(34, 65, 109, 0.28) !important;
  }

  #serviceSlider1 .service-box:hover:before {
    opacity: 0 !important;
    width: 100% !important;
  }

  #serviceSlider1 .service-box:hover .box-title {
    color: #FFFFFF !important;
  }

  #serviceSlider1 .service-box:hover .service-box_text {
    color: #E2E8F0 !important;
    line-height: 1.7 !important;
  }

  #serviceSlider1 .service-box:hover .service-box_number {
    color: #84ACDF !important; /* Soft ice blue accent */
    font-weight: 700 !important; /* Strictly matching default state */
  }

  #serviceSlider1 .service-box:hover .service-content {
    border-bottom-color: rgba(255, 255, 255, 0.18) !important;
  }
</style>

