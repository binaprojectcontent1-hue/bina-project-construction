---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import SectionHeader from '@components/SectionHeader.astro';
import consultationImg from '@assets/images/normal/consultation_img.jpg';
import consultationThumb from '@assets/images/normal/image.png';
import { createWhatsAppUrl } from '@utils/whatsapp';
import { getSiteSettings } from '@lib/siteSettingsService';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';

const siteConfig = await getSiteSettings();
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const waConsultationUrl = createWhatsAppUrl({
  whatsappNumber: siteConfig.contact.whatsappNumber,
  customMessage: currentLang === 'en'
    ? 'Hello Bina Project Team, I would like to consult on architectural construction/interior plans and request a free cost estimate.'
    : 'Halo Tim Arsitek Bina Project, saya ingin konsultasi rencana proyek konstruksi/interior dan estimasi RAB gratis.',
});
---

<section class="consultation-sec bg-title position-relative overflow-hidden" data-bg-src="/assets/img/bg/shape_bg_2.png">
  <div class="container">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-lg-7">
        <div class="consultation-title-area">
          <SectionHeader
            badge={t('consultationCta.badge')}
            badgeIcon="solar:chat-round-call-bold"
            title={t('consultationCta.title')}
            description={t('consultationCta.desc')}
            align="left"
            variant="dark"
            class="mb-20"
          />
          <div class="d-flex flex-wrap gap-3 consultation-cta-actions">
            <a
              href={waConsultationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="th-btn style1 th-icon d-inline-flex align-items-center btn-whatsapp-cta"
              onclick="if(typeof window.trackLead==='function') window.trackLead('consultation_sec_wa', 'homepage');"
            >
              <Icon name="simple-icons:whatsapp" width="18" height="18" class="me-2" />
              {t('consultationCta.btnWa')}
            </a>
            <a href={getLocalizedPath('/contact', currentLang)} class="th-btn style3 th-icon d-inline-flex align-items-center">
              {t('consultationCta.btnSurvey')} <Icon name="solar:arrow-right-linear" width="16" height="16" class="ms-2" />
            </a>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <figure class="consultation-photo">
          <Image
            src={consultationImg}
            alt={currentLang === 'en' ? 'Architectural Design & Construction Consultation Bina Project' : 'Konsultasi Desain & Konstruksi Bangunan Bina Project'}
            loading="lazy"
            decoding="async"
            width={880}
            height={660}
            format="webp"
            quality={85}
          />
          <figcaption class="consultation-float movingX">
            <Image
              src={consultationThumb}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              width={68}
              height={74}
              format="webp"
              quality={80}
            />
            <span class="consultation-float-text">
              <strong>{t('consultationCta.freeTitle')}</strong>
              <small>{t('consultationCta.freeSub')}</small>
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .consultation-sec {
    padding: 72px 0 96px;
  }
  .consultation-title-area {
    max-width: 100%;
  }
  .consultation-cta-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .consultation-cta-actions .th-btn {
    flex: 0 0 auto;
    width: auto;
    white-space: nowrap;
    padding: 19px 24px;
    font-size: 13.5px;
  }
  .consultation-photo {
    position: relative;
    margin: 0;
    border-radius: 22px;
    overflow: visible;
  }
  .consultation-photo > img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }
  .consultation-float {
    position: absolute;
    left: 18px;
    bottom: -22px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 12px 18px 12px 14px;
    border-radius: 16px;
    background: rgba(13, 25, 43, 0.72);
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }
  .consultation-float img {
    width: 34px;
    height: auto;
    flex-shrink: 0;
  }
  .consultation-float-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .consultation-float-text strong {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #ffffff;
    white-space: nowrap;
  }
  .consultation-float-text small {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.72);
    white-space: nowrap;
  }
  @media (max-width: 1199px) {
    .consultation-cta-actions .th-btn {
      padding: 17px 18px;
      font-size: 13px;
    }
  }
  @media (max-width: 991px) {
    .consultation-photo {
      max-width: 560px;
    }
    .consultation-float {
      bottom: -18px;
    }
  }
  @media (max-width: 767px) {
    .consultation-sec {
      padding: 56px 0 76px;
    }
  }
  @media (max-width: 575px) {
    .consultation-cta-actions {
      flex-direction: column;
      width: 100%;
    }
    .consultation-cta-actions .th-btn {
      width: 100%;
      justify-content: center;
    }
    .consultation-float {
      left: 12px;
      padding: 10px 14px 10px 12px;
    }
    .consultation-float img {
      width: 28px;
    }
    .consultation-float-text strong {
      font-size: 13px;
    }
    .consultation-float-text small {
      font-size: 11px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .consultation-float.movingX {
      animation: none;
    }
  }

  .btn-whatsapp-cta {
    background-color: #008069 !important;
    border-color: #008069 !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 15px rgba(0, 128, 105, 0.4) !important;
  }
</style>
