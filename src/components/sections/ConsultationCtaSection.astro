---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import SectionHeader from '@components/SectionHeader.astro';
import consultationImg from '@assets/images/normal/consultation_img.jpg';
import consultationThumb from '@assets/images/normal/image.png';
import { createWhatsAppUrl } from '@utils/whatsapp';
import { getSiteSettings } from '@lib/siteSettingsService';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';

const siteConfig = await getSiteSettings();
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const waConsultationUrl = createWhatsAppUrl({
  whatsappNumber: siteConfig.contact.whatsappNumber,
  customMessage: currentLang === 'en'
    ? 'Hello Bina Project Team, I would like to consult on architectural construction/interior plans and request a free cost estimate.'
    : 'Halo Tim Arsitek Bina Project, saya ingin konsultasi rencana proyek konstruksi/interior dan estimasi RAB gratis.',
});
---

<section class="consultation-sec bg-title position-relative overflow-hidden" data-bg-src="/assets/img/bg/shape_bg_2.png">
  <div class="consultation-thumb">
    <div class="shape_1"></div>
    <div class="shape_2"></div>
    <Image
      src={consultationImg}
      alt={currentLang === 'en' ? 'Architectural Design & Construction Consultation Bina Project' : 'Konsultasi Desain & Konstruksi Bangunan Bina Project'}
      loading="lazy"
      decoding="async"
      width={580}
      height={620}
      format="webp"
      quality={85}
    />
  </div>
  <div class="container">
    <div class="row align-items-end flex-md-row-reverse">
      <div class="col-md-8">
        <div class="consultation-title-area">
          <SectionHeader
            badge={t('consultationCta.badge')}
            badgeIcon="solar:chat-round-call-bold"
            title={t('consultationCta.title')}
            description={t('consultationCta.desc')}
            align="left"
            variant="dark"
            class="mb-30"
          />
          <div class="d-flex flex-wrap gap-3">
            <a
              href={waConsultationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="th-btn style1 th-icon d-inline-flex align-items-center"
              style="background-color: #25D366; border-color: #25D366; color: #FFFFFF; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);"
              onclick="if(typeof window.trackLead==='function') window.trackLead('consultation_sec_wa', 'homepage');"
            >
              <Icon name="simple-icons:whatsapp" width="18" height="18" class="me-2" />
              {t('consultationCta.btnWa')}
            </a>
            <a href={getLocalizedPath('/contact', currentLang)} class="th-btn style3 th-icon d-inline-flex align-items-center">
              {t('consultationCta.btnSurvey')} <Icon name="solar:arrow-right-linear" width="16" height="16" class="ms-2" />
            </a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="consultation-image movingX">
          <Image 
            src={consultationThumb} 
            alt="Konsultasi Bina Project" 
            loading="lazy" 
            decoding="async" 
            width={362} 
            height={527} 
            format="webp" 
            quality={85} 
          />
        </div>
      </div>
    </div>
  </div>
</section>
