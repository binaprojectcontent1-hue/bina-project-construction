---
/**
 * @file FaqSection.astro
 * @description Modern, high-performance FAQ section with floating search bar,
 * smart multi-term token matching, quick keyword chips, segmented category dock,
 * sticky architect consultation sidebar, dynamic search highlighting, smooth
 * borderless/stroke-free accordion, and multi-channel bottom CTA.
 */
import { Icon } from 'astro-icon/components';
import SectionHeader from '@components/SectionHeader.astro';
import { getFaqs, FAQ_CATEGORIES, generateFaqSchema } from '@data/faqs';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getWhatsAppUrl } from '@config/site';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const isEn = currentLang === 'en';

const faqs = getFaqs(currentLang);
const faqSchema = generateFaqSchema(faqs);
const categories = (Object.entries(FAQ_CATEGORIES) as [string, { label: string; icon: string }][]).map(([key, item]) => {
  let label = item.label;
  if (isEn) {
    if (key === 'biaya') label = 'Cost & Payments';
    else if (key === 'proses') label = 'Process & Timeline';
    else if (key === 'material') label = 'Materials & Tech';
    else if (key === 'garansi') label = 'Warranty & Services';
  }
  return [key, { ...item, label }] as [string, { label: string; icon: string }];
});

// Popular questions for quick jump
const popularFaqs = faqs.slice(0, 4);

// Suggested quick search keyword chips
const quickSearchChips = isEn
  ? ['Cost Estimate', 'Free Survey', 'Milestone Terms', 'Warranty', 'Kitchen Set', 'Waterproofing']
  : ['Estimasi RAB', 'Survei Gratis', 'Sistem Termin', 'Garansi', 'Kitchen Set', 'Waterproofing'];
---

<section class="faq-section" id="faq-sec">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />


  <div class="faq-container">
    <!-- Section Header -->
    <SectionHeader
      badge={t('faq.badge')}
      badgeIcon="solar:chat-round-dots-linear"
      title={t('faq.title')}
      titleAccent={t('faq.titleAccent')}
      description={t('faq.desc')}
      align="center"
    />

    <!-- Search Bar & Quick Suggestion Chips (Borderless Floating Card) -->
    <div class="faq-search-card">
      <div class="faq-search-input-wrap">
        <Icon name="solar:magnifer-linear" width="22" height="22" class="faq-search-icon" />
        <input
          type="text"
          id="faq-search-input"
          class="faq-search-input"
          placeholder={t('faq.searchPlaceholder')}
          autocomplete="off"
          aria-label={isEn ? "Search FAQ questions" : "Cari pertanyaan FAQ"}
        />
        <div class="faq-search-meta">
          <span id="faq-search-count" class="faq-search-count">{faqs.length} {t('faq.questionsCount')}</span>
          <button type="button" id="faq-search-clear" class="faq-search-clear" aria-label={isEn ? "Clear search" : "Hapus pencarian"} style="display: none;">
            <Icon name="solar:close-circle-linear" width="18" height="18" />
          </button>
          <span class="faq-search-kbd" title={isEn ? "Press Esc to reset" : "Tekan Esc untuk reset"}>ESC</span>
        </div>
      </div>

      <!-- Quick Chips -->
      <div class="faq-quick-chips">
        <span class="faq-quick-label">{isEn ? 'Popular Topics:' : 'Topik Populer:'}</span>
        <div class="faq-chips-list">
          {quickSearchChips.map((chip) => (
            <button type="button" class="faq-chip-btn" data-chip={chip}>
              {chip}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Segmented Floating Category Dock (Borderless) -->
    <div class="faq-dock-container">
      <div class="faq-dock" role="tablist" aria-label={isEn ? "FAQ Category Filter" : "Filter Kategori FAQ"}>
        <button class="faq-dock-tab faq-dock-tab--active" data-category="all" role="tab" aria-selected="true">
          <Icon name="solar:widget-linear" width="18" height="18" class="faq-dock-icon" />
          <span>{isEn ? 'All Topics' : 'Semua Topik'}</span>
          <span class="faq-dock-badge">{faqs.length}</span>
        </button>
        {categories.map(([key, { label, icon }]) => {
          const count = faqs.filter((f) => f.category === key).length;
          return (
            <button class="faq-dock-tab" data-category={key} role="tab" aria-selected="false">
              <Icon name={icon} width="18" height="18" class="faq-dock-icon" />
              <span>{label}</span>
              <span class="faq-dock-badge">{count}</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="faq-layout">
      <!-- Sticky Sidebar -->
      <aside class="faq-sidebar">
        <!-- 1. Live Architect Consultation Card -->
        <div class="faq-card-consult">
          <div class="faq-consult-header">
            <div class="faq-consult-icon-box">
              <Icon name="simple-icons:whatsapp" width="18" height="18" />
            </div>
            <span class="faq-consult-speed">
              <Icon name="solar:clock-circle-linear" width="14" height="14" />
              {isEn ? 'Response < 15 Mins' : 'Respon < 15 Mnt'}
            </span>
          </div>

          <div class="faq-consult-body">
            <h3 class="faq-consult-title">{isEn ? 'Direct WhatsApp Consultation' : 'Konsultasi Langsung via WhatsApp'}</h3>
            <p class="faq-consult-desc">
              {isEn
                ? 'Have custom floor plan requirements, technical questions, or need a preliminary BOQ estimate? Our architects are ready to assist with no upfront fee.'
                : 'Punya kebutuhan denah custom, pertanyaan teknis, atau ingin estimasi RAB awal? Arsitek kami siap membantu tanpa biaya.'}
            </p>
          </div>

          <a
            href={getWhatsAppUrl(
              isEn
                ? "Hello Bina Project, I would like to consult regarding construction/interior projects"
                : "Halo Bina Project, saya ingin konsultasi mengenai proyek konstruksi/interior",
              currentLang
            )}
            target="_blank"
            rel="noopener noreferrer"
            class="faq-consult-btn"
          >
            <Icon name="simple-icons:whatsapp" width="18" height="18" />
            <span>{isEn ? 'Chat Our Architect' : 'Chat WhatsApp'}</span>
            <Icon name="solar:arrow-right-linear" width="16" height="16" class="faq-consult-arrow" />
          </a>
        </div>

        <!-- 2. Trust Pillars Card (Borderless) -->
        <div class="faq-card-trust">
          <h4 class="faq-trust-title">{isEn ? 'Bina Service Guarantees' : 'Jaminan Layanan Bina'}</h4>
          <ul class="faq-trust-list">
            <li class="faq-trust-item">
              <div class="faq-trust-icon-box">
                <Icon name="solar:users-group-rounded-bold" width="16" height="16" />
              </div>
              <div class="faq-trust-text">
                <strong>{isEn ? 'Competent' : 'Berkompeten'}</strong>
                <span>{isEn ? 'Professional & Experienced Team' : 'Tim Profesional dan Berpengalaman'}</span>
              </div>
            </li>
            <li class="faq-trust-item">
              <div class="faq-trust-icon-box">
                <Icon name="solar:shield-check-bold" width="16" height="16" />
              </div>
              <div class="faq-trust-text">
                <strong>{isEn ? 'Warrantied' : 'Bergaransi'}</strong>
                <span>{isEn ? 'Maintenance Period for Every Project' : 'Masa Pemeliharaan di Setiap Pekerjaan'}</span>
              </div>
            </li>
            <li class="faq-trust-item">
              <div class="faq-trust-icon-box">
                <Icon name="solar:ruler-cross-pen-bold" width="16" height="16" />
              </div>
              <div class="faq-trust-text">
                <strong>{isEn ? 'Neat' : 'Rapi'}</strong>
                <span>{isEn ? 'Guaranteed Neater & Solution-Oriented' : 'Jaminan Lebih Rapi & Solutif'}</span>
              </div>
            </li>
            <li class="faq-trust-item">
              <div class="faq-trust-icon-box">
                <Icon name="solar:restart-circle-bold" width="16" height="16" />
              </div>
              <div class="faq-trust-text">
                <strong>{isEn ? 'Sustainable' : 'Berkelanjutan'}</strong>
                <span>{isEn ? 'Post-Maintenance Support Services' : 'Layanan Pasca Masa Pemeliharaan Selesai'}</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- 3. Popular Questions Quick Jump (Borderless) -->
        <div class="faq-card-popular">
          <h4 class="faq-popular-title">
            <Icon name="solar:star-bold" width="16" height="16" class="faq-popular-star" />
            {isEn ? 'Popular Questions' : 'Pertanyaan Populer'}
          </h4>
          <div class="faq-popular-list">
            {popularFaqs.map((faq, i) => (
              <button type="button" class="faq-popular-item" data-popular-index={i}>
                <span class="faq-popular-num">0{i + 1}</span>
                <span class="faq-popular-text">{faq.question}</span>
                <Icon name="solar:arrow-right-linear" width="14" height="14" class="faq-popular-arrow" />
              </button>
            ))}
          </div>
        </div>
      </aside>

      <!-- Right Column: Accordion Items (Borderless & Stroke-Free) -->
      <main class="faq-main">
        <!-- Results Status Bar -->
        <div class="faq-status-bar">
          <span class="faq-status-text">
            {isEn ? 'Showing' : 'Menampilkan'} <strong id="faq-count-live">{faqs.length}</strong> {isEn ? 'questions' : 'pertanyaan'}
          </span>
          <button type="button" id="faq-expand-all" class="faq-expand-all-btn">
            {isEn ? 'Expand All' : 'Buka Semua'}
          </button>
        </div>

        <!-- Accordion Container -->
        <div class="faq-accordion" id="faq-accordion">
          {faqs.map((faq, index) => (
            <details
              class="faq-item"
              data-category={faq.category}
              data-index={index}
              open={index === 0}
            >
              <summary class="faq-item__header">
                <div class="faq-item__num-wrap">
                  <span class="faq-item__num">{String(index + 1).padStart(2, '0')}</span>
                </div>
                <div class="faq-item__content-header">
                  <h3 class="faq-item__question">{faq.question}</h3>
                </div>
                <div class="faq-item__action">
                  <div class="faq-item__toggle-circle">
                    <Icon name="solar:alt-arrow-down-linear" width="18" height="18" class="faq-item__chevron" />
                  </div>
                </div>
              </summary>

              <div class="faq-item__body">
                <div class="faq-item__body-inner">
                  <p class="faq-item__answer">{faq.answer}</p>

                  <!-- Contextual CTA for items mentioning WhatsApp or consultation -->
                  {(faq.answer.includes('WhatsApp') || faq.answer.includes('+62 81-335-335-304') || faq.answer.includes('RAB') || faq.answer.includes('BOQ')) && (
                    <div class="faq-item__cta-box">
                      <div class="faq-item__cta-content">
                        <Icon name="simple-icons:whatsapp" width="18" height="18" class="faq-item__cta-wa-icon" />
                        <span>{isEn ? 'Consult on this topic directly with our team via WhatsApp' : 'Konsultasi topik ini langsung dengan tim kami via WhatsApp'}</span>
                      </div>
                      <a
                        href={getWhatsAppUrl(
                          isEn
                            ? `Hello Bina Project, I would like to consult regarding: "${faq.question}"`
                            : `Halo Bina Project, saya ingin konsultasi mengenai pertanyaan: "${faq.question}"`,
                          currentLang
                        )}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="faq-item__cta-link"
                      >
                        {isEn ? 'Contact WhatsApp →' : 'Hubungi WhatsApp →'}
                      </a>
                    </div>
                  )}

                  <!-- Micro-interaction footer: Feedback & Share -->
                  <div class="faq-item__footer">
                    <div class="faq-feedback-wrap">
                      <span class="faq-feedback-label">{isEn ? 'Was this helpful?' : 'Apakah ini membantu?'}</span>
                      <button type="button" class="faq-vote-btn" data-vote="yes" title={isEn ? 'Yes, helpful' : 'Ya, membantu'}>
                        👍 {isEn ? 'Yes' : 'Ya'}
                      </button>
                      <button type="button" class="faq-vote-btn" data-vote="no" title={isEn ? 'Not helpful' : 'Kurang membantu'}>
                        👎 {isEn ? 'No' : 'Kurang'}
                      </button>
                    </div>

                    <button
                      type="button"
                      class="faq-share-btn"
                      data-question={faq.question}
                      data-index={index}
                      title={isEn ? 'Copy link to this question' : 'Salin tautan pertanyaan ini'}
                    >
                      <Icon name="solar:document-text-linear" width="15" height="15" />
                      <span>{isEn ? 'Copy Question' : 'Salin Pertanyaan'}</span>
                    </button>
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>

        <!-- Empty State (Borderless) -->
        <div class="faq-empty" id="faq-empty" style="display: none;">
          <div class="faq-empty__icon-wrap">
            <Icon name="solar:magnifer-zoom-in-linear" width="44" height="44" class="faq-empty__icon" />
          </div>
          <h3 class="faq-empty__title">{isEn ? 'No Matching Questions Found' : 'Pertanyaan Tidak Ditemukan'}</h3>
          <p class="faq-empty__desc">
            {isEn ? 'No answers matched keyword' : 'Tidak ada jawaban yang cocok dengan kata kunci'} <span id="faq-empty-query" class="faq-empty-query"></span>.
            {isEn
              ? 'Please try another keyword or discuss directly with our architect.'
              : 'Silakan coba kata kunci lain atau diskusikan langsung dengan arsitek kami.'}
          </p>
          <div class="faq-empty__actions">
            <button type="button" id="faq-reset-search" class="faq-empty-btn faq-empty-btn--reset">
              {isEn ? 'Reset Search' : 'Reset Pencarian'}
            </button>
            <a
              href={getWhatsAppUrl(
                isEn
                  ? "Hello Bina Project, I have a question regarding services"
                  : "Halo Bina Project, saya ingin bertanya seputar layanan",
                currentLang
              )}
              target="_blank"
              rel="noopener noreferrer"
              class="faq-empty-btn faq-empty-btn--wa"
            >
              <Icon name="simple-icons:whatsapp" width="16" height="16" />
              <span>{isEn ? 'Ask on WhatsApp' : 'Tanya Langsung via WhatsApp'}</span>
            </a>
          </div>
        </div>
      </main>
    </div>

    <!-- Bottom Master CTA Bento Card (Borderless) -->
    <div class="faq-bottom-bento">
      <div class="faq-bento-content">
        <div class="faq-bento-badge">
          <Icon name="solar:chat-round-call-bold" width="16" height="16" />
          <span>{isEn ? 'Bina Project Advisory Services' : 'Layanan Konsultasi Bina Project'}</span>
        </div>
        <h3 class="faq-bento-title">
          {isEn
            ? 'Still Have Questions or Doubts About Your Project?'
            : 'Masih Ada Pertanyaan Seputar Proyek Anda?'}
        </h3>
        <p class="faq-bento-desc">
          {isEn
            ? 'Discuss floor plans, renovation needs, material specifications, and schedule an on-site survey directly with our lead architects & estimators.'
            : 'Diskusikan denah, kebutuhan renovasi, spesifikasi material, dan jadwal survei lokasi langsung dengan tim kami.'}
        </p>
      </div>

      <div class="faq-bento-actions">
        <a
          href={getWhatsAppUrl(
            isEn
              ? "Hello Bina Project, I would like to consult on a project"
              : "Halo Bina Project, saya ingin konsultasi proyek",
            currentLang
          )}
          target="_blank"
          rel="noopener noreferrer"
          class="faq-bento-btn faq-bento-btn--wa"
        >
          <Icon name="simple-icons:whatsapp" width="18" height="18" />
          <span>Chat WhatsApp</span>
        </a>
        <a href={isEn ? '/en/contact' : '/contact'} class="faq-bento-btn faq-bento-btn--outline">
          <span>{isEn ? 'Schedule On-Site Survey' : 'Jadwalkan Survei Lokasi'}</span>
          <Icon name="solar:arrow-right-linear" width="16" height="16" />
        </a>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="faq-toast" class="faq-toast" role="status" aria-live="polite">
    <Icon name="solar:check-circle-bold" width="18" height="18" class="faq-toast-icon" />
    <span id="faq-toast-msg">Tautan pertanyaan disalin!</span>
  </div>
</section>

<style>
  /* ==============================================================================
     FAQ SECTION - BORDERLESS / NO-OUTLINE DESIGN
     ============================================================================== */
  .faq-section {
    position: relative;
    padding: var(--space-section-desktop, 90px) 0;
    background: #FFFFFF;
    overflow: hidden;
    color: var(--bina-slate-900, #17202A);
    font-family: var(--font-body, 'Archivo', sans-serif);
    scroll-margin-top: 110px;
  }
  @media (max-width: 991px) {
    .faq-section {
      padding: var(--space-section-tablet, 65px) 0;
    }
  }
  @media (max-width: 767px) {
    .faq-section {
      padding: var(--space-section-mobile, 45px) 0;
    }
  }


  .faq-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  /* ----------------------------------------------------------------------------
     1. Search Card & Chips (Borderless)
     ---------------------------------------------------------------------------- */
  .faq-search-card {
    max-width: 760px;
    margin: 0 auto 36px;
    background: var(--bina-slate-50, #F8FAFC);
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    border-radius: 20px;
    padding: 14px 18px 16px;
    box-shadow: 0 4px 24px rgba(34, 65, 109, 0.04);
    transition: box-shadow 0.25s ease, transform 0.2s ease;
  }
  .faq-search-card:focus-within {
    box-shadow: 0 8px 32px rgba(34, 65, 109, 0.12);
  }
  .faq-search-input-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 4px 12px;
  }
  .faq-search-icon {
    color: var(--bina-navy, #22416D);
    flex-shrink: 0;
    opacity: 0.85;
  }
  .faq-search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 15px;
    font-family: inherit;
    color: var(--bina-slate-900, #17202A);
    background: transparent;
  }
  .faq-search-input::placeholder {
    color: var(--bina-slate-500, #64748B);
    font-size: 14px;
  }
  .faq-search-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .faq-search-count {
    font-size: 12px;
    font-weight: 700;
    color: var(--bina-navy, #22416D);
    background: rgba(34, 65, 109, 0.07);
    padding: 4px 10px;
    border-radius: 9999px;
  }
  .faq-search-clear {
    background: none;
    border: none;
    color: var(--bina-slate-500, #64748B);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, background 0.2s;
  }
  .faq-search-clear:hover {
    color: var(--bina-navy, #22416D);
    background: rgba(34, 65, 109, 0.08);
  }
  .faq-search-kbd {
    display: inline-block;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
    font-family: monospace;
    color: var(--bina-slate-500, #64748B);
    background: var(--bina-slate-100, #F1F5F9);
    border: none;
    border-radius: 6px;
  }

  /* Quick Chips (Borderless) */
  .faq-quick-chips {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .faq-quick-chips::-webkit-scrollbar {
    display: none;
  }
  .faq-quick-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--bina-slate-500, #64748B);
    white-space: nowrap;
  }
  .faq-chips-list {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .faq-chip-btn {
    font-size: 12px;
    font-weight: 600;
    color: var(--bina-slate-700, #334155);
    background: var(--bina-slate-100, #F1F5F9);
    border: none;
    border-radius: 9999px;
    padding: 4px 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .faq-chip-btn:hover,
  .faq-chip-btn--active {
    background: var(--bina-navy, #22416D);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(34, 65, 109, 0.2);
  }

  /* ----------------------------------------------------------------------------
     2. Segmented Category Dock (Borderless)
     ---------------------------------------------------------------------------- */
  .faq-dock-container {
    display: flex;
    justify-content: center;
    margin-bottom: 44px;
    overflow-x: auto;
    padding: 4px;
    scrollbar-width: none;
  }
  .faq-dock-container::-webkit-scrollbar {
    display: none;
  }
  .faq-dock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bina-slate-50, #F8FAFC);
    padding: 6px;
    border-radius: 9999px;
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    box-shadow: 0 4px 20px rgba(34, 65, 109, 0.05);
  }
  .faq-dock-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: var(--bina-slate-500, #475569);
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }
  .faq-dock-tab:hover {
    color: var(--bina-navy, #22416D);
    background: rgba(34, 65, 109, 0.04);
  }
  .faq-dock-tab--active {
    background: var(--bina-navy, #22416D) !important;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(34, 65, 109, 0.25);
  }
  .faq-dock-icon {
    flex-shrink: 0;
  }
  .faq-dock-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    background: rgba(34, 65, 109, 0.08);
    color: inherit;
    transition: background 0.2s;
  }
  .faq-dock-tab--active .faq-dock-badge {
    background: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
  }

  /* ----------------------------------------------------------------------------
     3. Two-Column Layout
     ---------------------------------------------------------------------------- */
  .faq-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 36px;
    align-items: start;
  }

  /* ----------------------------------------------------------------------------
     4. Sticky Sidebar Cards (Borderless)
     ---------------------------------------------------------------------------- */
  .faq-sidebar {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Card 1: Consult (Unified Slate Card) */
  .faq-card-consult {
    background: var(--bina-slate-50, #F8FAFC);
    border-radius: 20px;
    padding: 24px 22px;
    color: var(--bina-slate-900, #17202A);
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    box-shadow: 0 4px 20px rgba(34, 65, 109, 0.04);
    position: relative;
    overflow: hidden;
  }
  .faq-consult-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .faq-consult-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(34, 65, 109, 0.08);
    color: var(--bina-navy, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .faq-consult-speed {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: var(--bina-slate-500, #64748B);
  }
  .faq-consult-title {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 8px;
    color: var(--bina-slate-900, #17202A);
    font-family: var(--font-display, 'Archivo', sans-serif);
  }
  .faq-consult-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--bina-slate-600, #475569);
    margin: 0 0 20px;
  }
  .faq-consult-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 18px;
    border-radius: 12px;
    background: #25D366;
    color: #FFFFFF;
    border: none;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.25);
  }
  .faq-consult-btn:hover {
    background: #1EBE5D;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
  }
  .faq-consult-arrow {
    transition: transform 0.2s ease;
  }
  .faq-consult-btn:hover .faq-consult-arrow {
    transform: translateX(3px);
  }

  /* Card 2: Trust Pillars */
  .faq-card-trust {
    background: var(--bina-slate-50, #F8FAFC);
    border-radius: 20px;
    padding: 24px 22px;
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    box-shadow: 0 4px 20px rgba(34, 65, 109, 0.04);
  }
  .faq-trust-title {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bina-navy, #22416D);
    margin: 0 0 14px;
  }
  .faq-trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-trust-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .faq-trust-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 65, 109, 0.08);
    color: var(--bina-navy, #22416D);
    flex-shrink: 0;
  }
  .faq-trust-text {
    display: flex;
    flex-direction: column;
  }
  .faq-trust-text strong {
    font-size: 13px;
    font-weight: 700;
    color: var(--bina-slate-900, #17202A);
  }
  .faq-trust-text span {
    font-size: 12px;
    color: var(--bina-slate-500, #64748B);
    line-height: 1.35;
  }

  /* Card 3: Popular Questions */
  .faq-card-popular {
    background: var(--bina-slate-50, #F8FAFC);
    border-radius: 20px;
    padding: 24px 22px;
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    box-shadow: 0 4px 20px rgba(34, 65, 109, 0.04);
  }
  .faq-popular-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bina-navy, #22416D);
    margin: 0 0 14px;
  }
  .faq-popular-star {
    color: #F59E0B;
  }
  .faq-popular-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .faq-popular-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border: none;
    background: transparent;
    border-radius: 10px;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s ease, transform 0.2s ease;
    width: 100%;
  }
  .faq-popular-item:hover {
    background: rgba(34, 65, 109, 0.05);
    transform: translateX(2px);
  }
  .faq-popular-num {
    font-size: 11px;
    font-weight: 800;
    color: var(--bina-navy, #22416D);
    background: rgba(34, 65, 109, 0.08);
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .faq-popular-text {
    flex: 1;
    font-size: 12px;
    font-weight: 600;
    color: var(--bina-slate-700, #334155);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .faq-popular-arrow {
    color: var(--bina-slate-400, #94A3B8);
    flex-shrink: 0;
    transition: transform 0.2s, color 0.2s;
  }
  .faq-popular-item:hover .faq-popular-arrow {
    color: var(--bina-navy, #22416D);
    transform: translateX(3px);
  }

  /* ----------------------------------------------------------------------------
     5. Accordion Area (Borderless / No Outlines)
     ---------------------------------------------------------------------------- */
  .faq-main {
    min-width: 0;
  }
  .faq-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding: 0 4px;
  }
  .faq-status-text {
    font-size: 13px;
    color: var(--bina-slate-500, #64748B);
  }
  .faq-status-text strong {
    color: var(--bina-navy, #22416D);
  }
  .faq-expand-all-btn {
    background: none;
    border: none;
    color: var(--bina-navy, #22416D);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    padding: 0;
  }
  .faq-expand-all-btn:hover {
    color: var(--bina-navy-hover, #1B3457);
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Individual Card */
  .faq-item {
    background: var(--bina-slate-50, #F8FAFC);
    border-radius: 16px;
    border: 1px solid var(--bina-slate-200, #E2E8F0);
    box-shadow: 0 2px 10px rgba(34, 65, 109, 0.04);
    overflow: hidden;
    transition: box-shadow 0.25s ease, transform 0.2s ease;
  }
  .faq-item:hover {
    box-shadow: 0 6px 22px rgba(34, 65, 109, 0.08);
  }
  .faq-item[open] {
    box-shadow: 0 8px 30px rgba(34, 65, 109, 0.1);
  }

  /* Header */
  .faq-item__header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background 0.2s ease;
  }
  .faq-item__header::-webkit-details-marker { display: none; }
  .faq-item__header::marker { content: ''; }
  .faq-item[open] .faq-item__header {
    background: #F1F5F9;
  }

  .faq-item__num-wrap {
    flex-shrink: 0;
  }
  .faq-item__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--bina-slate-100, #F1F5F9);
    color: var(--bina-slate-700, #334155);
    font-size: 13px;
    font-weight: 800;
    font-family: var(--font-display, 'Archivo', sans-serif);
    transition: all 0.25s ease;
  }
  .faq-item[open] .faq-item__num {
    background: var(--bina-navy, #22416D);
    color: #FFFFFF;
  }

  .faq-item__content-header {
    flex: 1;
    min-width: 0;
  }
  .faq-item__question {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--bina-slate-900, #17202A);
    line-height: 1.45;
    margin: 0;
    transition: color 0.2s ease;
  }
  .faq-item:hover .faq-item__question {
    color: var(--bina-navy, #22416D);
  }

  /* Toggle Circle */
  .faq-item__action {
    flex-shrink: 0;
  }
  .faq-item__toggle-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bina-slate-100, #F1F5F9);
    color: var(--bina-slate-700, #334155);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }
  .faq-item[open] .faq-item__toggle-circle {
    background: var(--bina-navy, #22416D);
    color: #FFFFFF;
    transform: rotate(180deg);
  }
  .faq-item__chevron {
    transition: transform 0.25s ease;
  }

  /* Body */
  .faq-item__body {
    padding: 0 24px 24px;
    background: #FFFFFF;
    border: none;
    border-top: 1px solid var(--bina-slate-200, #E2E8F0);
    animation: faqFadeSlide 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes faqFadeSlide {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .faq-item__body-inner {
    padding-top: 18px;
  }
  .faq-item__answer {
    font-size: 15px;
    line-height: 1.8;
    color: var(--bina-slate-700, #334155);
    margin: 0 0 16px;
  }

  /* Contextual Inline CTA (No border) */
  .faq-item__cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    background: #ECFDF5;
    border: none;
    border-radius: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .faq-item__cta-content {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #065F46;
  }
  .faq-item__cta-wa-icon {
    color: #10B981;
    flex-shrink: 0;
  }
  .faq-item__cta-link {
    font-size: 13px;
    font-weight: 800;
    color: #047857;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .faq-item__cta-link:hover {
    text-decoration: underline;
    transform: translateX(2px);
  }

  /* Footer: Feedback & Share (No border) */
  .faq-item__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    border: none;
    flex-wrap: wrap;
  }
  .faq-feedback-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .faq-feedback-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--bina-slate-500, #64748B);
  }
  .faq-vote-btn {
    background: #FFFFFF;
    border: none;
    box-shadow: 0 1px 4px rgba(34, 65, 109, 0.06);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--bina-slate-700, #334155);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .faq-vote-btn:hover {
    background: var(--bina-slate-100, #F1F5F9);
  }
  .faq-vote-btn--voted {
    background: var(--bina-navy, #22416D) !important;
    color: #FFFFFF !important;
  }

  .faq-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    color: var(--bina-slate-500, #64748B);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  .faq-share-btn:hover {
    color: var(--bina-navy, #22416D);
    background: rgba(34, 65, 109, 0.05);
  }

  /* Hidden Item State */
  .faq-item--hidden {
    display: none !important;
  }

  /* Search Highlight */
  :global(.faq-hl) {
    background: #FEF08A;
    color: #854D0E;
    padding: 1px 4px;
    border-radius: 4px;
    font-weight: 700;
  }

  /* ----------------------------------------------------------------------------
     6. Empty State (Borderless)
     ---------------------------------------------------------------------------- */
  .faq-empty {
    text-align: center;
    padding: 56px 24px;
    background: #FFFFFF;
    border-radius: 20px;
    border: none;
    box-shadow: 0 4px 24px rgba(34, 65, 109, 0.05);
  }
  .faq-empty__icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(34, 65, 109, 0.06);
    color: var(--bina-navy, #22416D);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
  }
  .faq-empty__title {
    font-size: 18px;
    font-weight: 800;
    color: var(--bina-slate-900, #17202A);
    margin: 0 0 8px;
  }
  .faq-empty__desc {
    font-size: 14px;
    color: var(--bina-slate-500, #64748B);
    max-width: 460px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }
  .faq-empty-query {
    font-weight: 700;
    color: var(--bina-navy, #22416D);
  }
  .faq-empty__actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .faq-empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .faq-empty-btn--reset {
    background: var(--bina-slate-100, #F1F5F9);
    color: var(--bina-slate-700, #334155);
    border: none;
  }
  .faq-empty-btn--reset:hover {
    background: var(--bina-slate-200, #E2E8F0);
  }
  .faq-empty-btn--wa {
    background: #075E54;
    color: #FFFFFF;
    border: none;
  }
  .faq-empty-btn--wa:hover {
    background: #054C44;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(7, 94, 84, 0.3);
  }

  /* ----------------------------------------------------------------------------
     7. Bottom Bento Master CTA (Borderless)
     ---------------------------------------------------------------------------- */
  .faq-bottom-bento {
    margin-top: 60px;
    background: linear-gradient(135deg, #182C49 0%, #22416D 70%, #152742 100%);
    border-radius: 24px;
    padding: 44px 48px;
    color: #FFFFFF;
    border: none;
    box-shadow: 0 16px 40px rgba(13, 25, 43, 0.15);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    position: relative;
    overflow: hidden;
  }
  .faq-bottom-bento::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(132, 172, 223, 0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .faq-bento-content {
    flex: 1;
    position: relative;
    z-index: 1;
  }
  .faq-bento-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.12);
    border: none;
    padding: 5px 14px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    color: var(--bina-blue-ice, #84ACDF);
    margin-bottom: 12px;
  }
  .faq-bento-title {
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 10px;
    color: #FFFFFF;
    font-family: var(--font-display, 'Archivo', sans-serif);
  }
  .faq-bento-desc {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    max-width: 540px;
  }
  .faq-bento-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }
  .faq-bento-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    border-radius: 12px;
    font-size: 13.5px;
    font-weight: 800;
    border: none;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    font-family: var(--font-display, 'Archivo', sans-serif);
  }
  .faq-bento-btn--wa {
    background: #25D366;
    color: #064E3B;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
  }
  .faq-bento-btn--wa:hover {
    background: #1EBE5D;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45);
  }
  .faq-bento-btn--phone {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    border: none;
  }
  .faq-bento-btn--phone:hover {
    background: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
  }
  .faq-bento-btn--outline {
    background: #FFFFFF;
    color: var(--bina-navy, #22416D);
    border: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  }
  .faq-bento-btn--outline:hover {
    background: #F1F5F9;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  /* ----------------------------------------------------------------------------
     8. Toast
     ---------------------------------------------------------------------------- */
  .faq-toast {
    position: fixed;
    bottom: 28px;
    right: 28px;
    background: #1E293B;
    color: #FFFFFF;
    padding: 12px 20px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    z-index: 9999;
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .faq-toast--show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .faq-toast-icon {
    color: #10B981;
    flex-shrink: 0;
  }

  /* ----------------------------------------------------------------------------
     9. Responsive Breakpoints
     ---------------------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .faq-layout {
      grid-template-columns: 300px 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 899px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
    .faq-sidebar {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .faq-card-consult {
      grid-column: 1 / -1;
    }
    .faq-bottom-bento {
      flex-direction: column;
      text-align: center;
      padding: 36px 28px;
    }
    .faq-bento-desc {
      max-width: none;
    }
    .faq-bento-actions {
      justify-content: center;
      width: 100%;
    }
    .faq-bento-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .faq-sidebar {
      grid-template-columns: 1fr;
    }
    .faq-search-card {
      padding: 12px 14px 14px;
      margin-bottom: 24px;
    }
    .faq-search-input {
      font-size: 14px;
    }
    .faq-search-kbd {
      display: none;
    }
    .faq-item__header {
      padding: 16px 18px;
      gap: 12px;
    }
    .faq-item__num {
      width: 32px;
      height: 32px;
      font-size: 12px;
    }
    .faq-item__question {
      font-size: 14.5px;
    }
    .faq-item__body {
      padding: 0 18px 20px;
    }
    .faq-item__footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .faq-chip-btn {
      min-height: 44px;
      padding: 8px 16px;
      display: inline-flex;
      align-items: center;
    }
    .faq-dock-tab {
      min-height: 44px;
      padding: 10px 18px;
    }
    .faq-vote-btn {
      min-height: 44px;
      min-width: 68px;
      padding: 8px 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .faq-share-btn {
      min-height: 44px;
      padding: 8px 14px;
      display: inline-flex;
      align-items: center;
    }
    .faq-search-clear {
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const searchClear = document.getElementById('faq-search-clear') as HTMLElement | null;
    const searchCountBadge = document.getElementById('faq-search-count') as HTMLElement | null;
    const countLive = document.getElementById('faq-count-live') as HTMLElement | null;
    const dockTabs = document.querySelectorAll<HTMLElement>('.faq-dock-tab');
    const chipBtns = document.querySelectorAll<HTMLButtonElement>('.faq-chip-btn');
    const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    const emptyState = document.getElementById('faq-empty');
    const emptyQueryEl = document.getElementById('faq-empty-query');
    const resetSearchBtn = document.getElementById('faq-reset-search');
    const expandAllBtn = document.getElementById('faq-expand-all');
    const popularBtns = document.querySelectorAll<HTMLElement>('.faq-popular-item');
    const shareBtns = document.querySelectorAll<HTMLButtonElement>('.faq-share-btn');
    const voteBtns = document.querySelectorAll<HTMLButtonElement>('.faq-vote-btn');
    const toast = document.getElementById('faq-toast');
    const toastMsg = document.getElementById('faq-toast-msg');

    let activeCategory = 'all';
    let allExpanded = false;

    // Cache original innerHTML of question and answer for highlight resets
    const originalTexts = new Map<HTMLElement, { question: string; answer: string }>();
    faqItems.forEach((item) => {
      const qEl = item.querySelector('.faq-item__question') as HTMLElement | null;
      const aEl = item.querySelector('.faq-item__answer') as HTMLElement | null;
      if (qEl && aEl) {
        originalTexts.set(item, {
          question: qEl.textContent || '',
          answer: aEl.textContent || '',
        });
      }
    });

    // Toast helper
    let toastTimeout: ReturnType<typeof setTimeout> | null = null;
    function showToast(message: string) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      toast.classList.add('faq-toast--show');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('faq-toast--show');
      }, 2600);
    }

    // Escape regex
    function escapeRegExp(str: string) {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // Highlight search match tokens
    function applyHighlight(rawText: string, terms: string[]) {
      if (terms.length === 0) return rawText;
      const escapedTerms = terms.map(escapeRegExp).filter(Boolean);
      if (escapedTerms.length === 0) return rawText;
      const regex = new RegExp(`(${escapedTerms.join('|')})`, 'gi');
      return rawText.replace(regex, '<mark class="faq-hl">$1</mark>');
    }

    // Master filter function with multi-word token matching
    function filterFaqs() {
      const query = (searchInput?.value || '').trim();
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      let visibleCount = 0;

      faqItems.forEach((item) => {
        const cat = item.dataset.category || '';
        const data = originalTexts.get(item);
        const qText = data?.question || '';
        const aText = data?.answer || '';
        const combinedText = `${qText} ${aText}`.toLowerCase();

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesQuery = terms.length === 0 || terms.every((term) => combinedText.includes(term));

        const qEl = item.querySelector('.faq-item__question') as HTMLElement | null;
        const aEl = item.querySelector('.faq-item__answer') as HTMLElement | null;

        if (matchesCat && matchesQuery) {
          item.classList.remove('faq-item--hidden');
          visibleCount++;

          // Apply token highlighting if searching
          if (qEl && aEl) {
            if (terms.length > 0) {
              qEl.innerHTML = applyHighlight(qText, terms);
              aEl.innerHTML = applyHighlight(aText, terms);
            } else {
              qEl.textContent = qText;
              aEl.textContent = aText;
            }
          }
        } else {
          item.classList.add('faq-item--hidden');
        }
      });

      // Update counters
      if (countLive) countLive.textContent = String(visibleCount);
      if (searchCountBadge) {
        searchCountBadge.textContent = query
          ? `${visibleCount} ditemukan`
          : `${visibleCount} Pertanyaan`;
      }

      // Toggle clear button
      if (searchClear) {
        searchClear.style.display = query ? 'flex' : 'none';
      }

      // Empty State
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.style.display = 'block';
          if (emptyQueryEl) emptyQueryEl.textContent = `"${query}"`;
        } else {
          emptyState.style.display = 'none';
        }
      }
    }

    // Tab switcher
    dockTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        dockTabs.forEach((t) => {
          t.classList.remove('faq-dock-tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('faq-dock-tab--active');
        tab.setAttribute('aria-selected', 'true');
        activeCategory = tab.dataset.category || 'all';
        filterFaqs();
      });
    });

    // Chip quick search
    chipBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const chipVal = btn.dataset.chip || '';
        if (!searchInput) return;

        if (searchInput.value.trim().toLowerCase() === chipVal.toLowerCase()) {
          // Toggle off
          searchInput.value = '';
          btn.classList.remove('faq-chip-btn--active');
        } else {
          // Toggle on
          chipBtns.forEach((b) => b.classList.remove('faq-chip-btn--active'));
          btn.classList.add('faq-chip-btn--active');
          searchInput.value = chipVal;
        }

        filterFaqs();
        searchInput.focus();
      });
    });

    // Search input listener
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const val = searchInput.value.trim().toLowerCase();
        chipBtns.forEach((b) => {
          const cVal = (b.dataset.chip || '').toLowerCase();
          b.classList.toggle('faq-chip-btn--active', cVal === val);
        });
        filterFaqs();
      });

      // Esc key reset
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          chipBtns.forEach((b) => b.classList.remove('faq-chip-btn--active'));
          filterFaqs();
        }
      });
    }

    // Clear search button
    if (searchClear) {
      searchClear.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          chipBtns.forEach((b) => b.classList.remove('faq-chip-btn--active'));
          filterFaqs();
          searchInput.focus();
        }
      });
    }

    // Reset button in empty state
    if (resetSearchBtn) {
      resetSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        chipBtns.forEach((b) => b.classList.remove('faq-chip-btn--active'));
        activeCategory = 'all';
        dockTabs.forEach((t) => {
          const isAll = t.dataset.category === 'all';
          t.classList.toggle('faq-dock-tab--active', isAll);
          t.setAttribute('aria-selected', isAll ? 'true' : 'false');
        });
        filterFaqs();
      });
    }

    const isEnglish = window.location.pathname.startsWith('/en') || document.documentElement.lang === 'en';

    // Toggle expand / collapse all
    if (expandAllBtn) {
      expandAllBtn.addEventListener('click', () => {
        allExpanded = !allExpanded;
        faqItems.forEach((item) => {
          if (!item.classList.contains('faq-item--hidden')) {
            if (allExpanded) {
              item.setAttribute('open', '');
            } else {
              item.removeAttribute('open');
            }
          }
        });
        expandAllBtn.textContent = allExpanded
          ? (isEnglish ? 'Collapse All' : 'Tutup Semua')
          : (isEnglish ? 'Expand All' : 'Buka Semua');
      });
    }

    // Popular questions jump
    popularBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = btn.dataset.popularIndex;
        const target = document.querySelector<HTMLDetailsElement>(`.faq-item[data-index="${idx}"]`);
        if (!target) return;

        // Reset filter
        if (searchInput) searchInput.value = '';
        chipBtns.forEach((b) => b.classList.remove('faq-chip-btn--active'));
        activeCategory = 'all';
        dockTabs.forEach((t) => {
          const isAll = t.dataset.category === 'all';
          t.classList.toggle('faq-dock-tab--active', isAll);
          t.setAttribute('aria-selected', isAll ? 'true' : 'false');
        });
        filterFaqs();

        // Close all & open target
        faqItems.forEach((it) => it.removeAttribute('open'));
        target.setAttribute('open', '');

        // Smooth scroll
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });

        // Highlight ring effect without hard outline stroke
        target.style.transition = 'box-shadow 0.25s ease';
        target.style.boxShadow = '0 0 32px rgba(34, 65, 109, 0.35)';
        setTimeout(() => {
          target.style.boxShadow = '';
        }, 1800);
      });
    });

    // Share / Copy Link
    shareBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const question = btn.dataset.question || '';
        const url = `${window.location.origin}${window.location.pathname}#faq-sec`;
        const textToCopy = `FAQ Bina Project: "${question}"\n${url}`;

        if (navigator.clipboard) {
          navigator.clipboard.writeText(textToCopy).then(() => {
            showToast(isEnglish ? 'Question link copied to clipboard!' : 'Tautan pertanyaan berhasil disalin!');
          });
        } else {
          showToast(isEnglish ? 'Question: ' + question : 'Pertanyaan: ' + question);
        }
      });
    });

    // Feedback voting
    voteBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const parent = btn.closest('.faq-feedback-wrap');
        if (parent) {
          parent.querySelectorAll('.faq-vote-btn').forEach((b) => b.classList.remove('faq-vote-btn--voted'));
        }
        btn.classList.add('faq-vote-btn--voted');
        const voteFeedback = isEnglish
          ? (btn.dataset.vote === 'yes' ? 'helpful' : 'feedback noted')
          : (btn.dataset.vote === 'yes' ? 'membantu' : 'masukan dicatat');
        showToast(isEnglish ? `Thank you! Your feedback (${voteFeedback}) has been recorded.` : `Terima kasih! Umpan balik Anda (${voteFeedback}) telah kami simpan.`);
      });
    });
  });
</script>
