  }

  .hero-fs-sec .hero-title-white {
    color: #FFFFFF !important;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5) !important;
  }

  .hero-fs-sec .hero-title-cyan {
    background: linear-gradient(90deg, #38BDF8 0%, #00D2FF 50%, #60A5FA 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 4px 16px rgba(0, 210, 255, 0.35)) !important;
  }

  /* Description */
  .hero-fs-sec .hero-description {
    font-family: 'Archivo', sans-serif !important;
    font-size: 16px !important;
    font-weight: 400 !important;
    color: #CBD5E1 !important;
    line-height: 1.7 !important;
    margin-bottom: 34px !important;
    max-width: 580px !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7) !important;
  }

  /* CTA Buttons */
  .hero-fs-sec .hero-cta-buttons {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    flex-wrap: wrap !important;
    margin-bottom: 42px !important;
  }

  .hero-fs-sec .hero-pill-btn-primary {
    background: linear-gradient(135deg, #0099FF 0%, #0077EE 100%) !important;
    color: #FFFFFF !important;
    font-family: 'Archivo', sans-serif !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
    padding: 13px 28px !important;
    border-radius: 999px !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    text-decoration: none !important;
    box-shadow: 0 6px 20px rgba(0, 136, 255, 0.45) !important;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s ease !important;
    will-change: transform, box-shadow;
  }

  .hero-fs-sec .hero-pill-btn-primary:hover {
    background: linear-gradient(135deg, #1aa3ff 0%, #0084ff 100%) !important;
    color: #FFFFFF !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 10px 28px rgba(0, 136, 255, 0.6) !important;
  }

  .hero-fs-sec .hero-pill-btn-primary:active {
    transform: scale(0.96) translateY(1px) !important;
    box-shadow: 0 3px 12px rgba(0, 136, 255, 0.4) !important;
    transition: transform 0.12s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
  }

  .hero-fs-sec .hero-pill-btn-secondary {
    background: rgba(13, 25, 43, 0.55) !important;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
    font-family: 'Archivo', sans-serif !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
