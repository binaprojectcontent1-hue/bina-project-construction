---
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import heroArchitectural from '@assets/images/hero/hero_architectural.png';
import heroBg1 from '@assets/images/hero/hero_bg_1_1.jpg';
import { getLangFromUrl, getLocalizedPath } from '@i18n/utils';

const currentLang = getLangFromUrl(Astro.url);

const optimizedHeroMain = await getImage({ src: heroArchitectural, format: 'webp', quality: 68, width: 1200 });
const optimizedHeroAlt = await getImage({ src: heroBg1, format: 'webp', quality: 68, width: 1200 });

export interface HeroSlide {
  image: string;
  subtitle: string;
  titlePart1: string;
  titlePart2: string;
  desc: string;
  isH1: boolean;
}

const heroSlides: readonly HeroSlide[] = currentLang === 'en'
  ? [
      {
        image: optimizedHeroMain.src,
        subtitle: 'Certified SNI Quality Standards & Official SPK Warranty',
        titlePart1: 'BINA PROJECT',
        titlePart2: 'ARCHITECTURE & BUILD',
        desc: 'Turnkey residential building contractor, architectural renovation, bespoke kitchen sets, and trustworthy development in Greater Malang & East Java.',
        isH1: true,
      },
      {
        image: optimizedHeroAlt.src,
        subtitle: 'Trusted Architects & General Contractors in East Java',
        titlePart1: 'ARCHITECTURAL CONSTRUCTION &',
        titlePart2: 'INTERIOR DESIGN MALANG',
        desc: 'Turn your dream residence and commercial spaces into reality with modern architectural precision, transparent cost estimation, and dedicated engineering.',
        isH1: false,
      },
    ]
  : [
      {
        image: optimizedHeroMain.src,
        subtitle: 'Standar Mutu SNI & Garansi Pemeliharaan Resmi SPK',
        titlePart1: 'BINA PROJECT',
        titlePart2: 'ARCHITECTURE & BUILD',
        desc: 'Penyedia jasa bangun rumah baru, renovasi bangunan, custom kitchen set, dan developer amanah bergaransi di Malang Raya & sekitarnya.',
        isH1: true,
      },
      {
        image: optimizedHeroAlt.src,
        subtitle: 'Arsitek & Kontraktor Terpercaya di Jawa Timur',
        titlePart1: 'JASA KONSTRUKSI &',
        titlePart2: 'DESAIN INTERIOR MALANG',
        desc: 'Wujudkan hunian dan ruang usaha impian Anda dengan standar arsitektur modern, transparansi RAB tanpa biaya tersembunyi, dan pengawasan profesional.',
        isH1: false,
      },
    ];
---

<section class="hero-fs-sec" id="hero">
  <div class="swiper hero-fs-slider" id="heroFsSlider">
    <div class="swiper-wrapper">
      {heroSlides.map((slide) => (
        <div class="swiper-slide hero-fs-slide">
          <!-- Fullscreen Background Image -->
          <div class="hero-fs-bg" style={`background-image: url('${slide.image}');`}></div>

          <!-- Architectural Dark Blue Gradient Vignette (Left-focused for maximum contrast) -->
          <div class="hero-architectural-overlay" aria-hidden="true"></div>

          <!-- Left-Aligned Content Container -->
          <div class="container h-100 position-relative d-flex align-items-center">
            <div class="hero-left-content">
              <!-- Eyebrow Subtitle -->
              <span class="hero-eyebrow" data-original-text={slide.subtitle}>{slide.subtitle}</span>

              <!-- Dynamic Heading -->
              {slide.isH1 ? (
                <h1 class="hero-main-title">
                  <span class="hero-title-white">{slide.titlePart1}</span>
                  <span class="hero-title-cyan">{slide.titlePart2}</span>
                </h1>
              ) : (
                <h2 class="hero-main-title">
                  <span class="hero-title-white">{slide.titlePart1}</span>
                  <span class="hero-title-cyan">{slide.titlePart2}</span>
                </h2>
              )}

              <!-- Description Text -->
              <p class="hero-description">{slide.desc}</p>

              <!-- Pill CTA Action Buttons -->
              <div class="hero-cta-buttons">
                <a
                  href={`https://wa.me/6281335335304?text=${encodeURIComponent(currentLang === 'en' ? 'Hello Bina Project, I would like to consult my project and cost estimation.' : 'Halo Tim Arsitek Bina Project, saya ingin konsultasi rencana proyek dan estimasi biaya')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hero-pill-btn-primary"
                  onclick="if(typeof window.trackLead==='function') window.trackLead('hero_wa_cta', 'hero_slide');"
                >
                  <Icon name="simple-icons:whatsapp" width="18" height="18" class="btn-icon" />
                  <span>{currentLang === 'en' ? 'Free Cost Consultation' : 'Konsultasi Estimasi Biaya'}</span>
                </a>

                <a href={getLocalizedPath('/portfolio', currentLang)} class="hero-pill-btn-secondary">
                  <Icon name="solar:document-text-linear" width="18" height="18" class="btn-icon" />
                  <span>{currentLang === 'en' ? 'View 162+ Projects' : 'Lihat 162+ Portofolio'}</span>
                  <Icon name="solar:arrow-right-up-linear" width="14" height="14" class="btn-arrow" />
                </a>
              </div>

              <!-- 4 Trust Badges Horizontal Strip -->
              <div class="hero-trust-badges-grid">
                <div class="hero-badge-card">
                  <div class="badge-icon-box">
                    <Icon name="solar:shield-check-linear" width="22" height="22" />
                  </div>
                  <div class="badge-title">{currentLang === 'en' ? 'Experienced' : 'Berpengalaman'}</div>
                  <div class="badge-sub">{currentLang === 'en' ? 'Professional Team' : 'Tim Profesional'}</div>
                </div>

                <div class="hero-badge-card">
                  <div class="badge-icon-box">
                    <Icon name="solar:shield-check-linear" width="22" height="22" />
                  </div>
                  <div class="badge-title">{currentLang === 'en' ? 'Quality Material' : 'Material Berkualitas'}</div>
                  <div class="badge-sub">{currentLang === 'en' ? 'Long Lasting' : 'Tahan Lama'}</div>
                </div>

                <div class="hero-badge-card">
                  <div class="badge-icon-box">
                    <Icon name="solar:home-smile-linear" width="22" height="22" />
                  </div>
                  <div class="badge-title">{currentLang === 'en' ? 'Modern Design' : 'Desain Modern'}</div>
                  <div class="badge-sub">{currentLang === 'en' ? 'Customized' : 'Sesuai Kebutuhan'}</div>
                </div>

                <div class="hero-badge-card">
                  <div class="badge-icon-box">
                    <Icon name="solar:hand-shake-linear" width="22" height="22" />
                  </div>
                  <div class="badge-title">{currentLang === 'en' ? 'Work Warranty' : 'Garansi Pekerjaan'}</div>
                  <div class="badge-sub">{currentLang === 'en' ? 'Hassle Free' : 'Anti Ribet'}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Minimalist Slider Controls (Pill Cluster) -->
    <div class="hero-fs-controls-bottom">
      <div class="hero-fs-nav-cluster">
        <button type="button" class="hero-fs-nav-btn prev" id="heroSlidePrev" aria-label="Slide Sebelumnya">
          <Icon name="solar:alt-arrow-left-linear" width="13" height="13" />
        </button>
        <div class="hero-custom-pagination" id="heroCustomPagination"></div>
        <button type="button" class="hero-fs-nav-btn next" id="heroSlideNext" aria-label="Slide Berikutnya">
          <Icon name="solar:alt-arrow-right-linear" width="13" height="13" />
        </button>
      </div>
    </div>

    <!-- Bottom Right Scroll Down Indicator -->
    <a href="#about-sec" class="hero-scroll-indicator d-none d-lg-flex" aria-label={currentLang === 'en' ? 'Scroll down' : 'Scroll ke bawah'}>
      <div class="scroll-circle">
        <Icon name="solar:arrow-down-linear" width="15" height="15" />
      </div>
      <span class="scroll-text">{currentLang === 'en' ? 'Scroll down' : 'Scroll ke bawah'}</span>
    </a>
  </div>
</section>

<script is:inline>
  (function () {
    let heroRetries = 0;
    const maxRetries = 30;

    function initHeroSlider() {
      const sliderEl = document.getElementById('heroFsSlider');
      if (!sliderEl) return;

      if (typeof Swiper === 'undefined') {
        if (heroRetries < maxRetries) {
          heroRetries++;
          setTimeout(initHeroSlider, 100);
        }
        return;
      }

      if (sliderEl.swiper) {
        sliderEl.swiper.destroy(true, true);
      }

      const heroSec = sliderEl.closest('.hero-fs-sec');

      new Swiper(sliderEl, {
        effect: 'fade',
        fadeEffect: {
          crossFade: true,
        },
        slidesPerView: 1,
        spaceBetween: 0,
        loop: true,
        speed: 1200,
        autoplay: {
          delay: 7000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        navigation: {
          prevEl: '#heroSlidePrev',
          nextEl: '#heroSlideNext',
        },
        pagination: {
          el: '#heroCustomPagination',
          clickable: true,
          bulletElement: 'button',
          bulletClass: 'hero-nav-dot',
          bulletActiveClass: 'hero-nav-dot-active',
          bulletsClass: 'hero-dots-wrap',
          horizontalClass: 'hero-dots-h',
          renderBullet: function (index, className) {
            return '<button type="button" class="' + className + '" aria-label="Slide ' + (index + 1) + '"><span class="hero-dot-bar"><span class="hero-dot-fill"></span></span></button>';
          },
        },
        on: {
          init: function (swiper) {
            heroSec?.classList.add('is-initialized');
            triggerScramble(swiper);
          },
          slideChangeTransitionStart: function (swiper) {
            triggerScramble(swiper);
            setTimeout(() => {
              const activeDot = heroSec?.querySelector('.hero-nav-dot-active .hero-dot-fill');
              if (activeDot) {
                activeDot.style.animation = 'none';
                requestAnimationFrame(() => {
                  if (activeDot) activeDot.style.animation = '';
                });
              }
            }, 10);
          },
        },
      });

      function triggerScramble(swiper) {
        if (!swiper || !swiper.slides) return;
        const activeSlide = swiper.slides[swiper.activeIndex];
        if (!activeSlide) return;
        const eyebrow = activeSlide.querySelector('.hero-eyebrow');
        if (eyebrow) {
          scrambleText(eyebrow);
        }
      }

      function scrambleText(element) {
        if (!element) return;
        const originalText = element.getAttribute('data-original-text') || element.textContent?.trim() || '';
        if (!element.getAttribute('data-original-text')) {
          element.setAttribute('data-original-text', originalText);
        }
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789_#-+';
        let iteration = 0;
        clearInterval(element._scrambleInterval);

        element._scrambleInterval = setInterval(() => {
          element.textContent = originalText
            .split('')
            .map((char, index) => {
              if (char === ' ') return ' ';
              if (index < iteration) {
                return originalText[index];
              }
              return chars[Math.floor(Math.random() * chars.length)];
            })
            .join('');

          if (iteration >= originalText.length) {
            clearInterval(element._scrambleInterval);
            element.textContent = originalText;
          }
          iteration += 1 / 1.5;
        }, 28);
      }

      heroSec?.classList.add('is-initialized');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }

    document.addEventListener('astro:page-load', function () {
      heroRetries = 0;
      initHeroSlider();
    });
  })();
</script>

<style is:global>
  /* ========================================================
     Modern Architectural Hero Section (Reference Design)
     ======================================================== */
  .hero-fs-sec {
    position: relative !important;
    width: 100% !important;
    height: clamp(660px, 92vh, 900px) !important;
    background-color: #081426 !important;
    overflow: hidden !important;
  }

  .hero-fs-sec .hero-fs-slider {
    width: 100% !important;
    height: 100% !important;
    position: relative !important;
  }

  .hero-fs-sec .hero-fs-slide {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    overflow: hidden !important;
  }

  .hero-fs-sec .hero-fs-bg {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background-size: cover !important;
    background-position: center right !important;
    background-repeat: no-repeat !important;
    transform: scale(1.01);
    transition: transform 14s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    z-index: 0 !important;
  }

  .hero-fs-sec .swiper-slide-active .hero-fs-bg {
    transform: scale(1.07);
  }

  /* Left Architectural Dark Vignette Overlay for High Legibility */
  .hero-fs-sec .hero-architectural-overlay {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: linear-gradient(
      90deg,
      rgba(8, 20, 38, 0.96) 0%,
      rgba(8, 20, 38, 0.88) 32%,
      rgba(8, 20, 38, 0.65) 48%,
      rgba(8, 20, 38, 0.25) 64%,
      rgba(8, 20, 38, 0.05) 80%,
      rgba(8, 20, 38, 0) 100%
    ) !important;
    z-index: 1 !important;
    pointer-events: none !important;
  }

  /* Left Aligned Content */
  .hero-fs-sec .hero-left-content {
    position: relative !important;
    z-index: 3 !important;
    max-width: 680px !important;
    padding: 60px 0 65px 0 !important;
    text-align: left !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
  }

  /* ========================================================
     Apple Cinematic Progressive Blur-Fade Transitions
     ======================================================== */
  .hero-fs-sec .hero-eyebrow,
  .hero-fs-sec .hero-main-title,
  .hero-fs-sec .hero-description,
  .hero-fs-sec .hero-cta-buttons,
  .hero-fs-sec .hero-trust-badges-grid {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(26px);
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  /* Active Slide Cascading In - Apple Soft Deceleration */
  .hero-fs-sec .swiper-slide-active .hero-eyebrow {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.12s;
  }

  .hero-fs-sec .swiper-slide-active .hero-main-title {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
    transition: opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.95s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.24s;
  }

  .hero-fs-sec .swiper-slide-active .hero-description {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
    transition: opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.95s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.38s;
  }

  .hero-fs-sec .swiper-slide-active .hero-cta-buttons {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
    transition: opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.95s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.52s;
  }

  .hero-fs-sec .swiper-slide-active .hero-trust-badges-grid {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
    transition: opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.95s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.66s;
  }

  /* Uninitialized Fallback */
  .hero-fs-sec:not(.is-initialized) .hero-fs-slide:first-child .hero-eyebrow,
  .hero-fs-sec:not(.is-initialized) .hero-fs-slide:first-child .hero-main-title,
  .hero-fs-sec:not(.is-initialized) .hero-fs-slide:first-child .hero-description,
  .hero-fs-sec:not(.is-initialized) .hero-fs-slide:first-child .hero-cta-buttons,
  .hero-fs-sec:not(.is-initialized) .hero-fs-slide:first-child .hero-trust-badges-grid {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0);
  }

  /* Eyebrow */
  .hero-fs-sec .hero-eyebrow {
    display: inline-block !important;
    font-family: 'Archivo', sans-serif !important;
    font-size: 13.5px !important;
    font-weight: 700 !important;
    letter-spacing: 2px !important;
    text-transform: uppercase !important;
    color: rgba(255, 255, 255, 0.9) !important;
