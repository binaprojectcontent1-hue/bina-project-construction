---
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import heroBg1 from '@assets/images/hero/hero_bg_1_1.jpg';
import heroBg2 from '@assets/images/hero/hero_bg_1_2.jpg';

const optimizedHero1 = await getImage({ src: heroBg1, format: 'webp', quality: 85, width: 1920 });
const optimizedHero2 = await getImage({ src: heroBg2, format: 'webp', quality: 85, width: 1920 });

export interface HeroSlide {
  image: string;
  subtitle: string;
  title: string;
  desc: string;
  isH1: boolean;
}

const heroSlides: readonly HeroSlide[] = [
  {
    image: optimizedHero1.src,
    subtitle: 'Arsitek & Kontraktor Terpercaya di Jawa Timur',
    title: 'Jasa Konstruksi & <br /> Desain Interior Malang',
    desc: 'Wujudkan hunian dan ruang usaha impian Anda dengan standar arsitektur modern, transparansi RAB, dan pengawasan profesional.',
    isH1: true,
  },
  {
    image: optimizedHero2.src,
    subtitle: 'You Dream It, We Build It',
    title: 'BINA PROJECT <br /> CONSTRUCTION',
    desc: 'Penyedia jasa bangun rumah baru, renovasi gedung, kitchen set minimalis, dan developer terpercaya di Malang Raya.',
    isH1: false,
  },
];
---

<section class="hero-fs-sec" id="hero">
  <div class="swiper hero-fs-slider" id="heroFsSlider">
    <div class="swiper-wrapper">
      {heroSlides.map((slide) => (
        <div class="swiper-slide hero-fs-slide">
          <!-- Fullscreen Background Image -->
          <div class="hero-fs-bg" style={`background-image: url('${slide.image}');`}></div>

          <!-- Deep Navy Architectural Overlay for High Legibility -->
          <div class="hero-fs-overlay"></div>

          <!-- Centered Content Container -->
          <div class="container h-100 position-relative d-flex align-items-center justify-content-center">
            <div class="hero-fs-content hero-fs-centered">
              <span class="hero-fs-eyebrow">{slide.subtitle}</span>
              {slide.isH1 ? (
                <h1 class="hero-fs-title" set:html={slide.title} />
              ) : (
                <h2 class="hero-fs-title" set:html={slide.title} />
              )}
              <p class="hero-fs-desc">{slide.desc}</p>

              <!-- Centered Action Buttons -->
              <div class="hero-fs-cta-group justify-content-center">
                <a href="/portfolio" class="hero-fs-btn-primary">
                  Lihat Portofolio Kami
                </a>
                <a href="/contact" class="hero-fs-btn-secondary">
                  Konsultasi Gratis
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Sleek Minimalist Slider Controls -->
    <div class="hero-fs-controls-bottom">
      <div class="hero-fs-nav-cluster">
        <button type="button" class="hero-fs-nav-btn prev" id="heroSlidePrev" aria-label="Slide Sebelumnya">
          <Icon name="solar:alt-arrow-left-linear" width="13" height="13" />
        </button>
        <div class="hero-fs-pagination" id="heroFsPagination"></div>
        <button type="button" class="hero-fs-nav-btn next" id="heroSlideNext" aria-label="Slide Berikutnya">
          <Icon name="solar:alt-arrow-right-linear" width="13" height="13" />
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    let heroRetries = 0;
    const maxRetries = 30;

    function initHeroSlider() {
      const sliderEl = document.getElementById('heroFsSlider');
      if (!sliderEl) return;

      if (typeof Swiper === 'undefined') {
        if (heroRetries < maxRetries) {
          heroRetries++;
          setTimeout(initHeroSlider, 100);
        }
        return;
      }

      // Avoid re-initialization if swiper instance already exists
      if (sliderEl.swiper) {
        sliderEl.swiper.destroy(true, true);
      }

      const heroSec = sliderEl.closest('.hero-fs-sec');

      new Swiper(sliderEl, {
        effect: 'fade',
        fadeEffect: {
          crossFade: true,
        },
        slidesPerView: 1,
        spaceBetween: 0,
        loop: true,
        speed: 1000,
        autoplay: {
          delay: 6000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        navigation: {
          prevEl: '#heroSlidePrev',
          nextEl: '#heroSlideNext',
        },
        pagination: {
          el: '#heroFsPagination',
          clickable: true,
          renderBullet: function (index, className) {
            return '<span class="' + className + '" role="button" tabindex="0" aria-label="Slide ' + (index + 1) + '"><span class="bullet-bar"></span></span>';
          },
        },
        on: {
          init: function (swiper) {
            heroSec?.classList.add('is-initialized');
            triggerScramble(swiper);
          },
          slideChangeTransitionStart: function (swiper) {
            triggerScramble(swiper);
          },
        },
      });

      function triggerScramble(swiper) {
        if (!swiper || !swiper.slides) return;
        const activeSlide = swiper.slides[swiper.activeIndex];
        if (!activeSlide) return;
        const eyebrow = activeSlide.querySelector('.hero-fs-eyebrow');
        if (eyebrow) {
          scrambleText(eyebrow);
        }
      }

      function scrambleText(element) {
        if (!element) return;
        const originalText = element.getAttribute('data-original-text') || element.textContent?.trim() || '';
        if (!element.getAttribute('data-original-text')) {
          element.setAttribute('data-original-text', originalText);
        }
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789_#-+';
        let iteration = 0;
        clearInterval(element._scrambleInterval);

        element._scrambleInterval = setInterval(() => {
          element.textContent = originalText
            .split('')
            .map((char, index) => {
              if (char === ' ') return ' ';
              if (index < iteration) {
                return originalText[index];
              }
              return chars[Math.floor(Math.random() * chars.length)];
            })
            .join('');

          if (iteration >= originalText.length) {
            clearInterval(element._scrambleInterval);
            element.textContent = originalText;
          }
          iteration += 1 / 1.5;
        }, 28);
      }

      heroSec?.classList.add('is-initialized');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }

    document.addEventListener('astro:page-load', function () {
      heroRetries = 0;
      initHeroSlider();
    });
  })();
</script>

<style is:global>
  /* ========================================================
     Fullscreen Hero Slider (Clean Architectural & Fade)
     ======================================================== */
  .hero-fs-sec {
    position: relative !important;
    width: 100% !important;
    height: calc(100vh - 138px) !important;
    min-height: 580px !important;
