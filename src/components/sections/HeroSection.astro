    transition: transform 7s ease-out;
    z-index: 0 !important;
  }

  .hero-fs-sec .swiper-slide-active .hero-fs-bg {
    transform: scale(1.04);
  }

  .hero-fs-sec .hero-fs-overlay {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: 
      radial-gradient(ellipse at center, rgba(10, 34, 57, 0.65) 0%, rgba(10, 34, 57, 0.88) 100%),
      linear-gradient(180deg, rgba(10, 34, 57, 0.4) 0%, rgba(10, 34, 57, 0.85) 100%) !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .hero-fs-sec .hero-fs-content {
    position: relative !important;
    z-index: 3 !important;
    max-width: 840px !important;
    padding: 30px 20px 65px 20px !important;
    margin: 0 auto !important;
    text-align: center !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
  }

  /* ========================================================
     Staggered Text Motion Animation on Slide Transition
     ======================================================== */
  .hero-fs-sec .hero-fs-eyebrow,
  .hero-fs-sec .hero-fs-title,
  .hero-fs-sec .hero-fs-desc,
  .hero-fs-sec .hero-fs-cta-group,
  .hero-fs-sec .hero-fs-trust-strip {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    will-change: opacity, transform;
  }

  /* Active Slide Cascading In */
  .hero-fs-sec .swiper-slide-active .hero-fs-eyebrow {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.15s;
  }

  .hero-fs-sec .swiper-slide-active .hero-fs-title {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.30s;
  }

  .hero-fs-sec .swiper-slide-active .hero-fs-desc {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.45s;
  }

  .hero-fs-sec .swiper-slide-active .hero-fs-cta-group {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.60s;
  }

  .hero-fs-sec .swiper-slide-active .hero-fs-trust-strip {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
