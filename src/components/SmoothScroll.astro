---
// SmoothScroll.astro - Modern Lenis Smooth Scroll with GSAP Sync & Progressive Apple Reveal Engine
---

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  // Check user preference for reduced motion
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1.0,
      touchMultiplier: 1.3,
    });

    // Sync with GSAP ScrollTrigger if present
    let isGsapSynced = false;
    let attempts = 0;
    const maxAttempts = 30;

    const trySyncGsap = () => {
      // @ts-ignore
      if (window.gsap && window.ScrollTrigger && !isGsapSynced) {
        isGsapSynced = true;
        // @ts-ignore
        lenis.on('scroll', window.ScrollTrigger.update);
        // @ts-ignore
        window.gsap.ticker.add((time: number) => {
          lenis.raf(time * 1000);
        });
        // @ts-ignore
        window.gsap.ticker.lagSmoothing(0);
        return true;
      }
      return false;
    };

    function fallbackRaf(time: number) {
      if (!isGsapSynced) {
        lenis.raf(time);
        requestAnimationFrame(fallbackRaf);
      }
    }
    requestAnimationFrame(fallbackRaf);

    const pollGsap = () => {
      if (trySyncGsap()) return;
      if (attempts < maxAttempts) {
        attempts++;
        setTimeout(pollGsap, 100);
      }
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      pollGsap();
    } else {
      window.addEventListener('DOMContentLoaded', pollGsap);
    }

    // @ts-ignore
    window.lenis = lenis;

    // Progressive Apple Scroll Reveal Engine
    function initAppleScrollReveal() {
      // Automatically assign stagger delay to card siblings in grids/rows
      document.querySelectorAll('.row, .grid, [class*="grid-"]').forEach((container) => {
        const cards = container.querySelectorAll(
          '.service-card, .project-card, .feature-card, .why-card, .testimonial-card, .blog-card'
        );
        cards.forEach((card, index) => {
          const delayClass = `apple-reveal-delay-${(index % 4) + 1}`;
          if (
            !card.classList.contains('apple-reveal-delay-1') &&
            !card.classList.contains('apple-reveal-delay-2') &&
            !card.classList.contains('apple-reveal-delay-3') &&
            !card.classList.contains('apple-reveal-delay-4')
          ) {
            card.classList.add(delayClass);
          }
        });
      });

      const candidates = document.querySelectorAll(
        '.sec-title, .sec-text, .service-card, .project-card, .feature-card, .why-card, .testimonial-card, .blog-card, .apple-reveal'
      );

      if (!candidates.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px',
        }
      );

      candidates.forEach((el) => {
        if (!el.classList.contains('apple-reveal')) {
          el.classList.add('apple-reveal');
        }
        observer.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAppleScrollReveal);
    } else {
      initAppleScrollReveal();
    }

    document.addEventListener('astro:page-load', () => {
      initAppleScrollReveal();
    });
  }
</script>
