---
import { siteConfig } from '../config/site';
import { getLangFromUrl, getLocalizedPath } from '@i18n/utils';

interface Props {
  title: string;
  parent?: {
    title: string;
    url: string;
  };
  bgImage?: string;
  isH1?: boolean;
}

const {
  title,
  parent,
  bgImage = '/assets/img/bg/breadcumb-bg.jpg',
  isH1 = true
} = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const homeName = currentLang === 'en' ? 'Home' : 'Beranda';
const homePath = getLocalizedPath('/', currentLang);

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : siteConfig.siteUrl.replace(/\/$/, '');
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

interface BreadcrumbItem {
  "@type": "ListItem";
  position: number;
  name: string;
  item: string;
}

const itemListElement: BreadcrumbItem[] = [
  {
    "@type": "ListItem",
    position: 1,
    name: homeName,
    item: `${siteUrl}${homePath === '/' ? '' : homePath}`
  }
];

if (parent) {
  const parentUrl = parent.url.startsWith('http') ? parent.url : `${siteUrl}${getLocalizedPath(parent.url, currentLang)}`;
  itemListElement.push({
    "@type": "ListItem",
    "position": 2,
    "name": parent.title,
    "item": parentUrl
  });
  itemListElement.push({
    "@type": "ListItem",
    "position": 3,
    "name": title,
    "item": currentUrl
  });
} else {
  itemListElement.push({
    "@type": "ListItem",
    "position": 2,
    "name": title,
    "item": currentUrl
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": itemListElement
};
---

<div class="breadcumb-wrapper" data-bg-src={bgImage}>
  <div class="container">
    <div class="breadcumb-content">
      {isH1 ? (
        <h1 class="breadcumb-title">{title}</h1>
      ) : (
        <span class="breadcumb-title d-block">{title}</span>
      )}
      <nav aria-label="Navigasi Breadcrumb">
        <ul class="breadcumb-menu">
          <li><a href={homePath}>{homeName}</a></li>
          {parent && <li><a href={getLocalizedPath(parent.url, currentLang)}>{parent.title}</a></li>}
          <li>{title}</li>
        </ul>
      </nav>
    </div>
  </div>
</div>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
