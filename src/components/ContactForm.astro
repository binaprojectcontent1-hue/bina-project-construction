---
import { getSiteSettings } from '@lib/siteSettingsService';
import { Icon } from 'astro-icon/components';
import { SERVICE_OPTIONS } from '@data/services';
import { getLangFromUrl } from '@i18n/utils';

const siteConfig = await getSiteSettings();

interface Props {
  lang?: 'id' | 'en';
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);

const projectTypes = currentLang === 'en'
  ? ['New Construction', 'Home Renovation', 'Interior & Kitchen Set', 'Waterproofing & Roof', 'Architecture & BOQ', 'Commercial Building', 'Other Consultations']
  : [...SERVICE_OPTIONS, 'Konsultasi Lainnya'];
---

<form
  class="contact-form2"
  id="contactForm"
  data-wa-number={siteConfig.contact.whatsappNumber}
  data-lang={currentLang}
>
  <!-- Honeypot Field for Spam / Bot Protection -->
  <div style="display:none !important;" aria-hidden="true">
    <input type="text" name="_gotcha" id="formGotcha" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Do not fill this field" />
  </div>

  <div class="row g-3">
    <div class="form-group col-md-6 position-relative">
      <label for="name" class="visually-hidden">{currentLang === 'en' ? 'Full Name' : 'Nama Lengkap'}</label>
      <input type="text" class="form-control" name="name" id="name" placeholder={currentLang === 'en' ? 'Full Name *' : 'Nama Lengkap *'} aria-label={currentLang === 'en' ? 'Full Name' : 'Nama Lengkap'} maxlength="100" required />
      <Icon name="solar:user-linear" width="18" height="18" class="form-icon" />
    </div>
    <div class="form-group col-md-6 position-relative">
      <label for="email" class="visually-hidden">{currentLang === 'en' ? 'Email Address' : 'Alamat Email'}</label>
      <input type="email" class="form-control" name="email" id="email" placeholder={currentLang === 'en' ? 'Email Address *' : 'Alamat Email *'} aria-label={currentLang === 'en' ? 'Email Address' : 'Alamat Email'} maxlength="254" required />
      <Icon name="solar:letter-linear" width="18" height="18" class="form-icon" />
    </div>
    <div class="form-group col-md-6 position-relative">
      <label for="number" class="visually-hidden">{currentLang === 'en' ? 'Phone or WhatsApp Number' : 'Nomor Telepon atau WhatsApp'}</label>
      <input type="tel" class="form-control" name="number" id="number" placeholder={currentLang === 'en' ? 'Phone / WhatsApp *' : 'Nomor Telepon / WhatsApp *'} aria-label={currentLang === 'en' ? 'Phone or WhatsApp Number' : 'Nomor Telepon atau WhatsApp'} maxlength="20" required />
      <Icon name="solar:phone-linear" width="18" height="18" class="form-icon" />
    </div>
    <div class="form-group col-md-6">
      <label for="subject" class="visually-hidden">{currentLang === 'en' ? 'Project Service Type' : 'Jenis Layanan Proyek'}</label>
      <select name="subject" id="subject" class="form-select" aria-label={currentLang === 'en' ? 'Select Project Type' : 'Pilih Jenis Proyek'} required style="height: 56px; border-radius: 12px; border: 1.5px solid #E2E8F0; padding-left: 18px; color: #17202A; font-size: 16px;">
        <option value="" disabled selected hidden>{currentLang === 'en' ? 'Select Project Type *' : 'Pilih Jenis Proyek *'}</option>
        {projectTypes.map((type) => (
          <option value={type}>{type}</option>
        ))}
      </select>
    </div>
    <div class="form-group col-12 position-relative">
      <label for="message" class="visually-hidden">{currentLang === 'en' ? 'Project Brief & Details' : 'Detail Rencana Proyek'}</label>
      <textarea name="message" id="message" cols="30" rows="4" class="form-control" placeholder={currentLang === 'en' ? 'Describe your project plans, estimated location, or questions...' : 'Tuliskan detail rencana proyek, lokasi, atau pertanyaan Anda...'} aria-label={currentLang === 'en' ? 'Project Brief & Details' : 'Detail Rencana Proyek'} maxlength="1000" required style="border-radius: 12px; font-size: 16px;"></textarea>
      <Icon name="solar:pen-linear" width="18" height="18" class="form-icon" />
    </div>
    <div class="form-btn col-12">
      <button type="submit" class="th-btn w-100 d-flex align-items-center justify-content-center" id="sendButton" style="padding: 16px 28px; font-size: 15px; font-weight: 700; letter-spacing: 0.5px; border-radius: 12px;">
        <Icon name="simple-icons:whatsapp" width="18" height="18" class="me-2" /> {currentLang === 'en' ? 'SEND INQUIRY TO WHATSAPP' : 'KIRIM PESAN KE WHATSAPP KONSULTASI'}
      </button>
    </div>
  </div>
  <p class="form-messages mb-0 mt-3 text-center" id="formStatus" aria-live="polite"></p>
</form>

<style>
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
  .contact-form2 .form-control,
  .contact-form2 .form-select,
  .form-control,
  .form-select {
    font-size: 16px;
    border-radius: 12px;
    border: 1.5px solid #CBD5E1;
    transition: all 0.3s ease;
    background-color: #FFFFFF !important;
    color: #0F172A !important;
  }
  .contact-form2 .form-control:focus,
  .contact-form2 .form-select:focus,
  .form-control:focus,
  .form-select:focus {
    background-color: #FFFFFF !important;
    border-color: #22416D !important;
    box-shadow: 0 0 0 4px rgba(34, 65, 109, 0.12) !important;
    outline: none !important;
    color: #0F172A !important;
  }
  /* High-Contrast Form Placeholders (WCAG AAA Compliant: > 7:1) */
  .contact-form2 .form-control::placeholder,
  .contact-form2 textarea::placeholder,
  .contact-form2 input::placeholder,
  .form-control::placeholder,
  .form-select::placeholder,
  textarea::placeholder,
  input::placeholder {
    color: #334155 !important;
    opacity: 1 !important;
  }
  .form-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: #334155;
    pointer-events: none;
  }
  textarea ~ .form-icon {
    top: 25px;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const statusEl = document.getElementById('formStatus') as HTMLElement | null;
  const sendBtn = document.getElementById('sendButton') as HTMLButtonElement | null;

  // Validation and Sanitization Helper Functions
  function sanitizeInput(text: string): string {
    let cleaned = text.replace(/<[^>]*>/g, '');
    cleaned = cleaned.replace(/[\u0000-\u001F\u007F-\u009F]/g, '');
    cleaned = cleaned.replace(/\s+/g, ' ').trim();
    return cleaned;
  }

  function isValidEmail(email: string): boolean {
    const emailRegex = /^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
    return emailRegex.test(email) && email.length <= 254;
  }

  function isValidPhone(phone: string): boolean {
    const digitsOnly = phone.replace(/[\s\-\(\)]/g, '');
    const phoneRegex = /^\+?[0-9]{8,15}$/;
    return phoneRegex.test(digitsOnly);
  }

  function showError(message: string): void {
    if (statusEl) {
      statusEl.className = 'form-messages mb-0 mt-3 text-danger fw-semibold';
      statusEl.innerText = message;
    }
  }

  const MAX_LENGTHS = {
    name: 100,
    email: 254,
    number: 20,
    subject: 100,
    message: 1000
  };

  if (form) {
    const waNumber = form.dataset.waNumber ?? '6281335335304';
    const isEn = form.dataset.lang === 'en';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const botCheck = formData.get('_gotcha') as string | null;
      if (botCheck) {
        // Honeypot triggered by bot, silently exit
        return;
      }

      let name = (formData.get('name') as string | null)?.trim() ?? '';
      let email = (formData.get('email') as string | null)?.trim() ?? '';
      let number = (formData.get('number') as string | null)?.trim() ?? '';
      let subject = (formData.get('subject') as string | null)?.trim() ?? '';
      let message = (formData.get('message') as string | null)?.trim() ?? '';

      // Sanitize all text inputs
      name = sanitizeInput(name);
      email = sanitizeInput(email);
      number = sanitizeInput(number);
      subject = sanitizeInput(subject);
      message = sanitizeInput(message);

      if (!name || !email || !number || !subject || !message) {
        if (statusEl) {
          statusEl.className = 'form-messages mb-0 mt-3 text-danger fw-semibold';
          statusEl.innerText = isEn
            ? 'Please fill in all required fields marked with *.'
            : 'Harap lengkapi semua kolom bertanda * terlebih dahulu.';
        }
        return;
      }

      // Email format validation (Task 3.4, Requirement 2.2)
      if (!isValidEmail(email)) {
        showError(isEn ? 'Invalid email format. Example: name@domain.com' : 'Format email tidak valid. Contoh: nama@domain.com');
        return;
      }

      // Phone format validation (Task 3.5, Requirement 2.3)
      if (!isValidPhone(number)) {
        showError(isEn ? 'Phone number must contain 8-15 digits. Example: +6281335335304' : 'Nomor telepon harus berisi 8-15 digit. Contoh: +6281335335304 atau 0813XXXX');
        return;
      }

      // Length validation
      if (name.length > MAX_LENGTHS.name) {
        showError(isEn ? `Name is too long. Max ${MAX_LENGTHS.name} characters.` : `Nama terlalu panjang. Maksimal ${MAX_LENGTHS.name} karakter.`);
        return;
      }
      if (email.length > MAX_LENGTHS.email) {
        showError(isEn ? `Email is too long. Max ${MAX_LENGTHS.email} characters.` : `Email terlalu panjang. Maksimal ${MAX_LENGTHS.email} karakter.`);
        return;
      }
      if (number.length > MAX_LENGTHS.number) {
        showError(isEn ? `Phone number is too long. Max ${MAX_LENGTHS.number} characters.` : `Nomor telepon terlalu panjang. Maksimal ${MAX_LENGTHS.number} karakter.`);
        return;
      }
      if (subject.length > MAX_LENGTHS.subject) {
        showError(isEn ? `Subject is too long. Max ${MAX_LENGTHS.subject} characters.` : `Subjek terlalu panjang. Maksimal ${MAX_LENGTHS.subject} karakter.`);
        return;
      }
      if (message.length > MAX_LENGTHS.message) {
        showError(isEn ? `Message is too long. Max ${MAX_LENGTHS.message} characters.` : `Pesan terlalu panjang. Maksimal ${MAX_LENGTHS.message} karakter.`);
        return;
      }

      // Format WhatsApp message cleanly
      const waText = encodeURIComponent(
        isEn
          ? `*Hello Bina Project Team, I would like to consult on a project:*\n\n` +
            `👤 *Full Name:* ${name}\n` +
            `📧 *Email:* ${email}\n` +
            `📱 *Phone / WhatsApp:* ${number}\n` +
            `🛠️ *Service Type:* ${subject}\n` +
            `📝 *Project Details:*\n${message}\n\n` +
            `_Sent via binaproject.com contact form_`
          : `*Halo Tim Bina Project, saya ingin konsultasi proyek:*\n\n` +
            `👤 *Nama Lengkap:* ${name}\n` +
            `📧 *Email:* ${email}\n` +
            `📱 *No. HP/WhatsApp:* ${number}\n` +
            `🛠️ *Jenis Layanan:* ${subject}\n` +
            `📝 *Detail Rencana Proyek:*\n${message}\n\n` +
            `_Dikirimkan melalui formulir kontak binaproject.com_`
      );

      const waUrl = `https://wa.me/${waNumber}?text=${waText}`;

      if (statusEl) {
        statusEl.className = 'form-messages mb-0 mt-3 text-success fw-semibold';
        statusEl.innerText = isEn
          ? 'Saving consultation schedule & opening official WhatsApp...'
          : 'Menyimpan jadwal konsultasi & membuka WhatsApp resmi...';
      }

      if (sendBtn) {
        sendBtn.disabled = true;
        sendBtn.innerHTML = isEn
          ? '<svg class="me-2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Saving & Redirecting to WhatsApp...'
          : '<svg class="me-2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg> Menyimpan & Mengalihkan ke WhatsApp...';
      }

      // 1. Dispatch conversion event to GA4 and Meta Pixel
      if (typeof (window as any).trackLead === 'function') {
        (window as any).trackLead('contact_form', subject);
      }

      // 2. Dual-Action: Persist lead to Supabase Database with strict timeout fallback
      try {
        const { submitLead } = await import('@lib/leadsService');
        await submitLead({
          name,
          email,
          phone: number,
          service: subject,
          message,
          source_url: window.location.href,
        });
      } catch (saveError) {
        console.warn('[ContactForm] Background lead persistence note:', saveError);
      }

      // 3. Direct location navigation avoids mobile browser popup blockers (Safari/Chrome)
      window.location.href = waUrl;

      // Reset form after short delay in case user navigates back
      setTimeout(() => {
        form.reset();
        if (sendBtn) {
          sendBtn.disabled = false;
          sendBtn.innerHTML = isEn
            ? '<svg class="me-2" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> SEND INQUIRY TO WHATSAPP'
            : '<svg class="me-2" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> KIRIM PESAN KE WHATSAPP KONSULTASI';
        }
      }, 2000);
    });
  }
</script>
