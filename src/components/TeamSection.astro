---
/**
 * @file TeamSection.astro
 * @description Redesigned team showcase without skill checklists, featuring
 * modern architectural floating cards, role badges, elegant typography,
 * centered 5-member layout, and a high-converting consultation banner.
 */
import { Image } from 'astro:assets';
import { TEAM_MEMBERS } from '@data/team';
import SectionHeader from '@components/SectionHeader.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

import gesangImg from '@assets/images/team/Gesang Sudrajad, S.ST., M.M.webp';
import marhaendraImg from '@assets/images/team/Ir. Marhaendra Muslim Bachtiyar, S.T.webp';
import kuncoroImg from '@assets/images/team/Kuncoro Widiyan Nugroho, S.Ak.webp';
import firdhanImg from '@assets/images/team/Firdhan Choirul Anwar, S.Ikom.webp';

const teamPhotos: Record<string, ImageMetadata> = {
  'gesang-sudrajad': gesangImg,
  'marhaendra-muslim': marhaendraImg,
  'kuncoro-widiyan': kuncoroImg,
  'firdhan-choirul': firdhanImg,
};

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="team-section" id="our-team">

  <div class="container team-container">
    <!-- Section Header -->
    <SectionHeader
      badge={t('team.badge')}
      badgeIcon="solar:users-group-rounded-bold"
      title={t('team.title')}
      titleAccent={t('team.titleAccent')}
      description={t('team.desc')}
      align="center"
    />

    <!-- Team Cards (Centered Balanced Layout, Borderless) -->
    <div class="team-cards-wrap">
      {TEAM_MEMBERS.map((member) => (
        <article class="team-card">
          <!-- Avatar Frame (Seamless, Zero Border/Ring, Natural Uncropped 5:6 Aspect Ratio) -->
          <div class="team-avatar-frame">
            {teamPhotos[member.id] ? (
              <Image
                src={teamPhotos[member.id]}
                alt={`${member.name} - ${member.jobTitle} Bina Project`}
                loading="lazy"
                decoding="async"
                width={250}
                height={300}
                class="team-avatar-img"
              />
            ) : (
              <img
                src={member.image}
                alt={`${member.name} - ${member.jobTitle} Bina Project`}
                loading="lazy"
                decoding="async"
                width={135}
                height={162}
                class="team-avatar-img"
              />
            )}
          </div>

          <!-- Card Content -->
          <div class="team-card-body">
            <h3 class="team-name">{member.name}</h3>
            <p class="team-job-title">{member.jobTitle}</p>
            <p class="team-bio">{member.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ==============================================================================
     TEAM SECTION - REDESIGNED (BORDERLESS & BALANCED 4-CARD GRID)
     ============================================================================== */
  .team-section {
    position: relative;
    padding: clamp(60px, 8vw, 100px) 0;
    background: var(--bina-slate-50, #F8FAFC);
    overflow: hidden;
    color: var(--bina-slate-900, #17202A);
    font-family: var(--font-body, 'Archivo', sans-serif);
  }

  .team-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }


  /* ----------------------------------------------------------------------------
     1. Team Cards Layout (Balanced 4-Card Grid)
     ---------------------------------------------------------------------------- */
  .team-cards-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-bottom: 0;
  }

  /* ----------------------------------------------------------------------------
     2. Individual Team Card (Seamless Floating Design, No Borders)
     ---------------------------------------------------------------------------- */
  .team-card {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid #F1F5F9;
    box-shadow: 0 4px 24px rgba(34, 65, 109, 0.05);
    overflow: visible;
    display: flex;
    flex-direction: column;
    flex: 0 1 calc(25% - 18px);
    min-width: 270px;
    max-width: 315px;
    padding-top: 32px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }
  .team-card:hover {
    transform: translateY(-5px);
    border-color: #E2E8F0;
    box-shadow: 0 12px 36px rgba(34, 65, 109, 0.1);
  }

  /* Avatar Frame (Seamless, Zero Border/Ring, Natural 5:6 Aspect Ratio) */
  .team-avatar-frame {
    width: 135px;
    height: 162px;
    margin: 0 auto 16px !important;
    background: transparent !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
    position: relative;
    z-index: 2;
    overflow: visible !important;
    transition: transform 0.3s ease;
  }
  .team-card:hover .team-avatar-frame {
    transform: translateY(-3px) scale(1.03);
  }
  .team-avatar-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    display: block !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  /* Content Area */
  .team-card-body {
    padding: 0 22px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  /* Role Tag */
  .team-role-pill {
    display: inline-block;
    padding: 3px 12px;
    background: rgba(34, 65, 109, 0.08);
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bina-navy, #22416D);
    margin-bottom: 10px;
  }

  .team-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--bina-slate-900, #17202A);
    margin: 0 0 6px;
    line-height: 1.35;
    font-family: var(--font-display, 'Archivo', sans-serif);
  }
  .team-job-title {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bina-navy, #22416D);
    margin: 0 0 16px;
  }
  .team-bio {
    font-size: 13px;
    line-height: 1.65;
    color: var(--bina-slate-600, #475569);
    margin: 0 0 12px;
    flex: 1;
    text-align: left;
  }

  /* Card Footer Contact Link */
  .team-card-footer {
    width: 100%;
    padding-top: 14px;
    border-top: 1px solid var(--bina-slate-100, #F1F5F9);
    display: flex;
    justify-content: center;
  }
  .team-consult-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--bina-navy, #22416D);
    text-decoration: none;
    padding: 8px 18px;
    border-radius: 9999px;
    background: rgba(34, 65, 109, 0.05);
    transition: all 0.25s ease;
  }
  .team-consult-link:hover {
    background: var(--bina-navy, #22416D);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(34, 65, 109, 0.2);
  }
  .team-wa-icon {
    color: #25D366;
    transition: color 0.2s;
  }
  .team-consult-link:hover .team-wa-icon {
    color: #FFFFFF;
  }
  .team-arrow-icon {
    transition: transform 0.2s ease;
  }
  .team-consult-link:hover .team-arrow-icon {
    transform: translateX(3px);
  }

  /* ----------------------------------------------------------------------------
     3. Responsive Breakpoints
     ---------------------------------------------------------------------------- */
  @media (max-width: 1199px) {
    .team-cards-wrap {
      gap: 20px;
    }
    .team-card {
      flex: 0 1 calc(50% - 15px);
      max-width: 380px;
    }
  }

  @media (max-width: 640px) {
    .team-card {
      flex: 0 1 100%;
      min-width: 0;
      max-width: 100%;
    }
    .team-card-body {
      padding: 0 18px 20px;
    }
    .team-bio {
      font-size: 13px;
    }
  }
</style>
