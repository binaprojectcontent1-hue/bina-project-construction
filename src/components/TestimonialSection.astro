---
/**
 * @file TestimonialSection.astro
 * @description Stack Testimonial (Draggable Card Deck)
 * Redesigned section on Homepage powered by motion/react and Bina Navy (#22416D).
 */

import { TESTIMONIALS } from '@data/testimonials';
import StackTestimonial from '@components/StackTestimonial.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { siteConfig } from '@config/site';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

interface Props {
  bg?: 'white' | 'slate';
}

const { bg = 'white' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const testimonials = TESTIMONIALS;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : siteConfig.siteUrl.replace(/\/$/, '');

// GEO: Review JSON-LD dari data testimonial terverifikasi (6 ulasan bintang 5)
const reviewSchemas = TESTIMONIALS.map((t) => ({
  '@type': 'Review',
  '@id': `${siteUrl}/#review-${t.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
  itemReviewed: { '@id': `${siteUrl}/#organization` },
  author: { '@type': 'Person', name: t.name },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: String(t.rating),
    bestRating: '5',
    worstRating: '1',
  },
  reviewBody: t.quote,
  datePublished: '2025-11-15',
  publisher: { '@id': `${siteUrl}/#organization` },
}));

const reviewListSchema = {
  '@context': 'https://schema.org',
  '@graph': reviewSchemas,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(reviewListSchema)} />

<section class:list={['testimonial-section-modern space', { 'testimonial-section-modern--slate': bg === 'slate' }]} id="testi-sec">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-9 text-center">
        <SectionHeader
          badge={t('testimonials.badge')}
          badgeIcon="solar:chat-round-like-bold"
          title={t('testimonials.title')}
          description={t('testimonials.desc')}
          align="center"
        />
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-12">
        <StackTestimonial testimonials={testimonials} />
      </div>
    </div>
  </div>
</section>

<style>
  .testimonial-section-modern {
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  .testimonial-section-modern--slate {
    background: var(--bina-slate-50, #F8FAFC) !important;
  }
</style>
