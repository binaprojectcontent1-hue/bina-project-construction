---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileMenu from '@components/MobileMenu.astro';
import SideMenu from '@components/SideMenu.astro';
import Preloader from '@components/Preloader.astro';
import SmoothScroll from '@components/SmoothScroll.astro';
import CustomCursor from '@components/CustomCursor.astro';
import FloatingWhatsApp from '@components/FloatingWhatsApp.astro';
import { getSiteSettings } from '@lib/siteSettingsService';
import { MASTER_SERVICES } from '@data/services';
import { useTranslations } from '@i18n/utils';
import '@styles/global.css';

const siteConfig = await getSiteSettings();

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: string;
  noindex?: boolean;
  preloadImage?: string;
  lang?: 'id' | 'en';
  googleSiteVerification?: string;
}

const siteUrl = Astro.site ? Astro.site.href : siteConfig.siteUrl;
const cleanSiteUrl = siteUrl.replace(/\/$/, '');

const currentLang = Astro.props.lang || (Astro.url.pathname.startsWith('/en') ? 'en' : 'id');
const t = useTranslations(currentLang);

const cleanPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const idCanonical = `${cleanSiteUrl}${cleanPath === '/' ? '' : cleanPath}`;
const enCanonical = `${cleanSiteUrl}/en${cleanPath === '/' ? '' : cleanPath}`;
const activeCanonical = currentLang === 'en' ? enCanonical : idCanonical;

const defaultTitle = `${t('site.name')} - ${t('site.tagline')}`;
const defaultDesc = t('site.description');

const {
  title = defaultTitle,
  description = defaultDesc,
  keywords = 'jasa konstruksi malang, desain interior malang, kontraktor rumah batu, kitchen set kediri, bina project construction, arsitek malang',
  ogImage = '/assets/img/og-image.webp',
  canonicalUrl = activeCanonical,
  type = 'website',
  noindex = false,
  preloadImage,
  googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || import.meta.env.GOOGLE_SITE_VERIFICATION || (siteConfig as any).googleSiteVerification || '',
} = Astro.props;

const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${cleanSiteUrl}/${ogImage.replace(/^\//, '')}`;

// GEO: Service -> portfolio workExample mapping (bukti pengerjaan per layanan)
const servicePortfolioExamples: Record<string, string[]> = {
  konstruksi: [],
  interior: ['kitchen-set-pak-mario'],
  renovasi: [],
  waterproofing: [],
  'arsitektur-rab': [],
  developer: [],
};

// Schema.org Comprehensive Connected Knowledge Graph (@graph)
const connectedSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${cleanSiteUrl}/#website`,
      "url": `${cleanSiteUrl}/`,
      "name": t('site.name'),
      "description": description,
      "inLanguage": currentLang === 'en' ? 'en-US' : 'id-ID',
      "publisher": {
        "@id": `${cleanSiteUrl}/#organization`
      }
    },
    {
      "@type": ["HomeAndConstructionBusiness", "GeneralContractor", "Organization"],
      "@id": `${cleanSiteUrl}/#organization`,
      "name": siteConfig.legalName,
      "alternateName": t('site.name'),
      "url": `${cleanSiteUrl}/`,
      "logo": {
        "@type": "ImageObject",
        "@id": `${cleanSiteUrl}/#logo`,
        "url": `${cleanSiteUrl}/assets/img/logo.svg`,
        "caption": siteConfig.legalName
      },
      "image": resolvedOgImage,
      "description": description,
      "telephone": siteConfig.contact.phoneTel.replace('tel:', ''),
      "email": siteConfig.contact.email,
      "priceRange": "$$",
      "currenciesAccepted": "IDR",
      "paymentAccepted": "Cash, Bank Transfer, Termin",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.contact.address,
        "addressLocality": siteConfig.contact.city,
        "addressRegion": siteConfig.contact.province,
        "postalCode": siteConfig.contact.postalCode,
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -7.9498068,
        "longitude": 112.6088423
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "08:00",
          "closes": "16:00"
        }
      ],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": siteConfig.contact.phoneTel.replace('tel:', ''),
          "contactType": "customer service",
          "areaServed": "ID",
          "availableLanguage": ["Indonesian", "Javanese"]
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "162"
      },
      "slogan": siteConfig.tagline,
      "hasMap": siteConfig.contact.googleMapsUrl,
      "foundingLocation": {
        "@type": "Place",
        "name": "Kota Malang, Jawa Timur"
      },
      "knowsAbout": [
        "Jasa Konstruksi Bangunan",
        "Bangun Rumah Baru SNI",
        "Desain Interior Minimalis",
        "Custom Kitchen Set HPL Malang",
        "Waterproofing Dak Beton & Talang",
        "Renovasi Rumah & Bangunan Komersial",
        "Rencana Anggaran Biaya (RAB) Transparan",
        "Detail Engineering Design (DED)",
        "Arsitektur Tropis Modern"
      ],
      "sameAs": [
        ...siteConfig.socials.map((s) => s.url),
        siteConfig.contact.googleMapsUrl
      ],
      "areaServed": [
        { "@type": "City", "name": "Kota Malang", "sameAs": "https://id.wikipedia.org/wiki/Kota_Malang" },
        { "@type": "City", "name": "Kota Batu", "sameAs": "https://id.wikipedia.org/wiki/Kota_Batu" },
        { "@type": "AdministrativeArea", "name": "Kabupaten Malang", "sameAs": "https://id.wikipedia.org/wiki/Kabupaten_Malang" },
        { "@type": "City", "name": "Pasuruan", "sameAs": "https://id.wikipedia.org/wiki/Kota_Pasuruan" },
        { "@type": "City", "name": "Surabaya", "sameAs": "https://id.wikipedia.org/wiki/Kota_Surabaya" },
        { "@type": "City", "name": "Sidoarjo", "sameAs": "https://id.wikipedia.org/wiki/Kabupaten_Sidoarjo" },
        { "@type": "City", "name": "Kediri", "sameAs": "https://id.wikipedia.org/wiki/Kota_Kediri" },
        { "@type": "AdministrativeArea", "name": "Jawa Timur", "sameAs": "https://id.wikipedia.org/wiki/Jawa_Timur" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Katalog Layanan Konstruksi & Desain Interior",
        "itemListElement": MASTER_SERVICES.map((service) => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": service.title,
            "description": service.description,
            "provider": {
              "@id": `${cleanSiteUrl}/#organization`
            },
            ...((servicePortfolioExamples[service.id]?.length ?? 0) > 0
              ? {
                  workExample: (servicePortfolioExamples[service.id] ?? []).map((slug) => ({
                    "@type": "CreativeWork",
                    "@id": `${cleanSiteUrl}/portfolio/${slug}#project`,
                    url: `${cleanSiteUrl}/portfolio/${slug}`,
                  })),
                }
              : {}),
          },
        })),
      }
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": `${cleanSiteUrl}/#website`
      },
      "about": {
        "@id": `${cleanSiteUrl}/#organization`
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": resolvedOgImage
      },
      "inLanguage": "id-ID"
    }
  ]
};
---

<!doctype html>
<html class="no-js" lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Bina Project" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <!-- Advanced Robots Directives for Maximum Google Snippet Visibility -->
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      </>
    )}
    
    <!-- Google Search Console Verification -->
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    <!-- Canonical & Alternate Links -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id" href={idCanonical} />
    <link rel="alternate" hreflang="en" href={enCanonical} />
    <link rel="alternate" hreflang="x-default" href={idCanonical} />

    <!-- LLM and AI Agent Context Discovery (GEO Protocol) -->
    <link rel="alternate" type="text/plain" href={`${cleanSiteUrl}/llms.txt`} title="LLM Context Protocol" />
    <link rel="alternate" type="text/plain" href={`${cleanSiteUrl}/llms-full.txt`} title="LLM Full Reference Context" />
    <link rel="alternate" type="application/json" href={`${cleanSiteUrl}/llms-context.json`} title="Machine-Readable Knowledge Base" />

    <!-- Geo Meta Tags for Local Search Ranking (Kota Malang & Jawa Timur) -->
    <meta name="geo.region" content="ID-JI" />
    <meta name="geo.placename" content="Kota Malang, Jawa Timur" />
    <meta name="geo.position" content="-7.949807;112.608842" />
    <meta name="ICBM" content="-7.949807, 112.608842" />

    <!-- Open Graph / Facebook Meta -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={resolvedOgImage.endsWith('.webp') ? 'image/webp' : 'image/jpeg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {resolvedOgImage.endsWith('.webp') && (
      <>
        <meta property="og:image" content={resolvedOgImage.replace(/\.webp$/, '.jpg')} />
        <meta property="og:image:secure_url" content={resolvedOgImage.replace(/\.webp$/, '.jpg')} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Bina Project" />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'id_ID'} />

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@binaprojectid" />
    <meta name="twitter:creator" content="@binaprojectid" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicons -->
    <link rel="shortcut icon" href="/assets/img/favicons/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/x-icon" href="/assets/img/favicons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/img/favicons/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicons/android-icon-192x192.png" />
    <link rel="apple-touch-icon" href="/assets/img/favicons/apple-icon.png" />
    <link rel="apple-touch-icon" sizes="57x57" href="/assets/img/favicons/apple-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/assets/img/favicons/apple-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/assets/img/favicons/apple-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/assets/img/favicons/apple-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/assets/img/favicons/apple-icon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/assets/img/favicons/apple-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/assets/img/favicons/apple-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/assets/img/favicons/apple-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-icon-180x180.png" />
    <link rel="manifest" href="/assets/img/favicons/manifest.json" />
    <meta name="msapplication-config" content="/assets/img/favicons/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#22416D" />
    <meta name="msapplication-TileImage" content="/assets/img/favicons/ms-icon-144x144.png" />
    <meta name="theme-color" content="#22416D" />

    <!-- Google Fonts (Optimized Subset & Non-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Fragment set:html={`
      <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Titillium+Web:wght@400;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
      <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Titillium+Web:wght@400;600;700&display=swap" /></noscript>
    `} />

    <!-- LCP Critical Image Preload (Hero / Featured Media) -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- Critical Inline Styles (Prevent FOUC & Stabilize Layout) -->
    <style is:inline>
      @font-face {
        font-family: 'Archivo-Fallback';
        src: local('Arial'), local('Helvetica');
        ascent-override: 95%;
        descent-override: 25%;
        line-gap-override: 0%;
        size-adjust: 102%;
      }
      @font-face {
        font-family: 'Titillium-Fallback';
        src: local('Arial'), local('Trebuchet MS');
        ascent-override: 96%;
        descent-override: 22%;
        line-gap-override: 0%;
        size-adjust: 100%;
      }
      :root {
        --theme-color: #22416D;
        --theme-color2: #3B82F6;
        --title-color: #17202A;
        --body-color: #475569;
        --body-font: 'Archivo', 'Archivo-Fallback', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --title-font: 'Titillium Web', 'Titillium-Fallback', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        color: var(--body-color);
        font-family: var(--body-font);
        overflow-x: hidden;
      }
      .main-navbar-sticky {
        min-height: 68px;
      }
    </style>

    <!-- Optimized Stylesheet Cascade (Eliminates FOUC & Stabilizes Layout) -->
    <link rel="stylesheet" href="/assets/css/style.min.css" />
    <link rel="stylesheet" href="/assets/css/swiper-bundle.min.css" />
    <Fragment set:html={`
      <link rel="preload" as="style" href="/assets/css/bootstrap.min.css" onload="this.onload=null;this.rel='stylesheet'" />
      <noscript><link rel="stylesheet" href="/assets/css/bootstrap.min.css" /></noscript>
    `} />

    <!-- Schema.org Connected Knowledge Graph JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(connectedSchemaGraph)} />

    <!-- Performance & Attribution Tracking Stack (GA4 & Meta Pixel) -->
    {(() => {
      const gaId = import.meta.env.PUBLIC_GA_ID || import.meta.env.VITE_GA_ID || 'G-J8QZ1X2Y3P';
      const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || import.meta.env.VITE_META_PIXEL_ID || '';
      return (
        <>
          {/* Google Analytics 4 (Non-blocking & Idle / Interaction Triggered) */}
          <script is:inline set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${gaId}', {
              send_page_view: true,
              anonymize_ip: true,
              transport_type: 'beacon'
            });

            (function() {
              var gaLoaded = false;
              function initGA() {
                if (gaLoaded) return;
                gaLoaded = true;
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=${gaId}';
                document.head.appendChild(s);
              }

              var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
              var triggerGA = function() {
                initGA();
                events.forEach(function(e) { window.removeEventListener(e, triggerGA, { passive: true }); });
              };
              events.forEach(function(e) { window.addEventListener(e, triggerGA, { passive: true, once: true }); });

              if ('requestIdleCallback' in window) {
                requestIdleCallback(function() { setTimeout(initGA, 2500); });
              } else {
                setTimeout(initGA, 3000);
              }
            })();
          `} />

          {/* Meta Pixel (Facebook & Instagram Ads - Deferred & Non-blocking) */}
          {metaPixelId && (
            <>
              <script is:inline set:html={`
                window._fbqInit = window._fbqInit || false;
                !function(f,b,e,v,n,t,s)
                {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
                n.callMethod.apply(n,arguments):n.queue.push(arguments)};
                if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
                n.queue=[];}(window, document);
                fbq('init', '${metaPixelId}');
                fbq('track', 'PageView');

                (function() {
                  var fbLoaded = false;
                  function loadFBScript() {
                    if (fbLoaded) return;
                    fbLoaded = true;
                    var s = document.createElement('script');
                    s.async = true;
                    s.src = 'https://connect.facebook.net/en_US/fbevents.js';
                    document.head.appendChild(s);
                  }

                  var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
                  var triggerFB = function() {
                    loadFBScript();
                    events.forEach(function(e) { window.removeEventListener(e, triggerFB, { passive: true }); });
                  };
                  events.forEach(function(e) { window.addEventListener(e, triggerFB, { passive: true, once: true }); });

                  if ('requestIdleCallback' in window) {
                    requestIdleCallback(function() { setTimeout(loadFBScript, 3000); });
                  } else {
                    setTimeout(loadFBScript, 3500);
                  }
                })();
              `} />
              <noscript>
                <img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`} alt="" />
              </noscript>
            </>
          )}

          {/* Unified Commercial Lead Tracker (Dispatches to GA4, Meta Pixel & DOM) */}
          <script is:inline set:html={`
            window.trackLead = function(channel, details) {
              try {
                if (typeof window.gtag === 'function') {
                  window.gtag('event', 'generate_lead', {
                    method: channel || 'whatsapp',
                    lead_detail: details || '',
                    event_category: 'Commercial Conversion',
                    page_location: window.location.href
                  });
                }
                if (typeof window.fbq === 'function') {
                  window.fbq('track', 'Lead', {
                    content_name: details || channel,
                    content_category: 'Inbound Inquiry'
                  });
                }
                window.dispatchEvent(new CustomEvent('bina:lead_conversion', {
                  detail: { channel: channel, details: details, timestamp: Date.now() }
                }));
              } catch (err) {
                console.warn('[Analytics] Non-fatal tracking event error:', err);
              }
            };
          `} />
        </>
      );
    })()}
  </head>

  <body>
    <Preloader />
    <SideMenu />
    <MobileMenu />
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <FloatingWhatsApp />
    <SmoothScroll />
    <CustomCursor />

    <!-- Modern Interactive Engine (Zero jQuery, Zero Legacy Overhead) -->
    <script is:inline src="/assets/js/swiper-bundle.min.js" defer></script>
    <script is:inline src="/assets/js/gsap.min.js" defer></script>
    <script is:inline src="/assets/js/ScrollTrigger.min.js" defer></script>
    <script is:inline>
      (function () {
        // 1. [data-bg-src] Dynamic Background Image Setter
        function initBgSrc() {
          document.querySelectorAll('[data-bg-src]').forEach(function (el) {
            var src = el.getAttribute('data-bg-src');
            if (src) {
              el.style.backgroundImage = "url('" + src + "')";
              el.classList.add('background-image');
            }
          });
        }

        // 2. .th-slider Swiper Carousel Initializer
        function initThSliders() {
          if (typeof Swiper === 'undefined') {
            setTimeout(initThSliders, 80);
            return;
          }
          document.querySelectorAll('.th-slider').forEach(function (sliderEl) {
            if (sliderEl.swiper) return;
            var rawOpts = sliderEl.getAttribute('data-slider-options');
            var customOpts = {};
            try {
              if (rawOpts) customOpts = JSON.parse(rawOpts);
            } catch (err) {
              console.warn('Invalid slider options on element:', err);
            }
            var prevBtn = sliderEl.querySelector('.slider-prev');
            var nextBtn = sliderEl.querySelector('.slider-next');
            var paginationEl = sliderEl.querySelector('.slider-pagination');

            var defaultOpts = {
              slidesPerView: 1,
              spaceBetween: 24,
              loop: true,
              speed: 1000,
              autoplay: { delay: 6000, disableOnInteraction: false },
            };
            if (prevBtn && nextBtn) {
              defaultOpts.navigation = { prevEl: prevBtn, nextEl: nextBtn };
            }
            if (paginationEl) {
              defaultOpts.pagination = {
                el: paginationEl,
                clickable: true,
                renderBullet: function (index, className) {
                  return '<button type="button" class="' + className + '" aria-label="Go to Slide ' + (index + 1) + '"></button>';
                },
              };
            }
            var finalOpts = Object.assign({}, defaultOpts, customOpts);
            new Swiper(sliderEl, finalOpts);
          });
        }

        // 3. External Swiper Navigation Controller [data-slider-prev] / [data-slider-next]
        function initSliderNavButtons() {
          document.querySelectorAll('[data-slider-prev], [data-slider-next]').forEach(function (btn) {
            if (btn._hasSliderNav) return;
            btn._hasSliderNav = true;
            btn.addEventListener('click', function (e) {
              e.preventDefault();
              var targetSelector = btn.getAttribute('data-slider-prev') || btn.getAttribute('data-slider-next');
              var targetEl = targetSelector ? document.querySelector(targetSelector) : null;
              if (targetEl && targetEl.swiper) {
                if (btn.hasAttribute('data-slider-prev')) {
                  targetEl.swiper.slidePrev();
                } else {
                  targetEl.swiper.slideNext();
                }
              }
            });
          });
        }

        // 4. Zero-Dependency Modern Photo Lightbox for .popup-image
        var lightboxOverlay = null;
        var lightboxImg = null;

        function ensureLightbox() {
          if (lightboxOverlay) return;
          lightboxOverlay = document.createElement('div');
          lightboxOverlay.className = 'bina-lightbox-overlay';
          lightboxOverlay.setAttribute('aria-hidden', 'true');
          lightboxOverlay.innerHTML =
            '<div class="bina-lightbox-dialog">' +
              '<button type="button" class="bina-lightbox-close" aria-label="Tutup foto">&times;</button>' +
              '<img class="bina-lightbox-img" src="" alt="Dokumentasi Portofolio Bina Project" />' +
            '</div>';
          document.body.appendChild(lightboxOverlay);
          lightboxImg = lightboxOverlay.querySelector('.bina-lightbox-img');

          function closeLightbox() {
            if (!lightboxOverlay) return;
            lightboxOverlay.classList.remove('is-active');
            lightboxOverlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }

          lightboxOverlay.addEventListener('click', function (e) {
            if (e.target === lightboxOverlay || e.target.closest('.bina-lightbox-close')) {
              closeLightbox();
            }
          });

          window.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && lightboxOverlay && lightboxOverlay.classList.contains('is-active')) {
              closeLightbox();
            }
          });
        }

        function openPhotoLightbox(src) {
          ensureLightbox();
          if (!lightboxOverlay || !lightboxImg) return;
          lightboxImg.src = src;
          lightboxOverlay.classList.add('is-active');
          lightboxOverlay.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        document.addEventListener('click', function (e) {
          var zoomBtn = e.target.closest('.popup-image');
          if (!zoomBtn) return;
          e.preventDefault();
          var imgSrc = zoomBtn.getAttribute('href');
          if (imgSrc) openPhotoLightbox(imgSrc);
        });

        // Initialize on DOM ready and Astro page load
        function initVanillaEngine() {
          initBgSrc();
          initThSliders();
          initSliderNavButtons();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initVanillaEngine);
        } else {
          initVanillaEngine();
        }
        document.addEventListener('astro:page-load', initVanillaEngine);
      })();
    </script>

    <!-- Global Micro-Lightbox Styles (Zero Layout Shift) -->
    <style is:global>
      .bina-lightbox-overlay {
        position: fixed;
        inset: 0;
        z-index: 10000;
        background: rgba(13, 25, 43, 0.9);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        opacity: 0;
        transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }
      .bina-lightbox-overlay.is-active {
        opacity: 1;
        pointer-events: auto;
      }
      .bina-lightbox-dialog {
        position: relative;
        max-width: 90vw;
        max-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: scale(0.96);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .bina-lightbox-overlay.is-active .bina-lightbox-dialog {
        transform: scale(1);
      }
      .bina-lightbox-img {
        max-width: 100%;
        max-height: 85vh;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        object-fit: contain;
      }
      .bina-lightbox-close {
        position: absolute;
        top: -16px;
        right: -16px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #FFFFFF;
        color: #17202A;
        border: none;
        font-size: 22px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
        transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
      }
      .bina-lightbox-close:hover {
        transform: scale(1.08);
        background: #EF4444;
        color: #FFFFFF;
      }
    </style>
  </body>
</html>
