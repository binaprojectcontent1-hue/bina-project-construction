# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (for sitemap generation)
SITE=https://binaproject.com

# Google Analytics 4 (Get ID from analytics.google.com)
VITE_GA_ID=G-XXXXXXXXXX

# Meta Pixel (Facebook & Instagram Ads - Optional)
PUBLIC_META_PIXEL_ID=

# jsDelivr CDN Configuration (Optional: GitHub storage CDN)
PUBLIC_CDN_REPO=owner/repo
PUBLIC_CDN_BRANCH=main
